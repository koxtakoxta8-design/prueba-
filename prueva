--==============================================================
-- UTILIDADES
--==============================================================

local function GetRoot()
    local Character = Player.Character
    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

local function GetPosition(Object)

    if Object:IsA("BasePart") then
        return Object.Position
    end

    if Object:IsA("Model") then

        local Part =
            Object.PrimaryPart
            or Object:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        return Part and Part.Position
    end

    return nil
end

local function IsExcluded(Position)

    if not Position then
        return true
    end

    local X = math.abs(
        Position.X - EXCLUSION_CENTER.X
    )

    local Z = math.abs(
        Position.Z - EXCLUSION_CENTER.Z
    )

    return X <= EXCLUSION_RADIUS
       and Z <= EXCLUSION_RADIUS
end

local function IsEgg(Object)
    if not Object then
        return false
    end

    if Object:IsA("ProximityPrompt") then
        return GetEggFromPrompt(Object) ~= nil
    end

    return LooksLikeEggName(Object.Name)
        or Object:GetAttribute("IsEgg") == true
        or Object:GetAttribute("Egg") == true
end

local function FindPrompt(Object)
    if not Object then
        return nil
    end

    if Object:IsA("ProximityPrompt") then
        return Object
    end

    return Object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )
end

--==============================================================
-- VALOR
--==============================================================

local function GetValue(Object)

    local AttributeNames = {
        "Luck",
        "luck",
        "EggLuck",
        "RarityValue",
        "Value",
        "Price"
    }

    for _,Name in ipairs(AttributeNames) do

        local Value =
            Object:GetAttribute(Name)

        if typeof(Value) == "number" then
            return Value
        end
    end

    for _,Item in ipairs(
        Object:GetDescendants()
    ) do

        if Item:IsA("NumberValue")
        or Item:IsA("IntValue") then

            local Name =
                Item.Name:lower()

            if Name:find("luck")
            or Name:find("rarity")
            or Name:find("value")
            or Name:find("price") then

                return Item.Value
            end
        end
    end

    return 0
end

--==============================================================
-- PRIORIDAD DE HUEVOS
--==============================================================

local EggPriority = {
    ["Volcanic Egg"] = 2500000000000, -- 2.5T
    ["Cherub Egg"] = 1000000000000,
    ["Solaris Egg"] = 300000000000,
    ["Black Hole Egg"] = 100000000000,
    ["Blackhole Egg"] = 100000000000,
}

local function GetEggPriority(Object)
    if not Object then
        return 0
    end

    local exact = EggPriority[Object.Name]
    if exact then
        return exact
    end

    local name = Object.Name:lower()

    if name:find("volcanic", 1, true) then
        return EggPriority["Volcanic Egg"]
    elseif name:find("cherub", 1, true) then
        return EggPriority["Cherub Egg"]
    elseif name:find("solaris", 1, true) then
        return EggPriority["Solaris Egg"]
    elseif name:find("blackhole", 1, true)
        or (name:find("black", 1, true) and name:find("hole", 1, true)) then
        return EggPriority["Black Hole Egg"]
    end

    return GetValue(Object)
end

local function LooksLikeEggName(name)
    name = tostring(name or ""):lower()

    return name:find("egg", 1, true) ~= nil
        or name:find("huevo", 1, true) ~= nil
        or name:find("volcanic", 1, true) ~= nil
        or name:find("solar", 1, true) ~= nil
        or name:find("cherub", 1, true) ~= nil
        or name:find("blackhole", 1, true) ~= nil
        or (name:find("black", 1, true) and name:find("hole", 1, true)) ~= nil
end

local function GetEggFromPrompt(Prompt)
    if not Prompt then
        return nil
    end

    local current = Prompt.Parent

    for _ = 1, 10 do
        if not current then
            break
        end

        if current:IsA("Model") or current:IsA("BasePart") then
            if LooksLikeEggName(current.Name)
                or current:GetAttribute("IsEgg") == true
                or current:GetAttribute("Egg") == true then
                return current
            end
        end

        current = current.Parent
    end

    -- Si el prompt está dentro de un modelo sin "Egg" en el nombre,
    -- usar el modelo más cercano como candidato solamente cuando
    -- la acción/texto del prompt parece de recogida.
    local action = tostring(Prompt.ActionText or ""):lower()
    local objectText = tostring(Prompt.ObjectText or ""):lower()

    local pickupWords =
        action:find("grab", 1, true)
        or action:find("pick", 1, true)
        or action:find("collect", 1, true)
        or action:find("recoger", 1, true)
        or action:find("agarrar", 1, true)
        or action:find("tomar", 1, true)
        or objectText:find("egg", 1, true)
        or objectText:find("huevo", 1, true)

    if pickupWords then
        local model = Prompt:FindFirstAncestorOfClass("Model")
        if model then
            return model
        end
    end

    return nil
end

--==============================================================
-- CACHE DE HUEVOS
--==============================================================

local EggCache = {}
local PromptConnections = {}

local function WatchPrompt(Prompt)
    if not Prompt or not Prompt:IsA("ProximityPrompt") then
        return
    end

    if PromptConnections[Prompt] then
        return
    end

    PromptConnections[Prompt] =
        Prompt:GetPropertyChangedSignal("Enabled"):Connect(function()
            if Prompt.Parent and Prompt.Enabled then
                task.defer(function()
                    RegisterEgg(Prompt)
                end)
            end
        end)
end


local function RemoveEgg(Object)
    EggCache[Object] = nil
end

local function RegisterEgg(Object)
    if not Object or not Object.Parent then
        return
    end

    local Egg = Object

    -- Si viene de un prompt, encontrar el modelo real del huevo.
    if Object:IsA("ProximityPrompt") then
        Egg = GetEggFromPrompt(Object)
    end

    if not Egg then
        return
    end

    if not LooksLikeEggName(Egg.Name)
        and Egg:GetAttribute("IsEgg") ~= true
        and Egg:GetAttribute("Egg") ~= true then

        -- Aceptar un modelo que contenga un prompt de recogida.
        local PromptCandidate = FindPrompt(Egg)
        if not PromptCandidate then
            return
        end

        local action = tostring(PromptCandidate.ActionText or ""):lower()
        local objectText = tostring(PromptCandidate.ObjectText or ""):lower()

        local pickup =
            action:find("grab", 1, true)
            or action:find("pick", 1, true)
            or action:find("collect", 1, true)
            or action:find("recoger", 1, true)
            or action:find("agarrar", 1, true)
            or action:find("tomar", 1, true)
            or objectText:find("egg", 1, true)
            or objectText:find("huevo", 1, true)

        if not pickup then
            return
        end
    end

    local Position = GetPosition(Egg)

    if not Position or IsExcluded(Position) then
        EggCache[Egg] = nil
        return
    end

    local Prompt = FindPrompt(Egg)

    if not Prompt then
        return
    end

    WatchPrompt(Prompt)

    EggCache[Egg] = {
        Object = Egg,
        Position = Position,
        Prompt = Prompt,
        Value = GetValue(Egg),
        Priority = GetEggPriority(Egg)
    }
end

local function RebuildCache()
    table.clear(EggCache)

    -- Buscar prompts primero: esto permite detectar huevos aunque
    -- el modelo no tenga "Egg" en su nombre.
    for _, Object in ipairs(workspace:GetDescendants()) do
        if Object:IsA("ProximityPrompt") then
            RegisterEgg(Object)
        end
    end

    -- Y después revisar objetos que sí tienen nombres reconocibles.
    for _, Object in ipairs(workspace:GetDescendants()) do
        if LooksLikeEggName(Object.Name)
            or Object:GetAttribute("IsEgg") == true
            or Object:GetAttribute("Egg") == true then
            RegisterEgg(Object)
        end
    end
end

