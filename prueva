task.spawn(function()
    while task.wait(2) do
        for _,obj in ipairs(Workspace:GetDescendants()) do
            if isEgg(obj) then
                -- Only display ESP for eggs that are not inside a player's own base.
                local belongsToSomeone = false
                for player,data in pairs(active) do
                    if isInsideMyBase(player,obj) then
                        belongsToSomeone = true
                        break
                    end
                end

                if not belongsToSomeone then
                    for player,data in pairs(active) do
                        if data.ESP then
                            pcall(function() addESP(obj) end)
                        end
                    end
                else
                    local x = obj:FindFirstChild("KOXTA_EggESP")
                    if x then x:Destroy() end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(AUTO_DELAY) do
        for player,data in pairs(active) do
            if data.AUTO then
                local root = getRoot(player)
                local egg = bestEgg(player)

                if root and egg and egg.Parent then
                    local part = getPart(egg)

                    if part then
                        data.State.Text = "TP → "..egg.Name

                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        root.CFrame = CFrame.new(part.Position + Vector3.new(0,2.5,0))

                        -- Rapid server-side grab burst.
                        local grabbed = false
                        for i = 1,8 do
                            if not egg.Parent or egg:GetAttribute("KOXTA_Collected") then
                                grabbed = true
                                break
                            end

                            grabbed = grabEgg(player,egg) or grabbed
                            if grabbed then break end
                            task.wait(0.02)
                        end

                        if grabbed then
                            data.State.Text = "✓ GRABBED → BASE"
                        else
                            data.State.Text = "RETRYING..."
                        end
                    end
                else
                    data.State.Text = "NO EGG"
                end
            end
        end
    end
end)

Workspace.DescendantAdded:Connect(function(obj)
    if isEgg(obj) then
        task.wait(.1)
        local ignored = false
        for player,data in pairs(active) do
            if isInsideMyBase(player,obj) then
                ignored = true
                break
            end
        end

        if not ignored then
            for _,data in pairs(active) do
                if data.ESP then pcall(function() addESP(obj) end) end
            end
        end
    end
end)
