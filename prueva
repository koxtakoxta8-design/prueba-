--==============================================================
-- CANDIDATOS
--==============================================================

local Candidates = {}

local function AddCandidate(
    id,
    position,
    eggName,
    data
)

    if not position or not data then
        return
    end

    Candidates[id] = {
        Position = position,
        Name = eggName,
        Data = data
    }
end

--==============================================================
-- WORKSPACE
--==============================================================

local function ScanWorkspace()

    for _,obj in ipairs(
        Workspace:GetDescendants()
    ) do

        local eggName,data =
            GetEggData(obj.Name)

        if eggName and data then

            local part = GetPart(obj)

            if part then

                AddCandidate(
                    "WS_"..obj:GetFullName(),
                    part.Position,
                    eggName,
                    data
                )
            end
        end
    end
end

--==============================================================
-- SNAPSHOT
--==============================================================

local function ScanSnapshot()

    if not SnapshotRemote then
        return
    end

    local success,snapshot =
        pcall(function()
            return SnapshotRemote:InvokeServer()
        end)

    if not success or type(snapshot) ~= "table" then
        return
    end

    local records =
        snapshot.Records or snapshot

    if type(records) ~= "table" then
        return
    end

    for index,rec in ipairs(records) do

        if type(rec) == "table" then

            local position

            if typeof(rec.BottomCFrame) == "CFrame" then
                position = rec.BottomCFrame.Position

            elseif typeof(rec.BottomCFrame) == "Vector3" then
                position = rec.BottomCFrame
            end

            if position then

                local eggName,data =
                    GetEggData(rec.AssetCategory)

                if not data then
                    eggName,data =
                        GetEggData(rec.Name)
                end

                if not data then
                    eggName,data =
                        GetEggData(rec.DisplayName)
                end

                if eggName and data then

                    AddCandidate(
                        "SNAP_"..tostring(index),
                        position,
                        eggName,
                        data
                    )
                end
            end
        end
    end
end

--==============================================================
-- REDIBUJAR
--==============================================================

local function RefreshESP()

    if not ESP_ENABLED then
        return
    end

    Candidates = {}

    ScanWorkspace()
    ScanSnapshot()

    -- Buscar el mayor Lucky
    local bestId = nil
    local bestLuck = -1

    for id,info in pairs(Candidates) do

        if info.Data.Luck > bestLuck then

            bestLuck = info.Data.Luck
            bestId = id
        end
    end

    -- Dibujar
    for id,info in pairs(Candidates) do

        CreateESP(
            id,
            info.Position,
            info.Name,
            info.Data,
            id == bestId
        )
    end
end

--==============================================================
-- LIMPIAR
--==============================================================

local function ClearAll()

    for id in pairs(ActiveESP) do
        DestroyESP(id)
    end
end

