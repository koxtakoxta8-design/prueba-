local function SaveSpawn()

    local Root =
        GetRoot()

    if Root then
        SavedSpawn =
            Root.CFrame
    end
end

--==============================================================
-- TP
--==============================================================

local function TeleportToEgg(Egg)

    local Root =
        GetRoot()

    local Part =
        Egg and GetPart(Egg)

    if not Root or not Part then
        return false
    end

    Root.CFrame =
        CFrame.new(
            Part.Position +
            Vector3.new(0,2.5,0)
        )

    Root.AssemblyLinearVelocity =
        Vector3.zero

    Root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

local function ReturnSpawn()

    local Root =
        GetRoot()

    if Root and SavedSpawn then

        Root.CFrame =
            SavedSpawn

        Root.AssemblyLinearVelocity =
            Vector3.zero

        Root.AssemblyAngularVelocity =
            Vector3.zero

    end
end

--==============================================================
-- FREEZE
--==============================================================

local function Freeze()

    local Character =
        Player.Character

    if not Character then
        return
    end

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if Humanoid then

        Humanoid.AutoRotate = false
        Humanoid.WalkSpeed = 0
        Humanoid.JumpPower = 0

    end
end

local function Unfreeze()

    local Character =
        Player.Character

    if not Character then
        return
    end

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if Humanoid then

        Humanoid.AutoRotate = true
        Humanoid.WalkSpeed = 16
        Humanoid.JumpPower = 50

    end
end

