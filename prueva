local function ClickAnimation(button)

    local originalSize =
        button.Size

    TweenService:Create(
        button,
        TweenInfo.new(
            0.07,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            Size =
                UDim2.fromOffset(
                    originalSize.X.Offset - 5,
                    originalSize.Y.Offset - 3
                )
        }
    ):Play()

    task.delay(
        0.07,
        function()

            TweenService:Create(
                button,
                TweenInfo.new(
                    0.13,
                    Enum.EasingStyle.Back,
                    Enum.EasingDirection.Out
                ),
                {
                    Size =
                        originalSize
                }
            ):Play()

        end
    )

end

