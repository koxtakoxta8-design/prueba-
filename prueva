--==============================================================

local Radius = 100
local MinRadius = 25
local MaxRadius = 500

local CenterPosition = nil
local CirclePart = nil
local CircleConnection = nil

--==============================================================
-- OBTENER PERSONAJE
--==============================================================

local function GetRoot()

    local character = Player.Character

    if not character then
        return nil
    end

    return character:FindFirstChild(
        "HumanoidRootPart"
    )
end

--==============================================================
-- CREAR CÍRCULO
--==============================================================

local function CreateCircle()

    if CirclePart then
        CirclePart:Destroy()
    end

    CirclePart = Instance.new("Part")

    CirclePart.Name =
        "KOXTA_ExclusionCircle"

    CirclePart.Anchored = true
    CirclePart.CanCollide = false
    CirclePart.CanTouch = false
    CirclePart.CanQuery = false

    CirclePart.Transparency = 0.75

    CirclePart.Color =
        Color3.fromRGB(
            255,
            70,
            70
        )

    CirclePart.Material =
        Enum.Material.ForceField

    CirclePart.Shape =
        Enum.PartType.Cylinder

    CirclePart.Size =
        Vector3.new(
            0.15,
            Radius * 2,
            Radius * 2
        )

    CirclePart.Parent =
        workspace

    if CenterPosition then

        CirclePart.CFrame =
            CFrame.new(
                CenterPosition
            ) *
            CFrame.Angles(
                0,
                0,
                math.rad(90)
            )
    end
end

--==============================================================
-- ACTUALIZAR CÍRCULO
--==============================================================

local function UpdateCircle()

    if not CirclePart
    or not CenterPosition then
        return
    end

    CirclePart.Size =
        Vector3.new(
            0.15,
            Radius * 2,
            Radius * 2
        )

    CirclePart.CFrame =
        CFrame.new(
            CenterPosition
        ) *
        CFrame.Angles(
            0,
            0,
            math.rad(90)
        )
end

--==============================================================
-- TOMAR COORDENADAS ACTUALES
--==============================================================

local function SetCenterHere()

    local root = GetRoot()

    if not root then
        return false
    end

    CenterPosition =
        root.Position

    CreateCircle()

    return true
end

