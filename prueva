-- ServerScriptService/RideAPetController.server.lua

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CENTER = Vector3.new(146.87, 40316.12, 911.14)
local EXCLUSION_RADIUS = 210
local PLOT_SPEED = 500

local EggValues = {
	["White Egg"] = 1,
	["Brown Egg"] = 5,
	["Cracked Egg"] = 30,
	["Easter Egg"] = 50,
	["Stone Egg"] = 100,
	["Leaf Egg"] = 200,
	["Mushroom Egg"] = 500,
	["Flower Egg"] = 750,
	["Slime Egg"] = 1000,
	["Ice Egg"] = 3000,
	["Glass Egg"] = 10000,
	["Golden Egg"] = 30000,
	["Crystal Egg"] = 150000,
	["Skull Egg"] = 250000,
	["Dominus Egg"] = 700000,
	["Flaming Egg"] = 1000000,
	["Sinister Egg"] = 3000000,
	["Soul Egg"] = 7000000,
	["Aurora Egg"] = 300000000,
	["Galaxy Egg"] = 1500000000,
	["Blackhole Egg"] = 100000000000,
	["Solaris Egg"] = 300000000000,
	["Cherub Egg"] = 1000000000000,
	["Volcanic Egg"] = 2500000000000,
}

local function getEggName(obj)
	if EggValues[obj.Name] then
		return obj.Name
	end

	local attr = obj:GetAttribute("EggName")
	if typeof(attr) == "string" and EggValues[attr] then
		return attr
	end

	return nil
end

local function getEggPosition(obj)
	if obj:IsA("BasePart") then
		return obj.Position
	end

	if obj:IsA("Model") then
		return obj:GetPivot().Position
	end

	local part = obj:FindFirstChildWhichIsA("BasePart", true)

	if part then
		return part.Position
	end

	return nil
end

local function isEgg(obj)
	return getEggName(obj) ~= nil
end

local function insideForbiddenArea(position)
	return (position - CENTER).Magnitude <= EXCLUSION_RADIUS
end

local function findBestEgg()
	local bestEgg = nil
	local bestValue = -math.huge

	for _, obj in ipairs(workspace:GetDescendants()) do
		if isEgg(obj) then
			local position = getEggPosition(obj)

			if position and not insideForbiddenArea(position) then
				local name = getEggName(obj)
				local value = EggValues[name]

				if value and value > bestValue then
					bestValue = value
					bestEgg = obj
				end
			end
		end
	end

	return bestEgg
end

local function getCharacter(player)
	local character = player.Character

	if not character then
		return nil
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return nil
	end

	return character, root
end

local function teleportPlayer(player, position)
	local character, root = getCharacter(player)

	if not root then
		return false
	end

	character:PivotTo(CFrame.new(position + Vector3.new(0, 3, 0)))

	return true
end

local function findMyPlot(player)
	for _, obj in ipairs(workspace:GetDescendants()) do
		if not (obj:IsA("Model") or obj:IsA("Folder")) then
			continue
		end

		local ownerNames = {
			"Owner",
			"OwnerName",
			"Player",
			"PlayerName",
			"Username",
			"UserName",
		}

		for _, attributeName in ipairs(ownerNames) do
			local value = obj:GetAttribute(attributeName)

			if value == player.Name or value == player.DisplayName then
				return obj
			end
		end

		local userId = obj:GetAttribute("UserId")
			or obj:GetAttribute("OwnerUserId")

		if tonumber(userId) == player.UserId then
			return obj
		end
	end

	return nil
end

local function getPlotPosition(plot)
	if not plot then
		return nil
	end

	local preferredNames = {
		"Spawn",
		"SpawnLocation",
		"EggDrop",
		"Drop",
		"DropEgg",
		"Base",
	}

	for _, name in ipairs(preferredNames) do
		local obj = plot:FindFirstChild(name, true)

		if obj then
			if obj:IsA("BasePart") then
				return obj.Position
			elseif obj:IsA("Model") then
				return obj:GetPivot().Position
			end
		end
	end

	if plot:IsA("Model") then
		return plot:GetPivot().Position
	end

	return nil
end

local function findGrabPrompt(egg)
	if not egg then
		return nil
	end

	local words = {
		"grab",
		"pick",
		"collect",
		"take",
		"recoger",
		"agarrar",
		"tomar",
	}

	for _, obj in ipairs(egg:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			local text = string.lower(
				tostring(obj.ActionText) .. " " ..
				tostring(obj.ObjectText) .. " " ..
				obj.Name
			)

			for _, word in ipairs(words) do
				if string.find(text, word, 1, true) then
					return obj
				end
			end
		end
	end

	return nil
end

-- Esta función debe ser conectada al sistema real de tu juego.
-- El servidor es quien debe decidir si el jugador tomó el huevo.
local function grabEgg(player, egg)
	if not egg or not egg.Parent then
		return false
	end

	local prompt = findGrabPrompt(egg)

	if not prompt then
		return false
	end

	-- En tu juego, reemplaza esta sección por la función
	-- real que ya utilizas para recoger el huevo.
	local grabFunction = egg:FindFirstChild("Grab", true)

	if grabFunction and grabFunction:IsA("BindableEvent") then
		grabFunction:Fire(player)
		return true
	end

	return false
end

local function playerHasEgg(player)
	local character = player.Character

	if not character then
		return false
	end

	-- Adaptadores habituales para un huevo cargado.
	for _, obj in ipairs(character:GetChildren()) do
		if getEggName(obj) then
			return true
		end

		if obj:GetAttribute("IsEgg") == true then
			return true
		end

		if obj:GetAttribute("HoldingEgg") == true then
			return true
		end
	end

	if character:GetAttribute("HoldingEgg") == true then
		return true
	end

	if player:GetAttribute("HoldingEgg") == true then
		return true
	end

	return false
end

local function waitUntilGrabbed(player, egg)
	for _ = 1, 30 do
		if playerHasEgg(player) then
			return true
		end

		grabEgg(player, egg)
		task.wait(0.05)

		if not egg.Parent then
			return playerHasEgg(player)
		end
	end

	return playerHasEgg(player)
end

local function dropEgg(player)
	-- Tu juego debe conectar aquí su sistema oficial DropEgg.
	local dropEvent = ReplicatedStorage:FindFirstChild("DropEgg")

	if dropEvent and dropEvent:IsA("RemoteEvent") then
		dropEvent:FireClient(player)
		return true
	end

	return false
end

local function moveToPlot(player, position)
	local character, root = getCharacter(player)

	if not root then
		return false
	end

	local start = root.Position
	local distance = (position - start).Magnitude

	if distance <= 1 then
		return true
	end

	local duration = distance / PLOT_SPEED
	local started = os.clock()

	while os.clock() - started < duration do
		if not root.Parent then
			return false
		end

		local alpha = math.clamp(
			(os.clock() - started) / duration,
			0,
			1
		)

		local current = start:Lerp(position, alpha)

		character:PivotTo(CFrame.new(current))

		task.wait()
	end

	character:PivotTo(CFrame.new(position))

	return true
end

local function run(player)
	while player.Parent do

		-- =========================================
		-- 1. BUSCAR MEJOR HUEVO
		-- =========================================

		local egg = findBestEgg()

		if not egg then
			task.wait(0.25)
			continue
		end

		local eggPosition = getEggPosition(egg)

		if not eggPosition then
			task.wait(0.1)
			continue
		end

		-- =========================================
		-- 2. TP AL MEJOR HUEVO
		-- =========================================

		teleportPlayer(player, eggPosition)

		task.wait()

		-- =========================================
		-- 3. GRAB MUY RÁPIDO + REINTENTAR
		-- =========================================

		local grabbed = waitUntilGrabbed(player, egg)

		-- Si NO lo agarró, NO se va al centro.
		if not grabbed then
			task.wait(0.1)
			continue
		end

		-- =========================================
		-- 4. TP AL CENTRO
		-- =========================================

		teleportPlayer(player, CENTER)

		task.wait()

		-- =========================================
		-- 5. DROP
		-- =========================================

		dropEgg(player)

		task.wait(0.15)

		-- =========================================
		-- 6. BUSCAR HUEVO OTRA VEZ
		--    NUNCA ELEGIR LOS 210 STUDS CENTRALES
		-- =========================================

		local secondEgg

		for _ = 1, 40 do
			secondEgg = findBestEgg()

			if secondEgg then
				break
			end

			task.wait(0.05)
		end

		if not secondEgg then
			task.wait(0.2)
			continue
		end

		-- =========================================
		-- 7. TP AL HUEVO
		-- =========================================

		local secondPosition = getEggPosition(secondEgg)

		if not secondPosition then
			continue
		end

		-- Seguridad: nunca recoger dentro de 210
		if insideForbiddenArea(secondPosition) then
			continue
		end

		teleportPlayer(player, secondPosition)

		task.wait()

		-- =========================================
		-- 8. GRAB OTRA VEZ
		-- =========================================

		local grabbedAgain = waitUntilGrabbed(player, secondEgg)

		if not grabbedAgain then
			continue
		end

		-- =========================================
		-- 9. BUSCAR MI PLOT
		-- =========================================

		local plot = findMyPlot(player)

		if not plot then
			task.wait(0.2)
			continue
		end

		local plotPosition = getPlotPosition(plot)

		if not plotPosition then
			task.wait(0.2)
			continue
		end

		-- =========================================
		-- 10. IR AL PLOT A 500 STUDS/S
		-- =========================================

		moveToPlot(player, plotPosition)

		task.wait()

		-- =========================================
		-- 11. DROP FINAL
		-- =========================================

		if playerHasEgg(player) then
			dropEgg(player)
		end

		task.wait(0.25)
	end
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(2)

		task.spawn(function()
			run(player)
		end)
	end)
end)
