--------------------------------------------------

local EggLuck = {
    ["White Egg"] = 1,
    ["Brown Egg"] = 5,
    ["Cracked Egg"] = 30,
    ["Easter Egg"] = 50,
    ["Stone Egg"] = 100,
    ["Leaf Egg"] = 200,
    ["Mushroom Egg"] = 500,
    ["Flower Egg"] = 750,
    ["Slime Egg"] = 1000,
    ["Ice Egg"] = 3000,
    ["Glass Egg"] = 10000,
    ["Golden Egg"] = 30000,
    ["Crystal Egg"] = 150000,
    ["Skull Egg"] = 250000,
    ["Dominus Egg"] = 700000,
    ["Flaming Egg"] = 1000000,
    ["Sinister Egg"] = 3000000,
    ["Soul Egg"] = 7000000,
    ["Aurora Egg"] = 300000000,
    ["Galaxy Egg"] = 1500000000,
    ["Black Hole Egg"] = 100000000000,
    ["Cherub Egg"] = 1000000000000
}

local function Normalize(str)
    return tostring(str or "")
        :lower()
        :gsub("_", " ")
        :gsub("%-", " ")
end

local function GetLuck(asset)
    local n = Normalize(asset)

    for egg, luck in pairs(EggLuck) do
        local e = Normalize(egg)

        if n == e or string.find(n, e, 1, true) then
            return luck, egg
        end
    end

    return 0, tostring(asset)
end

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

local function GetRoot()
    local char = Player.Character

    if not char then
        return nil
    end

    return char:FindFirstChild("HumanoidRootPart")
end

local function Teleport(pos)
    local root = GetRoot()

    if not root then
        return false
    end

    root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))

    return true
end

--------------------------------------------------
-- SNAPSHOT / MEJOR HUEVO
--------------------------------------------------

local function FindBestEgg()

    if not SnapshotRemote then
        return nil, 0, 0
    end

    local ok, snapshot = pcall(function()
        return SnapshotRemote:InvokeServer()
    end)

    if not ok or type(snapshot) ~= "table" then
        return nil, 0, 0
    end

    local records = snapshot.Records or snapshot

    local best = nil
    local bestLuck = -1
    local count = 0

    for _, rec in ipairs(records) do

        if type(rec) == "table"
        and rec.State == "Slot"
        and rec.BottomCFrame then

            local position

            if typeof(rec.BottomCFrame) == "CFrame" then
                position = rec.BottomCFrame.Position

            elseif typeof(rec.BottomCFrame) == "Vector3" then
                position = rec.BottomCFrame
            end

            if position then

                count += 1

                local luck, displayName =
                    GetLuck(rec.AssetCategory)

                if luck > bestLuck then

                    bestLuck = luck

                    best = {
                        Name = displayName,
                        Asset = rec.AssetCategory,
                        Luck = luck,
                        Position = position,
                        Record = rec
                    }
                end
            end
        end
    end

    return best, bestLuck, count
end

