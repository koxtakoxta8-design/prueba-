    ["White Egg"]      = 1,
    ["Brown Egg"]      = 5,
    ["Cracked Egg"]    = 30,
    ["Easter Egg"]     = 50,
    ["Stone Egg"]      = 100,
    ["Leaf Egg"]       = 200,
