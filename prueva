--==============================================================
-- BUSCAR PLOT DEL JUGADOR
--==============================================================

local function GetMyPlot()

    local playerName =
        LocalPlayer.Name:lower()

    local displayName =
        LocalPlayer.DisplayName:lower()

    local candidates = {}

    for _, obj in ipairs(
        Workspace:GetChildren()
    ) do

        local name =
            obj.Name:lower()

        local matchesPlayer =
            name == playerName
            or name == displayName
            or name:find(
                playerName,
                1,
                true
            )
            or name:find(
                displayName,
                1,
                true
            )

        if matchesPlayer then

            table.insert(
                candidates,
                obj
            )
        end
    end

    -- Buscar también un nivel más profundo
    if #candidates == 0 then

        for _, obj in ipairs(
            Workspace:GetDescendants()
        ) do

            if obj:IsA("Model")
            or obj:IsA("Folder") then

                local name =
                    obj.Name:lower()

                if name == playerName
                or name == displayName
                or name:find(
                    playerName,
                    1,
                    true
                )
                or name:find(
                    displayName,
                    1,
                    true
                ) then

                    table.insert(
                        candidates,
                        obj
                    )
                end
            end
        end
    end

    -- Si hay varios, buscar uno que parezca plot
    for _, candidate in ipairs(candidates) do

        local score = 0

        for _, child in ipairs(
            candidate:GetDescendants()
        ) do

            local childName =
                child.Name:lower()

            if childName:find(
                "plot",
                1,
                true
            ) then
                score += 3
            end

            if childName:find(
                "ranch",
                1,
                true
            ) then
                score += 3
            end

            if childName:find(
                "base",
                1,
                true
            ) then
                score += 3
            end

            if childName:find(
                "nest",
                1,
                true
            ) then
                score += 2
            end
        end

        if score > 0 then
            return candidate
        end
    end

    return candidates[1]
end

--==============================================================
-- PUNTO DENTRO DE PARTE
--==============================================================

local function PointInsidePart(
    position,
    part
)

    local localPos =
        part.CFrame:PointToObjectSpace(
            position
        )

    local half =
        part.Size / 2

    return
        math.abs(localPos.X) <= half.X
        and
        math.abs(localPos.Y) <= half.Y
        and
        math.abs(localPos.Z) <= half.Z
end

--==============================================================
-- ¿ESTÁ DENTRO DEL PLOT?
--==============================================================

local function IsInsideMyPlot(
    part,
    plot
)

    if not part or not plot then
        return false
    end

    -- Revisar las partes del plot
    for _, child in ipairs(
        plot:GetDescendants()
    ) do

        if child:IsA("BasePart") then

            -- Evitar usar partes diminutas
            if child.Size.X > 4
            or child.Size.Z > 4 then

                if PointInsidePart(
                    part.Position,
                    child
                ) then

                    return true
                end
            end
        end
    end

    return false
end

--==============================================================
-- ESCANEAR WORKSPACE
--==============================================================

local function ScanWorkspace()

    local plot =
        GetMyPlot()

    local found = {}
    local processed = {}

    for _, obj in ipairs(
        Workspace:GetDescendants()
    ) do

        local data, realName =
            GetEggData(obj.Name)

        if data then

            local part =
                GetPart(obj)

            if part
            and not processed[obj] then

                processed[obj] = true

                local insideBase =
                    IsInsideMyPlot(
                        part,
                        plot
                    )

                if not insideBase then

                    table.insert(
                        found,
                        {
                            Object = obj,

                            Part = part,

                            Name = realName,

                            Luck = data.Luck,

                            LuckNumber =
                                LuckNumber(
                                    data.Luck
                                ),

                            Rarity =
                                data.Rarity,

                            Position =
                                part.Position
                        }
                    )
                end
            end
        end
    end

    return found
end

--==============================================================
-- MEJOR HUEVO
--==============================================================

local function FindBestEgg()

    local eggs =
        ScanWorkspace()

    local best = nil

    for _, egg in ipairs(eggs) do

        if not best
        or egg.LuckNumber >
           best.LuckNumber then

            best = egg
        end
    end

    return best, #eggs
end

--==============================================================
-- CONGELAR
--==============================================================

local function Freeze()

    local character =
        LocalPlayer.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if humanoid then

        humanoid:SetAttribute(
            "KOXTA_OLD_SPEED",
            humanoid.WalkSpeed
        )

        humanoid:SetAttribute(
            "KOXTA_OLD_JUMP",
            humanoid.JumpPower
        )

        humanoid:SetAttribute(
            "KOXTA_OLD_ROTATE",
            humanoid.AutoRotate
        )

        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.AutoRotate = false
    end

    if root then

        root.AssemblyLinearVelocity =
            Vector3.zero

        root.AssemblyAngularVelocity =
            Vector3.zero
    end
end

--==============================================================
-- DESCONGELAR
--==============================================================

local function Unfreeze()

    local character =
        LocalPlayer.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return
    end

    humanoid.WalkSpeed =
        humanoid:GetAttribute(
            "KOXTA_OLD_SPEED"
        ) or 16

    humanoid.JumpPower =
        humanoid:GetAttribute(
            "KOXTA_OLD_JUMP"
        ) or 50

    local oldRotate =
        humanoid:GetAttribute(
            "KOXTA_OLD_ROTATE"
        )

    if oldRotate == nil then
        humanoid.AutoRotate = true
    else
        humanoid.AutoRotate =
            oldRotate
    end
end

--==============================================================
-- TP AL HUEVO
--==============================================================

local function TeleportToEgg(egg)

    local root =
        GetRoot()

    if not root or not egg then
        return false
    end

    root.CFrame =
        CFrame.new(
            egg.Position +
            Vector3.new(
                0,
                3,
                0
            )
        )

    task.wait()

    Freeze()

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

--==============================================================
-- REGRESAR
--==============================================================

local function ReturnToStart()

    local root =
        GetRoot()

    if not root
    or not ReturnCFrame then
        return false
    end

    root.CFrame =
        ReturnCFrame

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

