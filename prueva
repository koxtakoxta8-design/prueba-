--==============================================================
-- ROOT
--==============================================================

local function GetRoot()

    local Character = Player.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild(
        "HumanoidRootPart"
    )
end

--==============================================================
-- PARTES
--==============================================================

local function GetParts(Object)

    local Parts = {}

    if Object:IsA("BasePart") then

        Parts[1] = Object

    elseif Object:IsA("Model") then

        for _,Item in ipairs(
            Object:GetDescendants()
        ) do

            if Item:IsA("BasePart") then
                Parts[#Parts + 1] = Item
            end
        end
    end

    return Parts
end

--==============================================================
-- POSICIÓN
--==============================================================

local function GetPosition(Object)

    local Parts = GetParts(Object)

    if #Parts == 0 then
        return nil
    end

    local Total = Vector3.zero

    for _,Part in ipairs(Parts) do
        Total += Part.Position
    end

    return Total / #Parts
end

--==============================================================
-- EXCLUSIÓN
--==============================================================

local function IsExcluded(Position)

    if not Position then
        return true
    end

    local X =
        math.abs(
            Position.X -
            EXCLUSION_CENTER.X
        )

    local Z =
        math.abs(
            Position.Z -
            EXCLUSION_CENTER.Z
        )

    return
        X <= EXCLUSION_RADIUS
        and
        Z <= EXCLUSION_RADIUS
end

--==============================================================
-- ¿ES HUEVO?
--==============================================================

local function IsEgg(Object)

    local Name =
        Object.Name:lower()

    if Name:find("egg") then
        return true
    end

    if Name:find("huevo") then
        return true
    end

    if Object:GetAttribute(
        "IsEgg"
    ) == true then
        return true
    end

    return false
end

--==============================================================
-- PROMPT
--==============================================================

local function FindPrompt(Object)

    if Object:IsA(
        "ProximityPrompt"
    ) then
        return Object
    end

    return Object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )
end

