--------------------------------------------------
-- SPAWN
--------------------------------------------------

local function GetSpawn()

    local spawn = Workspace:FindFirstChild(
        SPAWN_NAME,
        true
    )

    if spawn and spawn:IsA("BasePart") then
        return spawn.Position
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do

        if obj:IsA("SpawnLocation") then
            return obj.Position
        end
    end

    return nil
end

