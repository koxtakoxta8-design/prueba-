--==============================================================
-- CONVERTIR LUCKY
--==============================================================

local function ParseLuck(value)

    if not value then
        return 0
    end

    local text = tostring(value):upper()

    local number = tonumber(
        string.match(text, "[%d%.]+")
    )

    if not number then
        return 0
    end

    if string.find(text, "T", 1, true) then
        return number * 1000000000000

    elseif string.find(text, "B", 1, true) then
        return number * 1000000000

    elseif string.find(text, "M", 1, true) then
        return number * 1000000

    elseif string.find(text, "K", 1, true) then
        return number * 1000
    end

    return number
end

--==============================================================
-- OBTENER DATOS
--==============================================================

local function GetEggData(name)

    if not name then
        return nil
    end

    if EggData[name] then
        return EggData[name]
    end

    local lowerName = string.lower(name)

    for eggName, data in pairs(EggData) do

        if string.find(
            lowerName,
            string.lower(eggName),
            1,
            true
        ) then

            return data
        end
    end

    return nil
end

--==============================================================
-- OBTENER PARTE
--==============================================================

local function GetPart(obj)

    if not obj then
        return nil
    end

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then

        if obj.PrimaryPart then
            return obj.PrimaryPart
        end

        return obj:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
    end

    return nil
end

--==============================================================
-- POSICIÓN
--==============================================================

local function GetObjectPosition(obj)

    local part = GetPart(obj)

    if part then
        return part.Position
    end

    return nil
end

--==============================================================
-- ROOT
--==============================================================

local function GetRoot()

    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChild(
        "HumanoidRootPart"
    )
end

--==============================================================
-- EXCLUSIÓN
--==============================================================

local function IsInsideExclusion(obj)

    local position = GetObjectPosition(obj)

    if not position then
        return true
    end

    return (
        position - EXCLUSION_CENTER
    ).Magnitude <= EXCLUSION_RADIUS
end

--==============================================================
-- RANGO
--==============================================================

local function IsWithinDetectionRange(obj)

    local root = GetRoot()

    if not root then
        return false
    end

    local position = GetObjectPosition(obj)

    if not position then
        return false
    end

    return (
        position - root.Position
    ).Magnitude <= DETECTION_DISTANCE
end

--==============================================================
-- HUEVO VÁLIDO
--==============================================================

local function IsValidEgg(obj)

    if not obj then
        return false
    end

    if not obj.Parent then
        return false
    end

    if not GetEggData(obj.Name) then
        return false
    end

    if not GetPart(obj) then
        return false
    end

    if IsInsideExclusion(obj) then
        return false
    end

    if not IsWithinDetectionRange(obj) then
        return false
    end

    return true
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function FindBestEgg()

    local bestEgg = nil
    local bestLuck = -1

    for _, obj in ipairs(
        Workspace:GetDescendants()
    ) do

        if IsValidEgg(obj) then

            local data =
                GetEggData(obj.Name)

            if data then

                local luck =
                    ParseLuck(data.Luck)

                if luck > bestLuck then

                    bestLuck = luck
                    bestEgg = obj

                end
            end
        end
    end

    return bestEgg, bestLuck
end

--==============================================================
-- INMOVILIZAR
--==============================================================

local function FreezeCharacter()

    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if humanoid then
        humanoid.AutoRotate = false
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.JumpHeight = 0
    end

    if root then
        root.AssemblyLinearVelocity =
            Vector3.zero

        root.AssemblyAngularVelocity =
            Vector3.zero
    end

    return humanoid
end

--==============================================================
-- DESBLOQUEAR
--==============================================================

local function UnfreezeCharacter()

    local character = LocalPlayer.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if humanoid then
        humanoid.AutoRotate = true
        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50
    end
end

--==============================================================
-- TP AL HUEVO
--==============================================================

local function TeleportToEgg(egg)

    local root = GetRoot()
    local position = GetObjectPosition(egg)

    if not root or not position then
        return false
    end

    -- Queda ligeramente encima del huevo
    root.CFrame =
        CFrame.new(
            position + Vector3.new(0, 2.5, 0)
        )

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

--==============================================================
-- BUSCAR PROMPT DEL HUEVO
--==============================================================

local function FindGrabPrompt(egg)

    if not egg then
        return nil
    end

    for _, obj in ipairs(
        egg:GetDescendants()
    ) do

        if obj:IsA("ProximityPrompt") then

            local text =
                string.lower(
                    tostring(obj.ActionText)
                    .. " "
                    .. tostring(obj.ObjectText)
                )

            if
                string.find(text, "grab", 1, true)
                or string.find(text, "pick", 1, true)
                or string.find(text, "collect", 1, true)
                or string.find(text, "recoger", 1, true)
                or string.find(text, "agarrar", 1, true)
                or string.find(text, "tomar", 1, true)
            then
                return obj
            end
        end
    end

    return nil
end

--==============================================================
-- AUTO GRAB
--==============================================================

local function AutoGrab(egg)

    local prompt =
        FindGrabPrompt(egg)

    if not prompt then
        return false
    end

    local root = GetRoot()

    if not root then
        return false
    end

    -- Mantenerse quieto durante el grab
    FreezeCharacter()

    -- Acercamiento final
    local promptPart =
        prompt.Parent

    if promptPart and promptPart:IsA("BasePart") then

        root.CFrame =
            CFrame.new(
                promptPart.Position
            )

    end

    task.wait(0.1)

    -- Intento de activar el prompt
    pcall(function()

        prompt.HoldDuration = 0

    end)

    pcall(function()

        prompt:InputHoldBegin()

        task.wait(0.15)

        prompt:InputHoldEnd()

    end)

    return true
end

--==============================================================
-- BUSCAR RESPAWNS
--==============================================================

local function GetRespawns()

    local respawns = {}

    for _, obj in ipairs(
        Workspace:GetDescendants()
    ) do

        if obj:IsA("SpawnLocation") then
            table.insert(
                respawns,
                obj
            )
        end
    end

    return respawns
end

--==============================================================
-- TP AL RESPAWN
--==============================================================

local LastRespawn = 0

local function TeleportToRespawn()

    local respawns =
        GetRespawns()

    if #respawns == 0 then
        return false
    end

    LastRespawn =
        LastRespawn + 1

    if LastRespawn > #respawns then
        LastRespawn = 1
    end

    local spawn =
        respawns[LastRespawn]

    local root = GetRoot()

    if not root or not spawn then
        return false
    end

    root.CFrame =
        CFrame.new(
            spawn.Position
            + Vector3.new(0, 3, 0)
        )

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

--==============================================================
-- CICLO PRINCIPAL
--==============================================================

task.spawn(function()

    while Running do

        if not Busy then

            Busy = true

            pcall(function()

                --==============================================
                -- REFRESH
                --==============================================

                local bestEgg =
                    FindBestEgg()

                if not bestEgg then
                    Busy = false
                    return
                end

                --==============================================
                -- TP AL MEJOR
                --==============================================

                if not TeleportToEgg(bestEgg) then
                    Busy = false
                    return
                end

                --==============================================
                -- QUEDARSE TIESO
                --==============================================

                FreezeCharacter()

                task.wait(0.1)

                --==============================================
                -- AUTO GRAB
                --==============================================

                AutoGrab(bestEgg)

                --==============================================
                -- ESPERAR QUE TERMINE
                --==============================================

                task.wait(0.5)

                --==============================================
                -- TP AL RESPAWN
                --==============================================

                TeleportToRespawn()

                --==============================================
                -- DESBLOQUEAR
                --==============================================

                UnfreezeCharacter()

            end)

            Busy = false

        end

        -- REFRESH EXACTO: 1 SEGUNDO
        task.wait(REFRESH_TIME)

    end

end)
