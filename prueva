--==================================================
-- SNAPSHOT
--==================================================

local function FindRemote(path)
    local current = ReplicatedStorage

    for part in string.gmatch(path, "[^%.]+") do
        if not current then
            return nil
        end

        current = current:FindFirstChild(part)
    end

    return current
end

local SnapshotRemote =
    FindRemote("Packages.Networking.RF/EggWorld/AskFieldEggSnapshot")

--==================================================
-- CHARACTER
--==================================================

local function GetRoot()
    local character = LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()

    return character:WaitForChild("HumanoidRootPart")
end

local function Teleport(position)
    local root = GetRoot()

    if root and root.Parent then
        root.CFrame =
            CFrame.new(position + Vector3.new(0, 3, 0))
    end
end

--==================================================
-- ENCONTRAR EL REGISTRO CON MAYOR LUCKY
--==================================================

local function GetBestSnapshotEgg()

    if not SnapshotRemote then
        return nil
    end

    local success, snapshot = pcall(function()
        return SnapshotRemote:InvokeServer()
    end)

    if not success or type(snapshot) ~= "table" then
        return nil
    end

    local records = snapshot.Records or snapshot

    if type(records) ~= "table" then
        return nil
    end

    local bestRecord = nil
    local bestLucky = -math.huge

    --==================================================
    -- EXCLUSION: TU BASE
    --==================================================
    local EXCLUSION_CENTER = Vector3.new(146.87, 40316.12, 911.14)
    local EXCLUSION_RADIUS = 210

    for _, record in ipairs(records) do

        if type(record) == "table" then

            local asset = tostring(record.AssetCategory or "")
            local lucky = EggData[asset]
            local position = nil

            if typeof(record.BottomCFrame) == "CFrame" then
                position = record.BottomCFrame.Position
            elseif typeof(record.BottomCFrame) == "Vector3" then
                position = record.BottomCFrame
            end

            if lucky and position then

                local distanceFromBase =
                    (position - EXCLUSION_CENTER).Magnitude

                -- IGNORAR TODOS LOS HUEVOS DENTRO DE 210 STUDS
                if distanceFromBase > EXCLUSION_RADIUS then

                    if lucky > bestLucky then
                        bestLucky = lucky
                        bestRecord = record
                    end
                end
            end
        end
    end

    return bestRecord, bestLucky
end

--==================================================
-- OBTENER POSICIÓN
--==================================================

local function GetRecordPosition(record)

    if not record then
        return nil
    end

    if typeof(record.BottomCFrame) == "CFrame" then
        return record.BottomCFrame.Position
    end

    if typeof(record.BottomCFrame) == "Vector3" then
        return record.BottomCFrame
    end

    return nil
end

--==================================================
-- BUSCAR OBJETO CERCA DEL HUEVO
--==================================================

local function FindEggNear(position)

    local closest = nil
    local closestDistance = math.huge

    for _, object in ipairs(Workspace:GetDescendants()) do

        if object:IsA("BasePart") then

            local distance =
                (object.Position - position).Magnitude

            if distance <= 12 and distance < closestDistance then

                closest = object
                closestDistance = distance

            end
        end
    end

    return closest
end

--==================================================
-- INTENTAR RECOGER CON PROXIMITYPROMPT
--==================================================

local function TryCollect(position)

    local object = FindEggNear(position)

    if not object then
        return false
    end

    local prompt =
        object:FindFirstChildWhichIsA(
            "ProximityPrompt",
            true
        )

    if not prompt then

        local parent = object.Parent

        if parent then
            prompt =
                parent:FindFirstChildWhichIsA(
                    "ProximityPrompt",
                    true
                )
        end
    end

    if not prompt then
        return false
    end

    pcall(function()
        prompt.HoldDuration = 0
    end)

    -- Solo intenta usar el prompt existente del juego.
    pcall(function()
        fireproximityprompt(prompt)
    end)

    return true
end

--==================================================
-- BUSCAR SPAWN
--==================================================

local function GetBaseSpawn()

    local possibleNames = {
        "SpawnLocation",
        "BaseSpawn",
        "Base",
        "Spawn",
        "Home",
    }

    for _, name in ipairs(possibleNames) do

        local object =
            Workspace:FindFirstChild(name, true)

        if object then

            if object:IsA("BasePart") then
                return object.Position
            end

            if object:IsA("Model") then

                local part =
                    object.PrimaryPart
                    or object:FindFirstChildWhichIsA(
                        "BasePart",
                        true
                    )

                if part then
                    return part.Position
                end
            end
        end
    end

    return nil
end

