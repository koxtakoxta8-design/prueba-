--==============================================================
-- WORKSPACE
--==============================================================

local function ScanWorkspace()

    if not ESP_ENABLED then
        return
    end

    for _, obj in ipairs(
        Workspace:GetDescendants()
    ) do

        local eggName, data =
            GetEggData(obj.Name)

        if eggName and data then

            local part =
                GetPart(obj)

            if part then

                local id =
                    "WS_" ..
                    obj:GetFullName()

                CreateESP(
                    id,
                    part.Position,
                    eggName,
                    data
                )
            end
        end
    end
end

--==============================================================
-- SNAPSHOT
--==============================================================

local function ScanSnapshot()

    if not SnapshotRemote then
        return
    end

    local ok, snapshot =
        pcall(function()

            return SnapshotRemote:InvokeServer()

        end)

    if not ok then
        return
    end

    if type(snapshot) ~= "table" then
        return
    end

    local records =
        snapshot.Records or snapshot

    if type(records) ~= "table" then
        return
    end

    for index, rec in ipairs(records) do

        if type(rec) == "table" then

            local position = nil

            -- CFrame
            if typeof(
                rec.BottomCFrame
            ) == "CFrame" then

                position =
                    rec.BottomCFrame.Position

            -- Vector3
            elseif typeof(
                rec.BottomCFrame
            ) == "Vector3" then

                position =
                    rec.BottomCFrame
            end

            if position then

                -- Intentamos identificar el huevo
                -- usando AssetCategory.
                local eggName, data =
                    GetEggData(
                        rec.AssetCategory
                    )

                -- También probamos otros campos
                -- por si el juego los usa.
                if not data then

                    eggName, data =
                        GetEggData(
                            rec.Name
                        )
                end

                if not data then

                    eggName, data =
                        GetEggData(
                            rec.DisplayName
                        )
                end

                if eggName and data then

                    local id =
                        "SNAP_" ..
                        tostring(index)

                    CreateESP(
                        id,
                        position,
                        eggName,
                        data
                    )
                end
            end
        end
    end
end

--==============================================================
-- ESCANEO GENERAL
--==============================================================

local function ScanAll()

    if not ESP_ENABLED then
        return
    end

    pcall(ScanWorkspace)
    pcall(ScanSnapshot)
end

