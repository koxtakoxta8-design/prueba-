--// RIDE A PET - BEST EGG TP
--// Huevo -> recoger -> +100 studs -> Plot
--// Subida: 2000 | Viaje al plot: 1000

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Root = Character:WaitForChild("HumanoidRootPart")

local UP_SPEED = 2000
local PLOT_SPEED = 1000
local UP_DISTANCE = 100

local EggValues = {
    ["White Egg"] = 1,
    ["Brown Egg"] = 5,
    ["Cracked Egg"] = 30,
    ["Easter Egg"] = 50,
    ["Stone Egg"] = 100,
    ["Leaf Egg"] = 200,
    ["Mushroom Egg"] = 500,
    ["Flower Egg"] = 750,
    ["Slime Egg"] = 1000,
    ["Ice Egg"] = 3000,
    ["Glass Egg"] = 10000,
    ["Golden Egg"] = 30000,
    ["Crystal Egg"] = 150000,
    ["Skull Egg"] = 250000,
    ["Dominus Egg"] = 700000,
    ["Flaming Egg"] = 1000000,
    ["Sinister Egg"] = 3000000,
    ["Soul Egg"] = 7000000,
    ["Aurora Egg"] = 300000000,
    ["Galaxy Egg"] = 1500000000,
    ["Blackhole Egg"] = 100000000000,
    ["Solaris Egg"] = 300000000000,
    ["Cherub Egg"] = 1000000000000,
    ["Volcanic Egg"] = 2500000000000
}

local function getRoot()
    Character = Player.Character or Player.CharacterAdded:Wait()
    return Character:FindFirstChild("HumanoidRootPart")
end

local function isEgg(obj)
    local name = obj.Name:lower()

    return name:find("egg")
        or name:find("huevo")
end

local function getEggValue(obj)
    for eggName, value in pairs(EggValues) do
        if obj.Name:lower():find(eggName:lower()) then
            return value
        end
    end

    -- Si no está en la lista, intenta encontrar un valor dentro del objeto
    for _, v in ipairs(obj:GetDescendants()) do
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            if v.Name:lower():find("luck")
                or v.Name:lower():find("value")
                or v.Name:lower():find("worth") then
                return v.Value
            end
        end
    end

    return 0
end

local function findBestEgg()
    local bestEgg = nil
    local bestValue = -1

    for _, obj in ipairs(workspace:GetDescendants()) do
        if isEgg(obj) then
            local value = getEggValue(obj)

            if value > bestValue then
                local part =
                    obj:IsA("BasePart") and obj
                    or obj:FindFirstChildWhichIsA("BasePart", true)

                if part then
                    bestEgg = obj
                    bestValue = value
                end
            end
        end
    end

    return bestEgg, bestValue
end

local function getEggPart(egg)
    if not egg then return nil end

    if egg:IsA("BasePart") then
        return egg
    end

    return egg:FindFirstChildWhichIsA("BasePart", true)
end

local function moveTo(position, speed)
    local root = getRoot()
    if not root then return end

    local distance = (root.Position - position).Magnitude
    local duration = math.max(distance / speed, 0.03)

    local start = root.CFrame
    local finish = CFrame.new(position)

    local startTime = tick()

    while tick() - startTime < duration do
        root = getRoot()
        if not root then return end

        local alpha = math.clamp(
            (tick() - startTime) / duration,
            0,
            1
        )

        root.CFrame = start:Lerp(finish, alpha)
        RunService.Heartbeat:Wait()
    end

    root.CFrame = finish
end

local function findMyPlot()
    local possibleNames = {
        "Plot",
        "Plots",
        "Base",
        "Bases",
        "Tycoon",
        "Tycoons",
        "PlayerPlot",
        "MyPlot"
    }

    for _, container in ipairs(workspace:GetDescendants()) do
        for _, name in ipairs(possibleNames) do
            if container.Name == name then

                local owner = container:GetAttribute("Owner")
                    or container:GetAttribute("OwnerName")
                    or container:GetAttribute("Player")
                    or container:GetAttribute("PlayerName")
                    or container:GetAttribute("Username")
                    or container:GetAttribute("UserId")
                    or container:GetAttribute("OwnerUserId")

                if owner then
                    if tostring(owner) == Player.Name
                        or tostring(owner) == tostring(Player.UserId) then

                        return container
                    end
                end
            end
        end
    end

    return nil
end

local function getPlotPosition(plot)
    if not plot then return nil end

    if plot:IsA("BasePart") then
        return plot.Position
    end

    local spawn = plot:FindFirstChild("Spawn", true)
        or plot:FindFirstChild("SpawnLocation", true)
        or plot:FindFirstChild("PlotSpawn", true)
        or plot:FindFirstChild("Drop", true)

    if spawn and spawn:IsA("BasePart") then
        return spawn.Position
    end

    local part = plot:FindFirstChildWhichIsA("BasePart", true)

    if part then
        return part.Position
    end

    return nil
end

local function grabEgg(egg)
    -- Busca ProximityPrompt
    for _, obj in ipairs(egg:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            pcall(function()
                fireproximityprompt(obj)
            end)
        end
    end

    -- Busca ClickDetector
    for _, obj in ipairs(egg:GetDescendants()) do
        if obj:IsA("ClickDetector") then
            pcall(function()
                fireclickdetector(obj)
            end)
        end
    end
end

local function dropEgg()
    local root = getRoot()
    if not root then return end

    -- Procura botões/ProximityPrompts relacionados a Drop
    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = obj.Name:lower()

        if name == "drop"
            or name == "drop egg"
            or name == "dropp"
            or name == "soltar"
            or name == "dropegg" then

            if obj:IsA("ProximityPrompt") then
                pcall(function()
                    fireproximityprompt(obj)
                end)
            elseif obj:IsA("ClickDetector") then
                pcall(function()
                    fireclickdetector(obj)
                end)
            end
        end
    end
end

local function run()
    local root = getRoot()
    if not root then return end

    -- 1. Buscar mejor huevo
    local egg, value = findBestEgg()

    if not egg then
        warn("No encontré huevos.")
        return
    end

    print("MEJOR HUEVO:", egg.Name, "VALOR:", value)

    local eggPart = getEggPart(egg)
    if not eggPart then return end

    -- 2. Ir al huevo
    moveTo(eggPart.Position, UP_SPEED)

    -- 3. Recoger
    grabEgg(egg)

    task.wait(0.15)

    -- 4. Subir exactamente 100 studs
    root = getRoot()
    if not root then return end

    local highPosition =
        root.Position + Vector3.new(0, UP_DISTANCE, 0)

    moveTo(highPosition, UP_SPEED)

    -- 5. Buscar nuestro plot
    local plot = findMyPlot()

    if not plot then
        warn("No encontré tu plot.")
        return
    end

    local plotPosition = getPlotPosition(plot)

    if not plotPosition then
        warn("Encontré el plot pero no su posición.")
        return
    end

    -- 6. Ir al plot a 1000
    moveTo(plotPosition + Vector3.new(0, 3, 0), PLOT_SPEED)

    task.wait(0.5)

    -- 7. Soltar
    dropEgg()
end

-- Ejecutar
run()
