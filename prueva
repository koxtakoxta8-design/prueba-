--==============================================================
-- EJECUCIÓN
--==============================================================

local function Run()

    if Running then
        return
    end

    Running = true

    ----------------------------------------------------------
    -- GUARDAR POSICIÓN
    ----------------------------------------------------------

    if not SavePosition() then

        Status.Text =
            "Estado: ERROR POSICIÓN"

        Running = false
        return
    end

    ----------------------------------------------------------
    -- ESCANEAR
    ----------------------------------------------------------

    Status.Text =
        "Estado: ESCANEANDO MAPA..."

    local best, amount =
        FindBestEgg()

    Count.Text =
        "Huevos del mapa: " ..
        tostring(amount)

    ----------------------------------------------------------
    -- NO ENCONTRADO
    ----------------------------------------------------------

    if not best then

        Info.Text =
            "🥚 Mejor: NO ENCONTRADO\n" ..
            "🍀 Lucky: ---\n" ..
            "⭐ Rareza: ---"

        Status.Text =
            "Estado: NO HAY HUEVOS"

        Running = false
        return
    end

    ----------------------------------------------------------
    -- MOSTRAR
    ----------------------------------------------------------

    Info.Text =
        "🥚 Mejor: " ..
        best.Name ..
        "\n🍀 Lucky: " ..
        best.Luck ..
        "\n⭐ Rareza: " ..
        best.Rarity

    ----------------------------------------------------------
    -- TP
    ----------------------------------------------------------

    Status.Text =
        "Estado: TP → " ..
        best.Name

    if not TeleportToEgg(best) then

        Status.Text =
            "Estado: ERROR TP"

        Unfreeze()

        Running = false
        return
    end

    ----------------------------------------------------------
    -- CONGELADO
    ----------------------------------------------------------

    Status.Text =
        "Estado: CONGELADO EN EL HUEVO"

    task.wait(2)

    ----------------------------------------------------------
    -- AQUÍ SE CONECTARÍA LA MECÁNICA
    -- REAL DE RECOGER/MONTAR DEL JUEGO
    ----------------------------------------------------------

    Status.Text =
        "Estado: HUEVO SELECCIONADO"

    task.wait(1)

    ----------------------------------------------------------
    -- VOLVER
    ----------------------------------------------------------

    Status.Text =
        "Estado: REGRESANDO"

    ReturnToStart()

    task.wait(0.25)

    Unfreeze()

    Status.Text =
        "Estado: TERMINADO"

    Running = false
end

Button.Activated:Connect(
