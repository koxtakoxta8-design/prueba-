local Dragging = false
local DragStart
local StartPosition

MainFrame.InputBegan:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then

        Dragging = true
        DragStart = Input.Position
        StartPosition = MainFrame.Position

        Input.Changed:Connect(function()

            if Input.UserInputState == Enum.UserInputState.End then
                Dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(Input)

    if not Dragging then
        return
    end

    if Input.UserInputType == Enum.UserInputType.MouseMovement
    or Input.UserInputType == Enum.UserInputType.Touch then

        local Delta = Input.Position - DragStart

        MainFrame.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )
    end
end)

MainFrame.Size = UDim2.fromOffset(0,0)

TweenService:Create(
    MainFrame,
    TweenInfo.new(
        0.55,
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.Out
    ),
    {
        Size = UDim2.fromOffset(305,205)
    }
):Play()

-- Interfaz nueva conectada a la lógica original
local function setTargetEgg(eggObj, name, data)
    targetClearedByUser = false
    selectedTargetEgg = eggObj
    local rarity = translateRarity(data and data.Rarity or "Divine")
    TargetName.Text = string.upper(name) .. "  •  " .. rarity
end

local function updateTargetDisplay()
    if targetClearedByUser then return end
    local top10 = getTop10EggsInServer()
    if #top10 > 0 then
        if not selectedTargetEgg or not selectedTargetEgg.Parent then
            setTargetEgg(top10[1].Object, top10[1].Name, top10[1].Data)
        end
    else
        TargetName.Text = "NO EGG DETECTED"
    end
end

local manualFarmActive = false
local manualFarmThread = nil

local function stopManualFarm()
    manualFarmActive = false
    if manualFarmThread then
        task.cancel(manualFarmThread)
        manualFarmThread = nil
    end
end

TPClick.MouseButton1Click:Connect(function()
    if not IsTP() then
        stopManualFarm()
        return
    end
    if manualFarmActive then return end

    manualFarmActive = true
    manualFarmThread = task.spawn(function()
        local eggObj = selectedTargetEgg
        local eggNameCaptured = "UNKNOWN"
        local eggRarityCaptured = "Divine"
        local eggCostCaptured = "?"

        if eggObj and eggObj.Parent then
            eggNameCaptured = eggObj.Name
            local data = getEggData(eggObj.Name)
            eggRarityCaptured = translateRarity(data.Rarity)
            eggCostCaptured = data.Cost
        else
            local top10 = getTop10EggsInServer()
            if #top10 > 0 then
                eggObj = top10[1].Object
                eggNameCaptured = top10[1].Name
                eggRarityCaptured = translateRarity(top10[1].Data.Rarity)
                eggCostCaptured = top10[1].Data.Cost
                setTargetEgg(eggObj, eggNameCaptured, top10[1].Data)
            end
        end

        if eggObj and eggObj.Parent then
            local eggCF = eggObj:IsA("Model") and eggObj:GetPivot() or eggObj.CFrame
            if eggCF then
                teleportToCF(eggCF)
                task.wait(0.05)
                executeIdaAutoGrab(eggObj, function()
                    return manualFarmActive
                end)
                performAntiCheatAndReturn(
                    eggNameCaptured,
                    eggRarityCaptured,
                    eggCostCaptured
                )
            end
        end

        manualFarmActive = false
        manualFarmThread = nil
        updateTargetDisplay()
    end)
end)

local autoFarmThread = nil

LoopClick.MouseButton1Click:Connect(function()
    if IsLoop() then
        if autoFarmActive then return end
        autoFarmActive = true

        autoFarmThread = task.spawn(function()
            task.wait(1)

            while autoFarmActive and IsLoop() do
                local foundValidEgg = nil
                local foundItemName = ""
                local foundItemData = nil
                local allEggs = {}

                for _, container in ipairs({
                    Workspace:FindFirstChild("RenderedEggs"),
                    Workspace:FindFirstChild("Shop"),
                    Workspace:FindFirstChild("ShopEggs"),
                    Workspace:FindFirstChild("Eggs")
                }) do
                    if container then
                        for _, egg in ipairs(container:GetChildren()) do
                            if egg:IsA("Model") or egg:IsA("BasePart") then
                                local data = getEggData(egg.Name)
                                table.insert(allEggs, {
                                    Object = egg,
                                    Name = egg.Name,
                                    Data = data
                                })
                            end
                        end
                    end
                end

                table.sort(allEggs, function(a, b)
                    return a.Data.Rank > b.Data.Rank
                end)

                for _, item in ipairs(allEggs) do
                    if autoFarmEggs[item.Name] then
                        foundValidEgg = item.Object
                        foundItemName = item.Name
                        foundItemData = item.Data
                        break
                    end
                end

                if foundValidEgg and foundValidEgg.Parent then
                    setTargetEgg(foundValidEgg, foundItemName, foundItemData)

                    local eggCF = foundValidEgg:IsA("Model")
                        and foundValidEgg:GetPivot()
                        or foundValidEgg.CFrame

                    if eggCF then
                        teleportToCF(eggCF)
                        task.wait(0.05)

                        executeIdaAutoGrab(foundValidEgg, function()
                            return autoFarmActive and IsLoop()
                        end)

                        performAntiCheatAndReturn(
                            foundItemName,
                            translateRarity(foundItemData.Rarity),
                            foundItemData.Cost
                        )
                    end
                else
                    task.wait(2)
                end

                task.wait()
            end

            autoFarmActive = false
            autoFarmThread = nil
        end)
    else
        autoFarmActive = false
        if autoFarmThread then
            task.cancel(autoFarmThread)
            autoFarmThread = nil
        end
    end
end)

task.spawn(function()
    while task.wait(1) do
        if not manualFarmActive then
            updateTargetDisplay()
        end
    end
end)

updateTargetDisplay()
