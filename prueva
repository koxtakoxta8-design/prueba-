workspace.DescendantAdded:Connect(function(Object)
    if Object:IsA("ProximityPrompt") then
        WatchPrompt(Object)
        task.defer(function()
            RegisterEgg(Object)
        end)
        return
    end

    if LooksLikeEggName(Object.Name)
        or Object:GetAttribute("IsEgg") == true
        or Object:GetAttribute("Egg") == true then
        task.defer(function()
            RegisterEgg(Object)
        end)
    end
end)

workspace.DescendantRemoving:Connect(function(Object)
    if EggCache[Object] then
        EggCache[Object] = nil
    end

    if PromptConnections[Object] then
        PromptConnections[Object]:Disconnect()
        PromptConnections[Object] = nil
    end
end)

--==============================================================
-- MEJOR HUEVO DESDE CACHE
--==============================================================

local function FindBestEggFast()
    local Best = nil
    local Highest = -math.huge

    for Object, Data in pairs(EggCache) do
        if not Object.Parent then
            EggCache[Object] = nil
        else
            local Position = GetPosition(Object)

            if not Position or IsExcluded(Position) then
                EggCache[Object] = nil
            else
                local Prompt = FindPrompt(Object)

                if Prompt then
                    WatchPrompt(Prompt)

                    if Prompt.Enabled then
                        local Value = GetValue(Object)
                    local Priority = GetEggPriority(Object)

                    Data.Position = Position
                    Data.Prompt = Prompt
                    Data.Value = Value
                    Data.Priority = Priority

                        if Priority > Highest then
                            Highest = Priority
                            Best = Data
                        end
                    end
                else
                    EggCache[Object] = nil
                end
            end
        end
    end

    return Best
end

