--==============================================================
-- UTILIDADES
--==============================================================

local function GetRoot()

    local Character = Player.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

local function GetPosition(Object)

    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then
        return Object.Position
    end

    if Object:IsA("Model") then

        if Object.PrimaryPart then
            return Object.PrimaryPart.Position
        end

        local Part =
            Object:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        if Part then
            return Part.Position
        end
    end

    return nil
end

--==============================================================
-- NOMBRE DE HUEVO
--==============================================================

local function NormalizeName(Name)

    Name = tostring(Name or ""):lower()

    Name = Name:gsub("_"," ")
    Name = Name:gsub("-"," ")

    return Name
end

local function LooksLikeEgg(Object)

    if not Object then
        return false
    end

    if Object:GetAttribute("IsEgg") == true then
        return true
    end

    if Object:GetAttribute("Egg") == true then
        return true
    end

    local Name =
        NormalizeName(Object.Name)

    if Name:find("egg",1,true) then
        return true
    end

    if Name:find("huevo",1,true) then
        return true
    end

    if Name:find("volcanic",1,true) then
        return true
    end

    if Name:find("cherub",1,true) then
        return true
    end

    if Name:find("solaris",1,true) then
        return true
    end

    if Name:find("black hole",1,true) then
        return true
    end

    if Name:find("blackhole",1,true) then
        return true
    end

    return false
end

--==============================================================
-- PROMPT
--==============================================================

local function FindPrompt(Object)

    if not Object then
        return nil
    end

    if Object:IsA("ProximityPrompt") then
        return Object
    end

    return Object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )
end

local function FindEggFromPrompt(Prompt)

    if not Prompt then
        return nil
    end

    local Current = Prompt.Parent

    for _ = 1,12 do

        if not Current then
            break
        end

        if LooksLikeEgg(Current) then
            return Current
        end

        Current = Current.Parent
    end

    return nil
end

--==============================================================
-- LUCK / VALOR
--==============================================================

local function GetNumericValue(Object)

    if not Object then
        return 0
    end

    local Attributes = {

        "Luck",
        "luck",

        "HatchLuck",
        "Hatch_Luck",

        "EggLuck",
        "Egg_Luck",

        "RarityValue",
        "Value",

        "Price",
        "Worth",
        "Cost"
    }

    for _,Name in ipairs(Attributes) do

        local Value =
            Object:GetAttribute(Name)

        if typeof(Value) == "number" then
            return Value
        end
    end

    for _,Child in ipairs(Object:GetChildren()) do

        if Child:IsA("NumberValue")
        or Child:IsA("IntValue") then

            local Name =
                Child.Name:lower()

            if Name:find("luck",1,true)
            or Name:find("rarity",1,true)
            or Name:find("value",1,true)
            or Name:find("price",1,true)
            or Name:find("worth",1,true)
            or Name:find("cost",1,true) then

                return Child.Value
            end
        end
    end

    return 0
end

--==============================================================
-- PRIORIDAD
--==============================================================

local function GetEggScore(Object)

    if not Object then
        return 0
    end

    local Exact =
        EGG_PRIORITY[Object.Name]

    if Exact then
        return Exact
    end

    local Name =
        NormalizeName(Object.Name)

    -- VOLCANIC SIEMPRE #1
    if Name:find("volcanic",1,true) then
        return 2500000000000
    end

    -- CHERUB
    if Name:find("cherub",1,true) then
        return 1000000000000
    end

    -- SOLARIS
    if Name:find("solaris",1,true) then
        return 300000000000
    end

    -- BLACK HOLE
    if Name:find("black hole",1,true)
    or Name:find("blackhole",1,true) then

        return 100000000000
    end

    -- huevo desconocido:
    -- usa el valor real si el objeto lo expone
    local Numeric =
        GetNumericValue(Object)

    if Numeric > 0 then
        return Numeric
    end

    -- Sigue siendo candidato aunque
    -- el juego no exponga Luck como atributo.
    return 1
end

--==============================================================
-- REGISTRO
--==============================================================

local function RegisterEgg(Object)

    if not Object
    or not Object.Parent then
        return
    end

    local Egg = Object

    if Object:IsA("ProximityPrompt") then

        Egg =
            FindEggFromPrompt(Object)
    end

    if not Egg then
        return
    end

    if not LooksLikeEgg(Egg) then
        return
    end

    local Position =
        GetPosition(Egg)

    if not Position then
        return
    end

    local Prompt =
        FindPrompt(Egg)

    -- Algunos huevos pueden no tener
    -- prompt directamente todavía.
    if not Prompt then

        task.defer(function()

            task.wait(.1)

            if Egg.Parent then
                RegisterEgg(Egg)
            end

        end)

        return
    end

    local Score =
        GetEggScore(Egg)

    local Numeric =
        GetNumericValue(Egg)

    EggCache[Egg] = {

        Object = Egg,

        Position = Position,

        Prompt = Prompt,

        Value = Numeric,

        Score = Score,

        Name = Egg.Name
    }
end

