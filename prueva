--==============================================================
-- ROOT
--==============================================================

local function GetRoot()

    local Character = Player.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

--==============================================================
-- POSICIÓN DE OBJETO
--==============================================================

local function GetPosition(Object)

    if Object:IsA("BasePart") then
        return Object.Position
    end

    if Object:IsA("Model") then

        if Object.PrimaryPart then
            return Object.PrimaryPart.Position
        end

        local Part =
            Object:FindFirstChildWhichIsA("BasePart",true)

        if Part then
            return Part.Position
        end
    end

    return nil
end

--==============================================================
-- ZONA DE EXCLUSIÓN
--
-- IMPORTANTE:
-- Se mide X/Z y NO Y.
-- Así la zona funciona correctamente aunque el objeto
-- esté a diferente altura.
--==============================================================

local function IsExcluded(Position)

    if not Position then
        return true
    end

    local DX =
        Position.X - EXCLUSION_CENTER.X

    local DZ =
        Position.Z - EXCLUSION_CENTER.Z

    local Distance =
        math.sqrt(
            DX * DX +
            DZ * DZ
        )

    return Distance <= EXCLUSION_RADIUS
end

--==============================================================
-- ¿ES HUEVO?
--==============================================================

local function IsEgg(Object)

    local Name = Object.Name:lower()

    if Name:find("egg") then
        return true
    end

    if Name:find("huevo") then
        return true
    end

    if Object:GetAttribute("IsEgg") == true then
        return true
    end

    return false
end

--==============================================================
-- OBTENER LUCK
--==============================================================

local function GetLuck(Object)

    for _,Attribute in ipairs({
        "Luck",
        "luck",
        "EggLuck",
        "RarityValue"
    }) do

        local Value =
            Object:GetAttribute(Attribute)

        if typeof(Value) == "number" then
            return Value
        end
    end

    for _,Child in ipairs(
        Object:GetDescendants()
    ) do

        if Child:IsA("NumberValue")
        or Child:IsA("IntValue") then

            local Name =
                Child.Name:lower()

            if Name == "luck"
            or Name == "eggluck"
            or Name == "rarityvalue" then

                return Child.Value
            end
        end
    end

    return EggLuck[Object.Name] or 0
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function FindBestEgg()

    local BestEgg = nil
    local HighestLuck = -math.huge

    for _,Object in ipairs(
        workspace:GetDescendants()
    ) do

        if IsEgg(Object) then

            local Position =
                GetPosition(Object)

            -- PRIMER FILTRO:
            -- debe tener posición

            if Position then

                -- SEGUNDO FILTRO:
                -- NO puede estar dentro
                -- de la zona de exclusión

                if not IsExcluded(Position) then

                    local Luck =
                        GetLuck(Object)

                    if Luck > HighestLuck then

                        HighestLuck = Luck

                        BestEgg = {
                            Object = Object,
                            Position = Position,
                            Luck = Luck
                        }
                    end
                end
            end
        end
    end

    return BestEgg
end

--==============================================================
-- FORMATO
--==============================================================

local function FormatNumber(Number)

    if Number >= 1e12 then
        return string.format(
            "%.2fT",
            Number / 1e12
        )
    end

    if Number >= 1e9 then
        return string.format(
            "%.2fB",
            Number / 1e9
        )
    end

    if Number >= 1e6 then
        return string.format(
            "%.2fM",
            Number / 1e6
        )
    end

    if Number >= 1e3 then
        return string.format(
            "%.2fK",
            Number / 1e3
        )
    end

    return tostring(Number)
end

--==============================================================
-- TELEPORT
--==============================================================

local function TeleportTo(Position)

    local Root = GetRoot()

    if not Root then
        return false
    end

    Root.CFrame =
        CFrame.new(
            Position + Vector3.new(0,3,0)
        )

    return true
end

--==============================================================
-- PROMPT
--==============================================================

local function FindPrompt(Object)

    if Object:IsA("ProximityPrompt") then
        return Object
    end

    return Object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )
end

--==============================================================
-- RECOGER
--==============================================================

local function CollectEgg(Egg)

    if not Egg then
        return false
    end

    local Prompt =
        FindPrompt(Egg.Object)

    if not Prompt then

        Status.Text =
            "Estado: SIN PROMPT"

        return false
    end

    if not Prompt.Enabled then
        return false
    end

    Status.Text =
        "Estado: RECOGIENDO"

    pcall(function()

        Prompt:InputHoldBegin()

        task.wait(
            math.max(
                Prompt.HoldDuration,
                0.05
            )
        )

        Prompt:InputHoldEnd()

    end)

    return true
end

--==============================================================
-- ¿ES MI PLOT?
--==============================================================

local function IsMyPlot(Object)

    for _,Name in ipairs({
        "Owner",
        "owner",
        "OwnerName",
        "ownerName"
    }) do

        local Attribute =
            Object:GetAttribute(Name)

        if Attribute ~= nil then

            if tostring(Attribute)
                == Player.Name
            or tostring(Attribute)
                == tostring(Player.UserId) then

                return true
            end
        end

        local Value =
            Object:FindFirstChild(Name,true)

        if Value then

            if Value:IsA("StringValue")
            and Value.Value == Player.Name then

                return true
            end

            if Value:IsA("ObjectValue")
            and Value.Value == Player then

                return true
            end

            if Value:IsA("IntValue")
            and Value.Value == Player.UserId then

                return true
            end
        end
    end

    return false
end

--==============================================================
-- BUSCAR PLOT
--==============================================================

local function FindMyPlot()

    for _,Object in ipairs(
        workspace:GetDescendants()
    ) do

        local Name =
            Object.Name:lower()

        if Name:find("plot")
        or Name:find("tycoon")
        or Name:find("base")
        or Name:find("ranch") then

            if IsMyPlot(Object) then

                local Position =
                    GetPosition(Object)

                if Position then
                    return Object,Position
                end
            end
        end
    end

    return nil,nil
end

--==============================================================
-- SECUENCIA
--==============================================================

local function RunCycle()

    if BUSY or not AUTO then
        return
    end

    BUSY = true

    -- BUSCAR
    Status.Text =
        "Estado: BUSCANDO MEJOR"

    local Egg =
        FindBestEgg()

    if not Egg then

        Best.Text =
            "🏆 Mejor: NINGUNO"

        Luck.Text =
            "Luck: —"

        Status.Text =
            "Estado: NO HAY HUEVOS"

        BUSY = false

        return
    end

    -- MOSTRAR
    Best.Text =
        "🏆 Mejor: "
        .. Egg.Object.Name

    Luck.Text =
        "Luck: "
        .. FormatNumber(Egg.Luck)

    -- TP HUEVO
    Status.Text =
        "Estado: TP AL HUEVO"

    TeleportTo(Egg.Position)

    task.wait(0.2)

    -- VOLVER A COMPROBAR:
    -- quizá desapareció mientras llegábamos

    if not Egg.Object.Parent then

        BUSY = false
        return
    end

    -- RECOGER
    CollectEgg(Egg)

    task.wait(0.3)

    -- PLOT
    Status.Text =
        "Estado: BUSCANDO PLOT"

    local MyPlot,PlotPosition =
        FindMyPlot()

    if not MyPlot then

        Plot.Text =
            "🏠 Plot: NO ENCONTRADO"

        Status.Text =
            "Estado: PLOT NO ENCONTRADO"

        BUSY = false

        return
    end

    Plot.Text =
        "🏠 Plot: ENCONTRADO"

    -- TP PLOT
    Status.Text =
        "Estado: TP AL PLOT"

    TeleportTo(PlotPosition)

    task.wait(0.4)

    Status.Text =
        "Estado: COMPLETADO"

    BUSY = false
end

