local function FindGrabPrompt(egg)

    if not egg then
        return nil
    end

    for _, obj in ipairs(egg:GetDescendants()) do

        if obj:IsA("ProximityPrompt") then

            local text =
                string.lower(
                    tostring(obj.ActionText)
                    .. " "
                    .. tostring(obj.ObjectText)
                )

            if
                string.find(text, "grab", 1, true)
                or string.find(text, "pick", 1, true)
                or string.find(text, "collect", 1, true)
                or string.find(text, "recoger", 1, true)
                or string.find(text, "agarrar", 1, true)
                or string.find(text, "tomar", 1, true)
            then
                return obj
            end

        end

    end

    return nil
end

--==============================================================
-- AUTO GRAB x3
--==============================================================

local function AutoGrab(egg)

    local prompt =
        FindGrabPrompt(egg)

    if not prompt then
        return false
    end

    Freeze()

    pcall(function()
        prompt.HoldDuration = 0
    end)

    for i = 1, 5 do

        if not InstaTP then
            break
        end

        pcall(function()
            prompt:InputHoldBegin()
        end)

        task.wait(0.08)

        pcall(function()
            prompt:InputHoldEnd()
        end)

        task.wait(0.08)

    end

    return true
end

