--==============================================================
-- LUCK A NÚMERO
--==============================================================

local function LuckNumber(value)

    local text = tostring(value or "0")
    local number = tonumber(text:match("[%d%.]+")) or 0

    if text:find("T") then
        return number * 1e12
    elseif text:find("B") then
        return number * 1e9
    elseif text:find("M") then
        return number * 1e6
    elseif text:find("K") then
        return number * 1e3
    end

    return number
end

--==============================================================
-- DATOS DEL HUEVO
--==============================================================

local function GetEggData(name)

    if EggData[name] then
        return EggData[name], name
    end

    local lower = tostring(name):lower()

    for eggName, data in pairs(EggData) do
        if lower:find(eggName:lower(), 1, true) then
            return data, eggName
        end
    end

    return nil
end

--==============================================================
-- PARTE DEL HUEVO
--==============================================================

local function GetPart(obj)

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then

        if obj.PrimaryPart then
            return obj.PrimaryPart
        end

        return obj:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
    end

    return nil
end

--==============================================================
-- ROOT DEL JUGADOR
--==============================================================

local function GetRoot()

    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

--==============================================================
-- CALIBRAR BASE AUTOMÁTICAMENTE
--==============================================================

local function CalibrateBase()

    local root = GetRoot()

    if not root then
        return false
    end

    BasePosition = root.Position

    return true
end

--==============================================================
-- DISTANCIA A LA BASE
--==============================================================

local function IsInsideBase(position)

    if not BasePosition then
        return false
    end

    local a = Vector3.new(
        position.X,
        0,
        position.Z
    )

    local b = Vector3.new(
        BasePosition.X,
        0,
        BasePosition.Z
    )

    return (a - b).Magnitude <= BASE_RADIUS
end

--==============================================================
-- ESCANEAR WORKSPACE
--==============================================================

local function ScanWorkspace()

    local result = {}
    local seen = {}

    for _, obj in ipairs(
        Workspace:GetDescendants()
    ) do

        local data, realName =
            GetEggData(obj.Name)

        if data then

            local part = GetPart(obj)

            if part and not seen[obj] then

                seen[obj] = true

                -- IGNORAR HUEVOS DE LA ZONA DE BASE
                if not IsInsideBase(part.Position) then

                    table.insert(
                        result,
                        {
                            Object = obj,
                            Part = part,
                            Name = realName,
                            Luck = data.Luck,
                            LuckNumber = LuckNumber(data.Luck),
                            Rarity = data.Rarity,
                            Position = part.Position
                        }
                    )
                end
            end
        end
    end

    return result
end

--==============================================================
-- BUSCAR MEJOR
--==============================================================

local function FindBestEgg()

    local eggs = ScanWorkspace()
    local best = nil

    for _, egg in ipairs(eggs) do

        if not best
        or egg.LuckNumber > best.LuckNumber then

            best = egg
        end
    end

    return best, #eggs
end

--==============================================================
-- CONGELAR
--==============================================================

local function Freeze()

    local character = LocalPlayer.Character
    if not character then return end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if humanoid then
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.AutoRotate = false
    end

    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

--==============================================================
-- DESCONGELAR
--==============================================================

local function Unfreeze()

    local character = LocalPlayer.Character
    if not character then return end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50
        humanoid.AutoRotate = true
    end
end

--==============================================================
-- TP AL HUEVO
--==============================================================

local function TeleportToEgg(egg)

    local root = GetRoot()

    if not root or not egg then
        return false
    end

    root.CFrame =
        CFrame.new(
            egg.Position +
            Vector3.new(0, TP_HEIGHT, 0)
        )

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    task.wait()

    Freeze()

    return true
end

--==============================================================
-- REGRESAR
--==============================================================

local function ReturnToStart()

    local root = GetRoot()

    if not root or not ReturnCFrame then
        return false
    end

    root.CFrame = ReturnCFrame
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    return true
end

