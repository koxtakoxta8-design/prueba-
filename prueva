-- AUTO GRAB
--------------------------------------------------

Auto.MouseButton1Click:Connect(function()

    RUNNING = not RUNNING

    if RUNNING then

        Auto.Text = "AUTO GRAB: ON"
        Auto.TextColor3 = Color3.fromRGB(80, 255, 120)

        task.spawn(function()

            while RUNNING do

                local best = SearchBest()

                if best then

                    Status.Text = "Estado: TP AL HUEVO"

                    Teleport(best.Position)

                    task.wait(0.5)

                    Status.Text = "Estado: GRAB"

                    GrabEgg(best)

                    task.wait(0.7)

                    local spawnPos = GetSpawn()

                    if spawnPos then

                        Status.Text = "Estado: VOLVIENDO"

                        Teleport(spawnPos)

                    end
                end

                RUNNING = false
            end

            Auto.Text = "AUTO GRAB: OFF"
            Auto.TextColor3 = Color3.fromRGB(255, 80, 80)

            Status.Text = "Estado: ESPERANDO"

        end)

    else

        Auto.Text = "AUTO GRAB: OFF"
        Auto.TextColor3 = Color3.fromRGB(255, 80, 80)

        Status.Text = "Estado: DETENIDO"

    end
end)

