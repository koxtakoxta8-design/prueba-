--========================================================--
--                 RIDE A PET - AUTO EGG                  --
--========================================================--
-- FLUJO:
-- 1. Detectar mejor huevo
-- 2. Ignorar huevos dentro de 210 studs del centro
-- 3. TP al mejor huevo
-- 4. Agarrar
-- 5. TP al centro
-- 6. DropEgg
-- 7. Encontrar nuevamente el huevo
-- 8. Agarrarlo nuevamente
-- 9. Encontrar el plot del jugador
--10. Desplazarse al plot a 1000
--11. DropEgg
--========================================================--

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--========================================================--
-- CONFIGURACIÓN
--========================================================--

local CENTER = Vector3.new(
	146.87,
	40316.12,
	911.14
)

local EXCLUSION_RADIUS = 210
local PLOT_SPEED = 1000

--========================================================--
-- VALORES DE LOS HUEVOS
--========================================================--

local EggValues = {
	["White Egg"] = 1,
	["Brown Egg"] = 5,
	["Cracked Egg"] = 30,
	["Easter Egg"] = 50,
	["Stone Egg"] = 100,
	["Leaf Egg"] = 200,
	["Mushroom Egg"] = 500,
	["Flower Egg"] = 750,
	["Slime Egg"] = 1000,
	["Ice Egg"] = 3000,
	["Glass Egg"] = 10000,
	["Golden Egg"] = 30000,
	["Crystal Egg"] = 150000,
	["Skull Egg"] = 250000,
	["Dominus Egg"] = 700000,
	["Flaming Egg"] = 1000000,
	["Sinister Egg"] = 3000000,
	["Soul Egg"] = 7000000,
	["Aurora Egg"] = 300000000,
	["Galaxy Egg"] = 1500000000,
	["Blackhole Egg"] = 100000000000,
	["Solaris Egg"] = 300000000000,
	["Cherub Egg"] = 1000000000000,
	["Volcanic Egg"] = 2500000000000
}

--========================================================--
-- UTILIDADES
--========================================================--

local function getCharacter()

	return Player.Character
		or Player.CharacterAdded:Wait()

end

local function getRoot()

	local character = getCharacter()

	return character:FindFirstChild(
		"HumanoidRootPart"
	)

end

local function getPart(object)

	if not object then
		return nil
	end

	if object:IsA("BasePart") then
		return object
	end

	return object:FindFirstChildWhichIsA(
		"BasePart",
		true
	)

end

--========================================================--
-- DETECCIÓN DE HUEVOS
--========================================================--

local function isEgg(object)

	if not object then
		return false
	end

	local name =
		object.Name:lower()

	return
		name:find("egg", 1, true) ~= nil
		or
		name:find("huevo", 1, true) ~= nil

end

local function isInsideExclusion(position)

	return (
		position - CENTER
	).Magnitude <= EXCLUSION_RADIUS

end

--========================================================--
-- VALOR DEL HUEVO
--========================================================--

local function getEggValue(egg)

	local name =
		egg.Name:lower()

	local value = 0

	for eggName, eggValue in pairs(
		EggValues
	) do

		if name:find(
			eggName:lower(),
			1,
			true
		) then

			value =
				math.max(
					value,
					eggValue
				)

		end
	end

	-- Buscar valores internos
	for _, object in ipairs(
		egg:GetDescendants()
	) do

		if object:IsA("NumberValue")
			or object:IsA("IntValue") then

			local n =
				object.Name:lower()

			if n:find("luck", 1, true)
				or n:find("value", 1, true)
				or n:find("worth", 1, true)
				or n:find("rarity", 1, true) then

				value =
					math.max(
						value,
						object.Value
					)

			end
		end
	end

	return value

end

--========================================================--
-- BUSCAR MEJOR HUEVO
--========================================================--

local function findBestEgg()

	local bestEgg = nil
	local bestValue = -1

	for _, object in ipairs(
		workspace:GetDescendants()
	) do

		if isEgg(object) then

			local part =
				getPart(object)

			if part then

				if not isInsideExclusion(
					part.Position
				) then

					local value =
						getEggValue(object)

					if value > bestValue then

						bestEgg =
							object

						bestValue =
							value

					end
				end
			end
		end
	end

	return bestEgg, bestValue

end

--========================================================--
-- TP
--========================================================--

local function teleportTo(position)

	local root =
		getRoot()

	if not root then
		return false
	end

	root.CFrame =
		CFrame.new(position)

	return true

end

--========================================================--
-- MOVIMIENTO A 1000
--========================================================--

local function moveTo(position)

	local root =
		getRoot()

	if not root then
		return false
	end

	local startPosition =
		root.Position

	local distance =
		(
			position
			- startPosition
		).Magnitude

	if distance <= 1 then

		root.CFrame =
			CFrame.new(position)

		return true
	end

	local duration =
		distance / PLOT_SPEED

	local startTime =
		os.clock()

	while true do

		root =
			getRoot()

		if not root then
			return false
		end

		local alpha =
			math.clamp(
				(
					os.clock()
					- startTime
				) / duration,
				0,
				1
			)

		root.CFrame =
			CFrame.new(
				startPosition:Lerp(
					position,
					alpha
				)
			)

		if alpha >= 1 then
			break
		end

		RunService.Heartbeat:Wait()

	end

	return true

end

--========================================================--
-- AGARRAR HUEVO
--========================================================--

local function grabEgg(egg)

	if not egg then
		return false
	end

	local part =
		getPart(egg)

	if not part then
		return false
	end

	-- ProximityPrompt
	for _, object in ipairs(
		egg:GetDescendants()
	) do

		if object:IsA(
			"ProximityPrompt"
		) then

			pcall(function()

				object.Enabled = true

				fireproximityprompt(
					object
				)

			end)

		end
	end

	-- ClickDetector
	for _, object in ipairs(
		egg:GetDescendants()
	) do

		if object:IsA(
			"ClickDetector"
		) then

			pcall(function()

				fireclickdetector(
					object
				)

			end)

		end
	end

	-- Si tu juego tiene un botón de interacción
	-- asociado directamente al huevo
	for _, object in ipairs(
		PlayerGui:GetDescendants()
	) do

		if object:IsA("TextButton")
			or object:IsA("ImageButton") then

			local name =
				object.Name:lower()

			if name:find("grab", 1, true)
				or name:find("pick", 1, true)
				or name:find("take", 1, true)
				or name:find("collect", 1, true)
				or name:find("steal", 1, true)
				or name:find("agarr", 1, true)
				or name:find("tomar", 1, true)
				or name:find("robar", 1, true) then

				if object.Visible then

					pcall(function()
						object:Activate()
					end)

				end
			end
		end
	end

	return true

end

--========================================================--
-- DROP EGG
--========================================================--

local function triggerDropEggButton()

	local foundButton = nil

	-- Buscar DropEgg
	for _, gui in ipairs(
		PlayerGui:GetDescendants()
	) do

		if gui:IsA("TextButton")
			or gui:IsA("ImageButton") then

			local name =
				gui.Name:lower()

			if name == "dropegg"
				or name:find(
					"dropegg",
					1,
					true
				) then

				if gui.Visible then

					foundButton =
						gui

					break

				end
			end
		end
	end

	-- Activar botón
	if foundButton then

		pcall(function()
			foundButton:Activate()
		end)

		return true

	end

	-- Fallback del juego
	local packages =
		ReplicatedStorage:FindFirstChild(
			"Packages"
		)

	local networking =
		packages
		and packages:FindFirstChild(
			"Networking"
		)

	local remote =
		networking
		and networking:FindFirstChild(
			"RF/EggWorld/AskFieldEggDrop"
		)

	if remote then

		local success =
			pcall(function()

				remote:InvokeServer({
					Reason =
						"PlayerRequest"
				})

			end)

		return success

	end

	return false

end

--========================================================--
-- BUSCAR HUEVO CERCA DEL CENTRO
--========================================================--

local function findEggNearCenter()

	local closestEgg = nil
	local closestDistance =
		math.huge

	for _, object in ipairs(
		workspace:GetDescendants()
	) do

		if isEgg(object) then

			local part =
				getPart(object)

			if part then

				local distance =
					(
						part.Position
						- CENTER
					).Magnitude

				if distance < closestDistance then

					closestDistance =
						distance

					closestEgg =
						object

				end
			end
		end
	end

	return closestEgg

end

--========================================================--
-- ESPERAR HUEVO
--========================================================--

local function waitForEggNearCenter()

	local start =
		os.clock()

	while os.clock() - start < 6 do

		local egg =
			findEggNearCenter()

		if egg then
			return egg
		end

		task.wait(0.1)

	end

	return nil

end

--========================================================--
-- BUSCAR PLOT
--========================================================--

local function findMyPlot()

	local possibleNames = {
		"Plot",
		"Plots",
		"Base",
		"Bases",
		"Tycoon",
		"Tycoons",
		"PlayerPlot",
		"MyPlot",
		"PlotBase",
		"PlotBycoon"
	}

	local ownerAttributes = {
		"Owner",
		"OwnerName",
		"Player",
		"PlayerName",
		"Username",
		"UserName",
		"UserId",
		"OwnerUserId"
	}

	for _, object in ipairs(
		workspace:GetDescendants()
	) do

		local objectName =
			object.Name:lower()

		for _, possibleName in ipairs(
			possibleNames
		) do

			if objectName ==
				possibleName:lower() then

				for _, attribute in ipairs(
					ownerAttributes
				) do

					local owner =
						object:GetAttribute(
							attribute
						)

					if owner ~= nil then

						if tostring(owner)
							== Player.Name
							or tostring(owner)
							== tostring(
								Player.UserId
							) then

							return object

						end
					end
				end

				-- ObjectValue de propietario
				for _, child in ipairs(
					object:GetDescendants()
				) do

					if child:IsA(
						"ObjectValue"
					)
					and child.Value
						== Player then

						return object

					end
				end
			end
		end
	end

	return nil

end

--========================================================--
-- POSICIÓN DEL PLOT
--========================================================--

local function getPlotPosition(plot)

	if not plot then
		return nil
	end

	local possibleNames = {
		"Spawn",
		"SpawnLocation",
		"PlotSpawn",
		"SpawnPoint",
		"Drop",
		"DropPoint",
		"EggDrop"
	}

	for _, name in ipairs(
		possibleNames
	) do

		local object =
			plot:FindFirstChild(
				name,
				true
			)

		if object
			and object:IsA(
				"BasePart"
			) then

			return object.Position

		end
	end

	local part =
		plot:FindFirstChildWhichIsA(
			"BasePart",
			true
		)

	if part then
		return part.Position
	end

	return nil

end

--========================================================--
-- ESPERAR A QUE EL HUEVO SEA RECOGIDO
--========================================================--

local function waitUntilCarrying()

	local start =
		os.clock()

	while os.clock() - start < 3 do

		-- Busca indicadores comunes
		-- de que el huevo está siendo llevado.

		for _, gui in ipairs(
			PlayerGui:GetDescendants()
		) do

			if gui:IsA("TextButton")
				or gui:IsA("ImageButton") then

				local name =
					gui.Name:lower()

				if gui.Visible
					and (
						name:find(
							"dropegg",
							1,
							true
						)
						or name:find(
							"drop",
							1,
							true
						)
					) then

					return true

				end
			end
		end

		task.wait(0.1)

	end

	return false

end

--========================================================--
-- CICLO PRINCIPAL
--========================================================--

local function start()

	print(
		"=============================="
	)

	print(
		"🥚 BUSCANDO MEJOR HUEVO"
	)

	--==================================================
	-- 1. MEJOR HUEVO
	--==================================================

	local egg, value =
		findBestEgg()

	if not egg then

		warn(
			"❌ No encontré ningún huevo fuera de los 210 studs."
		)

		return

	end

	local eggPart =
		getPart(egg)

	if not eggPart then

		warn(
			"❌ El huevo no tiene parte."
		)

		return

	end

	print(
		"🥚 Huevo:",
		egg.Name
	)

	print(
		"💰 Valor:",
		value
	)

	--==================================================
	-- 2. TP AL MEJOR HUEVO
	--==================================================

	print(
		"📍 TP AL HUEVO"
	)

	teleportTo(
		eggPart.Position
	)

	task.wait(0.25)

	--==================================================
	-- 3. AGARRAR
	--==================================================

	print(
		"✋ AGARRANDO..."
	)

	grabEgg(egg)

	task.wait(0.5)

	--==================================================
	-- 4. CENTRO
	--==================================================

	print(
		"📍 TP AL CENTRO"
	)

	teleportTo(
		CENTER
	)

	task.wait(0.5)

	--==================================================
	-- 5. DROP
	--==================================================

	print(
		"📦 SOLTANDO"
	)

	triggerDropEggButton()

	task.wait(0.8)

	--==================================================
	-- 6. BUSCAR OTRA VEZ
	--==================================================

	print(
		"🔎 BUSCANDO EL HUEVO NUEVAMENTE"
	)

	local newEgg =
		waitForEggNearCenter()

	if not newEgg then

		warn(
			"❌ No encontré el huevo después del drop."
		)

		return

	end

	local newPart =
		getPart(newEgg)

	if not newPart then

		warn(
			"❌ No encontré la parte del huevo."
		)

		return

	end

	print(
		"🥚 ENCONTRADO:",
		newEgg.Name
	)

	--==================================================
	-- 7. TP AL HUEVO DROPEADO
	--==================================================

	teleportTo(
		newPart.Position
	)

	task.wait(0.25)

	--==================================================
	-- 8. AGARRAR NUEVAMENTE
	--==================================================

	print(
		"✋ AGARRANDO NUEVAMENTE..."
	)

	grabEgg(newEgg)

	task.wait(0.7)

	--==================================================
	-- 9. PLOT
	--==================================================

	print(
		"🏠 BUSCANDO TU PLOT..."
	)

	local plot =
		findMyPlot()

	if not plot then

		warn(
			"❌ No encontré tu plot."
		)

		return

	end

	local plotPosition =
		getPlotPosition(plot)

	if not plotPosition then

		warn(
			"❌ Encontré el plot pero no su posición."
		)

		return

	end

	print(
		"🏠 PLOT ENCONTRADO"
	)

	--==================================================
	-- 10. DESPLAZAMIENTO 1000
	--==================================================

	print(
		"🚀 DESPLAZAMIENTO A 1000"
	)

	moveTo(
		plotPosition
			+ Vector3.new(
				0,
				3,
				0
			)
	)

	task.wait(0.5)

	--==================================================
	-- 11. DROP FINAL
	--==================================================

	print(
		"📦 SOLTANDO EN EL PLOT"
	)

	triggerDropEggButton()

	print(
		"=============================="
	)

	print(
		"✅ CICLO COMPLETADO"
	)

end

--========================================================--
-- EJECUTAR
--========================================================--

start()
