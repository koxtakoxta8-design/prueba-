end

local function teleportToCF(cf)
    local root = getRoot()
    if root and cf then
        root.CFrame = cf * CFrame.new(0, 2, 0)
    end
end

local function teleportToVector(vector3Pos)
    local root = getRoot()
    if root and vector3Pos then
        root.CFrame = CFrame.new(vector3Pos)
    end
end

local function teleportToHome()
    local root = getRoot()
    if not root then return false end

    -- ============================================================
    -- JK HUB - TP AL PLOT DEL JUGADOR
    -- Busca primero ownership REAL del jugador y luego el spawn.
    -- Evita escoger plots de otros jugadores.
    -- ============================================================

    local containers = {
        Workspace:FindFirstChild("Plots"),
        Workspace:FindFirstChild("plots"),
        Workspace:FindFirstChild("Plot"),
        Workspace:FindFirstChild("plot"),
        Workspace:FindFirstChild("Bases"),
        Workspace:FindFirstChild("bases"),
        Workspace:FindFirstChild("Base"),
        Workspace:FindFirstChild("base"),
        Workspace:FindFirstChild("Tycoons"),
        Workspace:FindFirstChild("tycoons"),
        Workspace:FindFirstChild("Tycoon"),
        Workspace:FindFirstChild("tycoon"),
        Workspace:FindFirstChild("PlayerPlots"),
        Workspace:FindFirstChild("PlayerBases"),
        Workspace:FindFirstChild("PlayerHomes"),
        Workspace:FindFirstChild("Homes"),
        Workspace:FindFirstChild("Houses"),
        Workspace:FindFirstChild("Islands"),
        Workspace:FindFirstChild("Claims"),
        Workspace:FindFirstChild("ClaimedPlots"),
        Workspace:FindFirstChild("PlayerTycoons")
    }

    local ownerNames = {
        "Owner", "OwnerName", "OwnerId", "OwnerID", "OwnerUserId",
        "Player", "PlayerName", "PlayerId", "PlayerID", "PlayerUserId",
        "User", "UserName", "Username", "UserId", "UserID",
        "ClaimedBy", "ClaimOwner", "PlotOwner", "BaseOwner",
        "TycoonOwner", "OwnerValue", "OwnerTag", "ClaimedPlayer",
        "ClaimedUser", "PlotUser", "BaseUser", "TycoonUser"
    }

    local function normalize(v)
        return string.lower(
            string.gsub(
                tostring(v or ""),
                "[%s_%-]",
                ""
            )
        )
    end

    local myName = normalize(LocalPlayer.Name)
    local myDisplay = normalize(LocalPlayer.DisplayName)
    local myId = tostring(LocalPlayer.UserId)

    local function valueMatches(v)
        if v == nil then
            return false
        end

        if typeof(v) == "Instance" then
            if v == LocalPlayer then
                return true
            end

            local okName, name = pcall(function()
                return v.Name
            end)

            if okName then
                local normalizedName = normalize(name)
                if normalizedName == myName or normalizedName == myDisplay then
                    return true
                end
            end

            return false
        end

        local text = tostring(v)
        local normalizedText = normalize(text)

        return normalizedText == myName
            or normalizedText == myDisplay
            or text == myId
    end

    -- Devuelve cuánta evidencia de ownership tiene el objeto.
    -- 100 = ownership directo y fuerte.
    -- 50  = ownership encontrado en un descendiente.
    local function getOwnershipScore(obj)
        if not obj then
            return 0
        end

        local score = 0

        -- Attributes directos.
        for _, name in ipairs(ownerNames) do
            local ok, attr = pcall(function()
                return obj:GetAttribute(name)
            end)

            if ok and attr ~= nil and valueMatches(attr) then
                score = math.max(score, 100)
            end
        end

        -- Values directos.
        for _, name in ipairs(ownerNames) do
            local child = obj:FindFirstChild(name)

            if child then
                if child:IsA("ObjectValue") and child.Value == LocalPlayer then
                    score = math.max(score, 100)
                end

                local ok, val = pcall(function()
                    return child.Value
                end)

                if ok and valueMatches(val) then
                    score = math.max(score, 100)
                end

                if valueMatches(child) then
                    score = math.max(score, 100)
                end
            end
        end

        -- Revisar descendientes, pero con menor prioridad.
        for _, v in ipairs(obj:GetDescendants()) do
            local lname = string.lower(v.Name)

            if lname:find("owner", 1, true)
                or lname:find("player", 1, true)
                or lname:find("userid", 1, true)
                or lname:find("username", 1, true)
                or lname == "user"
                or lname == "claimedby" then

                if v:IsA("ObjectValue") and v.Value == LocalPlayer then
                    score = math.max(score, 80)
                end

                local ok, val = pcall(function()
                    return v.Value
                end)

                if ok and valueMatches(val) then
                    score = math.max(score, 80)
                end
            end
        end

        return score
    end

    local function looksLikePlot(obj)
        if not obj then
            return false
        end

        local n = string.lower(obj.Name)

        return n:find("plot", 1, true)
            or n:find("base", 1, true)
            or n:find("tycoon", 1, true)
            or n:find("farm", 1, true)
            or n:find("house", 1, true)
            or n:find("home", 1, true)
            or n:find("island", 1, true)
            or n:find("claim", 1, true)
    end

    local function findNearestPlotAncestor(obj)
        local current = obj

        for _ = 1, 15 do
            if not current then
                break
            end

            if looksLikePlot(current) then
                return current
            end

            current = current.Parent
        end

        return nil
    end

    local function getTargetFromObject(plot)
        if not plot then
            return nil, 0
        end

        local bestCF = nil
        local bestScore = -math.huge

        local exactNames = {
            "PlotSpawn",
            "PlayerSpawn",
            "HomeSpawn",
            "BaseSpawn",
            "FarmSpawn",
            "TycoonSpawn",
            "HouseSpawn",
            "ClaimSpawn",
            "SpawnPoint",
            "SpawnPart",
            "SpawnLocationPart",
            "TeleportPoint",
            "Teleport",
            "HomePoint",
            "Home",
            "Spawn",
            "SpawnLocation"
        }

        local function scoreTarget(obj, namePriority)
            if not obj then
                return
            end

            local cf = nil

            if obj:IsA("BasePart") then
                cf = obj.CFrame
            elseif obj:IsA("Model") then
                cf = obj:GetPivot()
            end

            if not cf then
                return
            end

            local n = string.lower(obj.Name)
            local score = namePriority or 0

            if n:find("plot", 1, true) then
                score = score + 8
            end

            if n:find("home", 1, true) then
                score = score + 10
            end

            if n:find("base", 1, true) then
                score = score + 10
            end

            if n:find("spawn", 1, true) then
                score = score + 20
            end

            if n:find("teleport", 1, true) then
                score = score + 15
            end

            if n == "spawnlocation" then
                score = score + 18
            end

            if score > bestScore then
                bestScore = score
                bestCF = cf + Vector3.new(0, 3, 0)
            end
        end

        -- 1. Nombres exactos conocidos.
        for priority, name in ipairs(exactNames) do
            local obj = plot:FindFirstChild(name, true)

            if obj then
                scoreTarget(obj, 1000 - priority)
            end
        end

        -- 2. SpawnLocations reales.
        for _, obj in ipairs(plot:GetDescendants()) do
            if obj:IsA("SpawnLocation") then
                scoreTarget(obj, 900)
            end
        end

        -- 3. Partes con nombres relacionados al spawn/home/base/teleport.
        for _, obj in ipairs(plot:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                local n = string.lower(obj.Name)

                if n:find("spawn", 1, true)
                    or n:find("home", 1, true)
                    or n:find("teleport", 1, true)
                    or n:find("base", 1, true)
                    or n:find("plot", 1, true) then

                    scoreTarget(obj, 500)
                end
            end
        end

        -- 4. Último recurso: pivot del plot.
        -- Solo se usa si el plot tiene ownership confirmado.
        if not bestCF then
            local ok, pivot = pcall(function()
                return plot:GetPivot()
            end)

            if ok and pivot then
                bestCF = pivot + Vector3.new(0, 3, 0)
                bestScore = 100
            elseif plot:IsA("BasePart") then
                bestCF = plot.CFrame + Vector3.new(0, 3, 0)
                bestScore = 100
            end
        end

        return bestCF, bestScore
    end

    local candidates = {}
    local seen = {}

    local function addCandidate(plot, ownershipScore, source)
        if not plot or seen[plot] then
            return
        end

        if ownershipScore <= 0 then
            return
        end

        seen[plot] = true

        local targetCF, targetScore = getTargetFromObject(plot)

        if targetCF then
            table.insert(candidates, {
                Plot = plot,
                Ownership = ownershipScore,
                TargetScore = targetScore,
                TargetCF = targetCF,
                Source = source or "unknown"
            })
        end
    end

    -- ============================================================
    -- 1. Buscar en los contenedores de plots/bases.
    -- ============================================================
    for _, container in ipairs(containers) do
        if container then
            for _, obj in ipairs(container:GetChildren()) do
                local ownership = getOwnershipScore(obj)

                if ownership > 0 then
                    addCandidate(obj, ownership, "container")
                else
                    -- Puede que el Owner esté dentro del modelo.
                    for _, child in ipairs(obj:GetDescendants()) do
                        local childOwnership = getOwnershipScore(child)

                        if childOwnership > 0 then
                            addCandidate(obj, childOwnership, "descendant")
                            break
                        end
                    end
                end
            end
        end
    end

    -- ============================================================
    -- 2. Fallback global:
    -- encontrar Owner/Player/UserId y subir al Plot/Base/Tycoon.
    -- ============================================================
    if #candidates == 0 then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            local lname = string.lower(obj.Name)

            if lname:find("owner", 1, true)
                or lname:find("player", 1, true)
                or lname:find("userid", 1, true)
                or lname:find("username", 1, true)
                or lname == "claimedby"
                or lname == "user" then

                local ownership = 0

                if obj:IsA("ObjectValue") and obj.Value == LocalPlayer then
                    ownership = 100
                else
                    local ok, val = pcall(function()
                        return obj.Value
                    end)

                    if ok and valueMatches(val) then
                        ownership = 90
                    end
                end

                if ownership > 0 then
                    local plot = findNearestPlotAncestor(obj)

                    if plot then
                        addCandidate(plot, ownership, "global")
                    end
                end
            end
        end
    end

    -- ============================================================
    -- 3. Fallback por nombre del jugador.
    -- Algunos juegos nombran el plot con el username.
    -- ============================================================
    if #candidates == 0 then
        for _, container in ipairs(containers) do
            if container then
                for _, obj in ipairs(container:GetChildren()) do
                    local normalizedObjectName = normalize(obj.Name)

                    if normalizedObjectName == myName
                        or normalizedObjectName == myDisplay then
                        addCandidate(obj, 60, "player-name")
                    end
                end
            end
        end
    end

    -- ============================================================
    -- Elegir SOLO el candidato con mejor ownership.
    -- En empate, gana el que tenga el mejor spawn.
    -- ============================================================
    table.sort(candidates, function(a, b)
        if a.Ownership ~= b.Ownership then
            return a.Ownership > b.Ownership
        end

        return a.TargetScore > b.TargetScore
    end)

    local chosen = candidates[1]

    if not chosen or not chosen.TargetCF then
        warn("JK HUB: NO se encontró el plot propio de " .. LocalPlayer.Name)
        return false
    end

    -- ============================================================
    -- TP + VERIFICACIÓN.
    -- Si el juego bloquea el primer TP, se intenta varias veces.
    -- ============================================================
    for attempt = 1, 8 do
        local currentRoot = getRoot()

        if not currentRoot then
            return false
        end

        currentRoot.CFrame = chosen.TargetCF

        task.wait(0.10)

        local distance = (currentRoot.Position - chosen.TargetCF.Position).Magnitude

        if distance <= 15 then
            return true
        end

        task.wait(0.10)
    end

    warn(
        "JK HUB: se encontró el plot de " ..
        LocalPlayer.Name ..
        " pero el TP no pudo confirmarse."
    )

    return false
end

local function unequipEggs()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid:UnequipTools()
    end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") or string.find(string.lower(child.Name), "egg") then
                child.Parent = backpack
            end
        end
    end
end

local function interactWithPrompt(object)
    if not object or not object.Parent then return end
    local prompt = object:FindFirstChildOfClass("ProximityPrompt") 
        or object:FindFirstChildWhichIsA("ProximityPrompt", true)

    if prompt then
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(0.02)
            prompt:InputHoldEnd()
        end
    end
end

local function triggerDropEggButton()
    -- Buscar dinámicamente el botón DropEgg en la interfaz del jugador o del juego
    local foundBtn = nil
    
    -- Búsqueda en PlayerGui
    for _, gui in ipairs(PlayerGui:GetDescendants()) do
        if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and (string.lower(gui.Name) == "dropegg" or string.find(string.lower(gui.Name), "dropegg")) then
            foundBtn = gui
            break
        end
    end

    if foundBtn then
        for _, conn in ipairs(getconnections(foundBtn.MouseButton1Click)) do
            conn:Fire()
        end
        for _, conn in ipairs(getconnections(foundBtn.Activated)) do
            conn:Fire()
        end
    else
        -- Fallback mediante remotos si estuviera disponible
        pcall(function()
            local remote = ReplicatedStorage:FindFirstChild("Packages") 
                and ReplicatedStorage.Packages:FindFirstChild("Networking") 
                and ReplicatedStorage.Packages.Networking:FindFirstChild("RF/EggWorld/AskFieldEggDrop")
            if remote then
                remote:InvokeServer({ Reason = "PlayerRequest" })
            end
        end)
    end
end

local function characterHasEgg()
    local char = LocalPlayer.Character
    if not char then return false end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") or string.find(string.lower(child.Name), "egg") then
            return true
        end
    end
    return false
end

local function getObjectCFrame(obj)
    if not obj or not obj.Parent then return nil end
    if obj:IsA("Model") then
        return obj:GetPivot()
    elseif obj:IsA("BasePart") then
        return obj.CFrame
    end
    return nil
end

local function findEggNearPlayer(eggName, maxDistance)
    local root = getRoot()
    if not root then return nil end

    local containers = {
        Workspace:FindFirstChild("RenderedEggs"),
        Workspace:FindFirstChild("Shop"),
        Workspace:FindFirstChild("ShopEggs"),
        Workspace:FindFirstChild("Eggs")
    }

    local bestEgg = nil
    local bestDistance = maxDistance or 40

    for _, container in ipairs(containers) do
        if container then
            for _, obj in ipairs(container:GetDescendants()) do
                if (obj:IsA("Model") or obj:IsA("BasePart")) then
                    local sameName = obj.Name == eggName or string.find(string.lower(obj.Name), string.lower(eggName), 1, true)
                    if sameName then
                        local cf = getObjectCFrame(obj)
                        if cf then
                            local distance = (cf.Position - root.Position).Magnitude
                            if distance <= bestDistance and obj:FindFirstChildWhichIsA("ProximityPrompt", true) then
                                bestEgg = obj
                                bestDistance = distance
                            end
                        end
                    end
                end
            end
        end
    end

    return bestEgg
end

local function performAntiCheatAndReturn(eggObj, eggName, rarity, cost)
    -- 1. TP a la nueva posicion intermedia
    teleportToVector(ANTI_CHEAT_POS)
    task.wait(0.15)

    -- 2. Soltar el huevo
    triggerDropEggButton()
    task.wait(0.15)

    -- 3. NO hacer TP al huevo. Buscar el huevo que acaba de soltarse
    --    cerca de la posicion actual y activar su ProximityPrompt.
    local grabbedAgain = false
    local grabStart = tick()
    local droppedEgg = nil

    while not grabbedAgain and (tick() - grabStart < 3) do
        if not droppedEgg or not droppedEgg.Parent then
            droppedEgg = findEggNearPlayer(eggName, 45)
        end

        if droppedEgg and droppedEgg.Parent then
            interactWithPrompt(droppedEgg)
        end

        task.wait(0.05)
        grabbedAgain = characterHasEgg()
    end

    -- 4. Solo ir al Plot cuando el segundo Auto Grab fue confirmado
    if not grabbedAgain then
        return false
    end

    addStealHistory(eggName, rarity, cost)

    -- IMPORTANTE: primero intentar el TP al plot; no ocultar el huevo antes.
    local wentHome = false
    for _ = 1, 5 do
        if teleportToHome() then
            wentHome = true
            break
        end
        task.wait(0.15)
    end

    if wentHome then
        task.wait(0.1)
        unequipEggs()
    end

    return wentHome
end

local function getTop10EggsInServer()
    local containers = {
        Workspace:FindFirstChild("RenderedEggs"),
        Workspace:FindFirstChild("Shop"),
        Workspace:FindFirstChild("ShopEggs"),
        Workspace:FindFirstChild("Eggs")
    }

    local foundEggs = {}
    for _, container in ipairs(containers) do
        if container then
            local children = container:GetChildren()
            for i = 1, #children do
                local egg = children[i]
                if egg:IsA("Model") or egg:IsA("BasePart") then
                    local data = getEggData(egg.Name)
                    table.insert(foundEggs, {Object = egg, Name = egg.Name, Data = data})
                end
            end
        end
    end

    table.sort(foundEggs, function(a, b) return a.Data.Rank > b.Data.Rank end)

    local top10 = {}
    for i = 1, math.min(10, #foundEggs) do
        table.insert(top10, foundEggs[i])
    end
    return top10
end

