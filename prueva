--==============================================================
-- MEJOR HUEVO
--==============================================================

local function FindBestEgg()

    local Best = nil
    local Highest = -math.huge

    for Object,Data in pairs(EggCache) do

        if not Object
        or not Object.Parent then

            EggCache[Object] = nil

        else

            local Prompt =
                Data.Prompt

            if not Prompt
            or not Prompt.Parent then

                Prompt =
                    FindPrompt(Object)

                Data.Prompt =
                    Prompt
            end

            if Prompt
            and Prompt.Enabled then

                local Position =
                    GetPosition(Object)

                if Position then

                    Data.Position =
                        Position

                    -- recalcular por si cambió
                    Data.Score =
                        GetEggScore(Object)

                    if Data.Score > Highest then

                        Highest =
                            Data.Score

                        Best =
                            Data
                    end
                end
            end
        end
    end

    return Best
end

--==============================================================
-- TELEPORT
--==============================================================

local function Teleport(Position)

    local Root =
        GetRoot()

    if not Root then
        return false
    end

    Root.CFrame =
        CFrame.new(
            Position + EGG_OFFSET
        )

    return true
end

--==============================================================
-- INTERACTUAR
--==============================================================

local function CollectEgg(Data)

    if not Data
    or not Data.Object
    or not Data.Object.Parent then

        return false
    end

    local Prompt =
        FindPrompt(Data.Object)

    if not Prompt
    or not Prompt.Enabled then

        return false
    end

    pcall(function()
        Prompt.HoldDuration = 0
    end)

    pcall(function()

        Prompt:InputHoldBegin()

        task.wait(
            PROMPT_DELAY
        )

        Prompt:InputHoldEnd()

    end)

    return true
end

--==============================================================
-- PLOT
--==============================================================

local function IsMyPlot(Object)

    local Names = {

        "Owner",
        "owner",
        "OwnerName",
        "ownerName"
    }

    for _,Name in ipairs(Names) do

        local Attribute =
            Object:GetAttribute(Name)

        if Attribute ~= nil then

            local Text =
                tostring(Attribute)

            if Text == Player.Name
            or Text == tostring(Player.UserId) then

                return true
            end
        end

        local Value =
            Object:FindFirstChild(
                Name,
                true
            )

        if Value then

            if Value:IsA("StringValue")
            and Value.Value == Player.Name then

                return true
            end

            if Value:IsA("IntValue")
            and Value.Value == Player.UserId then

                return true
            end

            if Value:IsA("ObjectValue")
            and Value.Value == Player then

                return true
            end
        end
    end

    return false
end

local function FindMyPlot()

    if CachedPlot then
        return CachedPlot
    end

    for _,Object in ipairs(
        workspace:GetDescendants()
    ) do

        local Name =
            Object.Name:lower()

        if Name:find("plot",1,true)
        or Name:find("base",1,true)
        or Name:find("tycoon",1,true) then

            if IsMyPlot(Object) then

                local Position =
                    GetPosition(Object)

                if Position then

                    CachedPlot =
                        Position

                    return Position
                end
            end
        end
    end

    return nil
end

--==============================================================
-- CICLO
--==============================================================

local function RunOnce()

    if BUSY then
        return
    end

    BUSY = true

    StatusLabel.Text =
        "Estado: BUSCANDO MEJOR"

    local Egg =
        FindBestEgg()

    if not Egg then

        BestLabel.Text =
            "🏆 Mejor: NINGUNO"

        ValueLabel.Text =
            "Luck: —"

        StatusLabel.Text =
            "Estado: NO DETECTADO"

        BUSY = false

        return
    end

    ------------------------------------------------------------
    -- MOSTRAR
    ------------------------------------------------------------

    BestLabel.Text =
        "🏆 Mejor: "
        .. Egg.Object.Name

    if Egg.Score >= 2500000000000 then

        ValueLabel.Text =
            "Luck: 2.5T • #1 VOLCANIC"

    elseif Egg.Score >= 1000000000000 then

        ValueLabel.Text =
            "Luck: 1T • CHERUB"

    elseif Egg.Score >= 300000000000 then

        ValueLabel.Text =
            "Luck: 300B • SOLARIS"

    else

        ValueLabel.Text =
            "Luck: "
            .. tostring(
                Egg.Value
                or Egg.Score
                or 0
            )
    end

    ------------------------------------------------------------
    -- ACTUALIZAR POSICIÓN
    ------------------------------------------------------------

    local Position =
        GetPosition(Egg.Object)

    if not Position then

        BUSY = false
        return
    end

    Egg.Position =
        Position

    ------------------------------------------------------------
    -- TP
    ------------------------------------------------------------

    StatusLabel.Text =
        "Estado: TP AL MEJOR HUEVO"

    Teleport(Position)

    task.wait(.12)

    ------------------------------------------------------------
    -- RECOGER
    ------------------------------------------------------------

    StatusLabel.Text =
        "Estado: RECOGIENDO"

    CollectEgg(Egg)

    task.wait(.20)

    ------------------------------------------------------------
    -- PLOT
    ------------------------------------------------------------

    StatusLabel.Text =
        "Estado: BUSCANDO PLOT"

    local Plot =
        FindMyPlot()

    if Plot then

        StatusLabel.Text =
            "Estado: TP AL PLOT"

        Teleport(Plot)

        task.wait(.20)

        StatusLabel.Text =
            "Estado: COMPLETADO"

    else

        StatusLabel.Text =
            "Estado: PLOT NO ENCONTRADO"
    end

    BUSY = false
end

