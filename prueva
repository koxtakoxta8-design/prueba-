--==============================================================
-- CONVERTIR LUCK
--==============================================================

local function LuckNumber(value)

    local text = tostring(value or "0")

    local number =
        tonumber(text:match("[%d%.]+")) or 0

    if text:find("T") then
        return number * 1e12
    elseif text:find("B") then
        return number * 1e9
    elseif text:find("M") then
        return number * 1e6
    elseif text:find("K") then
        return number * 1e3
    end

    return number
end

--==============================================================
-- DETECTAR NOMBRE
--==============================================================

local function GetEggData(name)

    local exact = EggData[name]

    if exact then
        return exact, name
    end

    local lower = tostring(name):lower()

    for eggName, data in pairs(EggData) do

        if lower:find(
            eggName:lower(),
            1,
            true
        ) then
            return data, eggName
        end
    end

    return nil
end

--==============================================================
-- PARTE DEL OBJETO
--==============================================================

local function GetPart(obj)

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then

        if obj.PrimaryPart then
            return obj.PrimaryPart
        end

        return obj:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
    end

    return nil
end

--==============================================================
-- ROOT
--==============================================================

local function GetRoot()

    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChild(
        "HumanoidRootPart"
    )
end

--==============================================================
-- GUARDAR POSICIÓN
--==============================================================

local function SavePosition()

    local root = GetRoot()

    if not root then
        return false
    end

    ReturnCFrame = root.CFrame

    return true
end

--==============================================================
-- CONGELAR
--==============================================================

local function Freeze()

    local character = LocalPlayer.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if humanoid then

        humanoid:SetAttribute(
            "KOXTA_OLD_SPEED",
            humanoid.WalkSpeed
        )

        humanoid:SetAttribute(
            "KOXTA_OLD_JUMP",
            humanoid.JumpPower
        )

        humanoid:SetAttribute(
            "KOXTA_OLD_ROTATE",
            humanoid.AutoRotate
        )

        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.AutoRotate = false
    end

    if root then
        root.AssemblyLinearVelocity =
            Vector3.zero

        root.AssemblyAngularVelocity =
            Vector3.zero
    end
end

--==============================================================
-- DESCONGELAR
--==============================================================

local function Unfreeze()

    local character = LocalPlayer.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return
    end

    humanoid.WalkSpeed =
        humanoid:GetAttribute(
            "KOXTA_OLD_SPEED"
        ) or 16

    humanoid.JumpPower =
        humanoid:GetAttribute(
            "KOXTA_OLD_JUMP"
        ) or 50

    humanoid.AutoRotate =
        humanoid:GetAttribute(
            "KOXTA_OLD_ROTATE"
        )

    if humanoid.AutoRotate == nil then
        humanoid.AutoRotate = true
    end
end

--==============================================================
-- ESCANEAR WORKSPACE
--==============================================================

local function ScanWorkspace()

    local found = {}

    for _, obj in ipairs(
        Workspace:GetDescendants()
    ) do

        local data, realName =
            GetEggData(obj.Name)

        if data then

            local part = GetPart(obj)

            if part then

                -- Evita duplicar un mismo huevo
                local already = false

                for _, egg in ipairs(found) do

                    if egg.Object == obj then
                        already = true
                        break
                    end
                end

                if not already then

                    table.insert(
                        found,
                        {
                            Object = obj,
                            Part = part,
                            Name = realName,
                            Luck = data.Luck,
                            LuckNumber =
                                LuckNumber(data.Luck),
                            Rarity = data.Rarity,
                            Position = part.Position
                        }
                    )
                end
            end
        end
    end

    return found
end

--==============================================================
-- ELEGIR MEJOR
--==============================================================

local function FindBestEgg()

    local eggs = ScanWorkspace()

    local best = nil

    for _, egg in ipairs(eggs) do

        if not best
        or egg.LuckNumber >
           best.LuckNumber then

            best = egg
        end
    end

    return best, #eggs
end

--==============================================================
-- TP
--==============================================================

local function TeleportToEgg(egg)

    local root = GetRoot()

    if not root or not egg then
        return false
    end

    root.CFrame =
        CFrame.new(
            egg.Position +
            Vector3.new(0, 3, 0)
        )

    task.wait()

    Freeze()

    return true
end

--==============================================================
-- VOLVER
--==============================================================

local function ReturnToStart()

    local root = GetRoot()

    if not root or not ReturnCFrame then
        return false
    end

    root.CFrame = ReturnCFrame

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

