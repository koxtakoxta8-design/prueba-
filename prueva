local MotionLines = {}

local function CreateMotionLine()

    local Line =
        Instance.new("Frame")

    Line.Size =
        UDim2.fromOffset(
            math.random(
                25,
                65
            ),
            math.random(
                1,
                2
            )
        )

    Line.AnchorPoint =
        Vector2.new(
            0.5,
            0.5
        )

    local Shade =
        math.random(
            70,
            180
        )

    Line.BackgroundColor3 =
        Color3.fromRGB(
            Shade,
            Shade,
            Shade
        )

    Line.BorderSizePixel = 0
    Line.ZIndex = 5

    Line.Parent =
        FX

    table.insert(
        MotionLines,
        {
            Object = Line,
            Side = math.random(
                1,
                4
            ),
            Progress = math.random(),
            Speed = math.random(
                20,
                55
            ) / 100
        }
    )
end

for i = 1, 14 do
    CreateMotionLine()
end

RunService.RenderStepped:Connect(
    function(Delta)

        for _,Data in ipairs(
            MotionLines
        ) do

            Data.Progress +=
                Delta *
                Data.Speed

            if Data.Progress > 1 then
                Data.Progress = 0
            end

            local Line =
                Data.Object

            local P =
                Data.Progress

            if Data.Side == 1 then

                Line.Position =
                    UDim2.new(
                        0,
                        25 +
                        P * 280,
                        0,
                        10
                    )

                Line.Rotation = 0

            elseif Data.Side == 2 then

                Line.Position =
                    UDim2.new(
                        0,
                        315,
                        0,
                        25 +
                        P * 180
                    )

                Line.Rotation = 90

            elseif Data.Side == 3 then

                Line.Position =
                    UDim2.new(
                        0,
                        305 -
                        P * 280,
                        0,
                        215
                    )

                Line.Rotation = 0

            else

                Line.Position =
                    UDim2.new(
                        0,
                        5,
                        0,
                        195 -
                        P * 180
                    )

                Line.Rotation = 90

            end
        end
    end
)

