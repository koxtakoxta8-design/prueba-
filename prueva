--==============================================================
-- SNAPSHOT REMOTE
--==============================================================

local function FindRemote(path)

    local current = ReplicatedStorage

    for part in string.gmatch(path, "[^%.]+") do

        if not current then
            return nil
        end

        current = current:FindFirstChild(part)
    end

    return current
end

local SnapshotRemote =
    FindRemote(
        "Packages.Networking.RF/EggWorld/AskFieldEggSnapshot"
    )

--==============================================================
-- LUCK -> NUMERO
--==============================================================

local function LuckNumber(value)

    local text = tostring(value or "0")

    local number =
        tonumber(text:match("[%d%.]+")) or 0

    if text:find("T") then
        return number * 1e12
    end

    if text:find("B") then
        return number * 1e9
    end

    if text:find("M") then
        return number * 1e6
    end

    if text:find("K") then
        return number * 1e3
    end

    return number
end

--==============================================================
-- DATOS DEL HUEVO
--==============================================================

local function GetEggData(name)

    if not name then
        return nil
    end

    if EggData[name] then
        return EggData[name], name
    end

    local lower =
        tostring(name):lower()

    for eggName, data in pairs(EggData) do

        if lower:find(
            eggName:lower(),
            1,
            true
        ) then

            return data, eggName
        end
    end

    return nil
end

--==============================================================
-- PARTE DE UN MODELO
--==============================================================

local function GetPart(obj)

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then

        if obj.PrimaryPart then
            return obj.PrimaryPart
        end

        return obj:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
    end

    return nil
end

--==============================================================
-- ROOT
--==============================================================

local function GetRoot()

    local character =
        Player.Character

    if not character then
        return nil
    end

    return character:FindFirstChild(
        "HumanoidRootPart"
    )
end

