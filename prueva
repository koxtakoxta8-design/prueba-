    if Running then
        return
    end

    Running = true

    Status.Text =
        "Estado: ESCANEANDO WORKSPACE..."

    -- Si por alguna razón todavía no hay
    -- posición de base, la toma ahora.
    if not BasePosition then
        CalibrateBase()
    end

    local root = GetRoot()

    if root then
        ReturnCFrame = root.CFrame
    end

    local best, amount =
        FindBestEgg()

    Count.Text =
        "Huevos del mapa: " ..
        tostring(amount)

    if not best then

        Info.Text =
            "🥚 Mejor: NO ENCONTRADO\n" ..
            "🍀 Lucky: ---\n" ..
            "⭐ Rareza: ---"

        Status.Text =
            "Estado: NO HAY HUEVOS"

        Running = false
        return
    end

    Info.Text =
        "🥚 Mejor: " ..
        best.Name ..
        "\n🍀 Lucky: " ..
        best.Luck ..
        "\n⭐ Rareza: " ..
        best.Rarity

    Status.Text =
        "Estado: TP → " ..
        best.Name

    if not TeleportToEgg(best) then

        Status.Text =
            "Estado: ERROR DE TP"

        Unfreeze()
        Running = false
        return
    end

    Status.Text =
        "Estado: CONGELADO EN EL HUEVO"

    task.wait(FREEZE_TIME)

    Status.Text =
        "Estado: REGRESANDO"

    ReturnToStart()

    task.wait(0.25)

    Unfreeze()

    Status.Text =
        "Estado: TERMINADO"

    Running = false
