--==============================================================
-- SWITCH LOP: MISMA VARIABLE Y MECÁNICA ORIGINAL
--==============================================================

LoopSwitch.Activated:Connect(function()
    ClickAnimation(LoopSwitch)

    LOP = not LOP
    UpdateLOPButton()

    if LOP then
        Status.Text = "● LOOP READY"
    else
        Status.Text = InstaTP and "● ACTIVE" or "● READY"
    end
end)

--==============================================================
-- ABRIR / CERRAR
--==============================================================

local interfaceOpen = true

local function SetInterfaceVisible(state)
    interfaceOpen = state
    Main.Visible = state
    OpenButton.Visible = not state
end

CloseButton.Activated:Connect(function()
    SetInterfaceVisible(false)
end)

OpenButton.Activated:Connect(function()
    SetInterfaceVisible(true)
end)

--==============================================================
-- ARRASTRE MÓVIL / PC
--==============================================================

local dragging = false
local dragStart
local startPosition

Top.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = Main.Position
    end
end)

Top.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        if dragging then
            local delta = input.Position - dragStart

            Main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = false
    end
end)

