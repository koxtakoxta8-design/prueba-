--// BEST EGG AUTO GRAB - SNAPSHOT
--// Para usar en tu propio juego de Roblox Studio

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local AUTO_START = true

-- Nombre de tu Spawn/Base.
-- Si tu juego usa otro nombre, cámbialo aquí.
local SPAWN_NAME = "SpawnLocation"

-- Distancia máxima para buscar el ProximityPrompt
local GRAB_DISTANCE = 12

--------------------------------------------------
-- SNAPSHOT REMOTE
--------------------------------------------------

local function findRemote(path)
    local cur = ReplicatedStorage

    for part in string.gmatch(path, "[^%.]+") do
        if cur then
            cur = cur:FindFirstChild(part)
        end
    end

    return cur
end

local SnapshotRemote =
    findRemote("Packages.Networking.RF/EggWorld/AskFieldEggSnapshot")

--------------------------------------------------
-- LOS 22 HUEVOS
--------------------------------------------------

local EggLuck = {
    ["White Egg"] = 1,
    ["Brown Egg"] = 5,
    ["Cracked Egg"] = 30,
    ["Easter Egg"] = 50,
    ["Stone Egg"] = 100,
    ["Leaf Egg"] = 200,
    ["Mushroom Egg"] = 500,
    ["Flower Egg"] = 750,
    ["Slime Egg"] = 1000,
    ["Ice Egg"] = 3000,
    ["Glass Egg"] = 10000,
    ["Golden Egg"] = 30000,
    ["Crystal Egg"] = 150000,
    ["Skull Egg"] = 250000,
    ["Dominus Egg"] = 700000,
    ["Flaming Egg"] = 1000000,
    ["Sinister Egg"] = 3000000,
    ["Soul Egg"] = 7000000,
    ["Aurora Egg"] = 300000000,
    ["Galaxy Egg"] = 1500000000,
    ["Black Hole Egg"] = 100000000000,
    ["Cherub Egg"] = 1000000000000
}

--------------------------------------------------
-- NORMALIZAR NOMBRES
--------------------------------------------------

local function NormalizeName(name)
    if not name then
        return ""
    end

    name = tostring(name)

    name = name:gsub("_", " ")
    name = name:gsub("%-", " ")

    return name:lower()
end

local EggLuckNormalized = {}

for name, luck in pairs(EggLuck) do
    EggLuckNormalized[NormalizeName(name)] = luck
end

--------------------------------------------------
-- OBTENER LUCK DEL EGG
--------------------------------------------------

local function GetEggLuck(assetCategory)
    if not assetCategory then
        return 0
    end

    local normalized = NormalizeName(assetCategory)

    -- Coincidencia exacta
    if EggLuckNormalized[normalized] then
        return EggLuckNormalized[normalized]
    end

    -- Coincidencia parcial
    for name, luck in pairs(EggLuckNormalized) do
        if string.find(normalized, name, 1, true)
        or string.find(name, normalized, 1, true) then
            return luck
        end
    end

    return 0
end

--------------------------------------------------
-- OBTENER POSICIÓN
--------------------------------------------------

local function GetRecordPosition(rec)
    if not rec then
        return nil
    end

    local cf = rec.BottomCFrame

    if typeof(cf) == "CFrame" then
        return cf.Position
    end

    if typeof(cf) == "Vector3" then
        return cf
    end

    return nil
end

--------------------------------------------------
-- BUSCAR EL MEJOR HUEVO
--------------------------------------------------

local function GetBestEgg()
    if not SnapshotRemote then
        warn("No se encontró AskFieldEggSnapshot")
        return nil
    end

    local ok, snapshot = pcall(function()
        return SnapshotRemote:InvokeServer()
    end)

    if not ok or type(snapshot) ~= "table" then
        warn("No se pudo obtener el snapshot")
        return nil
    end

    local records = snapshot.Records or snapshot

    if type(records) ~= "table" then
        return nil
    end

    local bestEgg = nil
    local bestLuck = -1

    for _, rec in ipairs(records) do

        if type(rec) == "table"
        and rec.State == "Slot"
        and rec.BottomCFrame then

            local position = GetRecordPosition(rec)

            if position then

                local asset = tostring(rec.AssetCategory or "")
                local luck = GetEggLuck(asset)

                if luck > bestLuck then

                    bestLuck = luck

                    bestEgg = {
                        Record = rec,
                        AssetCategory = asset,
                        Luck = luck,
                        Position = position
                    }
                end
            end
        end
    end

    return bestEgg
end

--------------------------------------------------
-- TP
--------------------------------------------------

local function GetCharacter()
    return LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()
end

local function GetRoot()
    local character = GetCharacter()

    return character:FindFirstChild("HumanoidRootPart")
end

local function TeleportTo(position)
    local root = GetRoot()

    if not root then
        return false
    end

    root.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))

    return true
end

--------------------------------------------------
-- BUSCAR PROXIMITY PROMPT
--------------------------------------------------

local function GetPromptPosition(prompt)
    local parent = prompt.Parent

    if not parent then
        return nil
    end

    if parent:IsA("BasePart") then
        return parent.Position
    end

    if parent:IsA("Attachment") then
        if parent.Parent and parent.Parent:IsA("BasePart") then
            return parent.Parent.Position
        end
    end

    return nil
end

local function FindGrabPrompt(eggPosition)
    local closest = nil
    local closestDistance = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do

        if obj:IsA("ProximityPrompt") then

            local promptPosition = GetPromptPosition(obj)

            if promptPosition then

                local distance =
                    (promptPosition - eggPosition).Magnitude

                if distance <= GRAB_DISTANCE
                and distance < closestDistance then

                    closestDistance = distance
                    closest = obj
                end
            end
        end
    end

    return closest, closestDistance
end

--------------------------------------------------
-- AUTO GRAB
--------------------------------------------------

local function AutoGrab(eggPosition)

    local prompt, distance =
        FindGrabPrompt(eggPosition)

    if not prompt then
        warn("No encontré ProximityPrompt para el huevo")
        return false
    end

    print(
        "Prompt encontrado:",
        prompt:GetFullName(),
        "Distancia:",
        distance
    )

    -- Para tu propio juego:
    -- dispara la interacción del prompt.
    if typeof(fireproximityprompt) == "function" then

        fireproximityprompt(prompt)

        return true
    end

    -- Alternativa para probar en Studio:
    if prompt.Enabled then
        print("Prompt listo para interacción:", prompt.Name)
    end

    return false
end

--------------------------------------------------
-- BUSCAR SPAWN
--------------------------------------------------

local function GetSpawnPosition()

    local spawn = Workspace:FindFirstChild(
        SPAWN_NAME,
        true
    )

    if spawn then

        if spawn:IsA("SpawnLocation") then
            return spawn.Position
        end

        if spawn:IsA("BasePart") then
            return spawn.Position
        end
    end

    -- Buscar cualquier SpawnLocation
    for _, obj in ipairs(Workspace:GetDescendants()) do

        if obj:IsA("SpawnLocation") then
            return obj.Position
        end
    end

    return nil
end

--------------------------------------------------
-- REGRESAR AL SPAWN
--------------------------------------------------

local function ReturnToSpawn()

    local spawnPosition = GetSpawnPosition()

    if not spawnPosition then
        warn("No encontré el Spawn")
        return false
    end

    task.wait(0.4)

    TeleportTo(spawnPosition)

    print("Regresando al Spawn")

    return true
end

--------------------------------------------------
-- CICLO PRINCIPAL
--------------------------------------------------

local Running = false

local function StartBestEgg()

    if Running then
        return
    end

    Running = true

    print("================================")
    print("BUSCANDO MEJOR HUEVO...")
    print("================================")

    local bestEgg = GetBestEgg()

    if not bestEgg then

        warn("No encontré ningún huevo válido")

        Running = false
        return
    end

    print("MEJOR HUEVO:")
    print("Nombre:", bestEgg.AssetCategory)
    print("Lucky:", bestEgg.Luck)
    print("Posición:", bestEgg.Position)

    --------------------------------------------------
    -- TP AL MEJOR HUEVO
    --------------------------------------------------

    local teleported =
        TeleportTo(bestEgg.Position)

    if not teleported then
        Running = false
        return
    end

    task.wait(0.5)

    --------------------------------------------------
    -- AUTO GRAB
    --------------------------------------------------

    local grabbed =
        AutoGrab(bestEgg.Position)

    if grabbed then

        print("AUTO GRAB EJECUTADO")

        task.wait(0.8)

        --------------------------------------------------
        -- VOLVER AL SPAWN
        --------------------------------------------------

        ReturnToSpawn()

    else

        warn("No se pudo ejecutar el grab")
    end

    Running = false
end

--------------------------------------------------
-- INICIAR
--------------------------------------------------

if AUTO_START then
    task.spawn(function()
        task.wait(2)
        StartBestEgg()
    end)
end
