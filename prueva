-- BOTÓN INSTA TP
--==============================================================

TPButton.Activated:Connect(function()

    InstaTP = not InstaTP

    if InstaTP then

        SaveSpawn()

        TPButton.Text = "INSTA TP: ON"
        TPButton.BackgroundColor3 = Color3.fromRGB(35,80,55)
        Status.Text = "Estado: activo"

        task.spawn(function()

            if not LOP and not Busy then
                Busy = true

                pcall(function()
                    DoCycle()
                end)

                Busy = false

                if not LOP then
                    InstaTP = false
                    TPButton.Text = "INSTA TP: OFF"
                    TPButton.BackgroundColor3 = Color3.fromRGB(50,50,50)
                end
            end

        end)

    else

        StopEggLock()
        Unfreeze()

        TPButton.Text = "INSTA TP: OFF"
        TPButton.BackgroundColor3 = Color3.fromRGB(50,50,50)
        Status.Text = "Estado: detenido"

    end
end)

--==============================================================
-- BOTÓN LOP
--==============================================================

LOPButton.Activated:Connect(function()

    LOP = not LOP

    if LOP then
        LOPButton.Text = "LOP: ON"
        LOPButton.BackgroundColor3 = Color3.fromRGB(35,80,55)

        -- Si se activa LOP antes de INSTA TP, no fuerza el TP.
        -- El usuario debe activar INSTA TP.
        Status.Text = InstaTP and "Estado: LOOP activo" or "Estado: activa INSTA TP"

    else
        LOPButton.Text = "LOP: OFF"
        LOPButton.BackgroundColor3 = Color3.fromRGB(50,50,50)

        if InstaTP then
            Status.Text = "Estado: activo"
        else
            Status.Text = "Estado: esperando"
        end
    end
end)

--==============================================================
-- AUTO GRAB x5
--==============================================================

GrabButton.Activated:Connect(function()

    RefreshBestEgg()
    UpdateUI()

    if not BestEgg then
        Status.Text = "Estado: no hay huevo"
        return
    end

    task.spawn(function()

        local oldInsta = InstaTP
        InstaTP = true

        for i = 1,5 do

            if not BestEgg or not BestEgg.Parent then
                RefreshBestEgg()
            end

            if BestEgg then
                pcall(function()
                    AutoGrab(BestEgg)
                end)
            end

            task.wait(0.08)
        end

        InstaTP = oldInsta

        if not InstaTP then
            Unfreeze()
            StopEggLock()
        end
    end)
end)

--==============================================================
-- ACTUALIZACIÓN DEL MEJOR HUEVO
--==============================================================

task.spawn(function()

    while ScreenGui.Parent do

        RefreshBestEgg()
        UpdateUI()

        task.wait(REFRESH_TIME)
    end

end)

--==============================================================
-- LOOP CONTINUO
--==============================================================

task.spawn(function()

    while ScreenGui.Parent do

        if InstaTP and LOP and not Busy then

            Busy = true

            pcall(function()
                DoCycle()
            end)

            Busy = false
        end

        task.wait(REFRESH_TIME)
    end

end)

