    ["Sinister Egg"] = 3000000,
    ["Soul Egg"] = 7000000,
    ["Aurora Egg"] = 300000000,
    ["Galaxy Egg"] = 1500000000,
    ["Black Hole Egg"] = 100000000000,
    ["Blackhole Egg"] = 100000000000,
    ["Solaris Egg"] = 300000000000,
    ["Cherub Egg"] = 1000000000000,
    ["Volcanic Egg"] = 2500000000000,
}

local function GetValue(Object)

    for _,Name in ipairs({
        "Luck",
        "luck",
        "EggLuck",
        "RarityValue",
        "Value"
    }) do

        local Value =
            Object:GetAttribute(Name)

        if typeof(Value) == "number" then
            return Value
        end
    end

    for _,Item in ipairs(
        Object:GetDescendants()
    ) do

        if Item:IsA("NumberValue")
        or Item:IsA("IntValue") then

            local Name =
                Item.Name:lower()

            if Name == "luck"
            or Name == "eggluck"
            or Name == "rarityvalue" then

                return Item.Value
            end
        end
    end

    return FALLBACK_VALUES[
        Object.Name
    ] or 0
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function FindBestEgg()

    local Best = nil
    local Highest = -math.huge

    for _,Object in ipairs(
        workspace:GetDescendants()
    ) do

        if IsEgg(Object) then

            local Position =
                GetPosition(Object)

            if Position
            and not IsExcluded(Position) then

                local Prompt =
                    FindPrompt(Object)

                if Prompt
                and Prompt.Enabled then

                    local Value =
                        GetValue(Object)

                    if Value > Highest then

                        Highest = Value

                        Best = {
                            Object = Object,
                            Position = Position,
                            Prompt = Prompt,
                            Value = Value
                        }
                    end
                end
            end
        end
    end

    return Best
end

--==============================================================
-- TP
--==============================================================

local function Teleport(Position)

    local Root =
        GetRoot()

    if not Root then
        return false
    end

    Root.CFrame =
        CFrame.new(
            Position +
            EGG_OFFSET
        )

    return true
end

--==============================================================
-- RECOGIDA
--==============================================================

local function CollectEgg(Egg)

    if not Egg
    or not Egg.Object
    or not Egg.Object.Parent then

        return false
    end

    local Prompt =
        FindPrompt(
            Egg.Object
        )

    if not Prompt
    or not Prompt.Enabled then

        return false
    end

    StatusLabel.Text =
        "Estado: RECOGIENDO"

    -- Solo se modifica el prompt si es una
    -- experiencia propia y el prompt lo permite.
    local OldDuration =
        Prompt.HoldDuration

    pcall(function()
        Prompt.HoldDuration = 0
    end)

    pcall(function()

        Prompt:InputHoldBegin()

        task.wait()

        Prompt:InputHoldEnd()

    end)

    -- Restaurar propiedad original
    pcall(function()
        Prompt.HoldDuration = OldDuration
    end)

    return true
end

--==============================================================
-- PLOT
--==============================================================

local function IsMyPlot(Object)

    for _,Name in ipairs({
        "Owner",
        "owner",
        "OwnerName",
        "ownerName"
    }) do

        local Attribute =
            Object:GetAttribute(Name)

        if Attribute ~= nil then

            if tostring(Attribute)
            == Player.Name
            or tostring(Attribute)
            == tostring(Player.UserId) then

                return true
            end
        end

        local Value =
            Object:FindFirstChild(
                Name,
                true
            )

        if Value then

            if Value:IsA(
                "StringValue"
            )
            and Value.Value ==
                Player.Name then

                return true
            end

            if Value:IsA(
                "IntValue"
            )
            and Value.Value ==
                Player.UserId then

                return true
            end

            if Value:IsA(
                "ObjectValue"
            )
            and Value.Value ==
                Player then

                return true
            end
        end
    end

    return false
end

local function FindMyPlot()

    for _,Object in ipairs(
        workspace:GetDescendants()
    ) do

        local Name =
            Object.Name:lower()

        if Name:find("plot")
        or Name:find("tycoon")
        or Name:find("base") then

            if IsMyPlot(Object) then

                local Position =
                    GetPosition(Object)

                if Position then
                    return Position
                end
            end
        end
    end

    return nil
end

--==============================================================
-- ESPERA DE RECOGIDA
--==============================================================

local function WaitForCollection(
    Egg,
    Timeout
)

    local Start =
        os.clock()

    while
        os.clock() - Start
        < Timeout
    do

        if not Egg.Object
        or not Egg.Object.Parent then

            return true
        end

        task.wait()

    end

    return false
end

--==============================================================
-- CICLO
--==============================================================

local function RunCycle()

    if Busy or not Running then
        return
    end

    Busy = true

    StatusLabel.Text =
        "Estado: BUSCANDO"

    local Egg =
        FindBestEgg()

    if not Egg then

        BestLabel.Text =
            "🏆 Mejor: NINGUNO"

        LuckLabel.Text =
            "Valor: —"

        StatusLabel.Text =
            "Estado: SIN HUEVO"

        Busy = false
        return
    end

    BestLabel.Text =
        "🏆 Mejor: "
        .. Egg.Object.Name

    LuckLabel.Text =
        "Valor: "
        .. tostring(Egg.Value)

    -- Comprobación final
    if IsExcluded(
        Egg.Position
    ) then

        Busy = false
        return
    end

    --==========================================================
    -- TP
    --==========================================================

    StatusLabel.Text =
        "Estado: TP AL HUEVO"

    Teleport(
        Egg.Position
    )

    task.wait(0.12)

    --==========================================================
    -- RECOGER
    --==========================================================

    if Egg.Object.Parent then

        CollectEgg(Egg)

        -- Esperar hasta que realmente desaparezca
        -- o hasta que expire el tiempo.
        local Collected =
            WaitForCollection(
                Egg,
                1.5
            )

        if not Collected then

            StatusLabel.Text =
                "Estado: NO CONFIRMADO"

            Busy = false
            return
        end
    end

    --==========================================================
    -- PLOT
    --==========================================================

    StatusLabel.Text =
        "Estado: BUSCANDO PLOT"

    local Plot =
        FindMyPlot()

    if not Plot then

        StatusLabel.Text =
            "Estado: PLOT NO ENCONTRADO"

        Busy = false
        return
    end

    StatusLabel.Text =
        "Estado: TP AL PLOT"

    Teleport(Plot)

    task.wait(0.35)

    StatusLabel.Text =
        "Estado: COMPLETADO"

    Busy = false
end

