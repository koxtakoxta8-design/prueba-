    if not root then
        return false
    end

    ReturnCFrame =
        root.CFrame

    return true
end

--==============================================================
-- SNAPSHOT
--==============================================================

local function GetSnapshot()

    if not SnapshotRemote then

        warn(
            "AskFieldEggSnapshot no encontrado"
        )

        return nil
    end

    local success, snapshot =
        pcall(function()

            return SnapshotRemote:InvokeServer()

        end)

    if not success then

        warn(
            "Error obteniendo snapshot"
        )

        return nil
    end

    if type(snapshot) ~= "table" then
        return nil
    end

    return snapshot
end

--==============================================================
-- OBTENER HUEVOS DEL CAMPO
--==============================================================

local function GetFieldEggs()

    local snapshot =
        GetSnapshot()

    if not snapshot then
        return {}
    end

    local records =
        snapshot.Records or snapshot

    if type(records) ~= "table" then
        return {}
    end

    local eggs = {}

    for _, rec in ipairs(records) do

        if type(rec) == "table"
        and rec.State == "Slot"
        and rec.BottomCFrame then

            local position

            if typeof(
                rec.BottomCFrame
            ) == "CFrame" then

                position =
                    rec.BottomCFrame.Position

            elseif typeof(
                rec.BottomCFrame
            ) == "Vector3" then

                position =
                    rec.BottomCFrame
            end

            if position then

                table.insert(
                    eggs,
                    {
                        Position = position,
                        AssetCategory =
                            tostring(
                                rec.AssetCategory or ""
                            ),
                        Record = rec
                    }
                )
            end
        end
    end

    return eggs
end

--==============================================================
-- ENCONTRAR OBJETO CERCA DE SNAPSHOT
--==============================================================

local function FindEggObject(position)

    local closest = nil
    local closestDistance = math.huge

    for _, obj in ipairs(
        Workspace:GetDescendants()
    ) do

        local data, realName =
            GetEggData(obj.Name)

        if data then

            local part =
                GetPart(obj)

            if part then

                local distance =
                    (
                        part.Position -
                        position
                    ).Magnitude

                if distance <= 15
                and distance < closestDistance then

                    closestDistance =
                        distance

                    closest = {
                        Object = obj,
                        Part = part,
                        Name = realName,
                        Luck = data.Luck,
                        LuckNumber =
                            LuckNumber(
                                data.Luck
                            ),
                        Rarity = data.Rarity,
                        Position = position
                    }
                end
            end
        end
    end

    return closest
end

--==============================================================
-- BUSCAR MEJOR
--==============================================================

local function FindBestEgg()

    local snapshotEggs =
        GetFieldEggs()

    local best = nil
    local bestLuck = -1
    local detected = 0

    for _, snapshotEgg in ipairs(
        snapshotEggs
    ) do

        local egg =
            FindEggObject(
                snapshotEgg.Position
            )

        if egg then

            detected += 1

            if egg.LuckNumber >
                bestLuck then

                bestLuck =
                    egg.LuckNumber

                best = egg
            end
        end
    end

    return best, detected
end

--==============================================================
-- CONGELAR
--==============================================================

local function FreezeCharacter()

    local character =
        Player.Character

    local humanoid =
        character and
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    local root =
        character and
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not humanoid then
        return
    end

    humanoid:SetAttribute(
        "KOXTA_OldWalkSpeed",
        humanoid.WalkSpeed
    )

    humanoid:SetAttribute(
        "KOXTA_OldJumpPower",
        humanoid.JumpPower
    )

    humanoid:SetAttribute(
        "KOXTA_OldAutoRotate",
        humanoid.AutoRotate
    )

    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.AutoRotate = false

    if root then

        root.AssemblyLinearVelocity =
            Vector3.zero

        root.AssemblyAngularVelocity =
            Vector3.zero
    end
end

--==============================================================
-- DESCONGELAR
--==============================================================

local function UnfreezeCharacter()

    local character =
        Player.Character

    local humanoid =
        character and
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return
    end

    humanoid.WalkSpeed =
        humanoid:GetAttribute(
            "KOXTA_OldWalkSpeed"
        ) or 16

    humanoid.JumpPower =
        humanoid:GetAttribute(
            "KOXTA_OldJumpPower"
        ) or 50

    humanoid.AutoRotate =
        humanoid:GetAttribute(
            "KOXTA_OldAutoRotate"
        )

    if humanoid.AutoRotate == nil then
        humanoid.AutoRotate = true
    end
end

--==============================================================
-- TP AL HUEVO
--==============================================================

local function TeleportToEgg(egg)

    local root =
        GetRoot()

    if not root or not egg then
        return false
    end

    root.CFrame =
        CFrame.new(
            egg.Position +
            Vector3.new(0, 3, 0)
        )

    task.wait()

    FreezeCharacter()

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

--==============================================================
-- BUSCAR PROMPT DEL HUEVO
--==============================================================

local function FindEggPrompt(egg)

    if not egg then
        return nil
    end

    local root =
        egg.Object

    if root then

        for _, obj in ipairs(
            root:GetDescendants()
        ) do

            if obj:IsA(
                "ProximityPrompt"
            ) then

                return obj
            end
        end
    end

    -- Segundo intento:
    -- buscar el prompt físicamente cerca
    -- de la posición del huevo.

    local closest = nil
    local distanceBest = math.huge

    for _, obj in ipairs(
        Workspace:GetDescendants()
    ) do

        if obj:IsA(
            "ProximityPrompt"
        ) then

            local parent =
                obj.Parent

            local part = nil

            if parent:IsA(
                "BasePart"
            ) then

                part = parent

            elseif parent:IsA(
                "Attachment"
            ) then

                if parent.Parent:IsA(
                    "BasePart"
                ) then

                    part =
                        parent.Parent
                end
            end

            if part then

                local distance =
                    (
                        part.Position -
                        egg.Position
                    ).Magnitude

                if distance <= 15
                and distance < distanceBest then

                    distanceBest =
                        distance

                    closest = obj
                end
            end
        end
    end

    return closest
end

--==============================================================
-- AUTO GRAB
--==============================================================

local function GrabEgg(egg)

    local prompt =
        FindEggPrompt(egg)

    if not prompt then

        warn(
            "No encontré ProximityPrompt del huevo"
        )

        return false
    end

    print(
        "Prompt encontrado:",
        prompt:GetFullName()
    )

    -- Si la experiencia utiliza ProximityPrompt
    -- y el método está disponible, iniciar la interacción.

    local began, ended =
        pcall(function()

            if prompt:IsA(
                "ProximityPrompt"
            ) then

                prompt:InputHoldBegin()

                task.wait(
                    math.max(
                        prompt.HoldDuration,
                        0.05
                    )
                )

                prompt:InputHoldEnd()

                return true
            end

            return false
        end)

    return began and ended
end

--==============================================================
-- REGRESAR EXACTAMENTE
--==============================================================

local function ReturnToBase()

    local root =
        GetRoot()

    if not root
    or not ReturnCFrame then

        return false
    end

    root.CFrame =
        ReturnCFrame

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

