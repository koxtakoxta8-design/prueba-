local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--==============================================================--
-- CONFIG
--==============================================================--

local CENTER = Vector3.new(
	146.87,
	40316.12,
	911.14
)

local EXCLUSION_RADIUS = 210

local PLOT_SPEED = 1000

local WAIT_AFTER_GRAB = 0.8
local WAIT_AFTER_DROP = 1
local SEARCH_TIMEOUT = 8

--==============================================================--
-- VALORES DE HUEVOS
--==============================================================--

local EggValues = {

	["White Egg"] = 1,
	["Brown Egg"] = 5,
	["Cracked Egg"] = 30,
	["Easter Egg"] = 50,
	["Stone Egg"] = 100,
	["Leaf Egg"] = 200,
	["Mushroom Egg"] = 500,
	["Flower Egg"] = 750,
	["Slime Egg"] = 1000,
	["Ice Egg"] = 3000,
	["Glass Egg"] = 10000,
	["Golden Egg"] = 30000,
	["Crystal Egg"] = 150000,
	["Skull Egg"] = 250000,
	["Dominus Egg"] = 700000,
	["Flaming Egg"] = 1000000,
	["Sinister Egg"] = 3000000,
	["Soul Egg"] = 7000000,
	["Aurora Egg"] = 300000000,
	["Galaxy Egg"] = 1500000000,
	["Blackhole Egg"] = 100000000000,
	["Solaris Egg"] = 300000000000,
	["Cherub Egg"] = 1000000000000,
	["Volcanic Egg"] = 2500000000000
}

--==============================================================--
-- UTILIDADES
--==============================================================--

local function getCharacter()

	return Player.Character
		or Player.CharacterAdded:Wait()

end

local function getRoot()

	local character = getCharacter()

	return character:FindFirstChild(
		"HumanoidRootPart"
	)

end

local function getPart(object)

	if not object then
		return nil
	end

	if object:IsA("BasePart") then
		return object
	end

	return object:FindFirstChildWhichIsA(
		"BasePart",
		true
	)

end

local function getDistance(a, b)

	return (
		a - b
	).Magnitude

end

--==============================================================--
-- DETECTAR HUEVO
--==============================================================--

local function isEgg(object)

	if not object then
		return false
	end

	local name =
		string.lower(object.Name)

	if name:find("egg", 1, true) then
		return true
	end

	if name:find("huevo", 1, true) then
		return true
	end

	return false

end

--==============================================================--
-- EXCLUSIÓN
--==============================================================--

local function isExcluded(position)

	return getDistance(
		position,
		CENTER
	) <= EXCLUSION_RADIUS

end

--==============================================================--
-- VALOR DEL HUEVO
--==============================================================--

local function getEggValue(egg)

	if not egg then
		return 0
	end

	local value = 0

	local eggName =
		string.lower(egg.Name)

	-- Valores por nombre
	for name, amount in pairs(EggValues) do

		if eggName:find(
			string.lower(name),
			1,
			true
		) then

			if amount > value then
				value = amount
			end

		end
	end

	-- Valores internos
	for _, object in ipairs(
		egg:GetDescendants()
	) do

		if object:IsA("NumberValue")
		or object:IsA("IntValue") then

			local objectName =
				string.lower(object.Name)

			if objectName:find(
				"luck",
				1,
				true
			)
			or objectName:find(
				"value",
				1,
				true
			)
			or objectName:find(
				"worth",
				1,
				true
			)
			or objectName:find(
				"rarity",
				1,
				true
			) then

				if object.Value > value then
					value = object.Value
				end

			end
		end
	end

	-- Attributes
	for _, attributeName in ipairs({
		"Luck",
		"Value",
		"Worth",
		"Rarity",
		"EggValue"
	}) do

		local attribute =
			egg:GetAttribute(attributeName)

		if typeof(attribute) == "number" then

			if attribute > value then
				value = attribute
			end

		end
	end

	return value

end

--==============================================================--
-- BUSCAR TODOS LOS HUEVOS
--==============================================================--

local function getEggs()

	local eggs = {}

	for _, object in ipairs(
		workspace:GetDescendants()
	) do

		if isEgg(object) then

			local part =
				getPart(object)

			if part then

				table.insert(
					eggs,
					{
						Object = object,
						Part = part,
						Value = getEggValue(object)
					}
				)

			end
		end
	end

	return eggs

end

--==============================================================--
-- BUSCAR MEJOR HUEVO
--==============================================================--

local function findBestEgg()

	local best = nil

	for _, data in ipairs(
		getEggs()
	) do

		if not isExcluded(
			data.Part.Position
		) then

			if not best
			or data.Value > best.Value then

				best = data

			end
		end
	end

	return best

end

--==============================================================--
-- TELEPORT
--==============================================================--

local function teleport(position)

	local root =
		getRoot()

	if not root then
		return false
	end

	root.CFrame =
		CFrame.new(position)

	return true

end

--==============================================================--
-- MOVIMIENTO A VELOCIDAD 1000
--==============================================================--

local function moveFast(position)

	local root =
		getRoot()

	if not root then
		return false
	end

	local start =
		root.Position

	local distance =
		getDistance(
			start,
			position
		)

	if distance <= 2 then

		root.CFrame =
			CFrame.new(position)

		return true

	end

	local duration =
		distance / PLOT_SPEED

	local started =
		os.clock()

	while true do

		root =
			getRoot()

		if not root then
			return false
		end

		local alpha =
			math.clamp(
				(os.clock() - started)
					/ duration,
				0,
				1
			)

		local current =
			start:Lerp(
				position,
				alpha
			)

		root.CFrame =
			CFrame.new(current)

		if alpha >= 1 then
			break
		end

		RunService.Heartbeat:Wait()

	end

	return true

end

--==============================================================--
-- BUSCAR DROPEGG
--==============================================================--

local function findDropButton()

	for _, gui in ipairs(
		PlayerGui:GetDescendants()
	) do

		if gui:IsA("TextButton")
		or gui:IsA("ImageButton") then

			local name =
				string.lower(gui.Name)

			if name == "dropegg"
			or name:find(
				"dropegg",
				1,
				true
			) then

				return gui

			end
		end
	end

	return nil

end

--==============================================================--
-- DROP REAL DEL JUEGO
--==============================================================--

local function dropEgg()

	print("📦 SOLTANDO HUEVO...")

	-- Primero intentar botón
	local button =
		findDropButton()

	if button then

		print(
			"🟢 DropEgg encontrado:",
			button:GetFullName()
		)

		local activated = false

		pcall(function()

			button:Activate()

			activated = true

		end)

		if activated then

			task.wait(0.4)

			print(
				"✅ DropEgg activado"
			)

			return true

		end
	end

	--========================================================--
	-- REMOTE CONFIRMADO DEL JUEGO
	--========================================================--

	local packages =
		ReplicatedStorage:FindFirstChild(
			"Packages"
		)

	if packages then

		local networking =
			packages:FindFirstChild(
				"Networking"
			)

		if networking then

			local remote =
				networking:FindFirstChild(
					"RF/EggWorld/AskFieldEggDrop"
				)

			if remote
			and remote:IsA("RemoteFunction") then

				local success =
					pcall(function()

						remote:InvokeServer({
							Reason =
								"PlayerRequest"
						})

					end)

				if success then

					print(
						"✅ Drop enviado por Remote"
					)

					task.wait(0.5)

					return true

				end
			end
		end
	end

	warn(
		"❌ NO SE ENCONTRÓ EL SISTEMA DE DROP"
	)

	return false

end

--==============================================================--
-- BUSCAR BOTONES DE AGARRE
--==============================================================--

local function findGrabButtons()

	local buttons = {}

	for _, gui in ipairs(
		PlayerGui:GetDescendants()
	) do

		if gui:IsA("TextButton")
		or gui:IsA("ImageButton") then

			local name =
				string.lower(gui.Name)

			local text = ""

			if gui:IsA("TextButton") then
				text =
					string.lower(
						gui.Text or ""
					)
			end

			local combined =
				name .. " " .. text

			local found =
				combined:find(
					"grab",
					1,
					true
				)
				or combined:find(
					"pickup",
					1,
					true
				)
				or combined:find(
					"pick up",
					1,
					true
				)
				or combined:find(
					"collect",
					1,
					true
				)
				or combined:find(
					"take",
					1,
					true
				)
				or combined:find(
					"steal",
					1,
					true
				)
				or combined:find(
					"agarr",
					1,
					true
				)
				or combined:find(
					"tomar",
					1,
					true
				)
				or combined:find(
					"recoger",
					1,
					true
				)
				or combined:find(
					"coger",
					1,
					true
				)

			if found
			and gui.Visible then

				table.insert(
					buttons,
					gui
				)

			end
		end
	end

	return buttons

end

--==============================================================--
-- AGARRAR HUEVO
--==============================================================--

local function grabEgg(egg)

	if not egg then
		return false
	end

	local part =
		getPart(egg)

	if not part then
		return false
	end

	print(
		"✋ Intentando agarrar:",
		egg.Name
	)

	--========================================================--
	-- PROXIMITY PROMPTS
	--========================================================--

	for _, object in ipairs(
		egg:GetDescendants()
	) do

		if object:IsA(
			"ProximityPrompt"
		) then

			pcall(function()

				object:InputHoldBegin()

				task.wait(
					math.max(
						object.HoldDuration,
						0.05
					)
				)

				object:InputHoldEnd()

			end)

		end
	end

	--========================================================--
	-- BOTONES DE AGARRE
	--========================================================--

	task.wait(0.15)

	local buttons =
		findGrabButtons()

	for _, button in ipairs(buttons) do

		pcall(function()

			button:Activate()

		end)

	end

	task.wait(
		WAIT_AFTER_GRAB
	)

	--========================================================--
	-- COMPROBAR SI APARECIÓ DROPEGG
	--========================================================--

	if findDropButton() then

		print(
			"✅ HUEVO AGARRADO"
		)

		return true

	end

	print(
		"⚠️ No apareció DropEgg"
	)

	return false

end

--==============================================================--
-- ESPERAR HUEVO CERCA DEL CENTRO
--==============================================================--

local function findEggAtCenter()

	local started =
		os.clock()

	local closest = nil
	local closestDistance =
		math.huge

	while os.clock() - started
		< SEARCH_TIMEOUT do

		closest = nil
		closestDistance =
			math.huge

		for _, data in ipairs(
			getEggs()
		) do

			local distance =
				getDistance(
					data.Part.Position,
					CENTER
				)

			if distance <
				closestDistance then

				closestDistance =
					distance

				closest =
					data

			end
		end

		if closest then
			return closest
		end

		task.wait(0.15)

	end

	return nil

end

--==============================================================--
-- COMPROBAR PLOT
--==============================================================--

local ownerNames = {

	"Owner",
	"OwnerName",
	"Player",
	"PlayerName",
	"Username",
	"UserName",
	"UserId",
	"OwnerUserId"

}

local plotNames = {

	"Plot",
	"Plots",
	"Base",
	"Bases",
	"Tycoon",
	"Tycoons",
	"PlayerPlot",
	"MyPlot",
	"PlotBase",
	"PlotBycoon",
	"Bycoon",
	"BycoonPlot"

}

local function belongsToPlayer(object)

	for _, attributeName in ipairs(
		ownerNames
	) do

		local value =
			object:GetAttribute(
				attributeName
			)

		if value ~= nil then

			if tostring(value)
				== Player.Name then

				return true

			end

			if tostring(value)
				== tostring(
					Player.UserId
				) then

				return true

			end
		end
	end

	-- ObjectValue
	for _, child in ipairs(
		object:GetDescendants()
	) do

		if child:IsA("ObjectValue") then

			if child.Value == Player then
				return true
			end

		end
	end

	return false

end

--==============================================================--
-- ENCONTRAR MI PLOT
--==============================================================--

local function findMyPlot()

	-- Primero buscar nombres exactos
	for _, object in ipairs(
		workspace:GetDescendants()
	) do

		local name =
			string.lower(
				object.Name
			)

		for _, plotName in ipairs(
			plotNames
		) do

			if name ==
				string.lower(
					plotName
				) then

				if belongsToPlayer(
					object
				) then

					return object

				end
			end
		end
	end

	-- Segunda búsqueda:
	-- cualquier objeto que tenga Owner
	for _, object in ipairs(
		workspace:GetDescendants()
	) do

		if belongsToPlayer(
			object
		) then

			return object

		end
	end

	return nil

end

--==============================================================--
-- POSICIÓN DEL PLOT
--==============================================================--

local function getPlotPosition(plot)

	if not plot then
		return nil
	end

	local names = {

		"Spawn",
		"SpawnLocation",
		"PlotSpawn",
		"SpawnPoint",
		"EggSpawn",
		"EggDrop",
		"Drop",
		"DropPoint",
		"Home",
		"HomeSpawn"

	}

	for _, name in ipairs(names) do

		local object =
			plot:FindFirstChild(
				name,
				true
			)

		if object
		and object:IsA(
			"BasePart"
		) then

			return object.Position

		end
	end

	local part =
		plot:FindFirstChildWhichIsA(
			"BasePart",
			true
		)

	if part then
		return part.Position
	end

	return nil

end

--==============================================================--
-- ESPERAR QUE DROPEGG DESAPAREZCA
--==============================================================--

local function waitDropFinished()

	local started =
		os.clock()

	while os.clock() - started < 5 do

		local button =
			findDropButton()

		if not button
		or not button.Visible then

			return true

		end

		task.wait(0.1)

	end

	return true

end

--==============================================================--
-- PROCESO COMPLETO
--==============================================================--

local function RunEggSystem()

	print("")
	print("====================================")
	print("🥚 RIDE A PET - INICIANDO")
	print("====================================")

	--========================================================--
	-- PASO 1
	--========================================================--

	print(
		"🔎 Buscando mejor huevo..."
	)

	local best =
		findBestEgg()

	if not best then

		warn(
			"❌ No encontré huevos fuera de los 210 studs."
		)

		return

	end

	print(
		"🥚 MEJOR HUEVO:",
		best.Object.Name
	)

	print(
		"💰 VALOR:",
		best.Value
	)

	--========================================================--
	-- PASO 2
	--========================================================--

	print(
		"📍 TP AL MEJOR HUEVO"
	)

	teleport(
		best.Part.Position
	)

	task.wait(0.4)

	--========================================================--
	-- PASO 3
	--========================================================--

	print(
		"✋ AGARRANDO PRIMERA VEZ"
	)

	grabEgg(
		best.Object
	)

	task.wait(
		WAIT_AFTER_GRAB
	)

	--========================================================--
	-- PASO 4
	--========================================================--

	print(
		"📍 TP AL CENTRO"
	)

	teleport(
		CENTER
	)

	task.wait(1)

	--========================================================--
	-- PASO 5
	--========================================================--

	print(
		"📦 DROP EN CENTRO"
	)

	local firstDrop =
		dropEgg()

	if not firstDrop then

		warn(
			"❌ EL PRIMER DROP FALLÓ"
		)

		return

	end

	waitDropFinished()

	task.wait(
		WAIT_AFTER_DROP
	)

	--========================================================--
	-- PASO 6
	--========================================================--

	print(
		"🔎 BUSCANDO HUEVO DESPUÉS DEL DROP"
	)

	local centerEgg =
		findEggAtCenter()

	if not centerEgg then

		warn(
			"❌ No apareció el huevo después del drop."
		)

		return

	end

	print(
		"🥚 HUEVO ENCONTRADO:",
		centerEgg.Object.Name
	)

	--========================================================--
	-- PASO 7
	--========================================================--

	print(
		"📍 TP AL HUEVO"
	)

	teleport(
		centerEgg.Part.Position
	)

	task.wait(0.5)

	print(
		"✋ AGARRANDO SEGUNDA VEZ"
	)

	local grabbedAgain =
		grabEgg(
			centerEgg.Object
		)

	if not grabbedAgain then

		warn(
			"⚠️ No se pudo confirmar el segundo agarre."
		)

	end

	task.wait(
		WAIT_AFTER_GRAB
	)

	--========================================================--
	-- PASO 8
	--========================================================--

	print(
		"🏠 BUSCANDO TU PLOT"
	)

	local plot =
		findMyPlot()

	if not plot then

		warn(
			"❌ NO ENCONTRÉ TU PLOT"
		)

		return

	end

	print(
		"✅ TU PLOT:",
		plot:GetFullName()
	)

	--========================================================--
	-- PASO 9
	--========================================================--

	local plotPosition =
		getPlotPosition(
			plot
		)

	if not plotPosition then

		warn(
			"❌ No encontré la posición del plot."
		)

		return

	end

	print(
		"📍 POSICIÓN DEL PLOT:",
		plotPosition
	)

	--========================================================--
	-- PASO 10
	--========================================================--

	print(
		"🚀 MOVIENDO A VELOCIDAD 1000"
	)

	moveFast(
		plotPosition
			+ Vector3.new(
				0,
				3,
				0
			)
	)

	task.wait(0.8)

	--========================================================--
	-- PASO 11
	--========================================================--

	print(
		"📦 DROP FINAL EN EL PLOT"
	)

	local finalDrop =
		dropEgg()

	if finalDrop then

		print(
			"===================================="
		)

		print(
			"✅ TODO COMPLETADO"
		)

		print(
			"🥚 Huevo entregado en tu plot."
		)

		print(
			"===================================="
		)

	else

		warn(
			"❌ Falló el drop final."
		)

	end

end

--==============================================================--
-- INICIAR
--==============================================================--

task.spawn(function()

	task.wait(2)

	RunEggSystem()

end)
