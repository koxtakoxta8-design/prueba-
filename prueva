--------------------------------------------------
-- LUCK
--------------------------------------------------

local function LuckNumber(value)
    local text = tostring(value or "0")
    local number = tonumber(text:match("[%d%.]+")) or 0

    if text:find("T") then return number * 1e12 end
    if text:find("B") then return number * 1e9 end
    if text:find("M") then return number * 1e6 end
    if text:find("K") then return number * 1e3 end

    return number
end

--------------------------------------------------
-- DATOS DEL HUEVO
--------------------------------------------------

local function GetEggData(name)

    if EggData[name] then
        return EggData[name], name
    end

    local lower = tostring(name):lower()

    for eggName, data in pairs(EggData) do
        if lower:find(eggName:lower(), 1, true) then
            return data, eggName
        end
    end

    return nil
end

--------------------------------------------------
-- PARTE
--------------------------------------------------

local function GetPart(obj)

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then
        return obj.PrimaryPart
            or obj:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

--------------------------------------------------
-- BUSCAR MEJOR HUEVO
--------------------------------------------------

local function FindBestEgg()

    local bestEgg = nil
    local bestLuck = -1
    local detected = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do

        local data, realName = GetEggData(obj.Name)

        if data then

            local part = GetPart(obj)

            if part then

                detected += 1

                local luck = LuckNumber(data.Luck)

                if luck > bestLuck then

                    bestLuck = luck

                    bestEgg = {
                        Object = obj,
                        Part = part,
                        Name = realName,
                        Luck = data.Luck,
                        LuckNumber = luck,
                        Rarity = data.Rarity
                    }
                end
            end
        end
    end

    return bestEgg, detected
end

--------------------------------------------------
-- ROOT
--------------------------------------------------

local function GetRoot()

    local character = Player.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

--------------------------------------------------
-- CONGELAR
--------------------------------------------------

local function FreezeCharacter()

    local character = Player.Character
    local humanoid =
        character and character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    if humanoid:GetAttribute("KOXTA_Frozen") then
        return
    end

    humanoid:SetAttribute(
        "KOXTA_OldWalkSpeed",
        humanoid.WalkSpeed
    )

    humanoid:SetAttribute(
        "KOXTA_OldJumpPower",
        humanoid.JumpPower
    )

    humanoid:SetAttribute(
        "KOXTA_OldAutoRotate",
        humanoid.AutoRotate
    )

    humanoid:SetAttribute(
        "KOXTA_Frozen",
        true
    )

    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.AutoRotate = false

    -- Evita que una velocidad residual siga moviéndolo.
    local root = character:FindFirstChild("HumanoidRootPart")

    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

--------------------------------------------------
-- DESCONGELAR
--------------------------------------------------

local function UnfreezeCharacter()

    local character = Player.Character
    local humanoid =
        character and character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    local oldSpeed =
        humanoid:GetAttribute("KOXTA_OldWalkSpeed")

    local oldJump =
        humanoid:GetAttribute("KOXTA_OldJumpPower")

    local oldRotate =
        humanoid:GetAttribute("KOXTA_OldAutoRotate")

    humanoid.WalkSpeed = oldSpeed or 16
    humanoid.JumpPower = oldJump or 50

    if oldRotate == nil then
        humanoid.AutoRotate = true
    else
        humanoid.AutoRotate = oldRotate
    end

    humanoid:SetAttribute("KOXTA_Frozen", false)
end

--------------------------------------------------
-- TP AL HUEVO
--------------------------------------------------

local function TeleportToEgg(egg)

    local root = GetRoot()

    if not root or not egg or not egg.Part then
        return false
    end

    -- TP ligeramente encima del huevo.
    root.CFrame =
        egg.Part.CFrame * CFrame.new(0, 3, 0)

    -- Congelar inmediatamente.
    task.wait()

    FreezeCharacter()

    -- Eliminar cualquier velocidad residual.
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    return true
end

--------------------------------------------------
-- SPAWN
--------------------------------------------------

local function GetSpawnPosition()

    local spawn =
        Workspace:FindFirstChild("SpawnLocation", true)

    if spawn and spawn:IsA("BasePart") then
        return spawn.Position
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do

        if obj:IsA("SpawnLocation") then
            return obj.Position
        end
    end

    return nil
end

local function TeleportToSpawn()

    local root = GetRoot()
    local position = GetSpawnPosition()

    if not root or not position then
        return false
    end

    root.CFrame =
        CFrame.new(position + Vector3.new(0, 3, 0))

    return true
end

--------------------------------------------------
-- GRAB
--------------------------------------------------

local function GrabEgg(egg)

    if not egg then
        return false
    end

    -- Aquí debe conectarse el Remote oficial
    -- que utiliza tu propia experiencia para recoger/montar.
    print("GRAB:", egg.Name)

    return true
end

