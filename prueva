    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

--==============================================================
-- CAPTURAR EL SPAWN CORRECTO DE ENTRADA
--==============================================================

local EntrySpawnCFrame = nil
local EntrySpawnLocation = nil
local EntryCaptured = false

local function CaptureEntrySpawn(character)
    if EntryCaptured or not character then
        return
    end

    local root = character:WaitForChild("HumanoidRootPart", 15)
    if not root then
        return
    end

    -- Busca el SpawnLocation más cercano al personaje en el momento
    -- en que aparece. Con 2 spawns, toma el que realmente corresponde
    -- a la posición de entrada, no simplemente el primero encontrado.
    local closestSpawn = nil
    local closestDistance = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") and obj.Enabled then
            local distance = (obj.Position - root.Position).Magnitude

            if distance < closestDistance then
                closestDistance = distance
                closestSpawn = obj
            end
        end
    end

    if closestSpawn then
        EntrySpawnLocation = closestSpawn
        EntrySpawnCFrame = closestSpawn.CFrame + Vector3.new(0, 3, 0)
    else
        -- Fallback: si el juego no expone SpawnLocation, usa el punto
        -- exacto donde apareció el personaje.
        EntrySpawnCFrame = root.CFrame
    end

    EntryCaptured = true
end

