        Main.Position.X.Scale,
        Main.Position.X.Offset,
        Main.Position.Y.Scale,
        Main.Position.Y.Offset - 18
    )

    TweenService:Create(
        Main,
        TweenInfo.new(PANEL_TWEEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            Position = target,
