--==============================================================
-- CHARACTER
--==============================================================

local function Root()

    local Character = Player.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

--==============================================================
-- POSICIÓN
--==============================================================

local function PositionOf(Object)

    if Object:IsA("BasePart") then
        return Object.Position
    end

    if Object:IsA("Model") then

        if Object.PrimaryPart then
            return Object.PrimaryPart.Position
        end

        local Part =
            Object:FindFirstChildWhichIsA("BasePart",true)

        if Part then
            return Part.Position
        end
    end

    return nil
end

--==============================================================
-- ES HUEVO
--==============================================================

local function IsEgg(Object)

    local Name = Object.Name:lower()

    return
        Name:find("egg") ~= nil
        or Name:find("huevo") ~= nil
        or Object:GetAttribute("IsEgg") == true
end

--==============================================================
-- LUCK
--==============================================================

local function GetLuck(Object)

    for _,Name in ipairs({
        "Luck",
        "luck",
        "EggLuck",
        "RarityValue"
    }) do

        local Value = Object:GetAttribute(Name)

        if typeof(Value) == "number" then
            return Value
        end
    end

    for _,Child in ipairs(Object:GetDescendants()) do

        if Child:IsA("NumberValue")
        or Child:IsA("IntValue") then

            local N = Child.Name:lower()

            if N == "luck"
            or N == "eggluck"
            or N == "rarityvalue" then

                return Child.Value
            end
        end
    end

    return KnownLuck[Object.Name] or 0
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function BestEgg()

    local Result = nil
    local Highest = -math.huge

    for _,Object in ipairs(workspace:GetDescendants()) do

        if IsEgg(Object) then

            local Position = PositionOf(Object)

            if Position then

                -- El centro de la zona es fijo, NO el jugador.
                local DistanciaCentro =
                    (Position - CENTRO_ZONA).Magnitude

                -- Solo considerar huevos FUERA de 210 studs.
                if DistanciaCentro > RADIO_EXCLUSION then

                    local Value = GetLuck(Object)

                    if Value > Highest then

                        Highest = Value

                        Result = {
                            Object = Object,
                            Position = Position,
                            Luck = Value,
                            DistanciaCentro = DistanciaCentro
                        }
                    end
                end
            end
        end
    end

    return Result
end

