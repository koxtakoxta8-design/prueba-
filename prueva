--============================================================--
-- UTILIDADES
--============================================================--

local function getCharacter()

    return Player.Character
        or Player.CharacterAdded:Wait()

end

local function getRoot()

    local character = getCharacter()

    return character:FindFirstChild(
        "HumanoidRootPart"
    )

end

local function getPart(object)

    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    return object:FindFirstChildWhichIsA(
        "BasePart",
        true
    )

end

--============================================================--
-- DETECTAR HUEVO
--============================================================--

local function isEgg(object)

    if not object then
        return false
    end

    local name =
        string.lower(object.Name)

    if name:find("egg", 1, true) then
        return true
    end

    if name:find("huevo", 1, true) then
        return true
    end

    return false

end

--============================================================--
-- DISTANCIA AL CENTRO
--============================================================--

local function isExcluded(position)

    return (
        position - CENTER
    ).Magnitude <= EXCLUSION_RADIUS

end

--============================================================--
-- VALOR DEL HUEVO
--============================================================--

local function getEggValue(egg)

    if not egg then
        return 0
    end

    local value = 0

    local eggName =
        string.lower(egg.Name)

    -- Por nombre
    for name, amount in pairs(EggValues) do

        if eggName:find(
            string.lower(name),
            1,
            true
        ) then

            if amount > value then
                value = amount
            end

        end
    end

    -- NumberValue / IntValue
    for _, obj in ipairs(
        egg:GetDescendants()
    ) do

        if obj:IsA("NumberValue")
        or obj:IsA("IntValue") then

            local name =
                string.lower(obj.Name)

            if name:find("luck", 1, true)
            or name:find("value", 1, true)
            or name:find("worth", 1, true)
            or name:find("rarity", 1, true)
            or name:find("eggvalue", 1, true) then

                if obj.Value > value then
                    value = obj.Value
                end

            end
        end
    end

    -- Attributes
    local attributes = {
        "Luck",
        "Value",
        "Worth",
        "Rarity",
        "EggValue"
    }

    for _, attribute in ipairs(attributes) do

        local v =
            egg:GetAttribute(attribute)

        if typeof(v) == "number" then

            if v > value then
                value = v
            end

        end
    end

    return value

end

--============================================================--
-- BUSCAR MEJOR HUEVO
--============================================================--

local function findBestEgg()

    local bestEgg = nil
    local bestValue = -1

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if isEgg(object) then

            local part =
                getPart(object)

            if part then

                -- NO seleccionar huevos
                -- dentro de los 210 studs
                if not isExcluded(
                    part.Position
                ) then

                    local value =
                        getEggValue(object)

                    if value > bestValue then

                        bestValue =
                            value

                        bestEgg =
                            object

                    end
                end
            end
        end
    end

    return bestEgg, bestValue

end

--============================================================--
-- TELEPORT
--============================================================--

local function teleportTo(position)

    local root =
        getRoot()

    if not root then
        return false
    end

    root.CFrame =
        CFrame.new(position)

    return true

end

--============================================================--
-- MOVIMIENTO A 1000
--============================================================--

local function moveTo1000(position)

    local root =
        getRoot()

    if not root then
        return false
    end

    local startPosition =
        root.Position

    local distance =
        (
            position
            - startPosition
        ).Magnitude

    if distance <= 2 then

        root.CFrame =
            CFrame.new(position)

        return true

    end

    local duration =
        distance / PLOT_SPEED

    local startTime =
        os.clock()

    while true do

        root =
            getRoot()

        if not root then
            return false
        end

        local alpha =
            math.clamp(
                (
                    os.clock()
                    - startTime
                ) / duration,
                0,
                1
            )

        root.CFrame =
            CFrame.new(
                startPosition:Lerp(
                    position,
                    alpha
                )
            )

        if alpha >= 1 then
            break
        end

        RunService.Heartbeat:Wait()

    end

    return true

end

--============================================================--
--                 DROP ORIGINAL DEL USUARIO                 --
--============================================================--

local function triggerDropEggButton()

    -- Buscar dinámicamente el botón DropEgg
    local foundBtn = nil

    -- Búsqueda en PlayerGui
    for _, gui in ipairs(
        PlayerGui:GetDescendants()
    ) do

        if (
            gui:IsA("TextButton")
            or gui:IsA("ImageButton")
        )
        and (
            string.lower(gui.Name) == "dropegg"
            or string.find(
                string.lower(gui.Name),
                "dropegg",
                1,
                true
            )
        ) then

            foundBtn = gui
            break

        end
    end

    --========================================================--
    -- ESTE ES EL SISTEMA ORIGINAL
    --========================================================--

    if foundBtn then

        print(
            "🟢 DropEgg encontrado:"
        )

        print(
            foundBtn:GetFullName()
        )

        pcall(function()

            for _, conn in ipairs(
                getconnections(
                    foundBtn.MouseButton1Click
                )
            ) do

                conn:Fire()

            end

        end)

        pcall(function()

            for _, conn in ipairs(
                getconnections(
                    foundBtn.Activated
                )
            ) do

                conn:Fire()

            end

        end)

        print(
            "✅ DROP EJECUTADO"
        )

        return true

    else

        --====================================================--
        -- FALLBACK ORIGINAL
        --====================================================--

        local success =
            pcall(function()

                local packages =
                    ReplicatedStorage:FindFirstChild(
                        "Packages"
                    )

                if not packages then
                    return
                end

                local networking =
                    packages:FindFirstChild(
                        "Networking"
                    )

                if not networking then
                    return
                end

                local remote =
                    networking:FindFirstChild(
                        "RF/EggWorld/AskFieldEggDrop"
                    )

                if remote then

                    remote:InvokeServer({
                        Reason =
                            "PlayerRequest"
                    })

                    print(
                        "✅ DROP POR REMOTE"
                    )

                end

            end)

        return success

    end
end

--============================================================--
-- BUSCAR BOTONES DE AGARRE
--============================================================--

local function findGrabButtons()

    local buttons = {}

    local words = {

        "grab",
        "pickup",
        "pick up",
        "collect",
        "take",
        "steal",

        "agarrar",
        "agarr",
        "recoger",
        "coger",
        "tomar",
        "robar",

        "prendre",
        "ramasser",

        "nehmen",
        "aufheben",

        "prendere",
        "raccogliere",

        "pegar",
        "recolher"

    }

    for _, gui in ipairs(
        PlayerGui:GetDescendants()
    ) do

        if gui:IsA("TextButton")
        or gui:IsA("ImageButton") then

            local name =
                string.lower(gui.Name)

            local text = ""

            if gui:IsA("TextButton") then

                text =
                    string.lower(
                        gui.Text or ""
                    )

            end

            local combined =
                name .. " " .. text

            for _, word in ipairs(words) do

                if combined:find(
                    word,
                    1,
                    true
                ) then

                    if gui.Visible then

                        table.insert(
                            buttons,
                            gui
                        )

                    end

                    break

                end
            end
        end
    end

    return buttons

end

--============================================================--
-- AGARRAR HUEVO
--============================================================--

local function grabEgg(egg)

    if not egg then
        return false
    end

    local part =
        getPart(egg)

    if not part then
        return false
    end

    print(
        "✋ Intentando agarrar:",
        egg.Name
    )

    --========================================================--
    -- PROXIMITY PROMPT
    --========================================================--

    for _, obj in ipairs(
        egg:GetDescendants()
    ) do

        if obj:IsA(
            "ProximityPrompt"
        ) then

            pcall(function()

                obj:InputHoldBegin()

                task.wait(
                    math.max(
                        obj.HoldDuration,
                        0.05
                    )
                )

                obj:InputHoldEnd()

            end)

        end
    end

    --========================================================--
    -- BOTONES DE AGARRE
    --========================================================--

    task.wait(0.2)

    local buttons =
        findGrabButtons()

    for _, button in ipairs(buttons) do

        pcall(function()

            for _, conn in ipairs(
                getconnections(
                    button.MouseButton1Click
                )
            ) do

                conn:Fire()

            end

        end)

        pcall(function()

            for _, conn in ipairs(
                getconnections(
                    button.Activated
                )
            ) do

                conn:Fire()

            end

        end)

    end

    task.wait(
        WAIT_GRAB
    )

    --========================================================--
    -- COMPROBAR DROPEGG
    --========================================================--

    local dropButton =
        nil

    for _, gui in ipairs(
        PlayerGui:GetDescendants()
    ) do

        if gui:IsA("TextButton")
        or gui:IsA("ImageButton") then

            local name =
                string.lower(gui.Name)

            if name == "dropegg"
            or name:find(
                "dropegg",
                1,
                true
            ) then

                if gui.Visible then

                    dropButton =
                        gui

                    break

                end
            end
        end
    end

    if dropButton then

        print(
            "✅ HUEVO AGARRADO"
        )

        return true

    end

    print(
        "⚠️ No pude confirmar el agarre"
    )

    return false

end

--============================================================--
-- BUSCAR HUEVO CERCA DEL CENTRO
--============================================================--

local function findEggNearCenter()

    local startTime =
        os.clock()

    while (
        os.clock()
        - startTime
    ) < SEARCH_TIMEOUT do

        local closestEgg = nil
        local closestDistance =
            math.huge

        for _, object in ipairs(
            workspace:GetDescendants()
        ) do

            if isEgg(object) then

                local part =
                    getPart(object)

                if part then

                    local distance =
                        (
                            part.Position
                            - CENTER
                        ).Magnitude

                    if distance <
                        closestDistance then

                        closestDistance =
                            distance

                        closestEgg =
                            object

                    end
                end
            end
        end

        if closestEgg then
            return closestEgg
        end

        task.wait(0.15)

    end

    return nil

end

--============================================================--
-- DETECTAR PROPIETARIO DEL PLOT
--============================================================--

local function objectBelongsToPlayer(object)

    local attributes = {

        "Owner",
        "OwnerName",
        "Player",
        "PlayerName",
        "Username",
        "UserName",
        "UserId",
        "OwnerUserId"

    }

    for _, attribute in ipairs(attributes) do

        local value =
            object:GetAttribute(attribute)

        if value ~= nil then

            if tostring(value)
                == Player.Name then

                return true

            end

            if tostring(value)
                == tostring(
                    Player.UserId
                ) then

                return true

            end
        end
    end

    -- ObjectValue
    for _, child in ipairs(
        object:GetDescendants()
    ) do

        if child:IsA(
            "ObjectValue"
        ) then

            if child.Value == Player then
                return true
            end

        end
    end

    return false

end

--============================================================--
-- BUSCAR MI PLOT
--============================================================--

local function findMyPlot()

    local names = {

        "Plot",
        "Plots",

        "Base",
        "Bases",

        "Tycoon",
        "Tycoons",

        "PlayerPlot",
        "MyPlot",

        "PlotBase",
        "PlotBycoon",

        "Bycoon",
        "BycoonPlot"

    }

    -- Primera pasada:
    -- nombres de plot
    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        local objectName =
            string.lower(
                object.Name
            )

        for _, name in ipairs(names) do

            if objectName ==
                string.lower(name) then

                if objectBelongsToPlayer(
                    object
                ) then

                    return object

                end
            end
        end
    end

    -- Segunda pasada:
    -- cualquier objeto con propietario
    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if objectBelongsToPlayer(
            object
        ) then

            return object

        end
    end

    return nil

end

--============================================================--
-- POSICIÓN DEL PLOT
--============================================================--

local function getPlotPosition(plot)

    if not plot then
        return nil
    end

    local possibleParts = {

        "Spawn",
        "SpawnLocation",

        "PlotSpawn",
        "SpawnPoint",

        "EggSpawn",
        "EggDrop",

        "Drop",
        "DropPoint",

        "Home",
        "HomeSpawn",

        "PetSpawn"

    }

    for _, name in ipairs(
        possibleParts
    ) do

        local object =
            plot:FindFirstChild(
                name,
                true
            )

        if object
        and object:IsA(
            "BasePart"
        ) then

            return object.Position

        end
    end

    -- Fallback
    local part =
        plot:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if part then

        return part.Position

    end

    return nil

end

--============================================================--
-- ESPERAR QUE TERMINE EL DROP
--============================================================--

local function waitAfterDrop()

    task.wait(
        WAIT_DROP
    )

end

--============================================================--
-- PROCESO COMPLETO
--============================================================--

local function Start()

    print("")
    print(
        "========================================"
    )
    print(
        "🥚 RIDE A PET - AUTO EGG"
    )
    print(
        "========================================"
    )

    --========================================================--
    -- 1. BUSCAR MEJOR HUEVO
    --========================================================--

    print(
        "🔎 Buscando mejor huevo..."
    )

    local bestEgg, bestValue =
        findBestEgg()

    if not bestEgg then

        warn(
            "❌ No encontré ningún huevo."
        )

        return

    end

    local bestPart =
        getPart(bestEgg)

    if not bestPart then

        warn(
            "❌ El mejor huevo no tiene BasePart."
        )

        return

    end

    print(
        "🥚 HUEVO:",
        bestEgg.Name
    )

    print(
        "💰 VALOR:",
        bestValue
    )

    --========================================================--
    -- 2. TP AL HUEVO
    --========================================================--

    print(
        "📍 TP AL HUEVO"
    )

    teleportTo(
        bestPart.Position
    )

    task.wait(0.4)

    --========================================================--
    -- 3. AGARRAR
    --========================================================--

    print(
        "✋ AGARRANDO..."
    )

    grabEgg(
        bestEgg
    )

    task.wait(
        WAIT_GRAB
    )

    --========================================================--
    -- 4. TP AL CENTRO
    --========================================================--

    print(
        "📍 TP AL CENTRO"
    )

    teleportTo(
        CENTER
    )

    task.wait(1)

    --========================================================--
    -- 5. DROP ORIGINAL
    --========================================================--

    print(
        "📦 SOLTANDO EN CENTRO..."
    )

    local dropped =
        triggerDropEggButton()

    if not dropped then

        warn(
            "❌ NO SE PUDO HACER EL DROP"
        )

        return

    end

    waitAfterDrop()

    print(
        "✅ DROP TERMINADO"
    )

    --========================================================--
    -- 6. BUSCAR HUEVO OTRA VEZ
    --========================================================--

    print(
        "🔎 Buscando huevo nuevamente..."
    )

    local newEgg =
        findEggNearCenter()

    if not newEgg then

        warn(
            "❌ No encontré el huevo después del drop."
        )

        return

    end

    local newPart =
        getPart(newEgg)

    if not newPart then

        warn(
            "❌ El huevo nuevo no tiene parte."
        )

        return

    end

    print(
        "🥚 HUEVO NUEVO:",
        newEgg.Name
    )

    --========================================================--
    -- 7. TP AL HUEVO NUEVO
    --========================================================--

    print(
        "📍 TP AL HUEVO NUEVO"
    )

    teleportTo(
        newPart.Position
    )

    task.wait(0.4)

    --========================================================--
    -- 8. AGARRAR NUEVAMENTE
    --========================================================--

    print(
        "✋ AGARRANDO NUEVAMENTE..."
    )

    local grabbedAgain =
        grabEgg(
            newEgg
        )

    if not grabbedAgain then

        warn(
            "⚠️ No se pudo confirmar el segundo agarre."
        )

    end

    task.wait(
        WAIT_GRAB
    )

    --========================================================--
    -- 9. BUSCAR PLOT
    --========================================================--

    print(
        "🏠 Buscando TU plot..."
    )

    local plot =
        findMyPlot()

    if not plot then

        warn(
            "❌ NO ENCONTRÉ TU PLOT."
        )

        return

    end

    print(
        "✅ PLOT:",
        plot:GetFullName()
    )

    --========================================================--
    -- 10. POSICIÓN PLOT
    --========================================================--

    local plotPosition =
        getPlotPosition(
            plot
        )

    if not plotPosition then

        warn(
            "❌ No encontré la posición del plot."
        )

        return

    end

    print(
        "🏠 POSICIÓN:",
        plotPosition
    )

    --========================================================--
    -- 11. IR AL PLOT A 1000
    --========================================================--

    print(
        "🚀 MOVIENDO A VELOCIDAD 1000..."
    )

    moveTo1000(
        plotPosition
        + Vector3.new(
            0,
            3,
            0
        )
    )

    task.wait(0.8)

    --========================================================--
    -- 12. DROP FINAL ORIGINAL
    --========================================================--

    print(
        "📦 SOLTANDO EN TU PLOT..."
    )

    local finalDrop =
        triggerDropEggButton()

    if finalDrop then

        print("")
        print(
            "========================================"
        )
        print(
            "✅ COMPLETADO"
        )
        print(
            "🥚 HUEVO ENTREGADO EN EL PLOT"
        )
        print(
            "========================================"
        )

    else

        warn(
            "❌ EL DROP FINAL FALLÓ."
        )

    end

end

