--// RIDE A PET - AUTO BEST EGG
--// SINGLE LOCAL SCRIPT
--// ON / OFF
--// BEST EGG -> GRAB -> CONFIRM -> CENTER -> DROP
--// -> FIND EGG -> GRAB -> CONFIRM -> PLOT @ 500

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local Player = Players.LocalPlayer

local CENTER = Vector3.new(146.87, 40316.12, 911.14)
local EXCLUSION_RADIUS = 210
local PLOT_SPEED = 500

local Enabled = false
local Busy = false

--------------------------------------------------
-- EGG VALUES
--------------------------------------------------

local EggValues = {
	["White Egg"] = 1,
	["Brown Egg"] = 5,
	["Cracked Egg"] = 30,
	["Easter Egg"] = 50,
	["Stone Egg"] = 100,
	["Leaf Egg"] = 200,
	["Mushroom Egg"] = 500,
	["Flower Egg"] = 750,
	["Slime Egg"] = 1000,
	["Ice Egg"] = 3000,
	["Glass Egg"] = 10000,
	["Golden Egg"] = 30000,
	["Crystal Egg"] = 150000,
	["Skull Egg"] = 250000,
	["Dominus Egg"] = 700000,
	["Flaming Egg"] = 1000000,
	["Sinister Egg"] = 3000000,
	["Soul Egg"] = 7000000,
	["Aurora Egg"] = 300000000,
	["Galaxy Egg"] = 1500000000,
	["Blackhole Egg"] = 100000000000,
	["Solaris Egg"] = 300000000000,
	["Cherub Egg"] = 1000000000000,
	["Volcanic Egg"] = 2500000000000,
}

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

local function getCharacter()
	local Character = Player.Character
	if not Character then
		return nil, nil
	end

	return Character, Character:FindFirstChild("HumanoidRootPart")
end

--------------------------------------------------
-- EGG POSITION
--------------------------------------------------

local function getPosition(Object)
	if not Object or not Object.Parent then
		return nil
	end

	if Object:IsA("BasePart") then
		return Object.Position
	end

	if Object:IsA("Model") then
		return Object:GetPivot().Position
	end

	local Part = Object:FindFirstChildWhichIsA("BasePart", true)
	return Part and Part.Position
end

--------------------------------------------------
-- EGG VALUE
--------------------------------------------------

local function getValue(Egg)
	if EggValues[Egg.Name] then
		return EggValues[Egg.Name]
	end

	local Name = Egg:GetAttribute("EggName")

	if typeof(Name) == "string" then
		return EggValues[Name]
	end

	return nil
end

--------------------------------------------------
-- CENTER EXCLUSION
--------------------------------------------------

local function forbidden(Position)
	return (Position - CENTER).Magnitude <= EXCLUSION_RADIUS
end

--------------------------------------------------
-- FIND BEST EGG
--------------------------------------------------

local function findBestEgg()

	local Best = nil
	local BestValue = -math.huge

	for _, Object in ipairs(workspace:GetDescendants()) do

		if not Enabled then
			return nil
		end

		local Value = getValue(Object)

		if Value then

			local Position = getPosition(Object)

			if Position and not forbidden(Position) then

				if Value > BestValue then
					Best = Object
					BestValue = Value
				end
			end
		end
	end

	return Best
end

--------------------------------------------------
-- TP
--------------------------------------------------

local function teleport(Position)

	if not Enabled then
		return false
	end

	local Character, Root = getCharacter()

	if not Character or not Root then
		return false
	end

	Character:PivotTo(
		CFrame.new(Position + Vector3.new(0, 3, 0))
	)

	return true
end

--------------------------------------------------
-- FIND GRAB PROMPT
--------------------------------------------------

local GrabWords = {
	"grab",
	"pickup",
	"pick up",
	"collect",
	"take",
	"get",
	"recoger",
	"agarrar",
	"tomar",
	"coger",
	"levantar",
}

local function findGrabPrompt(Egg)

	if not Egg or not Egg.Parent then
		return nil
	end

	for _, Object in ipairs(Egg:GetDescendants()) do

		if Object:IsA("ProximityPrompt") then

			local Text = string.lower(
				tostring(Object.Name) .. " " ..
				tostring(Object.ActionText) .. " " ..
				tostring(Object.ObjectText)
			)

			for _, Word in ipairs(GrabWords) do

				if string.find(Text, Word, 1, true) then
					return Object
				end
			end
		end
	end

	return nil
end

--------------------------------------------------
-- GRAB
--------------------------------------------------

local function grab(Egg)

	local Prompt = findGrabPrompt(Egg)

	if not Prompt then
		return false
	end

	pcall(function()
		Prompt.HoldDuration = 0
	end)

	pcall(function()
		Prompt:InputHoldBegin()
		task.wait()
		Prompt:InputHoldEnd()
	end)

	return true
end

--------------------------------------------------
-- CHECK IF EGG IS NOW CARRIED
--------------------------------------------------

local function carriedEggFound()

	local Character = Player.Character

	if not Character then
		return false
	end

	-- Atributos si el juego los usa
	if Character:GetAttribute("HoldingEgg") == true then
		return true
	end

	if Player:GetAttribute("HoldingEgg") == true then
		return true
	end

	-- Huevo convertido en objeto del personaje
	for _, Object in ipairs(Character:GetDescendants()) do

		if getValue(Object) then
			return true
		end

		if Object:GetAttribute("IsEgg") == true then
			return true
		end

		if Object:GetAttribute("HoldingEgg") == true then
			return true
		end
	end

	return false
end

--------------------------------------------------
-- CONFIRM GRAB
--------------------------------------------------

local function confirmGrab(Egg)

	-- Primera comprobación
	if carriedEggFound() then
		return true
	end

	-- Comprobar si el huevo original dejó de estar
	-- en su posición original después del grab.
	local OldPosition = getPosition(Egg)

	for _ = 1, 30 do

		if not Enabled then
			return false
		end

		if carriedEggFound() then
			return true
		end

		if not Egg.Parent then
			return true
		end

		local NewPosition = getPosition(Egg)

		if OldPosition and NewPosition then

			local Character, Root = getCharacter()

			if Root and (NewPosition - Root.Position).Magnitude < 15 then
				return true
			end
		end

		task.wait(0.05)
	end

	return carriedEggFound()
end

--------------------------------------------------
-- GRAB + CONFIRM + RETRY
--------------------------------------------------

local function grabAndConfirm(Egg)

	for _ = 1, 50 do

		if not Enabled then
			return false
		end

		if carriedEggFound() then
			return true
		end

		grab(Egg)

		if confirmGrab(Egg) then
			return true
		end

		task.wait(0.05)
	end

	return carriedEggFound()
end

--------------------------------------------------
-- DROP EGG
--------------------------------------------------

local function dropEgg()

	if not Enabled then
		return false
	end

	local PlayerGui = Player:FindFirstChild("PlayerGui")

	if not PlayerGui then
		return false
	end

	for _, Gui in ipairs(PlayerGui:GetDescendants()) do

		if
			(Gui:IsA("TextButton") or Gui:IsA("ImageButton"))
			and (
				string.lower(Gui.Name) == "dropegg"
				or string.find(
					string.lower(Gui.Name),
					"dropegg",
					1,
					true
				)
			)
		then

			pcall(function()
				Gui:Activate()
			end)

			return true
		end
	end

	return false
end

--------------------------------------------------
-- WAIT UNTIL DROPPED
--------------------------------------------------

local function waitDrop()

	for _ = 1, 30 do

		if not Enabled then
			return false
		end

		if not carriedEggFound() then
			return true
		end

		task.wait(0.05)
	end

	return not carriedEggFound()
end

--------------------------------------------------
-- FIND MY PLOT
--------------------------------------------------

local function findMyPlot()

	for _, Object in ipairs(workspace:GetDescendants()) do

		if not Enabled then
			return nil
		end

		if Object:IsA("Model") or Object:IsA("Folder") then

			local Attributes = {
				"Owner",
				"OwnerName",
				"Player",
				"PlayerName",
				"Username",
				"UserName",
			}

			for _, Attribute in ipairs(Attributes) do

				local Value = Object:GetAttribute(Attribute)

				if Value == Player.Name
					or Value == Player.DisplayName then

					return Object
				end
			end

			local UserId =
				Object:GetAttribute("UserId")
				or Object:GetAttribute("OwnerUserId")

			if tonumber(UserId) == Player.UserId then
				return Object
			end
		end
	end

	return nil
end

--------------------------------------------------
-- PLOT POSITION
--------------------------------------------------

local function getPlotPosition(Plot)

	if not Plot then
		return nil
	end

	for _, Name in ipairs({
		"Spawn",
		"SpawnLocation",
		"EggDrop",
		"DropEgg",
		"Drop",
		"Base",
	}) do

		local Object = Plot:FindFirstChild(Name, true)

		if Object then

			if Object:IsA("BasePart") then
				return Object.Position
			end

			if Object:IsA("Model") then
				return Object:GetPivot().Position
			end
		end
	end

	if Plot:IsA("Model") then
		return Plot:GetPivot().Position
	end

	return nil
end

--------------------------------------------------
-- MOVE 500 STUDS/S
--------------------------------------------------

local function moveToPlot(Destination)

	local Character, Root = getCharacter()

	if not Character or not Root then
		return false
	end

	local Start = Root.Position
	local Distance = (Destination - Start).Magnitude

	if Distance <= 1 then
		return true
	end

	local Duration = Distance / PLOT_SPEED
	local Started = os.clock()

	while Enabled do

		local Alpha = math.clamp(
			(os.clock() - Started) / Duration,
			0,
			1
		)

		Character:PivotTo(
			CFrame.new(
				Start:Lerp(Destination, Alpha)
			)
		)

		if Alpha >= 1 then
			return true
		end

		RunService.Heartbeat:Wait()
	end

	return false
end

--------------------------------------------------
-- MAIN
--------------------------------------------------

local function Main()

	if Busy then
		return
	end

	Busy = true

	while Enabled do

		-- ==========================================
		-- 1. MEJOR HUEVO
		-- ==========================================

		local Egg = findBestEgg()

		if not Egg then
			task.wait(0.2)
			continue
		end

		local Position = getPosition(Egg)

		if not Position then
			continue
		end

		-- ==========================================
		-- 2. TP AL MEJOR HUEVO
		-- ==========================================

		teleport(Position)

		task.wait()

		-- ==========================================
		-- 3. GRAB + CONFIRMAR
		-- ==========================================

		local Grabbed = grabAndConfirm(Egg)

		-- Si NO lo agarró:
		-- NO va al centro.
		if not Grabbed then
			continue
		end

		-- ==========================================
		-- 4. TP CENTRO
		-- ==========================================

		teleport(CENTER)

		task.wait()

		-- ==========================================
		-- 5. DROP
		-- ==========================================

		dropEgg()

		waitDrop()

		task.wait(0.15)

		-- ==========================================
		-- 6. BUSCAR HUEVO NUEVAMENTE
		-- ==========================================

		local Egg2

		for _ = 1, 40 do

			if not Enabled then
				break
			end

			Egg2 = findBestEgg()

			if Egg2 then
				break
			end

			task.wait(0.05)
		end

		if not Egg2 then
			continue
		end

		local Position2 = getPosition(Egg2)

		if not Position2 then
			continue
		end

		-- NUNCA recoger dentro de 210
		if forbidden(Position2) then
			continue
		end

		-- ==========================================
		-- 7. TP AL SEGUNDO HUEVO
		-- ==========================================

		teleport(Position2)

		task.wait()

		-- ==========================================
		-- 8. GRAB + CONFIRMAR
		-- ==========================================

		local Grabbed2 = grabAndConfirm(Egg2)

		if not Grabbed2 then
			continue
		end

		-- ==========================================
		-- 9. BUSCAR MI PLOT
		-- ==========================================

		local Plot = findMyPlot()

		if not Plot then
			task.wait(0.2)
			continue
		end

		local PlotPosition = getPlotPosition(Plot)

		if not PlotPosition then
			continue
		end

		-- ==========================================
		-- 10. IR A 500 STUDS/S
		-- ==========================================

		if not moveToPlot(PlotPosition) then
			break
		end

		-- ==========================================
		-- 11. DROP FINAL
		-- ==========================================

		if Enabled and carriedEggFound() then
			dropEgg()
		end

		waitDrop()

		task.wait(0.2)
	end

	Busy = false
end

