local Lines = {}

local function CreateMotionLine(
    angle,
    radius,
    length
)

    local line =
        Instance.new("Frame")

    line.AnchorPoint =
        Vector2.new(
            0.5,
            0.5
        )

    line.Size =
        UDim2.fromOffset(
            length,
            2
        )

    line.Position =
        UDim2.new(
            0.5,
            math.cos(angle) * radius,
            0.5,
            math.sin(angle) * radius
        )

    line.Rotation =
        math.deg(angle)

    line.BackgroundColor3 =
        Color3.fromRGB(
            150,
            150,
            155
        )

    line.BackgroundTransparency =
        0.25

    line.BorderSizePixel = 0

    line.ZIndex = 0

    line.Parent =
        MotionLayer

    local corner =
        Instance.new("UICorner")

    corner.CornerRadius =
        UDim.new(
            1,
            0
        )

    corner.Parent =
        line

    table.insert(
        Lines,
        {
            Object = line,
            Angle = angle,
            Radius = radius,
            Speed = math.random(
                20,
                55
            ) / 100,
            Alpha = math.random(
                10,
                45
            ) / 100
        }
    )

end

for i = 1, 18 do

    CreateMotionLine(
        math.rad(
            (360 / 18) * i
        ),
        math.random(
            155,
            190
        ),
        math.random(
            35,
            90
        )
    )

end

--==============================================================
-- ANIMACIÓN DE LÍNEAS
--==============================================================

local MotionConnection

MotionConnection =
    RunService.RenderStepped:Connect(
        function(delta)

            if not Main.Parent then

                if MotionConnection then
                    MotionConnection:Disconnect()
                end

                return
            end

            for _, info in ipairs(
                Lines
            ) do

                info.Angle +=
                    info.Speed *
                    delta

                local line =
                    info.Object

                local radius =
                    info.Radius +
                    math.sin(
                        tick() *
                        1.5 +
                        info.Angle
                    ) *
                    7

                line.Position =
                    UDim2.new(
                        0.5,
                        math.cos(
                            info.Angle
                        ) * radius,

                        0.5,
                        math.sin(
                            info.Angle
                        ) * radius
                    )

                line.Rotation =
                    math.deg(
                        info.Angle
                    )

                line.BackgroundTransparency =
                    0.25 +
                    math.sin(
                        tick() * 2 +
                        info.Angle
                    ) *
                    0.15

            end

        end
    )

