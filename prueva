--==============================================================
-- TELEPORT AL HUEVO
--==============================================================

local function TeleportToEgg(Egg)

    local Root =
        GetRoot()

    local Part =
        Egg and GetPart(Egg)

    if not Root or not Part then
        return false
    end

    Root.CFrame =
        CFrame.new(
            Part.Position +
            Vector3.new(
                0,
                2.5,
                0
            )
        )

    Root.AssemblyLinearVelocity =
        Vector3.zero

    Root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

--==============================================================
-- REGRESAR AL SPAWN
--==============================================================

local function ReturnSpawn()

    local Root =
        GetRoot()

    if Root and SavedSpawn then

        Root.CFrame =
            SavedSpawn

        Root.AssemblyLinearVelocity =
            Vector3.zero

        Root.AssemblyAngularVelocity =
            Vector3.zero

    end
end

--==============================================================
-- CONGELAR
--==============================================================

local function Freeze()

    local Character =
        Player.Character

    if not Character then
        return
    end

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if Humanoid then

        Humanoid.AutoRotate = false
        Humanoid.WalkSpeed = 0
        Humanoid.JumpPower = 0
        Humanoid.JumpHeight = 0

    end

    if Root then

        Root.AssemblyLinearVelocity =
            Vector3.zero

        Root.AssemblyAngularVelocity =
            Vector3.zero

    end
end

--==============================================================
-- DESCONGELAR
--==============================================================

local function Unfreeze()

    local Character =
        Player.Character

    if not Character then
        return
    end

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if Humanoid then

        Humanoid.AutoRotate = true
        Humanoid.WalkSpeed = 16
        Humanoid.JumpPower = 50
        Humanoid.JumpHeight = 7.2

    end
end

--==============================================================
-- BUSCAR PROXIMITY PROMPT
--==============================================================

local function FindPrompt(Egg)

    if not Egg then
        return nil
    end

    for _,Object in ipairs(
        Egg:GetDescendants()
    ) do

        if Object:IsA(
            "ProximityPrompt"
        ) then

            return Object

        end
    end

    return nil
end

--==============================================================
-- AUTO GRAB x3
--==============================================================

local function AutoGrab(Egg)

    local Prompt =
        FindPrompt(Egg)

    if not Prompt then
        return false
    end

    Freeze()

    pcall(function()
        Prompt.HoldDuration = 0
    end)

    for i = 1, 3 do

        if not InstaTP then
            break
        end

        pcall(function()
            Prompt:InputHoldBegin()
        end)

        task.wait(
            0.08
        )

        pcall(function()
            Prompt:InputHoldEnd()
        end)

        task.wait(
            0.08
        )
    end

    return true
end

