local function TP(Position)

    local Character = Player.Character
    local RootPart = Root()

    if not Character or not RootPart then
        return false
    end

    RootPart.CFrame =
        CFrame.new(Position + Vector3.new(0,3,0))

    return true
end

--==============================================================
-- BUSCAR PROMPT
--==============================================================

local function FindPrompt(Egg)

    if not Egg then
        return nil
    end

    if Egg:IsA("ProximityPrompt") then
        return Egg
    end

    local Prompt =
        Egg:FindFirstChildWhichIsA(
            "ProximityPrompt",
            true
        )

    if Prompt then
        return Prompt
    end

    return nil
end

--==============================================================
-- RECOGER
--==============================================================

local function CollectEgg(Egg)

    Status.Text = "Estado: AUTO GRAB x5"

    local Prompt = FindPrompt(Egg.Object)

    if not Prompt then
        return false
    end

    if not Prompt.Enabled then
        return false
    end

    local Success = false

    for i = 1, AUTO_GRAB_BURST do

        if not AUTO then
            break
        end

        Status.Text =
            "Estado: AUTO GRAB " .. i .. "/5"

        pcall(function()
            Prompt:InputHoldBegin()
        end)

        task.wait(
            math.max(
                Prompt.HoldDuration,
                0.03
            )
        )

        pcall(function()
            Prompt:InputHoldEnd()
        end)

        Success = true

        task.wait(0.04)
    end

    return Success
end

--==============================================================
-- OWNER
--==============================================================

local function IsMine(Object)

    for _,Name in ipairs({
        "Owner",
        "owner",
        "OwnerName",
        "ownerName"
    }) do

        local Attribute = Object:GetAttribute(Name)

        if Attribute ~= nil then

            if tostring(Attribute) == Player.Name
            or tostring(Attribute) == tostring(Player.UserId) then

                return true
            end
        end

        local Value =
            Object:FindFirstChild(Name,true)

        if Value then

            if Value:IsA("StringValue")
            and Value.Value == Player.Name then
                return true
            end

            if Value:IsA("ObjectValue")
            and Value.Value == Player then
                return true
            end

            if Value:IsA("IntValue")
            and Value.Value == Player.UserId then
                return true
            end
        end
    end

    return false
end

--==============================================================
-- BUSCAR MI PLOT
--==============================================================

local function FindMyPlot()

    local Containers = {
        workspace:FindFirstChild("Plots"),
        workspace:FindFirstChild("plots"),
        workspace:FindFirstChild("Bases"),
        workspace:FindFirstChild("bases"),
    }

    local function OwnerMatches(Value)

        if Value == nil then
            return false
        end

        if typeof(Value) == "Instance" then
            return Value == Player
        end

        local S = tostring(Value)

        return S == Player.Name
            or S == Player.DisplayName
            or S == tostring(Player.UserId)
    end

    local function HasOwner(Object)

        -- Atributos Owner
        for Name,Value in pairs(Object:GetAttributes()) do

            local N = string.lower(tostring(Name))

            if N == "owner"
            or N == "ownername"
            or N == "player"
            or N == "playername"
            or N == "username"
            or N == "userid"
            or N == "owneruserid" then

                if OwnerMatches(Value) then
                    return true
                end
            end
        end

        -- Values llamados Owner/Player/etc.
        for _,ValueObject in ipairs(Object:GetDescendants()) do

            local N = string.lower(ValueObject.Name)

            if N == "owner"
            or N == "ownername"
            or N == "player"
            or N == "playername"
            or N == "username"
            or N == "userid"
            or N == "owneruserid" then

                if ValueObject:IsA("ObjectValue") then

                    if ValueObject.Value == Player then
                        return true
                    end

                elseif ValueObject:IsA("StringValue")
                or ValueObject:IsA("IntValue")
                or ValueObject:IsA("NumberValue") then

                    if OwnerMatches(ValueObject.Value) then
                        return true
                    end
                end
            end
        end

        return false
    end

    local function FindSpawn(PlotObject)

        local Names = {
            "Spawn",
            "PlotSpawn",
            "SpawnLocation",
            "Respawn",
            "PlayerSpawn",
            "HomeSpawn",
            "BaseSpawn",
            "SpawnPoint",
            "SpawnPart",
            "PlayerSpawnLocation",
            "Home",
            "HomePoint"
        }

        for _,Name in ipairs(Names) do

            local Object =
                PlotObject:FindFirstChild(Name,true)

            if Object and Object:IsA("BasePart") then
                return Object
            end
        end

        for _,Object in ipairs(PlotObject:GetDescendants()) do

            if Object:IsA("SpawnLocation") then
                return Object
            end

            if Object:IsA("BasePart") then

                local N = Object.Name:lower()

                if N:find("spawn",1,true)
                or N:find("respawn",1,true) then

                    return Object
                end
            end
        end

        return nil
    end

    -- Primero revisar los contenedores de plots/bases.
    for _,Container in ipairs(Containers) do

        if Container then

            for _,Candidate in ipairs(Container:GetChildren()) do

                if HasOwner(Candidate) then

                    local Spawn =
                        FindSpawn(Candidate)

                    local Position

                    if Spawn then
                        Position = Spawn.Position
                    else
                        Position = PositionOf(Candidate)
                    end

                    if Position then
                        return Candidate,Position,Spawn
                    end
                end
            end
        end
    end

    -- Respaldo: buscar cualquier objeto que tenga Owner.
    for _,Object in ipairs(workspace:GetDescendants()) do

        if HasOwner(Object) then

            local Candidate = Object

            for _ = 1,6 do

                local Parent = Candidate.Parent

                if not Parent
                or Parent == workspace then
                    break
                end

                if Parent:IsA("Model")
                or Parent:IsA("Folder") then

                    Candidate = Parent
                else
                    break
                end
            end

            local Spawn =
                FindSpawn(Candidate)

            local Position

            if Spawn then
                Position = Spawn.Position
            else
                Position = PositionOf(Candidate)
            end

            if Position then
                return Candidate,Position,Spawn
            end
        end
    end

    return nil
end

--==============================================================
-- SECUENCIA COMPLETA
--==============================================================

local function Run()

    if BUSY or not AUTO then
        return
    end

    BUSY = true

    local Egg = BestEgg()

    if not Egg then

        Status.Text = "Estado: NO HAY HUEVOS"
        BUSY = false
        return
    end

    Best.Text =
        "🏆 Mejor: " .. Egg.Object.Name

    Luck.Text =
        "Luck: " .. tostring(Egg.Luck)

    -- 1. IR AL HUEVO
    Status.Text = "Estado: TP AL HUEVO"

    TP(Egg.Position)

    task.wait(.15)

    -- 2. RECOGER
    CollectEgg(Egg)

    task.wait(.25)

    -- 3. BUSCAR PLOT
    Status.Text = "Estado: BUSCANDO MI PLOT"

    local MyPlot,PlotPosition,PlotSpawn =
        FindMyPlot()

    if not MyPlot then

        Plot.Text = "Plot: NO ENCONTRADO"
        Status.Text = "Estado: ERROR PLOT"

        BUSY = false
        return
    end

    Plot.Text =
        PlotSpawn
        and "Plot: ENCONTRADO • SPAWN"
        or "Plot: ENCONTRADO"

    -- 4. VOLVER AL SPAWN DE MI PLOT
    Status.Text =
        PlotSpawn
        and "Estado: TP AL SPAWN"
        or "Estado: TP AL PLOT"

    TP(PlotPosition)

    task.wait(.3)

    Status.Text = "Estado: COMPLETADO"

    BUSY = false
end

