--// RIDE A PET - BEST EGG ROUTE
--// HUEVO -> CENTRO -> SOLTAR -> AGARRAR -> PLOT
--// Desplazamiento al plot: 1000

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

--==================================================
-- CONFIG
--==================================================

local CENTER = Vector3.new(
    146.87,
    40316.12,
    911.14
)

local EXCLUSION_RADIUS = 210
local PLOT_SPEED = 1000

--==================================================
-- VALORES DE HUEVOS
--==================================================

local EggValues = {
    ["White Egg"] = 1,
    ["Brown Egg"] = 5,
    ["Cracked Egg"] = 30,
    ["Easter Egg"] = 50,
    ["Stone Egg"] = 100,
    ["Leaf Egg"] = 200,
    ["Mushroom Egg"] = 500,
    ["Flower Egg"] = 750,
    ["Slime Egg"] = 1000,
    ["Ice Egg"] = 3000,
    ["Glass Egg"] = 10000,
    ["Golden Egg"] = 30000,
    ["Crystal Egg"] = 150000,
    ["Skull Egg"] = 250000,
    ["Dominus Egg"] = 700000,
    ["Flaming Egg"] = 1000000,
    ["Sinister Egg"] = 3000000,
    ["Soul Egg"] = 7000000,
    ["Aurora Egg"] = 300000000,
    ["Galaxy Egg"] = 1500000000,
    ["Blackhole Egg"] = 100000000000,
    ["Solaris Egg"] = 300000000000,
    ["Cherub Egg"] = 1000000000000,
    ["Volcanic Egg"] = 2500000000000
}

--==================================================
-- CHARACTER
--==================================================

local function GetRoot()
    local character =
        Player.Character
        or Player.CharacterAdded:Wait()

    return character:FindFirstChild(
        "HumanoidRootPart"
    )
end

--==================================================
-- DISTANCIA AL CENTRO
--==================================================

local function IsInsideCenter(position)
    return (
        position - CENTER
    ).Magnitude <= EXCLUSION_RADIUS
end

--==================================================
-- DETECTAR HUEVO
--==================================================

local function IsEgg(object)

    local name =
        object.Name:lower()

    return name:find("egg")
        ~= nil
        or name:find("huevo")
        ~= nil
end

--==================================================
-- PARTE DEL HUEVO
--==================================================

local function GetEggPart(egg)

    if egg:IsA("BasePart") then
        return egg
    end

    return egg:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

--==================================================
-- VALOR DEL HUEVO
--==================================================

local function GetEggValue(egg)

    local name =
        egg.Name:lower()

    local value = 0

    for eggName, eggValue in pairs(EggValues) do

        if name:find(
            eggName:lower(),
            1,
            true
        ) then

            value =
                math.max(
                    value,
                    eggValue
                )
        end
    end

    -- Valores internos
    for _, object in ipairs(
        egg:GetDescendants()
    ) do

        if object:IsA("NumberValue")
            or object:IsA("IntValue") then

            local n =
                object.Name:lower()

            if n:find("luck")
                or n:find("value")
                or n:find("worth") then

                value =
                    math.max(
                        value,
                        object.Value
                    )
            end
        end
    end

    return value
end

--==================================================
-- BUSCAR MEJOR HUEVO
--==================================================

local function FindBestEgg()

    local bestEgg = nil
    local bestValue = -1

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if IsEgg(object) then

            local part =
                GetEggPart(object)

            if part
                and not IsInsideCenter(
                    part.Position
                ) then

                local value =
                    GetEggValue(object)

                if value > bestValue then

                    bestValue = value
                    bestEgg = object

                end
            end
        end
    end

    return bestEgg, bestValue
end

--==================================================
-- TP DIRECTO
--==================================================

local function TeleportTo(position)

    local root = GetRoot()

    if not root then
        return false
    end

    root.CFrame =
        CFrame.new(position)

    return true
end

--==================================================
-- DESPLAZAMIENTO A 1000
--==================================================

local function MoveTo(position)

    local root = GetRoot()

    if not root then
        return false
    end

    local start =
        root.Position

    local distance =
        (position - start).Magnitude

    if distance <= 1 then
        root.CFrame =
            CFrame.new(position)

        return true
    end

    local duration =
        distance / PLOT_SPEED

    local startTime =
        tick()

    while true do

        root = GetRoot()

        if not root then
            return false
        end

        local alpha =
            math.clamp(
                (tick() - startTime)
                / duration,
                0,
                1
            )

        local positionNow =
            start:Lerp(
                position,
                alpha
            )

        root.CFrame =
            CFrame.new(
                positionNow
            )

        if alpha >= 1 then
            break
        end

        RunService.Heartbeat:Wait()
    end

    return true
end

--==================================================
-- AGARRAR
--==================================================

local function GrabEgg(egg)

    if not egg then
        return false
    end

    for _, object in ipairs(
        egg:GetDescendants()
    ) do

        if object:IsA(
            "ProximityPrompt"
        ) then

            pcall(function()
                fireproximityprompt(
                    object
                )
            end)

        elseif object:IsA(
            "ClickDetector"
        ) then

            pcall(function()
                fireclickdetector(
                    object
                )
            end)
        end
    end

    return true
end

--==================================================
-- SOLTAR
--==================================================

local function DropEgg()

    local names = {
        "DropEgg",
        "Drop Egg",
        "Drop",
        "DropButton",
        "DropEggButton",
        "Soltar",
        "SoltarHuevo"
    }

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        local objectName =
            object.Name:lower()

        for _, wanted in ipairs(names) do

            if objectName
                == wanted:lower() then

                if object:IsA(
                    "ProximityPrompt"
                ) then

                    pcall(function()
                        fireproximityprompt(
                            object
                        )
                    end)

                elseif object:IsA(
                    "ClickDetector"
                ) then

                    pcall(function()
                        fireclickdetector(
                            object
                        )
                    end)
                end
            end
        end
    end
end

--==================================================
-- BUSCAR PLOT
--==================================================

local function FindMyPlot()

    local plotNames = {
        "Plot",
        "Plots",
        "Base",
        "Bases",
        "Tycoon",
        "PlayerPlot",
        "MyPlot",
        "PlotBase",
        "PlotBycoon"
    }

    local ownerNames = {
        "Owner",
        "OwnerName",
        "Player",
        "PlayerName",
        "Username",
        "UserName",
        "UserId",
        "OwnerUserId"
    }

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        local objectName =
            object.Name:lower()

        for _, plotName in ipairs(
            plotNames
        ) do

            if objectName
                == plotName:lower() then

                for _, attribute in ipairs(
                    ownerNames
                ) do

                    local owner =
                        object:GetAttribute(
                            attribute
                        )

                    if owner ~= nil then

                        if tostring(owner)
                            == Player.Name
                            or tostring(owner)
                            == tostring(
                                Player.UserId
                            ) then

                            return object
                        end
                    end
                end
            end
        end
    end

    return nil
end

--==================================================
-- POSICIÓN DEL PLOT
--==================================================

local function GetPlotPosition(plot)

    if not plot then
        return nil
    end

    local names = {
        "Spawn",
        "SpawnLocation",
        "PlotSpawn",
        "SpawnPoint",
        "Drop",
        "DropPoint",
        "EggDrop"
    }

    for _, name in ipairs(names) do

        local object =
            plot:FindFirstChild(
                name,
                true
            )

        if object
            and object:IsA(
                "BasePart"
            ) then

            return object.Position
        end
    end

    local part =
        plot:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if part then
        return part.Position
    end

    return nil
end

--==================================================
-- CICLO
--==================================================

local function Start()

    print(
        "🔎 Buscando mejor huevo..."
    )

    local egg, value =
        FindBestEgg()

    if not egg then

        warn(
            "❌ No encontré ningún huevo."
        )

        return
    end

    local eggPart =
        GetEggPart(egg)

    if not eggPart then
        return
    end

    print(
        "🥚 MEJOR:",
        egg.Name,
        value
    )

    --==============================================
    -- 1. TP AL HUEVO
    --==============================================

    TeleportTo(
        eggPart.Position
    )

    task.wait(0.1)

    --==============================================
    -- 2. AGARRAR
    --==============================================

    GrabEgg(egg)

    task.wait(0.3)

    --==============================================
    -- 3. TP AL CENTRO
    --==============================================

    print(
        "📍 TP AL CENTRO"
    )

    TeleportTo(CENTER)

    task.wait(0.3)

    --==============================================
    -- 4. SOLTAR
    --==============================================

    print(
        "📦 SOLTANDO"
    )

    DropEgg()

    task.wait(0.3)

    --==============================================
    -- 5. VOLVER A AGARRAR
    --==============================================

    print(
        "✋ VOLVIENDO A AGARRAR"
    )

    GrabEgg(egg)

    task.wait(0.3)

    --==============================================
    -- 6. BUSCAR PLOT
    --==============================================

    local plot =
        FindMyPlot()

    if not plot then

        warn(
            "❌ No encontré tu plot."
        )

        return
    end

    local plotPosition =
        GetPlotPosition(plot)

    if not plotPosition then

        warn(
            "❌ No encontré la posición del plot."
        )

        return
    end

    --==============================================
    -- 7. DESPLAZAMIENTO A 1000
    --==============================================

    print(
        "🚀 DESPLAZAMIENTO AL PLOT: 1000"
    )

    MoveTo(
        plotPosition
        + Vector3.new(0, 3, 0)
    )

    task.wait(0.3)

    --==============================================
    -- 8. SOLTAR EN PLOT
    --==============================================

    print(
        "🏠 SOLTANDO EN EL PLOT"
    )

    DropEgg()

    print(
        "✅ CICLO TERMINADO"
    )
end

Start()
