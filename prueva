--==============================================================
-- ROOT DEL JUGADOR
--==============================================================

local function GetRoot()

    local Character = Player.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

--==============================================================
-- OBTENER PARTES DE UN OBJETO
--==============================================================

local function GetObjectParts(Object)

    local Parts = {}

    if Object:IsA("BasePart") then

        table.insert(Parts,Object)

        return Parts
    end

    if Object:IsA("Model") then

        for _,Child in ipairs(
            Object:GetDescendants()
        ) do

            if Child:IsA("BasePart") then

                table.insert(
                    Parts,
                    Child
                )

            end
        end
    end

    return Parts
end

--==============================================================
-- POSICIÓN DEL HUEVO
--==============================================================

local function GetEggPosition(Object)

    local Parts =
        GetObjectParts(Object)

    if #Parts == 0 then
        return nil
    end

    local Total =
        Vector3.zero

    for _,Part in ipairs(Parts) do

        Total += Part.Position

    end

    return Total / #Parts
end

--==============================================================
-- ZONA DE EXCLUSIÓN
--
-- IMPORTANTE:
-- El filtro ocurre ANTES de comparar Luck.
-- Por lo tanto, un huevo dentro de la zona no puede ganar.
--==============================================================

local function IsInsideExclusion(Position)

    if not Position then
        return true
    end

    local XDistance =
        math.abs(
            Position.X -
            EXCLUSION_CENTER.X
        )

    local ZDistance =
        math.abs(
            Position.Z -
            EXCLUSION_CENTER.Z
        )

    return
        XDistance <= EXCLUSION_RADIUS
        and
        ZDistance <= EXCLUSION_RADIUS
end

--==============================================================
-- IDENTIFICAR HUEVO
--==============================================================

local function IsEgg(Object)

    local Name =
        Object.Name:lower()

    if Name:find("egg") then
        return true
    end

    if Name:find("huevo") then
        return true
    end

    if Object:GetAttribute(
        "IsEgg"
    ) == true then

        return true
    end

    return false
end

--==============================================================
-- OBTENER LUCK
--==============================================================

local function GetLuck(Object)

    -- Atributos reales primero

    local Attributes = {
        "Luck",
        "luck",
        "EggLuck",
        "RarityValue",
    }

    for _,AttributeName in ipairs(
        Attributes
    ) do

        local Value =
            Object:GetAttribute(
                AttributeName
            )

        if typeof(Value) == "number" then

            return Value

        end
    end

    -- NumberValue / IntValue

    for _,Child in ipairs(
        Object:GetDescendants()
    ) do

        if Child:IsA("NumberValue")
        or Child:IsA("IntValue") then

            local Name =
                Child.Name:lower()

            if Name == "luck"
            or Name == "eggluck"
            or Name == "rarityvalue" then

                return Child.Value

            end
        end
    end

    -- Respaldo

    return EGG_LUCK[
        Object.Name
    ] or 0
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function FindBestEgg()

    local Best = nil
    local HighestLuck = -math.huge

    for _,Object in ipairs(
        workspace:GetDescendants()
    ) do

        if IsEgg(Object) then

            local Position =
                GetEggPosition(Object)

            if Position then

                --==================================================
                -- FILTRO CRÍTICO
                --==================================================

                if not IsInsideExclusion(
                    Position
                ) then

                    local Luck =
                        GetLuck(Object)

                    if Luck >
                        HighestLuck then

                        HighestLuck =
                            Luck

                        Best = {
                            Object = Object,
                            Position = Position,
                            Luck = Luck
                        }
                    end
                end
            end
        end
    end

    return Best
end

--==============================================================
-- FORMATO DE NÚMEROS
--==============================================================

local function FormatNumber(Number)

    if Number >= 1e12 then

        return string.format(
            "%.2fT",
            Number / 1e12
        )

    elseif Number >= 1e9 then

        return string.format(
            "%.2fB",
            Number / 1e9
        )

    elseif Number >= 1e6 then

        return string.format(
            "%.2fM",
            Number / 1e6
        )

    elseif Number >= 1e3 then

        return string.format(
            "%.2fK",
            Number / 1e3
        )
    end

    return tostring(Number)
end

--==============================================================
-- TELEPORT
--==============================================================

local function TeleportTo(Position)

    local Root =
        GetRoot()

    if not Root then
        return false
    end

    Root.CFrame =
        CFrame.new(
            Position +
            Vector3.new(
                0,
                TELEPORT_HEIGHT,
                0
            )
        )

    return true
end

--==============================================================
-- BUSCAR PROXIMITY PROMPT
--==============================================================

local function FindPrompt(Object)

    if Object:IsA(
        "ProximityPrompt"
    ) then

        return Object
    end

    return Object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )
end

--==============================================================
-- RECOGER HUEVO
--==============================================================

local function CollectEgg(Egg)

    if not Egg then
        return false
    end

    local Prompt =
        FindPrompt(
            Egg.Object
        )

    if not Prompt then

        StatusLabel.Text =
            "Estado: PROMPT NO ENCONTRADO"

        return false
    end

    if not Prompt.Enabled then
        return false
    end

    StatusLabel.Text =
        "Estado: RECOGIENDO"

    pcall(function()

        Prompt:InputHoldBegin()

        task.wait(
            math.max(
                Prompt.HoldDuration,
                0.05
            )
        )

        Prompt:InputHoldEnd()

    end)

    return true
end

--==============================================================
-- COMPROBAR OWNER
--==============================================================

local function IsMyPlot(Object)

    local OwnerNames = {
        "Owner",
        "owner",
        "OwnerName",
        "ownerName",
    }

    for _,Name in ipairs(
        OwnerNames
    ) do

        local Attribute =
            Object:GetAttribute(Name)

        if Attribute ~= nil then

            if tostring(Attribute)
                == Player.Name
            or tostring(Attribute)
                == tostring(
                    Player.UserId
                ) then

                return true
            end
        end

        local Value =
            Object:FindFirstChild(
                Name,
                true
            )

        if Value then

            if Value:IsA(
                "StringValue"
            ) and
                Value.Value ==
                Player.Name then

                return true
            end

            if Value:IsA(
                "ObjectValue"
            ) and
                Value.Value ==
                Player then

                return true
            end

            if Value:IsA(
                "IntValue"
            ) and
                Value.Value ==
                Player.UserId then

                return true
            end
        end
    end

    return false
end

--==============================================================
-- BUSCAR MI PLOT
--==============================================================

local function FindMyPlot()

    for _,Object in ipairs(
        workspace:GetDescendants()
    ) do

        local Name =
            Object.Name:lower()

        if Name:find("plot")
        or Name:find("tycoon")
        or Name:find("base")
        or Name:find("ranch") then

            if IsMyPlot(Object) then

                local Position =
                    GetEggPosition(Object)

                if Position then

                    return Object,Position

                end
            end
        end
    end

    return nil,nil
end

--==============================================================
-- CICLO PRINCIPAL
--==============================================================

local function RunCycle()

    if BUSY or not AUTO_EGG then
        return
    end

    BUSY = true

    --==========================================================
    -- 1. BUSCAR MEJOR HUEVO
    --==========================================================

    StatusLabel.Text =
        "Estado: BUSCANDO MEJOR"

    local Egg =
        FindBestEgg()

    if not Egg then

        BestEggLabel.Text =
            "🏆 Mejor: NINGUNO"

        LuckLabel.Text =
            "Luck: —"

        StatusLabel.Text =
            "Estado: NO HAY HUEVOS VÁLIDOS"

        BUSY = false

        return
    end

    --==========================================================
    -- 2. MOSTRAR EN PANEL
    --==========================================================

    BestEggLabel.Text =
        "🏆 Mejor: "
        .. Egg.Object.Name

    LuckLabel.Text =
        "Luck: "
        .. FormatNumber(
            Egg.Luck
        )

    --==========================================================
    -- 3. TP AL HUEVO
    --==========================================================

    StatusLabel.Text =
        "Estado: TP AL HUEVO"

    TeleportTo(
        Egg.Position
    )

    task.wait(0.2)

    --==========================================================
    -- 4. COMPROBAR QUE SIGUE EXISTIENDO
    --==========================================================

    if not Egg.Object.Parent then

        BUSY = false

        return
    end

    --==========================================================
    -- 5. RECOGER
    --==========================================================

    CollectEgg(Egg)

    task.wait(0.3)

    --==========================================================
    -- 6. BUSCAR PLOT
    --==========================================================

    StatusLabel.Text =
        "Estado: BUSCANDO MI PLOT"

    local MyPlot,
          PlotPosition =
        FindMyPlot()

    if not MyPlot then

        PlotLabel.Text =
            "🏠 Plot: NO ENCONTRADO"

        StatusLabel.Text =
            "Estado: ERROR DE PLOT"

        BUSY = false

        return
    end

    PlotLabel.Text =
        "🏠 Plot: ENCONTRADO"

    --==========================================================
    -- 7. TP AL PLOT
    --==========================================================

    StatusLabel.Text =
        "Estado: TP AL PLOT"

    TeleportTo(
        PlotPosition
    )

    task.wait(0.4)

    StatusLabel.Text =
        "Estado: COMPLETADO"

    BUSY = false
end

