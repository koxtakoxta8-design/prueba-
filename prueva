--==============================================================
-- UTILIDAD: FOTO DEL HUEVO
-- Busca ImageLabel, Decal o Texture dentro del huevo.
--==============================================================

local function FindEggImage(obj)
    if not obj then
        return nil
    end

    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("ImageLabel") or d:IsA("ImageButton") then
            if d.Image and d.Image ~= "" then
                return d.Image
            end
        end

        if d:IsA("Decal") or d:IsA("Texture") then
            if d.Texture and d.Texture ~= "" then
                return d.Texture
            end
        end
    end

    if obj:IsA("Decal") or obj:IsA("Texture") then
        return obj.Texture
    end

    return nil
end

