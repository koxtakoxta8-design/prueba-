--==============================================================
-- UTILIDADES
--==============================================================

local function GetRoot()
    local Character = Player.Character
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function GetParts(Object)
    local Parts = {}

    if Object:IsA("BasePart") then
        Parts[1] = Object
    elseif Object:IsA("Model") then
        for _,v in ipairs(Object:GetDescendants()) do
            if v:IsA("BasePart") then
                Parts[#Parts+1] = v
            end
        end
    end

    return Parts
end

local function GetPosition(Object)
    local Parts = GetParts(Object)

    if #Parts == 0 then
        return nil
    end

    local Total = Vector3.zero

    for _,Part in ipairs(Parts) do
        Total += Part.Position
    end

    return Total / #Parts
end

--==============================================================
-- EXCLUSÃO
--==============================================================

local function IsExcluded(Position)
    if not Position then
        return true
    end

    local X = math.abs(
        Position.X - EXCLUSION_CENTER.X
    )

    local Z = math.abs(
        Position.Z - EXCLUSION_CENTER.Z
    )

    return X <= EXCLUSION_RADIUS
       and Z <= EXCLUSION_RADIUS
end

--==============================================================
-- IDENTIFICAR HUEVO
--==============================================================

local function IsEgg(Object)
    local Name = Object.Name:lower()

    if Name:find("egg") then
        return true
    end

    if Name:find("huevo") then
        return true
    end

    if Object:GetAttribute("IsEgg") == true then
        return true
    end

    return false
end

--==============================================================
-- OBTENER VALOR
--==============================================================

local function GetLuck(Object)

    for _,Name in ipairs({
        "Luck",
        "luck",
        "EggLuck",
        "RarityValue",
        "Value"
    }) do
        local Value = Object:GetAttribute(Name)

        if typeof(Value) == "number" then
            return Value
        end
    end

    for _,v in ipairs(Object:GetDescendants()) do
        if v:IsA("NumberValue")
        or v:IsA("IntValue") then

            local N = v.Name:lower()

            if N == "luck"
            or N == "eggluck"
            or N == "rarityvalue" then
                return v.Value
            end
        end
    end

    return EGG_VALUES[Object.Name] or 0
end

--==============================================================
-- BUSCAR PROMPT
--==============================================================

local function FindPrompt(Object)

    if Object:IsA("ProximityPrompt") then
        return Object
    end

    return Object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function FindBestEgg()

    local BestEgg = nil
    local Highest = -math.huge

    for _,Object in ipairs(
        workspace:GetDescendants()
    ) do

        if IsEgg(Object) then

            local Position = GetPosition(Object)

            if Position
            and not IsExcluded(Position) then

                local Prompt = FindPrompt(Object)

                -- Solo consideramos huevos que realmente
                -- pueden recogerse con ProximityPrompt.
                if Prompt then

                    local Luck = GetLuck(Object)

                    if Luck > Highest then

                        Highest = Luck

                        BestEgg = {
                            Object = Object,
                            Position = Position,
                            Luck = Luck,
                            Prompt = Prompt
                        }
                    end
                end
            end
        end
    end

    return BestEgg
end

--==============================================================
-- TP
--==============================================================

local function Teleport(Position)

    local Root = GetRoot()

    if not Root then
        return false
    end

    Root.CFrame =
        CFrame.new(
            Position + Vector3.new(
                0,
                EGG_HEIGHT,
                0
            )
        )

    return true
end

--==============================================================
-- RECOGER CON PROXIMITYPROMPT
--==============================================================

local function CollectEgg(Egg)

    if not Egg
    or not Egg.Object
    or not Egg.Object.Parent then
        return false
    end

    local Prompt = Egg.Prompt

    if not Prompt
    or not Prompt.Parent
    or not Prompt.Enabled then
        return false
    end

    Status.Text = "Estado: RECOGIENDO"

    pcall(function()

        Prompt:InputHoldBegin()

        task.wait(
            math.max(
                Prompt.HoldDuration,
                0.05
            )
        )

        Prompt:InputHoldEnd()

    end)

    return true
end

--==============================================================
-- PLOT
--==============================================================

local function IsMyPlot(Object)

    for _,Name in ipairs({
        "Owner",
        "owner",
        "OwnerName",
        "ownerName"
    }) do

        local Attribute =
            Object:GetAttribute(Name)

        if Attribute ~= nil then
            if tostring(Attribute) == Player.Name
            or tostring(Attribute) == tostring(Player.UserId) then
                return true
            end
        end

        local Value =
            Object:FindFirstChild(Name,true)

        if Value then

            if Value:IsA("StringValue")
            and Value.Value == Player.Name then
                return true
            end

            if Value:IsA("IntValue")
            and Value.Value == Player.UserId then
                return true
            end

            if Value:IsA("ObjectValue")
            and Value.Value == Player then
                return true
            end
        end
    end

    return false
end

local function FindMyPlot()

    for _,Object in ipairs(
        workspace:GetDescendants()
    ) do

        local Name = Object.Name:lower()

        if Name:find("plot")
        or Name:find("tycoon")
        or Name:find("base") then

            if IsMyPlot(Object) then

                local Position =
                    GetPosition(Object)

                if Position then
                    return Position
                end
            end
        end
    end

    return nil
end

--==============================================================
-- CICLO
--==============================================================

local function RunCycle()

    if Busy or not Enabled then
        return
    end

    Busy = true

    Status.Text = "Estado: BUSCANDO"

    local Egg = FindBestEgg()

    if not Egg then

        Best.Text = "🏆 Mejor: NINGUNO"
        Luck.Text = "Luck: —"
        Status.Text = "Estado: SIN HUEVO VÁLIDO"

        Busy = false
        return
    end

    Best.Text =
        "🏆 Mejor: " .. Egg.Object.Name

    Luck.Text =
        "Luck: " .. tostring(Egg.Luck)

    -- Verificación final antes del TP
    if IsExcluded(Egg.Position) then
        Busy = false
        return
    end

    Status.Text = "Estado: TP AL HUEVO"

    Teleport(Egg.Position)

    task.wait(0.15)

    -- El huevo pudo desaparecer mientras viajábamos
    if not Egg.Object.Parent then
        Busy = false
        return
    end

    Status.Text = "Estado: RECOGIENDO"

    CollectEgg(Egg)

    task.wait(0.35)

    Status.Text = "Estado: BUSCANDO PLOT"

    local PlotPosition = FindMyPlot()

    if not PlotPosition then
        Status.Text = "Estado: PLOT NO ENCONTRADO"
        Busy = false
        return
    end

    Status.Text = "Estado: TP AL PLOT"

    Teleport(PlotPosition)

    task.wait(0.4)

    Status.Text = "Estado: COMPLETADO"

    Busy = false
end

