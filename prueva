local function FindPrompt(Egg)

    if not Egg then
        return nil
    end

    for _,obj in ipairs(
        Egg:GetDescendants()
    ) do

        if obj:IsA(
            "ProximityPrompt"
        ) then

            return obj

        end
    end
end

--==============================================================
-- AUTO GRAB x3
--==============================================================

local function AutoGrab(Egg)

    local Prompt =
        FindPrompt(Egg)

    if not Prompt then
        return
    end

    Freeze()

    pcall(function()
        Prompt.HoldDuration = 0
    end)

    for i = 1,3 do

        if not InstaTP then
            break
        end

        pcall(function()
            Prompt:InputHoldBegin()
        end)

        task.wait(.08)

        pcall(function()
            Prompt:InputHoldEnd()
        end)

        task.wait(.08)
    end
end

--==============================================================
-- CICLO
--==============================================================

local function DoCycle()

    if not InstaTP then
        return
    end

    BestEgg =
        FindBestEgg()

    if not BestEgg then

        Status.Text =
            "● NO HAY HUEVO"

        return
    end

    Status.Text =
        "● TELEPORT"

    TeleportToEgg(
        BestEgg
    )

    Freeze()

    task.wait(.12)

    if not InstaTP then
        Unfreeze()
        return
    end

    Status.Text =
        "● AUTO GRAB x3"

    AutoGrab(
        BestEgg
    )

    task.wait(.25)

    if not InstaTP then
        Unfreeze()
        return
    end

    Status.Text =
        "● SPAWN"

    ReturnSpawn()

    task.wait(.15)

    Unfreeze()

    Status.Text =
        LOP
        and "● LOOP ACTIVE"
        or "● READY"
end

