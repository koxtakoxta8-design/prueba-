-- CICLO
--==============================================================

local function DoCycle()

    if not InstaTP then
        return
    end

    RefreshBestEgg()
    UpdateUI()

    local egg =
        BestEgg

    if not egg then

        Status.Text =
            "● NO HAY HUEVO"

        return

    end

    Status.Text =
        "● TELEPORT"

    if not TeleportToEgg(egg) then
        return
    end

    FreezeCharacter()

    task.wait(0.12)

    if not InstaTP then

        UnfreezeCharacter()

        return

    end

    Status.Text =
        "● AUTO GRAB x3"

    AutoGrab(egg)

    task.wait(0.25)

    if not InstaTP then

        UnfreezeCharacter()

        return

    end

    Status.Text =
        "● RETURN SPAWN"

    ReturnToSpawn()

    task.wait(0.15)

    UnfreezeCharacter()

    if LOP then

        Status.Text =
            "● LOOP ACTIVE"

    else

        Status.Text =
            "● READY"

    end

end

--==============================================================
-- BOTÓN LOP
--==============================================================

LOPButton.Activated:Connect(
    function()

        ClickAnimation(
            LOPButton
        )

        LOP =
            not LOP

        UpdateLOPButton()

        if LOP then

            Status.Text =
                "● LOOP READY"

        else

            Status.Text =
                InstaTP
                and "● ACTIVE"
                or "● READY"

        end

    end
)

--==============================================================
-- BOTÓN INSTA TP
--==============================================================

TPButton.Activated:Connect(
    function()

        ClickAnimation(
            TPButton
        )

        InstaTP =
            not InstaTP

        UpdateTPButton()

        if InstaTP then

            SaveSpawn()

            if LOP then

                Status.Text =
                    "● LOOP ACTIVE"

                task.spawn(
                    function()

                        while
                            InstaTP
                            and LOP
                        do

                            if not Busy then

                                Busy = true

                                pcall(
                                    function()
                                        DoCycle()
                                    end
                                )

                                Busy = false

                            end

                            task.wait(
                                REFRESH_TIME
                            )

                        end

                    end
                )

            else

                task.spawn(
                    function()

                        if not Busy then

                            Busy = true

                            pcall(
                                function()
                                    DoCycle()
                                end
                            )

                            Busy = false

                        end

                        InstaTP = false

                        UpdateTPButton()

                        Status.Text =
                            "● READY"

                    end
                )

            end

        else

            InstaTP = false

            Status.Text =
                "● READY"

            UnfreezeCharacter()

        end

    end
)

