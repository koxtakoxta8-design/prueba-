local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

--==================================================
-- 22 HUEVOS
--==================================================

local Eggs = {
    ["White Egg"]      = 1,
    ["Brown Egg"]      = 5,
    ["Cracked Egg"]    = 30,
    ["Easter Egg"]     = 50,
    ["Stone Egg"]      = 100,
    ["Leaf Egg"]       = 200,
    ["Mushroom Egg"]   = 500,
    ["Flower Egg"]     = 750,
    ["Slime Egg"]      = 1000,
    ["Ice Egg"]        = 3000,
    ["Glass Egg"]      = 10000,
    ["Golden Egg"]     = 30000,
    ["Crystal Egg"]    = 150000,
    ["Skull Egg"]      = 250000,
    ["Dominus Egg"]    = 700000,
    ["Flaming Egg"]    = 1000000,
    ["Sinister Egg"]   = 3000000,
    ["Soul Egg"]       = 7000000,
    ["Aurora Egg"]     = 300000000,
    ["Galaxy Egg"]     = 1500000000,
    ["Black Hole Egg"] = 100000000000,
    ["Cherub Egg"]     = 1000000000000
}

--==================================================
-- BUSCAR PARTE
--==================================================

local function GetPart(obj)
    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then
        return obj.PrimaryPart
            or obj:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

--==================================================
-- BUSCAR MEJOR HUEVO
--==================================================

local function GetBestEgg()

    local bestEgg = nil
    local bestPart = nil
    local bestLuck = -1

    for _, obj in ipairs(Workspace:GetDescendants()) do

        local luck = Eggs[obj.Name]

        if luck then

            local part = GetPart(obj)

            if part and luck > bestLuck then
                bestEgg = obj
                bestPart = part
                bestLuck = luck
            end
        end
    end

    return bestEgg, bestPart, bestLuck
end

--==================================================
-- BUSCAR PROMPT
--==================================================

local function GetPrompt(egg)

    return egg:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )
end

--==================================================
-- BUSCAR SPAWN
--==================================================

local function GetSpawn()

    return Workspace:FindFirstChildWhichIsA(
        "SpawnLocation",
        true
    )
end

--==================================================
-- HACER SECUENCIA
--==================================================

local Busy = false

local function Execute()

    if Busy then
        return
    end

    Busy = true

    local character = Player.Character
    local root = character
        and character:FindFirstChild("HumanoidRootPart")

    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    if not root then
        Busy = false
        return
    end

    -- Buscar huevo
    local egg, part, luck = GetBestEgg()

    if not egg or not part then
        warn("No encontré ninguno de los 22 huevos.")
        Busy = false
        return
    end

    print("================================")
    print("🥚 HUEVO:", egg.Name)
    print("🍀 LUCK:", luck)
    print("================================")

    -- Guardar posición original
    local oldPosition = root.CFrame
    local oldAnchored = root.Anchored

    -- Evitar movimiento
    root.Anchored = true

    if humanoid then
        humanoid.AutoRotate = false
    end

    --==================================================
    -- TP AL HUEVO
    --==================================================

    local eggPosition =
        part.CFrame + Vector3.new(0, 3, 0)

    root.CFrame = eggPosition

    -- Mantener exactamente la posición
    -- mientras se procesa el huevo
    local holding = true

    local keepPosition

    keepPosition = RunService.Heartbeat:Connect(function()

        if holding and root.Parent then
            root.CFrame = eggPosition
        end

    end)

    task.wait(0.15)

    --==================================================
    -- ACTIVAR PROMPT
    --==================================================

    local prompt = GetPrompt(egg)

    if prompt then

        print("🟢 ProximityPrompt encontrado")

        pcall(function()
            prompt:InputHoldBegin()
        end)

        task.wait(
            math.max(
                prompt.HoldDuration,
                0.05
            )
        )

        pcall(function()
            prompt:InputHoldEnd()
        end)

        print("🥚 Interacción terminada")

    else

        warn("El huevo no tiene ProximityPrompt.")

    end

    task.wait(0.25)

    -- Dejar de fijar la posición
    holding = false

    if keepPosition then
        keepPosition:Disconnect()
    end

    --==================================================
    -- BUSCAR SPAWN
    --==================================================

    local spawn = GetSpawn()

    if spawn then

        -- Mantener quieto mientras se hace el TP
        root.CFrame =
            spawn.CFrame + Vector3.new(0, 3, 0)

        print("🏠 Regresó al spawn")

    else

        warn("No encontré SpawnLocation.")

        -- Si no existe SpawnLocation,
        -- regresar a la posición inicial
        root.CFrame = oldPosition

    end

    task.wait(0.2)

    -- Restaurar movimiento
    root.Anchored = oldAnchored

    if humanoid then
        humanoid.AutoRotate = true
    end

    Busy = false
end

