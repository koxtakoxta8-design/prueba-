--==============================================================

local function DoCycle()

    if not InstaTP then
        return
    end

    RefreshBestEgg()
    UpdateUI()

    local egg =
        BestEgg

    if not egg then

        Status.Text =
            "● NO HAY HUEVO"

        return

    end

    Status.Text =
        "● TELEPORT"

    if not TeleportToEgg(egg) then
        return
    end

    FreezeCharacter()

    task.wait(0.12)

    if not InstaTP then

        UnfreezeCharacter()

        return

    end

    Status.Text =
        "● AUTO GRAB x3"

    AutoGrab(egg)

    task.wait(0.25)

    if not InstaTP then

        UnfreezeCharacter()

        return

    end

    Status.Text =
        "● RETURN SPAWN"

    ReturnToSpawn()

    task.wait(0.15)

    UnfreezeCharacter()

    if LOP then

        Status.Text =
            "● LOOP ACTIVE"

    else

        Status.Text =
            "● READY"

    end

end

