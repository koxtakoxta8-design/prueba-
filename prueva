    ["Crystal Egg"] = 150000,
    ["Skull Egg"] = 250000,
    ["Dominus Egg"] = 700000,
    ["Flaming Egg"] = 1000000,
    ["Sinister Egg"] = 3000000,
    ["Soul Egg"] = 7000000,
    ["Aurora Egg"] = 300000000,
    ["Galaxy Egg"] = 1500000000,
    ["Blackhole Egg"] = 100000000000,
    ["Solaris Egg"] = 300000000000,
    ["Cherub Egg"] = 1000000000000,
    ["Volcanic Egg"] = 2500000000000
}

--==============================================================--
-- UTILIDADES
--==============================================================--

local function getCharacter()

    return Player.Character
        or Player.CharacterAdded:Wait()

end

local function getRoot()

    local character =
        getCharacter()

    return character:FindFirstChild(
        "HumanoidRootPart"
    )

end

local function getPart(object)

    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    return object:FindFirstChildWhichIsA(
        "BasePart",
        true
    )

end

--==============================================================--
-- DETECTAR HUEVO
--==============================================================--

local function isEgg(object)

    if not object then
        return false
    end

    local name =
        string.lower(
            object.Name
        )

    return
        name:find("egg", 1, true) ~= nil
        or
        name:find("huevo", 1, true) ~= nil

end

--==============================================================--
-- EXCLUSIÓN DEL CENTRO
--==============================================================--

local function isInsideExclusion(position)

    return (
        position - CENTER
    ).Magnitude <= EXCLUSION_RADIUS

end

--==============================================================--
-- VALOR DEL HUEVO
--==============================================================--

local function getEggValue(egg)

    if not egg then
        return 0
    end

    local value = 0

    local eggName =
        string.lower(
            egg.Name
        )

    -- POR NOMBRE
    for name, amount in pairs(
        EggValues
    ) do

        if eggName:find(
            string.lower(name),
            1,
            true
        ) then

            if amount > value then
                value = amount
            end

        end
    end

    -- NumberValue / IntValue
    for _, object in ipairs(
        egg:GetDescendants()
    ) do

        if object:IsA("NumberValue")
        or object:IsA("IntValue") then

            local name =
                string.lower(
                    object.Name
                )

            if name:find("luck", 1, true)
            or name:find("value", 1, true)
            or name:find("worth", 1, true)
            or name:find("rarity", 1, true)
            or name:find("eggvalue", 1, true) then

                value =
                    math.max(
                        value,
                        object.Value
                    )

            end
        end
    end

    -- ATTRIBUTES
    for _, attribute in ipairs({

        "Luck",
        "Value",
        "Worth",
        "Rarity",
        "EggValue"

    }) do

        local v =
            egg:GetAttribute(
                attribute
            )

        if typeof(v) == "number" then

            value =
                math.max(
                    value,
                    v
                )

        end
    end

    return value

end

--==============================================================--
-- BUSCAR MEJOR HUEVO
--==============================================================--

local function findBestEgg()

    local bestEgg = nil
    local bestValue = -1

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if isEgg(object) then

            local part =
                getPart(object)

            if part then

                if not isInsideExclusion(
                    part.Position
                ) then

                    local value =
                        getEggValue(
                            object
                        )

                    if value > bestValue then

                        bestValue =
                            value

                        bestEgg =
                            object

                    end
                end
            end
        end
    end

    return bestEgg, bestValue

end

--==============================================================--
-- TELEPORT
--==============================================================--

local function teleportTo(position)

    local root =
        getRoot()

    if not root then
        return false
    end

    root.CFrame =
        CFrame.new(
            position
        )

    return true

end

--==============================================================--
-- ENCONTRAR DROPEGG
--==============================================================--

local function findDropEggButton()

    for _, gui in ipairs(
        PlayerGui:GetDescendants()
    ) do

        if gui:IsA("TextButton")
        or gui:IsA("ImageButton") then

            local name =
                string.lower(
                    gui.Name
                )

            if name == "dropegg"
            or name:find(
                "dropegg",
                1,
                true
            ) then

                return gui

            end
        end
    end

    return nil

end

--==============================================================--
-- CONFIRMAR QUE TIENE EL HUEVO
--==============================================================--

local function isCarryingEgg()

    -- PRIMERA COMPROBACIÓN:
    -- El botón DropEgg aparece cuando lleva el huevo.

    local dropButton =
        findDropEggButton()

    if dropButton
    and dropButton.Visible then

        return true

    end

    -- ATRIBUTOS DEL PERSONAJE
    local character =
        Player.Character

    if character then

        local attributes = {

            "CarryingEgg",
            "HasEgg",
            "HoldingEgg",
            "Holding",
            "Carrying"

        }

        for _, attribute in ipairs(
            attributes
        ) do

            if character:GetAttribute(
                attribute
            ) == true then

                return true

            end
        end
    end

    -- ATRIBUTOS DEL PLAYER
    local playerAttributes = {

        "CarryingEgg",
        "HasEgg",
        "HoldingEgg",
        "Holding"

    }

    for _, attribute in ipairs(
        playerAttributes
    ) do

        if Player:GetAttribute(
            attribute
        ) == true then

            return true

        end
    end

    return false

end

--==============================================================--
-- BOTONES DE AGARRE
--==============================================================--

local GrabWords = {

    "grab",
    "pickup",
    "pick up",
    "collect",
    "take",
    "steal",
    "claim",

    "agarrar",
    "agarr",
    "recoger",
    "coger",
    "tomar",
    "robar",

    "prendre",
    "ramasser",

    "nehmen",
    "aufheben",

    "prendere",
    "raccogliere",

    "pegar",
    "recolher"

}

local function isGrabButton(button)

    if not button then
        return false
    end

    local name =
        string.lower(
            button.Name
        )

    local text = ""

    if button:IsA("TextButton") then

        text =
            string.lower(
                button.Text or ""
            )

    end

    local combined =
        name .. " " .. text

    for _, word in ipairs(
        GrabWords
    ) do

        if combined:find(
            word,
            1,
            true
        ) then

            return true

        end
    end

    return false

end

--==============================================================--
-- ACTIVAR BOTONES DE AGARRE
--==============================================================--

local function activateGrabButtons()

    for _, gui in ipairs(
        PlayerGui:GetDescendants()
    ) do

        if gui:IsA("TextButton")
        or gui:IsA("ImageButton") then

            if gui.Visible
            and isGrabButton(gui) then

                -- Activación normal
                pcall(function()

                    gui:Activate()

                end)

                -- Sistema que ya usabas
                pcall(function()

                    for _, conn in ipairs(
                        getconnections(
                            gui.MouseButton1Click
                        )
                    ) do

                        conn:Fire()

                    end

                end)

                pcall(function()

                    for _, conn in ipairs(
                        getconnections(
                            gui.Activated
                        )
                    ) do

                        conn:Fire()

                    end

                end)

            end
        end
    end

end

--==============================================================--
-- ACTIVAR PROXIMITY PROMPTS
--==============================================================--

local function activatePrompts(egg)

    if not egg then
        return
    end

    for _, object in ipairs(
        egg:GetDescendants()
    ) do

        if object:IsA(
            "ProximityPrompt"
        ) then

            pcall(function()

                object.Enabled = true

                object:InputHoldBegin()

                task.wait(0.02)

                object:InputHoldEnd()

            end)

        end
    end

end

--==============================================================--
-- INTENTO DE AGARRE
--==============================================================--

local function attemptGrab(egg)

    if not egg
    or not egg.Parent then

        return false

    end

    local part =
        getPart(egg)

    if not part then
        return false
    end

    -- TP AL HUEVO
    teleportTo(
        part.Position
    )

    -- AGARRE
    activatePrompts(
        egg
    )

    activateGrabButtons()

    -- COMPROBACIÓN MUY RÁPIDA
    task.wait(
        GRAB_CHECK_DELAY
    )

    if isCarryingEgg() then

        return true

    end

    return false

end

--==============================================================--
-- AGARRAR HASTA CONFIRMAR
--==============================================================--

local function grabUntilConfirmed(egg)

    if not egg then
        return false
    end

    print(
        "⚡ AGARRE ULTRA RÁPIDO"
    )

    for attempt = 1, MAX_GRAB_ATTEMPTS do

        -- Si ya lo lleva, salir
        if isCarryingEgg() then

            print(
                "✅ YA LLEVA EL HUEVO"
            )

            return true

        end

        if not egg.Parent then

            print(
                "🔄 El huevo desapareció, buscando otro..."
            )

            return false

        end

        local success =
            attemptGrab(
                egg
            )

        if success then

            print(
                "✅ AGARRADO - INTENTO:",
                attempt
            )

            return true

        end

        task.wait(
            GRAB_RETRY_DELAY
        )

    end

    -- Última comprobación
    if isCarryingEgg() then
        return true
    end

    warn(
        "❌ No se pudo confirmar el agarre."
    )

    return false

end

--==============================================================--
-- DROP ORIGINAL DEL USUARIO
--==============================================================--

local function triggerDropEggButton()

    local foundBtn = nil

    -- BUSCAR DROPEGG
    for _, gui in ipairs(
        PlayerGui:GetDescendants()
    ) do

        if (
            gui:IsA("TextButton")
            or gui:IsA("ImageButton")
        )
        and (
            string.lower(gui.Name)
            == "dropegg"

            or

            string.find(
                string.lower(gui.Name),
                "dropegg",
                1,
                true
            )
        ) then

            foundBtn = gui
            break

        end
    end

    --========================================================--
    -- MÉTODO ORIGINAL
    --========================================================--

    if foundBtn then

        print(
            "🟢 DROPEGG ENCONTRADO"
        )

        pcall(function()

            for _, conn in ipairs(
                getconnections(
                    foundBtn.MouseButton1Click
                )
            ) do

                conn:Fire()

            end

        end)

        pcall(function()

            for _, conn in ipairs(
                getconnections(
                    foundBtn.Activated
                )
            ) do

                conn:Fire()

            end

        end)

        return true

    end

    --========================================================--
    -- FALLBACK ORIGINAL
    --========================================================--

    local success =
        pcall(function()

            local packages =
                ReplicatedStorage:FindFirstChild(
                    "Packages"
                )

            if not packages then
                return
            end

            local networking =
                packages:FindFirstChild(
                    "Networking"
                )

            if not networking then
                return
            end

            local remote =
                networking:FindFirstChild(
                    "RF/EggWorld/AskFieldEggDrop"
                )

            if remote then

                remote:InvokeServer({
                    Reason =
                        "PlayerRequest"
                })

            end

        end)

    return success

end

--==============================================================--
-- DROP HASTA CONFIRMAR
--==============================================================--

local function dropUntilConfirmed()

    print(
        "📦 DROP..."
    )

    for attempt = 1, MAX_DROP_ATTEMPTS do

        -- Si ya no lo lleva, ya está soltado
        if not isCarryingEgg() then

            print(
                "✅ DROP YA CONFIRMADO"
            )

            return true

        end

        triggerDropEggButton()

        task.wait(
            DROP_RETRY_DELAY
        )

        if not isCarryingEgg() then

            print(
                "✅ HUEVO SOLTADO"
            )

            return true

        end

        print(
            "🔄 DROP REINTENTO:",
            attempt
        )

    end

    return not isCarryingEgg()

end

--==============================================================--
-- BUSCAR HUEVO CERCA DEL CENTRO
--==============================================================--

local function findEggNearCenter()

    local startTime =
        os.clock()

    local bestEgg = nil
    local bestDistance =
        math.huge

    while (
        os.clock()
        - startTime
    ) < MAX_SEARCH_TIME do

        bestEgg = nil
        bestDistance =
            math.huge

        for _, object in ipairs(
            workspace:GetDescendants()
        ) do

            if isEgg(object) then

                local part =
                    getPart(object)

                if part then

                    local distance =
                        (
                            part.Position
                            - CENTER
                        ).Magnitude

                    if distance <
                        bestDistance then

                        bestDistance =
                            distance

                        bestEgg =
                            object

                    end
                end
            end
        end

        if bestEgg then

            return bestEgg

        end

        task.wait(
            SEARCH_DELAY
        )

    end

    return nil

end

--==============================================================--
-- PLOT
--==============================================================--

local OwnerAttributes = {

    "Owner",
    "OwnerName",
    "Player",
    "PlayerName",
    "Username",
    "UserName",
    "UserId",
    "OwnerUserId"

}

local PlotNames = {

    "Plot",
    "Plots",
    "Base",
    "Bases",
    "Tycoon",
    "Tycoons",
    "PlayerPlot",
    "MyPlot",
    "PlotBase",
    "PlotBycoon",
    "Bycoon",
    "BycoonPlot"

}

local function belongsToPlayer(object)

    for _, attribute in ipairs(
        OwnerAttributes
    ) do

        local value =
            object:GetAttribute(
                attribute
            )

        if value ~= nil then

            if tostring(value)
                == Player.Name then

                return true

            end

            if tostring(value)
                == tostring(
                    Player.UserId
                ) then

                return true

            end

        end
    end

    -- ObjectValue
    for _, child in ipairs(
        object:GetDescendants()
    ) do

        if child:IsA(
            "ObjectValue"
        )
        and child.Value == Player then

            return true

        end
    end

    return false

end

--==============================================================--
-- BUSCAR MI PLOT
--==============================================================--

local function findMyPlot()

    -- PRIMERA PASADA
    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        local objectName =
            string.lower(
                object.Name
            )

        for _, plotName in ipairs(
            PlotNames
        ) do

            if objectName ==
                string.lower(
                    plotName
                ) then

                if belongsToPlayer(
                    object
                ) then

                    return object

                end
            end
        end
    end

    -- SEGUNDA PASADA
    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if belongsToPlayer(
            object
        ) then

            return object

        end
    end

    return nil

end

--==============================================================--
-- POSICIÓN DEL PLOT
--==============================================================--

local function getPlotPosition(plot)

    if not plot then
        return nil
    end

    local SpawnNames = {

        "Spawn",
        "SpawnLocation",
        "PlotSpawn",
        "SpawnPoint",

        "EggSpawn",
        "EggDrop",

        "Drop",
        "DropPoint",

        "Home",
        "HomeSpawn",

        "PetSpawn"

    }

    -- Buscar spawn
    for _, name in ipairs(
        SpawnNames
    ) do

        local object =
            plot:FindFirstChild(
                name,
                true
            )

        if object
        and object:IsA(
            "BasePart"
        ) then

            return object.Position

        end
    end

    -- Fallback
    local part =
        plot:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if part then

        return part.Position

    end

    return nil

end

--==============================================================--
-- MOVIMIENTO 500
--==============================================================--

local function moveToPlot(position)

    local root =
        getRoot()

    if not root then
        return false
    end

    local startPosition =
        root.Position

    local distance =
        (
            position
            - startPosition
        ).Magnitude

    if distance <= 1 then

        root.CFrame =
            CFrame.new(position)

        return true

    end

    local duration =
        distance / PLOT_SPEED

    local startTime =
        os.clock()

    while true do

        root =
            getRoot()

        if not root then
            return false
        end

        local alpha =
            math.clamp(
                (
                    os.clock()
                    - startTime
                ) / duration,
                0,
                1
            )

        local current =
            startPosition:Lerp(
                position,
                alpha
            )

        root.CFrame =
            CFrame.new(
                current
            )

        if alpha >= 1 then
            break
        end

        RunService.Heartbeat:Wait()

    end

    return true

end

--==============================================================--
-- PROCESO PRINCIPAL
--==============================================================--

local function StartAutoEgg()

    print("")
    print(
        "=========================================="
    )
    print(
        "🥚 RIDE A PET - AUTO EGG ULTRA"
    )
    print(
        "=========================================="
    )

    --========================================================--
    -- PASO 1: MEJOR HUEVO
    --========================================================--

    print(
        "🔎 BUSCANDO MEJOR HUEVO..."
    )

    local egg, value =
        findBestEgg()

    if not egg then

        warn(
            "❌ NO ENCONTRÉ HUEVOS"
        )

        return

    end

    local eggPart =
        getPart(egg)

    if not eggPart then

        warn(
            "❌ EL HUEVO NO TIENE PARTE"
        )

        return

    end

    print(
        "🥚 MEJOR:",
        egg.Name
    )

    print(
        "💰 VALOR:",
        value
    )

    --========================================================--
    -- PASO 2: AGARRAR
    --========================================================--

    local grabbed =
        grabUntilConfirmed(
            egg
        )

    if not grabbed then

        warn(
            "❌ NO SE PUDO AGARRAR"
        )

        return

    end

    --========================================================--
    -- PASO 3: CENTRO INMEDIATO
    --========================================================--

    print(
        "🚀 HUEVO CONFIRMADO"
    )

    print(
        "📍 TP CENTRO"
    )

    teleportTo(
        CENTER
    )

    --========================================================--
    -- PASO 4: DROP
    --========================================================--

    task.wait(
        0.1
    )

    if not dropUntilConfirmed() then

        warn(
            "❌ NO SE PUDO SOLTAR"
        )

        return

    end

    --========================================================--
    -- PASO 5: BUSCAR HUEVO NUEVAMENTE
    --========================================================--

    print(
        "🔎 BUSCANDO HUEVO DESPUÉS DEL DROP..."
    )

    local centerEgg = nil

    repeat

        centerEgg =
            findEggNearCenter()

        if not centerEgg then

            task.wait(
                SEARCH_DELAY
            )

        end

    until centerEgg

    print(
        "🥚 HUEVO ENCONTRADO:",
        centerEgg.Name
    )

    --========================================================--
    -- PASO 6: SEGUNDO AGARRE
    --========================================================--

    local secondGrab =
        grabUntilConfirmed(
            centerEgg
        )

    if not secondGrab then

        warn(
            "❌ NO SE PUDO AGARRAR DE NUEVO"
        )

        return

    end

    print(
        "✅ SEGUNDO AGARRE CONFIRMADO"
    )

    --========================================================--
    -- PASO 7: BUSCAR PLOT
    --========================================================--

    print(
        "🏠 BUSCANDO TU PLOT..."
    )

    local plot =
        findMyPlot()

    if not plot then

        warn(
            "❌ NO ENCONTRÉ TU PLOT"
        )

        return

    end

    print(
        "✅ PLOT ENCONTRADO:",
        plot:GetFullName()
    )

    --========================================================--
    -- PASO 8: POSICIÓN PLOT
    --========================================================--

    local plotPosition =
        getPlotPosition(
            plot
        )

    if not plotPosition then

        warn(
            "❌ NO ENCONTRÉ EL SPAWN DEL PLOT"
        )

        return

    end

    print(
        "🏠 POSICIÓN DEL PLOT:",
        plotPosition
    )

    --========================================================--
    -- PASO 9: VELOCIDAD 500
    --========================================================--

    print(
        "🚀 MOVIMIENTO A 500"
    )

    moveToPlot(
        plotPosition
        + Vector3.new(
            0,
            3,
            0
        )
    )

    --========================================================--
    -- PASO 10: DROP FINAL
    --========================================================--

    task.wait(
        0.1
    )

    print(
        "📦 DROP FINAL"
    )

    if dropUntilConfirmed() then

        print("")
        print(
            "=========================================="
        )
        print(
            "✅ TODO COMPLETADO"
        )
        print(
            "🥚 HUEVO ENTREGADO EN TU PLOT"
        )
        print(
            "=========================================="
        )

    else

        warn(
            "❌ FALLÓ EL DROP FINAL"
        )

    end

end

