local function HasGrabPrompt(obj)
    if not obj then
        return false
    end

    for _, p in ipairs(obj:GetDescendants()) do
        if p:IsA("ProximityPrompt") then
            local text = string.lower(
                tostring(p.ActionText) .. " " .. tostring(p.ObjectText)
            )

            if string.find(text,"grab",1,true)
            or string.find(text,"pick",1,true)
            or string.find(text,"collect",1,true)
            or string.find(text,"recoger",1,true)
            or string.find(text,"agarrar",1,true)
            or string.find(text,"tomar",1,true) then
                return true
            end
        end
    end

    return false
end

local function IsValidEgg(obj)

    if not obj or not obj.Parent then
        return false
    end

    -- No exigir que el nombre esté en EggData.
    -- Los huevos nuevos pueden traer Luck como atributo/Value.
    local luck = GetDynamicLuck(obj)

    if not luck or luck <= 0 then
        return false
    end

    local position = GetPosition(obj)

    if not position then
        return false
    end

    local root = GetRoot()

    if not root then
        return false
    end

    -- Nunca seleccionar nada dentro de los 210 studs del centro excluido.
    if (position - BASE_EXCLUSION_CENTER).Magnitude <= BASE_EXCLUSION_RADIUS then
        return false
    end

    if (position - root.Position).Magnitude > DETECTION_DISTANCE then
        return false
    end

    -- Evita seleccionar modelos/zonas decorativas que simplemente
    -- contienen "Egg" en algún nombre pero no pueden recogerse.
    if not HasGrabPrompt(obj) then
        return false
    end

    return true
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function RefreshBestEgg()

    local best = nil
    local bestLuck = -1

    for obj in pairs(EggCache) do

        if IsValidEgg(obj) then

            local luck = GetDynamicLuck(obj)

            if luck and luck > bestLuck then
                bestLuck = luck
                best = obj
            end

        else
            EggCache[obj] = nil
        end
    end

    BestEgg = best
    BestLuck = bestLuck > 0 and bestLuck or 0

    return best
end

