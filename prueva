--==============================================================
-- LUCK -> NUMERO
--==============================================================

local function LuckNumber(value)

    local text = tostring(value or "0")

    local number =
        tonumber(
            text:match("[%d%.]+")
        ) or 0

    if text:find("T") then
        return number * 1e12
    end

    if text:find("B") then
        return number * 1e9
    end

    if text:find("M") then
        return number * 1e6
    end

    if text:find("K") then
        return number * 1e3
    end

    return number
end

--==============================================================
-- OBTENER DATOS
--==============================================================

local function GetEggData(name)

    if not name then
        return nil
    end

    if EggData[name] then
        return EggData[name], name
    end

    local lowerName =
        tostring(name):lower()

    for eggName, data in pairs(EggData) do

        if lowerName:find(
            eggName:lower(),
            1,
            true
        ) then

            return data, eggName
        end
    end

    return nil
end

--==============================================================
-- OBTENER PARTE
--==============================================================

local function GetPart(obj)

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then

        if obj.PrimaryPart then
            return obj.PrimaryPart
        end

        return obj:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
    end

    return nil
end

--==============================================================
-- ROOT
--==============================================================

