local function GetPart(obj)
    if not obj then
        return nil
    end

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then
        if obj.PrimaryPart then
            return obj.PrimaryPart
        end

        return obj:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
    end

    return nil
end

local function GetPosition(obj)
    local part = GetPart(obj)

    if part then
        return part.Position
    end

    return nil
end

--==============================================================
-- CACHE DE HUEVOS
--==============================================================

local EggCache = {}

local function GetDynamicLuck(obj)
    if not obj then
        return nil
    end

    local data = GetEggData(obj.Name)
    if data and data.Luck then
        return ParseLuck(data.Luck)
    end

    -- Intentar leer Luck/HatchLuck directamente del objeto.
    local keys = {
        "Luck", "HatchLuck", "Hatch Luck",
        "LuckValue", "HatchLuckValue"
    }

    for _, key in ipairs(keys) do
        local attr = obj:GetAttribute(key)
        if attr ~= nil then
            local n = ParseLuck(attr)
            if n > 0 then
                return n
            end
        end
    end

    for _, child in ipairs(obj:GetDescendants()) do
        local n = string.lower(child.Name)
        if n == "luck" or n == "hatchluck"
        or n == "hatch luck" or n == "luckvalue"
        or n == "hatchluckvalue" then
            if child:IsA("StringValue")
            or child:IsA("IntValue")
            or child:IsA("NumberValue") then
                local value = ParseLuck(child.Value)
                if value > 0 then
                    return value
                end
            end
        end
    end

    return nil
end

local function LooksLikeEgg(obj)
    if not obj then
        return false
    end

    local lower = string.lower(tostring(obj.Name or ""))

    if string.find(lower, "egg", 1, true) then
        return true
    end

    return GetDynamicLuck(obj) ~= nil
end

local function RegisterEgg(obj)
    if not obj or not obj.Parent then
        return
    end

    if LooksLikeEgg(obj) then
        EggCache[obj] = true
    end
end

local function RemoveEgg(obj)
    EggCache[obj] = nil
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    RegisterEgg(obj)
end

Workspace.DescendantAdded:Connect(function(obj)
