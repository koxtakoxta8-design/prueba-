local function ParseLuck(value)
    local text = tostring(value or ""):upper()
    local number = tonumber(string.match(text, "[%d%.]+"))

    if not number then
        return 0
    end

    if string.find(text, "T", 1, true) then
        return number * 1e12
    elseif string.find(text, "B", 1, true) then
        return number * 1e9
    elseif string.find(text, "M", 1, true) then
        return number * 1e6
    elseif string.find(text, "K", 1, true) then
        return number * 1e3
    end

    return number
end

local function GetEggData(name)
    if not name then
        return nil
    end

    if EggData[name] then
        return EggData[name]
    end

    local lower = string.lower(tostring(name))

    -- Variantes de nombre que pueden usar modelos/GUI del juego.
    if string.find(lower, "volcanic", 1, true)
    or string.find(lower, "volcano", 1, true) then
        return {Luck="2.5T", Rarity="Ethereal"}
    end

    for eggName, data in pairs(EggData) do
        if string.find(
            lower,
            string.lower(eggName),
            1,
            true
        ) then
            return data
        end
    end

    return nil
end

local function GetRoot()
