local EggNames = {
    ["White Egg"]="1",
    ["Brown Egg"]="5",
    ["Cracked Egg"]="30",
    ["Easter Egg"]="50",
    ["Stone Egg"]="100",
    ["Leaf Egg"]="200",
    ["Mushroom Egg"]="500",
    ["Flower Egg"]="750",
    ["Slime Egg"]="1K",
    ["Ice Egg"]="3K",
    ["Glass Egg"]="10K",
    ["Golden Egg"]="30K",
    ["Crystal Egg"]="150K",
    ["Skull Egg"]="250K",
    ["Dominus Egg"]="700K",
    ["Flaming Egg"]="1M",
    ["Sinister Egg"]="3M",
    ["Soul Egg"]="7M",
    ["Aurora Egg"]="300M",
    ["Galaxy Egg"]="1.5B",
    ["Black Hole Egg"]="100B",
    ["Cherub Egg"]="1T"
}

local function LuckValue(value)

    local n =
        tonumber(
            string.match(
                tostring(value),
                "[%d%.]+"
            )
        )

    if not n then
        return 0
    end

    local s =
        string.upper(
            tostring(value)
        )

    if string.find(s,"T",1,true) then
        return n * 1e12
    elseif string.find(s,"B",1,true) then
        return n * 1e9
    elseif string.find(s,"M",1,true) then
        return n * 1e6
    elseif string.find(s,"K",1,true) then
        return n * 1e3
    end

    return n
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function GetRoot()

    local Character =
        Player.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild(
        "HumanoidRootPart"
    )
end

local function GetPart(obj)

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then
        return obj.PrimaryPart
            or obj:FindFirstChildWhichIsA(
                "BasePart",
                true
            )
    end
end

local function FindBestEgg()

    local Root = GetRoot()

    if not Root then
        return nil
    end

    local Best = nil
    local Value = -1

    for _,obj in ipairs(
        Workspace:GetDescendants()
    ) do

        local luck =
            EggNames[obj.Name]

        local part =
            GetPart(obj)

        if luck and part then

            local distance =
                (
                    part.Position -
                    Root.Position
                ).Magnitude

            if distance <= MAX_DISTANCE then

                local score =
                    LuckValue(luck)

                if score > Value then

                    Value = score
                    Best = obj

                end
            end
        end
    end

    return Best
end

