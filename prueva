local MotionConnection

MotionConnection =
    RunService.RenderStepped:Connect(
        function(delta)

            if not Main.Parent then

                if MotionConnection then
                    MotionConnection:Disconnect()
                end

                return
            end

            for _, info in ipairs(
                Lines
            ) do

                info.Angle +=
                    info.Speed *
                    delta

                local line =
                    info.Object

                local radius =
                    info.Radius +
                    math.sin(
                        tick() *
                        1.5 +
                        info.Angle
                    ) *
                    7

                line.Position =
                    UDim2.new(
                        0.5,
                        math.cos(
                            info.Angle
                        ) * radius,

                        0.5,
                        math.sin(
                            info.Angle
                        ) * radius
                    )

                line.Rotation =
                    math.deg(
                        info.Angle
                    )

                line.BackgroundTransparency =
                    0.25 +
                    math.sin(
                        tick() * 2 +
                        info.Angle
                    ) *
                    0.15

            end

        end
    )

