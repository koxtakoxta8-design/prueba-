local ESP_DISTANCE = 5000
local AUTO_DELAY = 0.25
local AUTO_DISTANCE = 18
local active = {}

local function eggData(name)
    if EggData[name] then return EggData[name] end
    local n = string.lower(name)
    for k,v in pairs(EggData) do
        if string.find(n,string.lower(k),1,true) then return v end
    end
end

local function isEgg(obj)
    if not obj then return false end
    local n = string.lower(obj.Name)
    return string.find(n,"egg",1,true) ~= nil
        or string.find(n,"huevo",1,true) ~= nil
        or eggData(obj.Name) ~= nil
end

local function getPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart end
        return obj:FindFirstChildWhichIsA("BasePart",true)
    end
end

local function getPrompt(egg)
    for _,v in ipairs(egg:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.Enabled then
            return v
        end
    end
end

local function isPlaced(egg)
    for _,a in ipairs({"Placed","IsPlaced","Claimed","Owned","InBase","InPlot","Planted","IsPlanted"}) do
        if egg:GetAttribute(a) == true then return true end
        local x = egg:FindFirstChild(a,true)
        if x and x:IsA("BoolValue") and x.Value then return true end
    end
    return false
end

local function getRoot(player)
    local c = player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getPlayerBase(player)
    for _,folderName in ipairs({"Plots","Bases","BasesFolder","PlayerBases"}) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _,base in ipairs(folder:GetChildren()) do
                if base.Name == player.Name
                    or base:GetAttribute("Owner") == player.Name
                    or base:GetAttribute("OwnerUserId") == player.UserId then
                    return base
                end
            end
        end
    end

    for _,obj in ipairs(Workspace:GetDescendants()) do
        if obj:GetAttribute("OwnerUserId") == player.UserId
            or obj:GetAttribute("Owner") == player.Name then
            return obj
        end
    end
end

local function basePart(player)
    local base = getPlayerBase(player)
    return base and getPart(base)
end

local function isInsideMyBase(player, obj)
    local base = getPlayerBase(player)
    if not base or not obj then return false end
    return obj == base or obj:IsDescendantOf(base)
end

local function isOwnedObject(player, obj)
    if not obj then return false end

    -- Anything physically inside the player's base is ignored.
    if isInsideMyBase(player, obj) then
        return true
    end

    -- Also respect common ownership attributes on eggs, pets and containers.
    local ownerUserId = obj:GetAttribute("OwnerUserId")
    local owner = obj:GetAttribute("Owner")

    if ownerUserId == player.UserId then
        return true
    end

    if owner == player.Name or owner == tostring(player.UserId) then
        return true
    end

    return false
end

local function bestEgg(player)
    local best, value = nil, -math.huge
    for _,egg in ipairs(Workspace:GetDescendants()) do
        if isEgg(egg)
            and not isPlaced(egg)
            and not isOwnedObject(player,egg) then
            local d = eggData(egg.Name)
            local p = getPart(egg)
            local prompt = getPrompt(egg)
            if d and p and prompt and d.Value > value then
                best, value = egg, d.Value
            end
        end
    end
    return best
end

local function addESP(egg)
    if egg:FindFirstChild("KOXTA_EggESP") then return end
    local p = getPart(egg)
    local d = eggData(egg.Name)
    if not p or not d then return end

    local gui = Instance.new("BillboardGui")
    gui.Name = "KOXTA_EggESP"
    gui.Size = UDim2.fromOffset(145,65)
    gui.StudsOffset = Vector3.new(0,2.8,0)
    gui.AlwaysOnTop = true
    gui.MaxDistance = ESP_DISTANCE
    gui.Adornee = p
    gui.Parent = egg

    local f = Instance.new("Frame")
    f.Size = UDim2.fromScale(1,1)
    f.BackgroundColor3 = Color3.fromRGB(12,12,17)
    f.BackgroundTransparency = .15
    f.BorderSizePixel = 0
    f.Parent = gui

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,7)
    c.Parent = f

    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(0,255,140)
    s.Thickness = 1.5
    s.Parent = f

    local function label(text,y,size,color)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1,-8,0,size)
        l.Position = UDim2.fromOffset(4,y)
        l.BackgroundTransparency = 1
        l.Font = Enum.Font.GothamBold
        l.Text = text
        l.TextSize = size <= 18 and 9 or 10
        l.TextColor3 = color
        l.TextXAlignment = Enum.TextXAlignment.Center
        l.TextTruncate = Enum.TextTruncate.AtEnd
        l.Parent = f
    end

    label("🥚 "..egg.Name,2,21,Color3.fromRGB(255,255,255))
    label("🍀 Lucky: "..d.Luck,23,18,Color3.fromRGB(80,255,140))
    label("⭐ "..d.Rarity,43,17,Color3.fromRGB(255,220,80))
end

local function grabEgg(player,egg)
    if not egg or not egg.Parent or not isEgg(egg) or isPlaced(egg) then return false end

    local root = getRoot(player)
    local part = getPart(egg)
    local prompt = getPrompt(egg)
    if not root or not part or not prompt then return false end

    if (root.Position-part.Position).Magnitude > math.max(prompt.MaxActivationDistance+12,AUTO_DISTANCE) then
        return false
    end

    if egg:GetAttribute("KOXTA_Collected") then return false end

    egg:SetAttribute("KOXTA_Collected",true)

    local stats = player:FindFirstChild("leaderstats")
    local d = eggData(egg.Name)
    if stats and d then
        local coins = stats:FindFirstChild("Coins") or stats:FindFirstChild("Money")
        if coins and (coins:IsA("IntValue") or coins:IsA("NumberValue")) then
            coins.Value += d.Value
        end
    end

    local base = basePart(player)
    if base and root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = CFrame.new(base.Position + Vector3.new(0,3,0))
    end

    task.defer(function()
        if egg and egg.Parent then egg:Destroy() end
    end)

    return true
end

