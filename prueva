--==============================================================
-- ACTUALIZAR INTERFAZ
--==============================================================

local function UpdateUI()
    if BestEgg and BestEgg.Parent then
        local data = GetEggData(BestEgg.Name)

        if data then
            EggName.Text = BestEgg.Name
            LuckyText.Text = "🍀 Lucky: " .. tostring(data.Luck)
            RarityText.Text = tostring(data.Rarity)
        end
    else
        EggName.Text = "Buscando..."
        LuckyText.Text = "🍀 Lucky: --"
        RarityText.Text = "--"
    end
end

--==============================================================
-- ANIMACIÓN DE CLICK MUY LIGERA
--==============================================================

local function ClickAnimation(button)
    local originalSize = button.Size

    TweenService:Create(
        button,
        TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            Size = UDim2.fromOffset(
                originalSize.X.Offset - 3,
                originalSize.Y.Offset - 2
            )
        }
    ):Play()

    task.delay(0.06, function()
        if button and button.Parent then
            TweenService:Create(
                button,
                TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                {Size = originalSize}
            ):Play()
        end
    end)
end

--==============================================================
-- ESTADO INSTA TP
--==============================================================

local function UpdateTPButton()
    if InstaTP then
        TPButton.Text = "INSTA TP   ON"
        TPButton.TextColor3 = Color3.fromRGB(225, 226, 230)
        TPStroke.Color = Color3.fromRGB(125, 126, 131)
    else
        TPButton.Text = "INSTA TP   OFF"
        TPButton.TextColor3 = Color3.fromRGB(215, 216, 220)
        TPStroke.Color = Color3.fromRGB(65, 66, 70)
    end
end

--==============================================================
-- ESTADO LOP
--==============================================================

local function UpdateLOPButton()
    if LOP then
        LOPButton.Text = "LOP   ON"
        LOPButton.TextColor3 = Color3.fromRGB(225, 226, 230)
        LOPStroke.Color = Color3.fromRGB(120, 121, 126)

