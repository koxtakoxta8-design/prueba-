--==============================================================
-- EJECUTAR
--==============================================================

local function Run()

    if Running then
        return
    end

    Running = true

    Status.Text =
        "Estado: GUARDANDO POSICIÓN..."

    if not SavePosition() then

        Status.Text =
            "Estado: ERROR"

        Running = false
        return
    end

    Status.Text =
        "Estado: ESCANEANDO WORKSPACE..."

    local best, amount =
        FindBestEgg()

    Count.Text =
        "Huevos encontrados: " ..
        tostring(amount)

    if not best then

        Status.Text =
            "Estado: NO ENCONTRÉ HUEVOS"

        Running = false
        return
    end

    Info.Text =
        "🥚 Mejor: " ..
        best.Name ..
        "\n🍀 Lucky: " ..
        best.Luck ..
        "\n⭐ Rareza: " ..
        best.Rarity

    Status.Text =
        "Estado: TP → " ..
        best.Name

    if not TeleportToEgg(best) then

        Status.Text =
            "Estado: ERROR TP"

        Unfreeze()

        Running = false
        return
    end

    Status.Text =
        "Estado: CONGELADO EN EL HUEVO"

    task.wait(2)

    -- Aquí queda detenido en el huevo.
    -- Cuando conectemos la interacción real de
    -- montar/recoger, se ejecutará aquí.

    Status.Text =
        "Estado: REGRESANDO"

    ReturnToStart()

    task.wait(0.25)

    Unfreeze()

    Status.Text =
        "Estado: TERMINADO"

    Running = false
end

