--============================================================--
--              RIDE A PET - AUTO EGG ULTRA                  --
--============================================================--
-- FLUJO:
--
-- MEJOR HUEVO
--      ↓
-- TP AL HUEVO
--      ↓
-- AGARRAR MUY RÁPIDO
--      ↓
-- ¿LO AGARRÓ?
--   NO ───────→ REINTENTAR
--   SI
--      ↓
-- TP CENTRO
--      ↓
-- DROP
--      ↓
-- ¿SE SOLTÓ?
--   NO ───────→ REINTENTAR DROP
--   SI
--      ↓
-- BUSCAR HUEVO
--      ↓
-- AGARRAR MUY RÁPIDO
--      ↓
-- ¿LO AGARRÓ?
--   NO ───────→ REINTENTAR
--   SI
--      ↓
-- PLOT
--      ↓
-- VELOCIDAD 500
--      ↓
-- DROP FINAL
--
--============================================================--

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--============================================================--
-- CONFIG
--============================================================--

local CENTER = Vector3.new(
    146.87,
    40316.12,
    911.14
)

local EXCLUSION_RADIUS = 210

-- VELOCIDAD FINAL AL PLOT
local PLOT_SPEED = 500

-- Tiempos muy pequeños para el agarre
local GRAB_DELAY = 0.08
local RETRY_DELAY = 0.12
local DROP_DELAY = 0.25

--============================================================--
-- HUEVOS
--============================================================--

local EggValues = {

    ["White Egg"] = 1,
    ["Brown Egg"] = 5,
    ["Cracked Egg"] = 30,
    ["Easter Egg"] = 50,
    ["Stone Egg"] = 100,
    ["Leaf Egg"] = 200,
    ["Mushroom Egg"] = 500,
    ["Flower Egg"] = 750,
    ["Slime Egg"] = 1000,
    ["Ice Egg"] = 3000,
    ["Glass Egg"] = 10000,
    ["Golden Egg"] = 30000,
    ["Crystal Egg"] = 150000,
    ["Skull Egg"] = 250000,
    ["Dominus Egg"] = 700000,
    ["Flaming Egg"] = 1000000,
    ["Sinister Egg"] = 3000000,
    ["Soul Egg"] = 7000000,
    ["Aurora Egg"] = 300000000,
    ["Galaxy Egg"] = 1500000000,
    ["Blackhole Egg"] = 100000000000,
    ["Solaris Egg"] = 300000000000,
    ["Cherub Egg"] = 1000000000000,
    ["Volcanic Egg"] = 2500000000000
}

--============================================================--
-- UTILIDADES
--============================================================--

local function getCharacter()

    return Player.Character
        or Player.CharacterAdded:Wait()

end

local function getRoot()

    local character = getCharacter()

    return character:FindFirstChild(
        "HumanoidRootPart"
    )

end

local function getPart(object)

    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    return object:FindFirstChildWhichIsA(
        "BasePart",
        true
    )

end

--============================================================--
-- DETECTAR HUEVO
--============================================================--

local function isEgg(object)

    if not object then
        return false
    end

    local name =
        string.lower(object.Name)

    return
        name:find("egg", 1, true) ~= nil
        or
        name:find("huevo", 1, true) ~= nil

end

--============================================================--
-- EXCLUSIÓN 210 STUDS
--============================================================--

local function isExcluded(position)

    return (
        position - CENTER
    ).Magnitude <= EXCLUSION_RADIUS

end

--============================================================--
-- VALOR HUEVO
--============================================================--

local function getEggValue(egg)

    local value = 0

    if not egg then
        return value
    end

    local eggName =
        string.lower(egg.Name)

    for name, amount in pairs(EggValues) do

        if eggName:find(
            string.lower(name),
            1,
            true
        ) then

            value =
                math.max(
                    value,
                    amount
                )

        end
    end

    -- Valores internos
    for _, obj in ipairs(
        egg:GetDescendants()
    ) do

        if obj:IsA("NumberValue")
        or obj:IsA("IntValue") then

            local name =
                string.lower(obj.Name)

            if name:find("luck", 1, true)
            or name:find("value", 1, true)
            or name:find("worth", 1, true)
            or name:find("rarity", 1, true)
            or name:find("eggvalue", 1, true) then

                value =
                    math.max(
                        value,
                        obj.Value
                    )

            end
        end
    end

    -- Attributes
    for _, attribute in ipairs({
        "Luck",
        "Value",
        "Worth",
        "Rarity",
        "EggValue"
    }) do

        local v =
            egg:GetAttribute(attribute)

        if typeof(v) == "number" then

            value =
                math.max(
                    value,
                    v
                )

        end
    end

    return value

end

--============================================================--
-- MEJOR HUEVO
--============================================================--

local function findBestEgg()

    local best = nil
    local bestValue = -1

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if isEgg(object) then

            local part =
                getPart(object)

            if part
            and not isExcluded(
                part.Position
            ) then

                local value =
                    getEggValue(object)

                if value > bestValue then

                    best =
                        object

                    bestValue =
                        value

                end
            end
        end
    end

    return best, bestValue

end

--============================================================--
-- TELEPORT
--============================================================--

local function teleportTo(position)

    local root =
        getRoot()

    if not root then
        return false
    end

    root.CFrame =
        CFrame.new(position)

    return true

end

--============================================================--
-- DROPEGG ORIGINAL
--============================================================--

local function triggerDropEggButton()

    local foundBtn = nil

    for _, gui in ipairs(
        PlayerGui:GetDescendants()
    ) do

        if gui:IsA("TextButton")
        or gui:IsA("ImageButton") then

            local guiName =
                string.lower(gui.Name)

            if guiName == "dropegg"
            or string.find(
                guiName,
                "dropegg",
                1,
                true
            ) then

                foundBtn = gui
                break

            end
        end
    end

    -- SISTEMA ORIGINAL
    if foundBtn then

        pcall(function()

            for _, conn in ipairs(
                getconnections(
                    foundBtn.MouseButton1Click
                )
            ) do

                conn:Fire()

            end

        end)

        pcall(function()

            for _, conn in ipairs(
                getconnections(
                    foundBtn.Activated
                )
            ) do

                conn:Fire()

            end

        end)

        return true
    end

    -- FALLBACK ORIGINAL
    pcall(function()

        local packages =
            ReplicatedStorage:FindFirstChild(
                "Packages"
            )

        local networking =
            packages
            and packages:FindFirstChild(
                "Networking"
            )

        local remote =
            networking
            and networking:FindFirstChild(
                "RF/EggWorld/AskFieldEggDrop"
            )

        if remote then

            remote:InvokeServer({
                Reason = "PlayerRequest"
            })

        end

    end)

    return false

end

--============================================================--
-- ENCONTRAR DROPEGG
--============================================================--

local function findDropButton()

    for _, gui in ipairs(
        PlayerGui:GetDescendants()
    ) do

        if gui:IsA("TextButton")
        or gui:IsA("ImageButton") then

            local name =
                string.lower(gui.Name)

            if (
                name == "dropegg"
                or name:find(
                    "dropegg",
                    1,
                    true
                )
            )
            and gui.Visible then

                return gui

            end
        end
    end

    return nil

end

--============================================================--
-- ESTADO: ¿ESTÁ LLEVANDO EL HUEVO?
--============================================================--

local function isCarryingEgg()

    -- Método principal:
    -- DropEgg aparece cuando llevamos el huevo.

    if findDropButton() then
        return true
    end

    -- Estados/atributos que tu juego pueda utilizar
    local character =
        getCharacter()

    local names = {
        "CarryingEgg",
        "HasEgg",
        "HoldingEgg",
        "Holding",
        "Carrying"
    }

    for _, name in ipairs(names) do

        local value =
            character:GetAttribute(name)

        if value == true then
            return true
        end

    end

    return false

end

--============================================================--
-- BOTONES DE AGARRE
--============================================================--

local function findGrabButtons()

    local result = {}

    local words = {

        "grab",
        "pickup",
        "pick up",
        "collect",
        "take",
        "steal",

        "agarr",
        "recoger",
        "coger",
        "tomar",
        "robar",

        "prendre",
        "ramasser",

        "nehmen",
        "aufheben",

        "prendere",
        "raccogliere",

        "pegar",
        "recolher"

    }

    for _, gui in ipairs(
        PlayerGui:GetDescendants()
    ) do

        if gui:IsA("TextButton")
        or gui:IsA("ImageButton") then

            if gui.Visible then

                local name =
                    string.lower(gui.Name)

                local text = ""

                if gui:IsA("TextButton") then
                    text =
                        string.lower(
                            gui.Text or ""
                        )
                end

                local combined =
                    name .. " " .. text

                for _, word in ipairs(words) do

                    if combined:find(
                        word,
                        1,
                        true
                    ) then

                        table.insert(
                            result,
                            gui
                        )

                        break

                    end
                end
            end
        end
    end

    return result

end

--============================================================--
-- INTENTO DE AGARRE
--============================================================--

local function attemptGrab(egg)

    if not egg then
        return false
    end

    local part =
        getPart(egg)

    if not part then
        return false
    end

    -- TP exacto al huevo
    teleportTo(
        part.Position
    )

    task.wait(
        GRAB_DELAY
    )

    --========================================================--
    -- PROXIMITY PROMPT
    --========================================================--

    for _, obj in ipairs(
        egg:GetDescendants()
    ) do

        if obj:IsA(
            "ProximityPrompt"
        ) then

            pcall(function()

                obj:InputHoldBegin()

                task.wait(
                    math.max(
                        obj.HoldDuration,
                        0.03
                    )
                )

                obj:InputHoldEnd()

            end)

        end
    end

    --========================================================--
    -- BOTONES
    --========================================================--

    for _, button in ipairs(
        findGrabButtons()
    ) do

        pcall(function()

            button:Activate()

        end)

    end

    task.wait(
        GRAB_DELAY
    )

    return isCarryingEgg()

end

--============================================================--
-- AGARRAR HASTA CONSEGUIRLO
--============================================================--

local function grabUntilSuccess(egg)

    print(
        "⚡ AGARRE ULTRA RÁPIDO"
    )

    while true do

        if not egg
        or not egg.Parent then

            print(
                "🔎 El huevo cambió, buscando otro..."
            )

            return false

        end

        if isCarryingEgg() then

            print(
                "✅ AGARRE CONFIRMADO"
            )

            return true

        end

        local success =
            attemptGrab(egg)

        if success then

            print(
                "✅ HUEVO AGARRADO"
            )

            return true

        end

        print(
            "❌ NO LO AGARRÓ → REINTENTANDO"
        )

        task.wait(
            RETRY_DELAY
        )

    end

end

--============================================================--
-- DROP HASTA CONSEGUIRLO
--============================================================--

local function dropUntilSuccess()

    while isCarryingEgg() do

        print(
            "📦 INTENTANDO DROP..."
        )

        triggerDropEggButton()

        task.wait(
            DROP_DELAY
        )

        if not isCarryingEgg() then

            print(
                "✅ DROP CONFIRMADO"
            )

            return true

        end

        print(
            "❌ NO SE SOLTÓ → REINTENTANDO"
        )

    end

    return true

end

--============================================================--
-- BUSCAR HUEVO CERCA DEL CENTRO
--============================================================--

local function findEggAtCenter()

    local closest = nil
    local closestDistance =
        math.huge

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if isEgg(object) then

            local part =
                getPart(object)

            if part then

                local distance =
                    (
                        part.Position
                        - CENTER
                    ).Magnitude

                if distance <
                    closestDistance then

                    closestDistance =
                        distance

                    closest =
                        object

                end
            end
        end
    end

    return closest

end

--============================================================--
-- BUSCAR PLOT
--============================================================--

local function belongsToPlayer(object)

    local attributes = {

        "Owner",
        "OwnerName",
        "Player",
        "PlayerName",
        "Username",
        "UserName",
        "UserId",
        "OwnerUserId"

    }

    for _, attribute in ipairs(
        attributes
    ) do

        local value =
            object:GetAttribute(
                attribute
            )

        if value ~= nil then

            if tostring(value)
                == Player.Name
            or tostring(value)
                == tostring(
                    Player.UserId
                ) then

                return true

            end
        end
    end

    for _, child in ipairs(
        object:GetDescendants()
    ) do

        if child:IsA(
            "ObjectValue"
        )
        and child.Value == Player then

            return true

        end
    end

    return false

end

local function findMyPlot()

    local names = {

        "Plot",
        "Plots",
        "Base",
        "Bases",
        "Tycoon",
        "Tycoons",
        "PlayerPlot",
        "MyPlot",
        "PlotBase",
        "PlotBycoon",
        "Bycoon",
        "BycoonPlot"

    }

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        local objectName =
            string.lower(
                object.Name
            )

        for _, name in ipairs(names) do

            if objectName ==
                string.lower(name)
            and belongsToPlayer(object) then

                return object

            end
        end
    end

    return nil

end

--============================================================--
-- POSICIÓN PLOT
--============================================================--

local function getPlotPosition(plot)

    if not plot then
        return nil
    end

    local names = {

        "Spawn",
        "SpawnLocation",
        "PlotSpawn",
        "SpawnPoint",
        "EggSpawn",
        "EggDrop",
        "Drop",
        "DropPoint",
        "Home",
        "HomeSpawn",
        "PetSpawn"

    }

    for _, name in ipairs(names) do

        local object =
            plot:FindFirstChild(
                name,
                true
            )

        if object
        and object:IsA(
            "BasePart"
        ) then

            return object.Position

        end
    end

    local part =
        plot:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if part then
        return part.Position
    end

    return nil

end

--============================================================--
-- MOVIMIENTO 500
--============================================================--

local function moveToPlot(position)

    local root =
        getRoot()

    if not root then
        return false
    end

    local start =
        root.Position

    local distance =
        (
            position - start
        ).Magnitude

    if distance <= 2 then
        return true
    end

    local duration =
        distance / PLOT_SPEED

    local startTime =
        os.clock()

    while true do

        root =
            getRoot()

        if not root then
            return false
        end

        local alpha =
            math.clamp(
                (
                    os.clock()
                    - startTime
                ) / duration,
                0,
                1
            )

        root.CFrame =
            CFrame.new(
                start:Lerp(
                    position,
                    alpha
                )
            )

        if alpha >= 1 then
            break
        end

        RunService.Heartbeat:Wait()

    end

    return true

end

--============================================================--
-- PROCESO PRINCIPAL
--============================================================--

local function start()

    print("")
    print("======================================")
    print("🥚 RIDE A PET AUTO EGG")
    print("======================================")

    --========================================================--
    -- 1. MEJOR HUEVO
    --========================================================--

    local egg, value =
        findBestEgg()

    if not egg then

        warn(
            "❌ No encontré ningún huevo."
        )

        return

    end

    print(
        "🥚 MEJOR:",
        egg.Name
    )

    print(
        "💰 VALOR:",
        value
    )

    --========================================================--
    -- 2. AGARRAR HASTA ÉXITO
    --========================================================--

    if not grabUntilSuccess(
        egg
    ) then

        return

    end

    --========================================================--
    -- 3. CENTRO
    --========================================================--

    print(
        "📍 TP CENTRO"
    )

    teleportTo(
        CENTER
    )

    task.wait(
        0.3
    )

    --========================================================--
    -- 4. DROP
    --========================================================--

    dropUntilSuccess()

    --========================================================--
    -- 5. BUSCAR NUEVAMENTE
    --========================================================--

    local centerEgg = nil

    repeat

        centerEgg =
            findEggAtCenter()

        if not centerEgg then
            task.wait(0.1)
        end

    until centerEgg

    print(
        "🥚 ENCONTRADO NUEVAMENTE:",
        centerEgg.Name
    )

    --========================================================--
    -- 6. AGARRAR NUEVAMENTE
    --========================================================--

    if not grabUntilSuccess(
        centerEgg
    ) then

        return

    end

    --========================================================--
    -- 7. PLOT
    --========================================================--

    local plot =
        findMyPlot()

    if not plot then

        warn(
            "❌ No encontré tu plot."
        )

        return

    end

    local plotPosition =
        getPlotPosition(
            plot
        )

    if not plotPosition then

        warn(
            "❌ No encontré la posición del plot."
        )

        return

    end

    --========================================================--
    -- 8. VELOCIDAD 500
    --========================================================--

    print(
        "🚀 DESPLAZAMIENTO: 500"
    )

    moveToPlot(
        plotPosition
        + Vector3.new(
            0,
            3,
            0
        )
    )

    task.wait(
        0.25
    )

    --========================================================--
    -- 9. DROP FINAL
    --========================================================--

    dropUntilSuccess()

    print("")
    print("======================================")
    print("✅ PROCESO COMPLETADO")
    print("======================================")

end

--============================================================--
-- INICIAR
--============================================================--

task.spawn(function()

    task.wait(1)

    start()

end)
