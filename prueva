local Lines = {}

local function CreateMotionLine(
    angle,
    radius,
    length
)

    local line =
        Instance.new("Frame")

    line.AnchorPoint =
        Vector2.new(
            0.5,
            0.5
        )

    line.Size =
        UDim2.fromOffset(
            length,
            2
        )

    line.Position =
        UDim2.new(
            0.5,
            math.cos(angle) * radius,
            0.5,
            math.sin(angle) * radius
        )

    line.Rotation =
        math.deg(angle)

    line.BackgroundColor3 =
        Color3.fromRGB(
            150,
            150,
            155
        )

    line.BackgroundTransparency =
        0.25

    line.BorderSizePixel = 0

    line.ZIndex = 0

    line.Parent =
        MotionLayer

    local corner =
        Instance.new("UICorner")

    corner.CornerRadius =
        UDim.new(
            1,
            0
        )

    corner.Parent =
        line

    table.insert(
        Lines,
        {
            Object = line,
            Angle = angle,
            Radius = radius,
            Speed = math.random(
                20,
                55
            ) / 100,
            Alpha = math.random(
                10,
                45
            ) / 100
        }
    )

end

