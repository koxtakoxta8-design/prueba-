        if data then
            EggName.Text = BestEgg.Name
            LuckyText.Text = "🍀 Lucky: " .. tostring(data.Luck)
            RarityText.Text = tostring(data.Rarity)

            local image = FindEggImage(BestEgg)

            if image then
                EggImage.Image = image
                EggFallback.Visible = false
            else
                EggImage.Image = ""
                EggFallback.Visible = true
            end
        end
    else
        EggName.Text = "Buscando..."
        LuckyText.Text = "🍀 Lucky: --"
        RarityText.Text = "--"
        EggImage.Image = ""
        EggFallback.Visible = true
    end
end

--==============================================================
-- ANIMACIÓN SIMPLE DE CLICK
--==============================================================

local function ClickAnimation(button)
    local oldSize = button.Size

    TweenService:Create(
        button,
        TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            Size = UDim2.fromOffset(
                oldSize.X.Offset - 3,
                oldSize.Y.Offset - 2
            )
        }
    ):Play()

    task.delay(0.06, function()
        if button and button.Parent then
            TweenService:Create(
                button,
                TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                {Size = oldSize}
            ):Play()
        end
    end)
end

