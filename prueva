local function refreshConfigList()
    for _, child in ipairs(ConfigListFrame:GetChildren()) do
        if child:IsA("TextButton") and child ~= CloseConfigBtn then child:Destroy() end
    end

    local allEggsList = {}
    for name, data in pairs(EggDatabase) do
        table.insert(allEggsList, {Name = name, Data = data})
    end
    table.sort(allEggsList, function(a, b) return a.Data.Rank > b.Data.Rank end)

    ConfigListFrame.CanvasSize = UDim2.fromOffset(0, (#allEggsList * 38) + 40)

    for _, item in ipairs(allEggsList) do
        local isSelected = autoFarmEggs[item.Name] == true

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -12, 0, 34)
