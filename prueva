--==================================================
-- ACCIÓN PRINCIPAL
--==================================================

local function RunRoute()

    if Running then
        return
    end

    Running = true

    Status.Text = "🔎 Buscando mejor huevo..."

    local record, lucky =
        GetBestSnapshotEgg()

    if not Enabled then
        Running = false
        return
    end

    if not record then

        Status.Text =
            "❌ No encontré un huevo de la lista."

        Running = false
        return
    end

    local position =
        GetRecordPosition(record)

    if not position then

        Status.Text =
            "❌ El huevo no tiene posición."

        Running = false
        return
    end

    local eggName =
        tostring(record.AssetCategory or "Egg")

    Status.Text =
        "🥚 " .. eggName ..
        "\n🍀 Lucky: " .. tostring(lucky)

    -- TP AL MEJOR HUEVO
    Teleport(position)

    task.wait(0.35)

    if not Enabled then
        Running = false
        return
    end

    -- INTENTAR RECOGER
    Status.Text =
        "🥚 Intentando recoger..."

    local collected =
        TryCollect(position)

    if collected then

        Status.Text =
            "✅ Recogido. Regresando..."

    else

        Status.Text =
            "⚠️ No encontré ProximityPrompt. Regresando..."

    end

    task.wait(0.35)

    if not Enabled then
        Running = false
        return
    end

    -- VOLVER A BASE
    local basePosition =
        GetBaseSpawn()

    if basePosition then

        Teleport(basePosition)

        Status.Text =
            "🏠 Regresé a la base."

    else

        Status.Text =
            "⚠️ No encontré el Spawn de la base."

    end

    Enabled = false
    Toggle.Text = "TP OFF"
    Toggle.BackgroundColor3 =
        Color3.fromRGB(170, 45, 45)

    Running = false
end

