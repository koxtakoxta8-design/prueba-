-- Declarados antes de los botones para que los callbacks usen la lógica real.
local manualFarmActive=false
local manualFarmThread=nil
local autoFarmActive=false
local autoFarmThread=nil
local TPButton,IsTP,SetTP
local LoopButton,IsLoop,SetLoop

local function stopManualFarmInternal(resetButton)
    manualFarmActive=false
    if manualFarmThread then
        pcall(task.cancel, manualFarmThread)
        manualFarmThread=nil
    end
    if resetButton and IsTP() then SetTP(false) end
end

local function stopAutoFarmInternal(resetButton)
    autoFarmActive=false
    if autoFarmThread then
        pcall(task.cancel, autoFarmThread)
        autoFarmThread=nil
    end
    if resetButton and IsLoop() then SetLoop(false) end
end

TPButton,IsTP,SetTP = CreateSwitch("TPButton","INSTA TP",UDim2.fromOffset(15,139),function(state)
    if state then
        stopManualFarmInternal(false)
        manualFarmActive=true
        setManualSwitchState(true)
        manualFarmThread=task.spawn(function()
            local eggObj=selectedTargetEgg
            local eggNameCaptured=""
            local eggRarityCaptured="Divine"
            local eggCostCaptured="---"
            if eggObj and eggObj.Parent then
                eggNameCaptured=eggObj.Name
                local data=getEggData(eggNameCaptured)
                eggRarityCaptured=translateRarity(data.Rarity)
                eggCostCaptured=data.Cost
            else
                local top10=getTop10EggsInServer()
                if #top10>0 then
                    eggObj=top10[1].Object
                    eggNameCaptured=top10[1].Name
                    eggRarityCaptured=translateRarity(top10[1].Data.Rarity)
                    eggCostCaptured=top10[1].Data.Cost
                    setTargetEgg(eggObj,eggNameCaptured,top10[1].Data)
                end
            end
            if eggObj and eggObj.Parent and manualFarmActive then
                local eggCF=eggObj:IsA("Model") and eggObj:GetPivot() or eggObj.CFrame
                if eggCF then
                    teleportToCF(eggCF)
                    task.wait(0.05)
                    executeIdaAutoGrab(eggObj,function() return manualFarmActive end)
                    if manualFarmActive then performAntiCheatAndReturn(eggNameCaptured,eggRarityCaptured,eggCostCaptured) end
                end
            end
            manualFarmActive=false
            manualFarmThread=nil
            setManualSwitchState(false)
            SetTP(false)
        end)
    else
        stopManualFarmInternal(false)
    end
end)

LoopButton,IsLoop,SetLoop = CreateSwitch("LoopButton","LOOP",UDim2.fromOffset(163,139),function(state)
    if state then
        stopAutoFarmInternal(false)
        autoFarmActive=true
        setAutoSwitchState(true)
        autoFarmThread=task.spawn(function()
            task.wait(1)
            while autoFarmActive do
                local foundValidEgg=nil
                local foundItemName=""
                local foundItemData=nil
                local allEggs={}
                for _,container in ipairs({Workspace:FindFirstChild("RenderedEggs"),Workspace:FindFirstChild("Shop"),Workspace:FindFirstChild("ShopEggs"),Workspace:FindFirstChild("Eggs")}) do
                    if container then
                        for _,egg in ipairs(container:GetChildren()) do
                            if egg:IsA("Model") or egg:IsA("BasePart") then
                                local data=getEggData(egg.Name)
                                table.insert(allEggs,{Object=egg,Name=egg.Name,Data=data})
                            end
                        end
                    end
                end
                table.sort(allEggs,function(a,b) return a.Data.Rank>b.Data.Rank end)
                for _,item in ipairs(allEggs) do
                    if autoFarmEggs[item.Name] then
                        foundValidEgg=item.Object
                        foundItemName=item.Name
                        foundItemData=item.Data
                        break
                    end
                end
                if foundValidEgg and foundValidEgg.Parent then
                    setTargetEgg(foundValidEgg,foundItemName,foundItemData)
                    local eggCF=foundValidEgg:IsA("Model") and foundValidEgg:GetPivot() or foundValidEgg.CFrame
                    if eggCF then
                        teleportToCF(eggCF)
                        task.wait(0.05)
                        executeIdaAutoGrab(foundValidEgg,function() return autoFarmActive end)
                        if autoFarmActive then performAntiCheatAndReturn(foundItemName,translateRarity(foundItemData.Rarity),foundItemData.Cost) end
                    end
                else
                    task.wait(2)
                end
                task.wait()
            end
            autoFarmThread=nil
        end)
    else
        stopAutoFarmInternal(false)
    end
end)

function setManualSwitchState(state)
    manualFarmActive=state
end
function setAutoSwitchState(state)
    autoFarmActive=state
end

function stopManualFarm()
    stopManualFarmInternal(true)
end

function stopAutoFarm()
    stopAutoFarmInternal(true)
end

-- Drag táctil / mouse.
local Dragging=false
local DragStart
local StartPosition
Main.InputBegan:Connect(function(Input)
    if Input.UserInputType==Enum.UserInputType.MouseButton1 or Input.UserInputType==Enum.UserInputType.Touch then
        Dragging=true
        DragStart=Input.Position
        StartPosition=Main.Position
        Input.Changed:Connect(function()
            if Input.UserInputState==Enum.UserInputState.End then Dragging=false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(Input)
    if not Dragging then return end
    if Input.UserInputType==Enum.UserInputType.MouseMovement or Input.UserInputType==Enum.UserInputType.Touch then
        local Delta=Input.Position-DragStart
        Main.Position=UDim2.new(StartPosition.X.Scale,StartPosition.X.Offset+Delta.X,StartPosition.Y.Scale,StartPosition.Y.Offset+Delta.Y)
    end
end)

