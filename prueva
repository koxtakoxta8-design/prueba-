--==============================================================
-- CANDIDATOS
--==============================================================

local Candidates = {}

local function AddCandidate(
    id,
    position,
    eggName,
    data,
    source
)

    if not position then
        return
    end

    if not eggName or not data then
        return
    end

    Candidates[id] = {
        Position = position,
        Name = eggName,
        Data = data,
        Source = source
    }
end

--==============================================================
-- ESCANEAR OBJETO Y PADRES
--==============================================================

local function InspectObject(obj)

    if not obj then
        return
    end

    local position =
        FindParentPosition(obj)

    if not position then
        return
    end

    --==========================================================
    -- NOMBRE
    --==========================================================

    local eggName, data =
        FindEggData(obj.Name)

    if eggName and data then

        AddCandidate(
            "NAME_" ..
            obj:GetFullName(),

            position,

            eggName,
            data,

            "Name"
        )
    end

    --==========================================================
    -- ATTRIBUTES
    --==========================================================

    for attributeName, value in pairs(
        obj:GetAttributes()
    ) do

        local foundName, foundData =
            FindEggData(value)

        if foundName then

            AddCandidate(
                "ATTR_" ..
                obj:GetFullName() ..
                "_" ..
                tostring(attributeName),

                position,

                foundName,
                foundData,

                "Attribute"
            )
        end

        foundName, foundData =
            FindEggData(attributeName)

        if foundName then

            AddCandidate(
                "ATTRNAME_" ..
                obj:GetFullName() ..
                "_" ..
                tostring(attributeName),

                position,

                foundName,
                foundData,

                "AttributeName"
            )
        end
    end

    --==========================================================
    -- STRING VALUE
    --==========================================================

    if obj:IsA("StringValue") then

        local foundName, foundData =
            FindEggData(obj.Value)

        if foundName then

            AddCandidate(
                "STRING_" ..
                obj:GetFullName(),

                position,

                foundName,
                foundData,

                "StringValue"
            )
        end
    end

    --==========================================================
    -- PROXIMITY PROMPT
    --==========================================================

    if obj:IsA("ProximityPrompt") then

        local foundName, foundData =
            FindEggData(
                obj.ObjectText
            )

        if not foundName then

            foundName, foundData =
                FindEggData(
                    obj.ActionText
                )
        end

        if not foundName then

            foundName, foundData =
                FindEggData(
                    obj.Parent and
                    obj.Parent.Name
                )
        end

        if foundName then

            AddCandidate(
                "PROMPT_" ..
                obj:GetFullName(),

                position,

                foundName,
                foundData,

                "Prompt"
            )
        end
    end

    --==========================================================
    -- TEXT
    --==========================================================

    if obj:IsA("TextLabel")
    or obj:IsA("TextButton")
    or obj:IsA("TextBox") then

        local foundName, foundData =
            FindEggData(obj.Text)

        if foundName then

            AddCandidate(
                "TEXT_" ..
                obj:GetFullName(),

                position,

                foundName,
                foundData,

                "Text"
            )
        end
    end
end

--==============================================================
-- WORKSPACE COMPLETO
--==============================================================

local function ScanWorkspace()

    for _, obj in ipairs(
        Workspace:GetDescendants()
    ) do

        InspectObject(obj)
    end
end

--==============================================================
-- SNAPSHOT
--==============================================================

local function ScanSnapshot()

    if not SnapshotRemote then
        return
    end

    local success, snapshot =
        pcall(function()

            return SnapshotRemote:InvokeServer()

        end)

    if not success then
        return
    end

    if type(snapshot) ~= "table" then
        return
    end

    local records =
        snapshot.Records or snapshot

    if type(records) ~= "table" then
        return
    end

    for index, rec in ipairs(records) do

        if type(rec) == "table" then

            local position

            -- BottomCFrame
            if typeof(
                rec.BottomCFrame
            ) == "CFrame" then

                position =
                    rec.BottomCFrame.Position

            elseif typeof(
                rec.BottomCFrame
            ) == "Vector3" then

                position =
                    rec.BottomCFrame
            end

            if position then

                local eggName, data

                -- AssetCategory
                eggName, data =
                    FindEggData(
                        rec.AssetCategory
                    )

                -- Name
                if not eggName then

                    eggName, data =
                        FindEggData(
                            rec.Name
                        )
                end

                -- DisplayName
                if not eggName then

                    eggName, data =
                        FindEggData(
                            rec.DisplayName
                        )
                end

                -- EggName
                if not eggName then

                    eggName, data =
                        FindEggData(
                            rec.EggName
                        )
                end

                if eggName and data then

                    AddCandidate(
                        "SNAPSHOT_" ..
                        tostring(index),

                        position,

                        eggName,
                        data,

                        "Snapshot"
                    )
                end
            end
        end
    end
end

--==============================================================
-- ELIMINAR DUPLICADOS POR POSICIÓN
--==============================================================

local function RemoveDuplicates()

    local result = {}

    for id, candidate in pairs(
        Candidates
    ) do

        local duplicate = false

        for otherId, other in pairs(
            result
        ) do

            local distance =
                (
                    candidate.Position -
                    other.Position
                ).Magnitude

            if distance < 3 then

                -- Conservamos la fuente
                -- que tenga prioridad.

                local priority = {
                    Snapshot = 4,
                    Prompt = 3,
                    Attribute = 2,
                    Text = 1,
                    Name = 1
                }

                local p1 =
                    priority[candidate.Source]
                    or 0

                local p2 =
                    priority[other.Source]
                    or 0

                if p1 > p2 then
                    result[otherId] =
                        candidate
                end

                duplicate = true
                break
            end
        end

        if not duplicate then
            result[id] = candidate
        end
    end

    Candidates = result
end

