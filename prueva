--==============================================================
-- CONVERTIR LUCK
--==============================================================

local function LuckNumber(value)

    local text = tostring(value or "0")

    local number =
        tonumber(
            text:match("[%d%.]+")
        ) or 0

    if text:find("T") then
        return number * 1e12
    end

    if text:find("B") then
        return number * 1e9
    end

    if text:find("M") then
        return number * 1e6
    end

    if text:find("K") then
        return number * 1e3
    end

    return number
end

--==============================================================
-- CATÁLOGO
--==============================================================

local Catalog = {}

pcall(function()

    local Data =
        ReplicatedStorage:FindFirstChild("Data")

    if not Data then
        return
    end

    local Assets =
        Data:FindFirstChild("Assets")

    if not Assets then
        return
    end

    local module =
        require(Assets)

    if type(module) == "table"
    and type(module.Directory) == "table" then

        Catalog =
            module.Directory
    end
end)

--==============================================================
-- OBTENER DATOS DEL ASSET
--==============================================================

local function GetAssetData(assetCategory)

    local key =
        tostring(assetCategory or "")

    local entry =
        Catalog[key]

    if type(entry) == "table" then

        local name =
            entry.DisplayName
            or entry._id
            or key

        local rarity = "Common"

        if type(entry.Rarity) == "table" then

            rarity =
                entry.Rarity.DisplayName
                or entry.Rarity._id
                or "Common"

        elseif entry.Rarity then

            rarity =
                tostring(entry.Rarity)
        end

        local luck =
            entry.Luck
            or entry.Lucky
            or entry.LuckMultiplier

        if luck then

            return {
                Name = tostring(name),
                Luck = tostring(luck),
                LuckNumber = LuckNumber(luck),
                Rarity = rarity
            }
        end
    end

    -- Buscar por nombre conocido

    for eggName, data in pairs(EggData) do

        if key:lower():find(
            eggName:lower(),
            1,
            true
        ) then

            return {
                Name = eggName,
                Luck = data.Luck,
                LuckNumber =
                    LuckNumber(data.Luck),
                Rarity = data.Rarity
            }
        end
    end

    return nil
end

--==============================================================
-- SNAPSHOT
--==============================================================

local function GetSnapshot()

    if not SnapshotRemote then

        warn(
            "KOXTA: AskFieldEggSnapshot no encontrado"
        )

        return nil
    end

    local success, result =
        pcall(function()

            return SnapshotRemote:InvokeServer()

        end)

    if not success then

        warn(
            "KOXTA: fallo InvokeServer"
        )

        return nil
    end

    if type(result) ~= "table" then
        return nil
    end

    return result
end

--==============================================================
-- DETECTAR TODOS LOS HUEVOS
--==============================================================

local function GetAllEggs()

    local snapshot =
        GetSnapshot()

    if not snapshot then
        return {}
    end

    local records =
        snapshot.Records or snapshot

    if type(records) ~= "table" then
        return {}
    end

    local eggs = {}

    for _, record in ipairs(records) do

        if type(record) == "table"
        and record.State == "Slot"
        and record.BottomCFrame then

            local position

            if typeof(
                record.BottomCFrame
            ) == "CFrame" then

                position =
                    record.BottomCFrame.Position

            elseif typeof(
                record.BottomCFrame
            ) == "Vector3" then

                position =
                    record.BottomCFrame
            end

            if position then

                local info =
                    GetAssetData(
                        record.AssetCategory
                    )

                if info then

                    table.insert(
                        eggs,
                        {
                            Position = position,
                            Name = info.Name,
                            Luck = info.Luck,
                            LuckNumber =
                                info.LuckNumber,
                            Rarity = info.Rarity,
                            Record = record,
                            AssetCategory =
                                record.AssetCategory
                        }
                    )
                end
            end
        end
    end

    return eggs
end

--==============================================================
-- MEJOR HUEVO
--==============================================================

local function FindBestEgg()

    local eggs =
        GetAllEggs()

    local best = nil

    for _, egg in ipairs(eggs) do

        if not best
        or egg.LuckNumber >
           best.LuckNumber then

            best = egg
        end
    end

    return best, #eggs
end

--==============================================================
-- ROOT
--==============================================================

local function GetRoot()

    local character =
        Player.Character

    if not character then
        return nil
    end

    return character:FindFirstChild(
        "HumanoidRootPart"
    )
end

--==============================================================
-- GUARDAR POSICIÓN
--==============================================================

local function SaveReturnPosition()

    local root =
        GetRoot()

    if not root then
        return false
    end

    ReturnCFrame =
        root.CFrame

    return true
end

--==============================================================
-- CONGELAR
--==============================================================

local function FreezeCharacter()

    local character =
        Player.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not humanoid then
        return
    end

    humanoid:SetAttribute(
        "KOXTA_OLD_SPEED",
        humanoid.WalkSpeed
    )

    humanoid:SetAttribute(
        "KOXTA_OLD_JUMP",
        humanoid.JumpPower
    )

    humanoid:SetAttribute(
        "KOXTA_OLD_ROTATE",
        humanoid.AutoRotate
    )

    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.AutoRotate = false

    if root then

        root.AssemblyLinearVelocity =
            Vector3.zero

        root.AssemblyAngularVelocity =
            Vector3.zero
    end
end

--==============================================================
-- DESCONGELAR
--==============================================================

local function UnfreezeCharacter()

    local character =
        Player.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return
    end

    humanoid.WalkSpeed =
        humanoid:GetAttribute(
            "KOXTA_OLD_SPEED"
        ) or 16

    humanoid.JumpPower =
        humanoid:GetAttribute(
            "KOXTA_OLD_JUMP"
        ) or 50

    local rotate =
        humanoid:GetAttribute(
            "KOXTA_OLD_ROTATE"
        )

    if rotate == nil then
        humanoid.AutoRotate = true
    else
        humanoid.AutoRotate = rotate
    end
end

--==============================================================
-- TP
--==============================================================

local function TeleportToEgg(egg)

    local root =
        GetRoot()

    if not root
    or not egg
    or not egg.Position then

        return false
    end

    root.CFrame =
        CFrame.new(
            egg.Position +
            Vector3.new(0, 3, 0)
        )

    task.wait()

    FreezeCharacter()

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

--==============================================================
-- REGRESAR
--==============================================================

local function ReturnToBase()

    local root =
        GetRoot()

    if not root
    or not ReturnCFrame then

        return false
    end

    root.CFrame =
        ReturnCFrame

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

