--==============================================================

local function TeleportToEgg(egg)

    local root =
        GetRoot()

    local position =
        GetPosition(egg)

    if not root or not position then
        return false
    end

    root.CFrame =
        CFrame.new(
            position +
            Vector3.new(0, 2.5, 0)
        )

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

--==============================================================
-- TP AL SPAWN
--==============================================================

local function ReturnToSpawn()

    local root =
        GetRoot()

    if not root or
        not SavedSpawnCFrame then

        return false
    end

    root.CFrame =
        SavedSpawnCFrame

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

--==============================================================
-- FREEZE
--==============================================================

local function FreezeCharacter()

    local character =
        LocalPlayer.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if humanoid then

        humanoid.AutoRotate = false
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.JumpHeight = 0

    end

    if root then

        root.AssemblyLinearVelocity =
            Vector3.zero

        root.AssemblyAngularVelocity =
            Vector3.zero

    end

end

local function UnfreezeCharacter()

    local character =
        LocalPlayer.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if humanoid then

        humanoid.AutoRotate = true
        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50
        humanoid.JumpHeight = 7.2

    end

end

--==============================================================
-- BUSCAR PROMPT
--==============================================================

local function FindGrabPrompt(egg)

    if not egg then
        return nil
    end

    for _, obj in ipairs(
        egg:GetDescendants()
    ) do

        if obj:IsA(
            "ProximityPrompt"
        ) then

            local text =
                string.lower(
                    tostring(
                        obj.ActionText
                    )
                    .. " "
                    ..
                    tostring(
                        obj.ObjectText
                    )
                )

            if
                string.find(
                    text,
                    "grab",
                    1,
                    true
                )
                or
                string.find(
                    text,
                    "pick",
                    1,
                    true
                )
                or
                string.find(
                    text,
                    "collect",
                    1,
                    true
                )
                or
                string.find(
                    text,
                    "recoger",
                    1,
                    true
                )
                or
                string.find(
                    text,
                    "agarrar",
                    1,
                    true
                )
                or
                string.find(
                    text,
                    "tomar",
                    1,
                    true
                )
            then

                return obj

            end

        end

    end

    return nil
end

--==============================================================
-- AUTO GRAB x3
--==============================================================

local function AutoGrab(egg)

    local prompt =
        FindGrabPrompt(egg)

    if not prompt then
        return false
    end

    FreezeCharacter()

    pcall(function()
        prompt.HoldDuration = 0
    end)

    for i = 1, 3 do

        if not InstaTP then
            break
        end

        pcall(function()
            prompt:InputHoldBegin()
        end)

        task.wait(0.08)

        pcall(function()
            prompt:InputHoldEnd()
        end)

        task.wait(0.08)

    end

    return true
end

