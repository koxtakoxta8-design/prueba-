local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--==================================================
-- CONFIG
--==================================================

local CENTER = Vector3.new(
    146.87,
    40316.12,
    911.14
)

local EXCLUSION_RADIUS = 210
local PLOT_SPEED = 1000

--==================================================
-- VALORES
--==================================================

local EggValues = {
    ["White Egg"] = 1,
    ["Brown Egg"] = 5,
    ["Cracked Egg"] = 30,
    ["Easter Egg"] = 50,
    ["Stone Egg"] = 100,
    ["Leaf Egg"] = 200,
    ["Mushroom Egg"] = 500,
    ["Flower Egg"] = 750,
    ["Slime Egg"] = 1000,
    ["Ice Egg"] = 3000,
    ["Glass Egg"] = 10000,
    ["Golden Egg"] = 30000,
    ["Crystal Egg"] = 150000,
    ["Skull Egg"] = 250000,
    ["Dominus Egg"] = 700000,
    ["Flaming Egg"] = 1000000,
    ["Sinister Egg"] = 3000000,
    ["Soul Egg"] = 7000000,
    ["Aurora Egg"] = 300000000,
    ["Galaxy Egg"] = 1500000000,
    ["Blackhole Egg"] = 100000000000,
    ["Solaris Egg"] = 300000000000,
    ["Cherub Egg"] = 1000000000000,
    ["Volcanic Egg"] = 2500000000000
}

--==================================================
-- ROOT
--==================================================

local function getRoot()

    local character =
        Player.Character
        or Player.CharacterAdded:Wait()

    return character:FindFirstChild(
        "HumanoidRootPart"
    )
end

--==================================================
-- DETECTAR HUEVO
--==================================================

local function isEgg(obj)

    local name =
        obj.Name:lower()

    return name:find(
        "egg",
        1,
        true
    ) ~= nil
    or name:find(
        "huevo",
        1,
        true
    ) ~= nil
end

--==================================================
-- PARTE DEL HUEVO
--==================================================

local function getEggPart(egg)

    if not egg then
        return nil
    end

    if egg:IsA("BasePart") then
        return egg
    end

    return egg:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

--==================================================
-- VALOR
--==================================================

local function getEggValue(egg)

    local name =
        egg.Name:lower()

    local value = 0

    for eggName, eggValue in pairs(EggValues) do

        if name:find(
            eggName:lower(),
            1,
            true
        ) then

            value =
                math.max(
                    value,
                    eggValue
                )
        end
    end

    for _, obj in ipairs(
        egg:GetDescendants()
    ) do

        if obj:IsA("NumberValue")
            or obj:IsA("IntValue") then

            local n =
                obj.Name:lower()

            if n:find("luck", 1, true)
                or n:find("value", 1, true)
                or n:find("worth", 1, true) then

                value =
                    math.max(
                        value,
                        obj.Value
                    )
            end
        end
    end

    return value
end

--==================================================
-- EXCLUSIÓN
--==================================================

local function isInsideExclusion(position)

    return (
        position - CENTER
    ).Magnitude <= EXCLUSION_RADIUS
end

--==================================================
-- MEJOR HUEVO
--==================================================

local function findBestEgg()

    local bestEgg
    local bestValue = -1

    for _, obj in ipairs(
        workspace:GetDescendants()
    ) do

        if isEgg(obj) then

            local part =
                getEggPart(obj)

            if part
                and not isInsideExclusion(
                    part.Position
                ) then

                local value =
                    getEggValue(obj)

                if value > bestValue then

                    bestValue = value
                    bestEgg = obj

                end
            end
        end
    end

    return bestEgg, bestValue
end

--==================================================
-- TP
--==================================================

local function teleportTo(position)

    local root =
        getRoot()

    if not root then
        return false
    end

    root.CFrame =
        CFrame.new(position)

    return true
end

--==================================================
-- MOVIMIENTO 1000
--==================================================

local function moveTo(position)

    local root =
        getRoot()

    if not root then
        return false
    end

    local startPosition =
        root.Position

    local distance =
        (
            position
            - startPosition
        ).Magnitude

    if distance <= 1 then

        root.CFrame =
            CFrame.new(position)

        return true
    end

    local duration =
        distance / PLOT_SPEED

    local startTime =
        os.clock()

    while true do

        root =
            getRoot()

        if not root then
            return false
        end

        local alpha =
            math.clamp(
                (
                    os.clock()
                    - startTime
                ) / duration,
                0,
                1
            )

        local current =
            startPosition:Lerp(
                position,
                alpha
            )

        root.CFrame =
            CFrame.new(current)

        if alpha >= 1 then
            break
        end

        RunService.Heartbeat:Wait()
    end

    return true
end

--==================================================
-- AGARRAR
--==================================================

local function grabEgg(egg)

    if not egg then
        return false
    end

    for _, obj in ipairs(
        egg:GetDescendants()
    ) do

        if obj:IsA(
            "ProximityPrompt"
        ) then

            pcall(function()
                fireproximityprompt(obj)
            end)

        elseif obj:IsA(
            "ClickDetector"
        ) then

            pcall(function()
                fireclickdetector(obj)
            end)
        end
    end

    return true
end

--==================================================
-- DROP EGG
--==================================================

local function triggerDropEggButton()

    local foundButton = nil

    -- Buscar DropEgg
    for _, gui in ipairs(
        PlayerGui:GetDescendants()
    ) do

        if gui:IsA("TextButton")
            or gui:IsA("ImageButton") then

            local name =
                gui.Name:lower()

            if name == "dropegg"
                or name:find(
                    "dropegg",
                    1,
                    true
                ) then

                if gui.Visible then

                    foundButton = gui
                    break

                end
            end
        end
    end

    --==============================================
    -- BOTÓN
    --==============================================

    if foundButton then

        pcall(function()
            foundButton:Activate()
        end)

        pcall(function()

            for _, connection in ipairs(
                getconnections(
                    foundButton.Activated
                )
            ) do

                connection:Fire()

            end

        end)

        pcall(function()

            for _, connection in ipairs(
                getconnections(
                    foundButton.MouseButton1Click
                )
            ) do

                connection:Fire()

            end

        end)

        return true
    end

    --==============================================
    -- REMOTE
    --==============================================

    local packages =
        ReplicatedStorage:FindFirstChild(
            "Packages"
        )

    local networking =
        packages
        and packages:FindFirstChild(
            "Networking"
        )

    local remote =
        networking
        and networking:FindFirstChild(
            "RF/EggWorld/AskFieldEggDrop"
        )

    if remote then

        local success =
            pcall(function()

                remote:InvokeServer({
                    Reason = "PlayerRequest"
                })

            end)

        if success then
            return true
        end
    end

    return false
end

--==================================================
-- BUSCAR HUEVO CERCA DEL CENTRO
--==================================================

local function findEggNearCenter()

    local closestEgg = nil
    local closestDistance = math.huge

    for _, obj in ipairs(
        workspace:GetDescendants()
    ) do

        if isEgg(obj) then

            local part =
                getEggPart(obj)

            if part then

                local distance =
                    (
                        part.Position
                        - CENTER
                    ).Magnitude

                if distance < closestDistance then

                    closestDistance =
                        distance

                    closestEgg =
                        obj

                end
            end
        end
    end

    return closestEgg
end

--==================================================
-- ESPERAR HUEVO EN CENTRO
--==================================================

local function waitForEggNearCenter()

    local timeout = 5
    local start = os.clock()

    while os.clock() - start < timeout do

        local egg =
            findEggNearCenter()

        if egg then
            return egg
        end

        task.wait(0.1)
    end

    return nil
end

--==================================================
-- PLOT
--==================================================

local function findMyPlot()

    local plotNames = {
        "Plot",
        "Plots",
        "Base",
        "Bases",
        "Tycoon",
        "Tycoons",
        "PlayerPlot",
        "MyPlot",
        "PlotBase",
        "PlotBycoon"
    }

    local ownerAttributes = {
        "Owner",
        "OwnerName",
        "Player",
        "PlayerName",
        "Username",
        "UserName",
        "UserId",
        "OwnerUserId"
    }

    for _, obj in ipairs(
        workspace:GetDescendants()
    ) do

        local objectName =
            obj.Name:lower()

        for _, plotName in ipairs(
            plotNames
        ) do

            if objectName ==
                plotName:lower() then

                for _, attribute in ipairs(
                    ownerAttributes
                ) do

                    local owner =
                        obj:GetAttribute(
                            attribute
                        )

                    if owner ~= nil then

                        if tostring(owner)
                            == Player.Name
                            or tostring(owner)
                            == tostring(
                                Player.UserId
                            ) then

                            return obj

                        end
                    end
                end

                for _, child in ipairs(
                    obj:GetDescendants()
                ) do

                    if child:IsA(
                        "ObjectValue"
                    )
                    and child.Value
                        == Player then

                        return obj
                    end
                end
            end
        end
    end

    return nil
end

--==================================================
-- POSICIÓN PLOT
--==================================================

local function getPlotPosition(plot)

    if not plot then
        return nil
    end

    local names = {
        "Spawn",
        "SpawnLocation",
        "PlotSpawn",
        "SpawnPoint",
        "Drop",
        "DropPoint",
        "EggDrop"
    }

    for _, name in ipairs(names) do

        local obj =
            plot:FindFirstChild(
                name,
                true
            )

        if obj
            and obj:IsA("BasePart") then

            return obj.Position

        end
    end

    local part =
        plot:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    return part
        and part.Position
end

--==================================================
-- CICLO
--==================================================

local function start()

    --==============================================
    -- 1. MEJOR HUEVO
    --==============================================

    print(
        "🔎 Buscando mejor huevo..."
    )

    local egg, value =
        findBestEgg()

    if not egg then

        warn(
            "❌ No encontré huevo."
        )

        return
    end

    local part =
        getEggPart(egg)

    if not part then
        return
    end

    print(
        "🥚",
        egg.Name,
        "|",
        value
    )

    --==============================================
    -- 2. TP AL HUEVO
    --==============================================

    teleportTo(
        part.Position
    )

    task.wait(0.2)

    --==============================================
    -- 3. AGARRAR
    --==============================================

    grabEgg(egg)

    task.wait(0.5)

    --==============================================
    -- 4. TP CENTRO
    --==============================================

    print("📍 TP CENTRO")

    teleportTo(CENTER)

    task.wait(0.5)

    --==============================================
    -- 5. DROP
    --==============================================

    print("📦 DROP")

    triggerDropEggButton()

    task.wait(0.8)

    --==============================================
    -- 6. BUSCAR NUEVA REFERENCIA
    --==============================================

    print(
        "🔎 Buscando huevo después del drop..."
    )

    local newEgg =
        waitForEggNearCenter()

    if not newEgg then

        warn(
            "❌ No encontré el huevo después de soltarlo."
        )

        return
    end

    local newPart =
        getEggPart(newEgg)

    if not newPart then

        warn(
            "❌ El nuevo huevo no tiene parte."
        )

        return
    end

    print(
        "🥚 Encontrado nuevamente:",
        newEgg.Name
    )

    --==============================================
    -- 7. TP AL HUEVO DROPEADO
    --==============================================

    teleportTo(
        newPart.Position
    )

    task.wait(0.2)

    --==============================================
    -- 8. AGARRAR NUEVAMENTE
    --==============================================

    print(
        "✋ AGARRANDO NUEVAMENTE..."
    )

    grabEgg(newEgg)

    task.wait(0.8)

    --==============================================
    -- 9. COMPROBAR QUE SIGUE CERCA DEL JUGADOR
    --==============================================

    local root =
        getRoot()

    if not root then
        return
    end

    local distance =
        (
            newPart.Position
            - root.Position
        ).Magnitude

    print(
        "📏 Distancia:",
        math.floor(distance)
    )

    --==============================================
    -- 10. PLOT
    --==============================================

    local plot =
        findMyPlot()

    if not plot then

        warn(
            "❌ No encontré tu plot."
        )

        return
    end

    local plotPosition =
        getPlotPosition(plot)

    if not plotPosition then

        warn(
            "❌ No encontré posición del plot."
        )

        return
    end

    --==============================================
    -- 11. DESPLAZAMIENTO 1000
    --==============================================

    print(
        "🚀 DESPLAZAMIENTO 1000"
    )

    moveTo(
        plotPosition
            + Vector3.new(
                0,
                3,
                0
            )
    )

    task.wait(0.5)

    --==============================================
    -- 12. DROP FINAL
    --==============================================

    print(
        "📦 DROP FINAL"
    )

    triggerDropEggButton()

    print(
        "✅ TERMINADO"
    )
end

start()
