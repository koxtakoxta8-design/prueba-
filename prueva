--==============================================================
-- ACTUALIZAR
--==============================================================

local function Refresh()

    if not ENABLED then
        return
    end

    ClearESP()

    Candidates = {}

    -- Workspace
    pcall(function()
        ScanWorkspace()
    end)

    -- Snapshot
    pcall(function()
        ScanSnapshot()
    end)

    RemoveDuplicates()

    --==========================================================
    -- ENCONTRAR MEJOR
    --==========================================================

    local bestId = nil
    local bestLuck = -1

    for id,candidate in pairs(
        Candidates
    ) do

        if candidate.Data.Luck >
            bestLuck then

            bestLuck =
                candidate.Data.Luck

            bestId =
                id
        end
    end

    --==========================================================
    -- CREAR CARTEL
    --==========================================================

    local count = 0

    for id,candidate in pairs(
        Candidates
    ) do

        count += 1

        if count <= MAX_ESP then

            CreateESP(
                id,
                candidate,
                id == bestId
            )
        end
    end

    return count,bestId,bestLuck
end

