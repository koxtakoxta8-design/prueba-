--==============================================================
-- EJECUTAR
--==============================================================

local function Run()

    if Running then
        return
    end

    Running = true

    ----------------------------------------------------------
    -- GUARDAR PUNTO ORIGINAL
    ----------------------------------------------------------

    if not SaveReturnPosition() then

        Status.Text =
            "Estado: ERROR POSICIÓN"

        Running = false
        return
    end

    ----------------------------------------------------------
    -- BUSCAR
    ----------------------------------------------------------

    Status.Text =
        "Estado: ESCANEANDO..."

    local egg, amount =
        FindBestEgg()

    Count.Text =
        "Huevos detectados: " ..
        tostring(amount)

    if not egg then

        Info.Text =
            "🥚 Mejor: NO ENCONTRADO\n" ..
            "🍀 Lucky: ---\n" ..
            "⭐ Rareza: ---"

        Status.Text =
            "Estado: NO SE DETECTARON HUEVOS"

        Running = false
        return
    end

    ----------------------------------------------------------
    -- MOSTRAR
    ----------------------------------------------------------

    Info.Text =
        "🥚 Mejor: " ..
        egg.Name ..
        "\n🍀 Lucky: " ..
        egg.Luck ..
        "\n⭐ Rareza: " ..
        egg.Rarity

    ----------------------------------------------------------
    -- TP
    ----------------------------------------------------------

    Status.Text =
        "Estado: TP AL MEJOR HUEVO"

    if not TeleportToEgg(egg) then

        Status.Text =
            "Estado: ERROR TP"

        UnfreezeCharacter()

        Running = false
        return
    end

    ----------------------------------------------------------
    -- CONGELADO
    ----------------------------------------------------------

    Status.Text =
        "Estado: CONGELADO EN EL HUEVO"

    task.wait(1)

    ----------------------------------------------------------
    -- AQUÍ FALTA EL REMOTE REAL DE GRAB
    ----------------------------------------------------------

    Status.Text =
        "Estado: ESPERANDO GRAB"

    task.wait(1)

    ----------------------------------------------------------
    -- REGRESAR
    ----------------------------------------------------------

    Status.Text =
        "Estado: REGRESANDO"

    ReturnToBase()

    task.wait(.2)

    UnfreezeCharacter()

    Status.Text =
        "Estado: TERMINADO"

    Running = false
end

