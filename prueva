--------------------------------------------------
-- CHARACTER
--------------------------------------------------

local function getCharacter()
	local Character = Player.Character
	if not Character then
		return nil, nil
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")
	return Character, Root
end

--------------------------------------------------
-- EGG
--------------------------------------------------

local function getEggPosition(Egg)
	if not Egg then
		return nil
	end

	if Egg:IsA("BasePart") then
		return Egg.Position
	end

	if Egg:IsA("Model") then
		return Egg:GetPivot().Position
	end

	local Part = Egg:FindFirstChildWhichIsA("BasePart", true)

	if Part then
		return Part.Position
	end

	return nil
end

local function getEggValue(Egg)
	if EggValues[Egg.Name] then
		return EggValues[Egg.Name]
	end

	local Attribute = Egg:GetAttribute("EggName")

	if typeof(Attribute) == "string" then
		return EggValues[Attribute]
	end

	return nil
end

local function isEgg(Egg)
	return getEggValue(Egg) ~= nil
end

local function isForbidden(Position)
	return (Position - CENTER).Magnitude <= EXCLUSION_RADIUS
end

--------------------------------------------------
-- FIND BEST EGG
--------------------------------------------------

local function findBestEgg()
	local BestEgg = nil
	local BestValue = -1

	for _, Object in ipairs(workspace:GetDescendants()) do

		if not Enabled then
			return nil
		end

		if isEgg(Object) then

			local Position = getEggPosition(Object)

			if Position and not isForbidden(Position) then

				local Value = getEggValue(Object)

				if Value and Value > BestValue then
					BestValue = Value
					BestEgg = Object
				end
			end
		end
	end

	return BestEgg
end

--------------------------------------------------
-- TP
--------------------------------------------------

local function teleportTo(Position)
	if not Enabled then
		return false
	end

	local Character, Root = getCharacter()

	if not Character or not Root then
		return false
	end

	Character:PivotTo(
		CFrame.new(Position + Vector3.new(0, 2, 0))
	)

	return true
end

--------------------------------------------------
-- FIND GRAB PROMPT
--------------------------------------------------

local GrabWords = {
	"grab",
	"pick",
	"pickup",
	"collect",
	"take",
	"get",
	"recoger",
	"agarrar",
	"tomar",
	"coger",
	"levantar"
}

local function isGrabPrompt(Prompt)

	if not Prompt:IsA("ProximityPrompt") then
		return false
	end

	local Text = string.lower(
		tostring(Prompt.ActionText) ..
		" " ..
		tostring(Prompt.ObjectText) ..
		" " ..
		tostring(Prompt.Name)
	)

	for _, Word in ipairs(GrabWords) do
		if string.find(Text, Word, 1, true) then
			return true
		end
	end

	return false
end

--------------------------------------------------
-- GRAB
--------------------------------------------------

local function grabEgg(Egg)

	if not Enabled or not Egg or not Egg.Parent then
		return false
	end

	for _, Object in ipairs(Egg:GetDescendants()) do

		if Object:IsA("ProximityPrompt") and isGrabPrompt(Object) then

			pcall(function()
				Object.HoldDuration = 0
			end)

			pcall(function()
				Object:InputHoldBegin()
				task.wait()
				Object:InputHoldEnd()
			end)

			return true
		end
	end

	return false
end

--------------------------------------------------
-- CHECK HOLDING
--------------------------------------------------

local function isHoldingEgg()

	local Character = Player.Character

	if not Character then
		return false
	end

	if Character:GetAttribute("HoldingEgg") == true then
		return true
	end

	if Player:GetAttribute("HoldingEgg") == true then
		return true
	end

	for _, Object in ipairs(Character:GetDescendants()) do

		if Object:GetAttribute("IsEgg") == true then
			return true
		end

		if EggValues[Object.Name] then
			return true
		end
	end

	return false
end

--------------------------------------------------
-- GRAB + VERIFY
--------------------------------------------------

local function grabUntilConfirmed(Egg)

	for Attempt = 1, 30 do

		if not Enabled then
			return false
		end

		if isHoldingEgg() then
			return true
		end

		grabEgg(Egg)

		task.wait(0.05)

		if isHoldingEgg() then
			return true
		end
	end

	return isHoldingEgg()
end

--------------------------------------------------
-- DROP BUTTON
--------------------------------------------------

local function dropEgg()

	if not Enabled then
		return false
	end

	local PlayerGui = Player:FindFirstChild("PlayerGui")

	if PlayerGui then

		for _, Gui in ipairs(PlayerGui:GetDescendants()) do

			if
				(Gui:IsA("TextButton") or Gui:IsA("ImageButton"))
				and string.find(
					string.lower(Gui.Name),
					"dropegg",
					1,
					true
				)
			then

				pcall(function()
					Gui:Activate()
				end)

				return true
			end
		end
	end

	return false
end

--------------------------------------------------
-- FIND MY PLOT
--------------------------------------------------

local function isMyPlot(Object)

	local Attributes = {
		"Owner",
		"OwnerName",
		"Player",
		"PlayerName",
		"Username",
		"UserName"
	}

	for _, Name in ipairs(Attributes) do

		local Value = Object:GetAttribute(Name)

		if Value == Player.Name or Value == Player.DisplayName then
			return true
		end
	end

	local UserId =
		Object:GetAttribute("UserId")
		or Object:GetAttribute("OwnerUserId")

	if tonumber(UserId) == Player.UserId then
		return true
	end

	return false
end

local function findMyPlot()

	for _, Object in ipairs(workspace:GetDescendants()) do

		if not Enabled then
			return nil
		end

		if Object:IsA("Model") or Object:IsA("Folder") then

			if isMyPlot(Object) then
				return Object
			end
		end
	end

	return nil
end

--------------------------------------------------
-- PLOT POSITION
--------------------------------------------------

local function getPlotPosition(Plot)

	if not Plot then
		return nil
	end

	local Names = {
		"Spawn",
		"SpawnLocation",
		"EggDrop",
		"DropEgg",
		"Drop",
		"Base"
	}

	for _, Name in ipairs(Names) do

		local Object = Plot:FindFirstChild(Name, true)

		if Object then

			if Object:IsA("BasePart") then
				return Object.Position
			end

			if Object:IsA("Model") then
				return Object:GetPivot().Position
			end
		end
	end

	if Plot:IsA("Model") then
		return Plot:GetPivot().Position
	end

	return nil
end

--------------------------------------------------
-- MOVE 500 STUDS/S
--------------------------------------------------

local function moveToPlot(Position)

	local Character, Root = getCharacter()

	if not Character or not Root then
		return false
	end

	local Start = Root.Position
	local Distance = (Position - Start).Magnitude

	if Distance <= 1 then
		return true
	end

	local Duration = Distance / PLOT_SPEED
	local StartTime = os.clock()

	while Enabled do

		local Alpha = math.clamp(
			(os.clock() - StartTime) / Duration,
			0,
			1
		)

		local Current =
			Start:Lerp(Position, Alpha)

		Character:PivotTo(
			CFrame.new(Current)
		)

		if Alpha >= 1 then
			break
		end

		RunService.Heartbeat:Wait()
	end

	return Enabled
end

--------------------------------------------------
-- MAIN
--------------------------------------------------

local function MainLoop()

	if Busy then
		return
	end

	Busy = true

	while Enabled do

		------------------------------------------------
		-- BEST EGG
		------------------------------------------------

		local Egg = findBestEgg()

		if not Egg then
			task.wait(0.25)
			continue
		end

		local EggPosition = getEggPosition(Egg)

		if not EggPosition then
			task.wait()
			continue
		end

		------------------------------------------------
		-- TP EGG
		------------------------------------------------

		teleportTo(EggPosition)

		task.wait()

		------------------------------------------------
		-- GRAB
		------------------------------------------------

		local Grabbed = grabUntilConfirmed(Egg)

		if not Grabbed then
			-- NO TP AL CENTRO SI NO LO AGARRÓ
			task.wait(0.1)
			continue
		end

		------------------------------------------------
		-- CENTER
		------------------------------------------------

		teleportTo(CENTER)

		task.wait()

		------------------------------------------------
		-- DROP
		------------------------------------------------

		dropEgg()

		task.wait(0.2)

		------------------------------------------------
		-- SECOND EGG
		------------------------------------------------

		local Egg2 = findBestEgg()

		if not Egg2 then
			task.wait()
			continue
		end

		local Position2 = getEggPosition(Egg2)

		if not Position2 then
			continue
		end

		-- NUNCA AGARRAR DENTRO DE LOS 210
		if isForbidden(Position2) then
			continue
		end

		------------------------------------------------
		-- TP SECOND EGG
		------------------------------------------------

		teleportTo(Position2)

		task.wait()

		------------------------------------------------
		-- SECOND GRAB
		------------------------------------------------

		local Grabbed2 = grabUntilConfirmed(Egg2)

		if not Grabbed2 then
			continue
		end

		------------------------------------------------
		-- MY PLOT
		------------------------------------------------

		local Plot = findMyPlot()

		if not Plot then
			task.wait(0.2)
			continue
		end

		local PlotPosition = getPlotPosition(Plot)

		if not PlotPosition then
			task.wait(0.2)
			continue
		end

		------------------------------------------------
		-- 500 STUDS/S
		------------------------------------------------

		moveToPlot(PlotPosition)

		if not Enabled then
			break
		end

		------------------------------------------------
		-- FINAL DROP
		------------------------------------------------

		dropEgg()

		task.wait(0.3)
	end

	Busy = false
end

