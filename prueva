local function StopEggLock()
    if EggLockConnection then
        EggLockConnection:Disconnect()
        EggLockConnection = nil
    end
    EggLockCFrame = nil
end

local function TeleportToEgg(egg)

    local root = GetRoot()
    local position = GetPosition(egg)

    if not root or not position then
        return false
    end

    -- Detiene cualquier bloqueo anterior ANTES de crear el nuevo.
    StopEggLock()

    -- El TP ocurre primero.
    local targetCFrame =
        CFrame.new(
            position + Vector3.new(0, 2.5, 0)
        )

    root.CFrame = targetCFrame

    -- Cero movimiento al terminar el TP.
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    -- Guarda la posición y mantenla hasta terminar el Auto Grab.
    EggLockCFrame = targetCFrame

    EggLockConnection = RunService.Heartbeat:Connect(function()
        if not InstaTP or not EggLockCFrame then
            return
        end

        local currentRoot = GetRoot()
        if not currentRoot then
            return
        end

        currentRoot.CFrame = EggLockCFrame
        currentRoot.AssemblyLinearVelocity = Vector3.zero
        currentRoot.AssemblyAngularVelocity = Vector3.zero
    end)

    return true
end

--==============================================================
-- OWNER → MI PLOT → SPAWN
--==============================================================

local function OwnerMatches(value)
    if value == nil then return false end
    if typeof(value) == "Instance" then return value == LocalPlayer end
    local v = tostring(value)
    return v == LocalPlayer.Name
        or v == LocalPlayer.DisplayName
        or v == tostring(LocalPlayer.UserId)
end

local function HasMyOwner(obj)
    if not obj then return false end

    for name,value in pairs(obj:GetAttributes()) do
        local n = string.lower(tostring(name))
        if n == "owner" or n == "ownername" or n == "player"
        or n == "playername" or n == "username" or n == "userid"
        or n == "owneruserid" then
            if OwnerMatches(value) then return true end
        end
    end

    for _,v in ipairs(obj:GetDescendants()) do
        local n = string.lower(v.Name)
        if n == "owner" or n == "ownername" or n == "player"
        or n == "playername" or n == "username" or n == "userid"
        or n == "owneruserid" then
            if v:IsA("ObjectValue") and v.Value == LocalPlayer then
                return true
            elseif (v:IsA("StringValue") or v:IsA("IntValue") or v:IsA("NumberValue"))
            and OwnerMatches(v.Value) then
                return true
            end
        end
    end
    return false
end

local function FindPlotSpawn(plot)
    if not plot then return nil end
    local names={"Spawn","PlotSpawn","SpawnLocation","Respawn","PlayerSpawn","HomeSpawn","BaseSpawn","SpawnPoint","SpawnPart","HomePoint"}
    for _,name in ipairs(names) do
        local o=plot:FindFirstChild(name,true)
        if o and o:IsA("BasePart") then return o end
    end
    for _,o in ipairs(plot:GetDescendants()) do
        if o:IsA("SpawnLocation") then return o end
        if o:IsA("BasePart") then
            local n=o.Name:lower()
            if n:find("spawn",1,true) or n:find("respawn",1,true) then return o end
        end
    end
    return nil
end

local function FindMyPlotSpawn()
    local containers={Workspace:FindFirstChild("Plots"),Workspace:FindFirstChild("plots"),Workspace:FindFirstChild("Bases"),Workspace:FindFirstChild("bases")}
    for _,container in ipairs(containers) do
        if container then
            for _,plot in ipairs(container:GetChildren()) do
                if HasMyOwner(plot) then
                    local spawn=FindPlotSpawn(plot)
                    if spawn then return spawn end
                    local part=plot:IsA("BasePart") and plot or plot:FindFirstChildWhichIsA("BasePart",true)
                    if part then return part end
                end
            end
        end
    end
    return nil
end

local function ReturnSpawn()
    local root=GetRoot()
    if not root then return false end

    local plotSpawn=FindMyPlotSpawn()
    local respawnCFrame=plotSpawn and (plotSpawn.CFrame + Vector3.new(0,3,0))
        or SavedSpawnCFrame
        or GetRespawnCFrame()

    if not respawnCFrame then return false end

    root.CFrame=respawnCFrame
    root.AssemblyLinearVelocity=Vector3.zero
    root.AssemblyAngularVelocity=Vector3.zero
    task.wait(0.05)

    local currentRoot=GetRoot()
    if currentRoot then
        currentRoot.CFrame=respawnCFrame
        currentRoot.AssemblyLinearVelocity=Vector3.zero
        currentRoot.AssemblyAngularVelocity=Vector3.zero
    end
    return true
end

