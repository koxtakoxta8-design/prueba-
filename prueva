--==============================================================
-- MEJOR HUEVO
--==============================================================

local function FindBestEgg()

    local Best = nil
    local Highest = -math.huge

    for Object,Data in pairs(EggCache) do

        if not Object
        or not Object.Parent then

            EggCache[Object] = nil

        else

            local Prompt = Data.Prompt

            if not Prompt
            or not Prompt.Parent then

                Prompt = FindPrompt(Object)
                Data.Prompt = Prompt
            end

            if Prompt
            and Prompt.Enabled then

                local Position = GetPosition(Object)

                if Position
                and not IsExcluded(Position) then

                    Data.Position = Position

                    local Priority =
                        GetPriority(Object)

                    Data.Priority = Priority

                    local Score = Priority

                    if Score > Highest then

                        Highest = Score
                        Best = Data
                    end
                end
            end
        end
    end

    return Best
end

--==============================================================
-- TELEPORT
--==============================================================

local function Teleport(Position)

    local Root = GetRoot()

    if not Root then
        return false
    end

    Root.CFrame =
        CFrame.new(
            Position + EGG_OFFSET
        )

    return true
end

--==============================================================
-- RECOGER
--==============================================================

local function CollectEgg(Egg)

    if not Egg
    or not Egg.Object
    or not Egg.Object.Parent then

        return false
    end

    local Prompt =
        FindPrompt(Egg.Object)

    if not Prompt
    or not Prompt.Enabled then

        return false
    end

    pcall(function()
        Prompt.HoldDuration = 0
    end)

    pcall(function()

        Prompt:InputHoldBegin()

        task.wait(PROMPT_DELAY)

        Prompt:InputHoldEnd()

    end)

    return true
end

--==============================================================
-- BUSCAR MI PLOT
--==============================================================

local function IsMyPlot(Object)

    local Names = {
        "Owner",
        "owner",
        "OwnerName",
        "ownerName"
    }

    for _,Name in ipairs(Names) do

        local Attribute =
            Object:GetAttribute(Name)

        if Attribute ~= nil then

            local Text =
                tostring(Attribute)

            if Text == Player.Name
            or Text == tostring(Player.UserId) then

                return true
            end
        end

        local Value =
            Object:FindFirstChild(
                Name,
                true
            )

        if Value then

            if Value:IsA("StringValue")
            and Value.Value == Player.Name then

                return true
            end

            if Value:IsA("IntValue")
            and Value.Value == Player.UserId then

                return true
            end

            if Value:IsA("ObjectValue")
            and Value.Value == Player then

                return true
            end
        end
    end

    return false
end

local function FindMyPlot()

    if CachedPlotPosition then
        return CachedPlotPosition
    end

    for _,Object in ipairs(workspace:GetDescendants()) do

        local Name =
            Object.Name:lower()

        if Name:find("plot",1,true)
        or Name:find("tycoon",1,true)
        or Name:find("base",1,true) then

            if IsMyPlot(Object) then

                local Position =
                    GetPosition(Object)

                if Position then

                    CachedPlotPosition =
                        Position

                    return Position
                end
            end
        end
    end

    return nil
end

--==============================================================
-- CICLO PRINCIPAL
--==============================================================

local function RunOnce()

    if BUSY then
        return
    end

    BUSY = true

    StatusLabel.Text =
        "Estado: BUSCANDO MEJOR HUEVO"

    local Egg = FindBestEgg()

    if not Egg then

        BestLabel.Text =
            "🏆 Mejor: NINGUNO"

        ValueLabel.Text =
            "Valor: —"

        StatusLabel.Text =
            "Estado: SIN HUEVO"

        BUSY = false

        return
    end

    BestLabel.Text =
        "🏆 Mejor: "
        .. Egg.Object.Name

    if Egg.Priority >= 2500000000000 then

        ValueLabel.Text =
            "Valor: 2.5T • PRIORIDAD #1"

    else

        ValueLabel.Text =
            "Valor: "
            .. tostring(Egg.Value or Egg.Priority or 0)
    end

    --==========================================================
    -- TP DIRECTO AL MEJOR HUEVO
    --==========================================================

    StatusLabel.Text =
        "Estado: TP AL MEJOR HUEVO"

    local Position =
        GetPosition(Egg.Object)

    if not Position then

        BUSY = false
        return
    end

    Egg.Position = Position

    Teleport(Position)

    -- esperar a que el personaje quede encima
    task.wait(0.10)

    --==========================================================
    -- RECOGER
    --==========================================================

    StatusLabel.Text =
        "Estado: RECOGIENDO"

    CollectEgg(Egg)

    -- dar tiempo al servidor
    task.wait(0.18)

    --==========================================================
    -- PLOT
    --==========================================================

    StatusLabel.Text =
        "Estado: BUSCANDO PLOT"

    local Plot =
        FindMyPlot()

    if Plot then

        StatusLabel.Text =
            "Estado: TP AL PLOT"

        Teleport(Plot)

        task.wait(0.20)

        StatusLabel.Text =
            "Estado: COMPLETADO"

    else

        StatusLabel.Text =
            "Estado: PLOT NO ENCONTRADO"
    end

    BUSY = false
end

