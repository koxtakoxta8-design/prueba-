        corner.Parent = btn
        createAnimatedStroke(btn, 1)

        local itemImg = Instance.new("ImageLabel")
        itemImg.Size = UDim2.fromOffset(26, 26)
        itemImg.Position = UDim2.fromOffset(6, 4)
        itemImg.BackgroundTransparency = 1
        itemImg.Image = getEggImage(item.Name)
        itemImg.ScaleType = Enum.ScaleType.Fit
        itemImg.ZIndex = 7
        itemImg.Parent = btn

        local itemTitle = Instance.new("TextLabel")
        itemTitle.Size = UDim2.new(1, -80, 0, 16)
        itemTitle.Position = UDim2.fromOffset(36, 2)
        itemTitle.BackgroundTransparency = 1
        itemTitle.Text = string.upper(item.Name)
        itemTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
        itemTitle.TextSize = 10
        itemTitle.FontFace = Font.fromEnum(Enum.Font.GothamBold)
        itemTitle.TextXAlignment = Enum.TextXAlignment.Left
        itemTitle.ZIndex = 7
        itemTitle.Parent = btn

        local englishRarity = translateRarity(item.Data.Rarity)
        local itemSub = Instance.new("TextLabel")
        itemSub.Size = UDim2.new(1, -40, 0, 14)
        itemSub.Position = UDim2.fromOffset(36, 17)
        itemSub.BackgroundTransparency = 1
        itemSub.Text = englishRarity .. " • " .. item.Data.Cost
        itemSub.TextSize = 9
        itemSub.FontFace = Font.fromEnum(Enum.Font.Gotham)
        itemSub.TextXAlignment = Enum.TextXAlignment.Left
        itemSub.ZIndex = 7
        itemSub.Parent = btn
        applyRarityStyle(itemSub, englishRarity)

        local statusLabel = Instance.new("TextLabel")
        statusLabel.Size = UDim2.new(0, 35, 1, 0)
        statusLabel.Position = UDim2.new(1, -38, 0, 0)
        statusLabel.BackgroundTransparency = 1
