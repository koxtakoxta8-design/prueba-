--==============================================================
-- PROCESO PRINCIPAL
--==============================================================

local function Run()

    if Running then
        return
    end

    Running = true

    ----------------------------------------------------------
    -- GUARDAR POSICIÓN ORIGINAL
    ----------------------------------------------------------

    if not SaveReturnPosition() then

        Status.Text =
            "Estado: ERROR POSICIÓN"

        Running = false
        return
    end

    ----------------------------------------------------------
    -- BUSCAR
    ----------------------------------------------------------

    Status.Text =
        "Estado: ESCANEANDO..."

    local egg, amount =
        FindBestEgg()

    Count.Text =
        "Huevos detectados: " ..
        tostring(amount)

    if not egg then

        Status.Text =
            "Estado: NO HAY HUEVOS"

        Running = false
        return
    end

    Info.Text =
        "🥚 Mejor: " ..
        egg.Name ..
        "\n🍀 Lucky: " ..
        egg.Luck ..
        "\n⭐ Rareza: " ..
        egg.Rarity

    ----------------------------------------------------------
    -- TP
    ----------------------------------------------------------

    Status.Text =
        "Estado: TP AL HUEVO"

    if not TeleportToEgg(
        egg
    ) then

        Status.Text =
            "Estado: ERROR TP"

        UnfreezeCharacter()

        Running = false
        return
    end

    ----------------------------------------------------------
    -- CONGELADO
    ----------------------------------------------------------

    Status.Text =
        "Estado: CONGELADO"

    task.wait(0.5)

    ----------------------------------------------------------
    -- GRAB
    ----------------------------------------------------------

    Status.Text =
        "Estado: AUTO GRAB"

    local grabbed =
        GrabEgg(egg)

    if grabbed then

        Status.Text =
            "Estado: GRAB EJECUTADO"

    else

        Status.Text =
            "Estado: PROMPT NO ACTIVADO"
    end

    task.wait(0.8)

    ----------------------------------------------------------
    -- REGRESAR
    ----------------------------------------------------------

    Status.Text =
        "Estado: VOLVIENDO"

    ReturnToBase()

    task.wait(0.2)

    ----------------------------------------------------------
    -- DESCONGELAR
    ----------------------------------------------------------

    UnfreezeCharacter()

    Status.Text =
        "Estado: TERMINADO"

    Running = false
end

