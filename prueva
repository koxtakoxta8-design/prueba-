local function Teleport(Position)

    local Root = GetRoot()

    if not Root then
        return false
    end

    Root.CFrame =
        CFrame.new(
            Position + EGG_OFFSET
        )

    return true
end

--==============================================================
-- RECOGER x5
--==============================================================

local function BurstCollect(Egg)

    if not Egg
    or not Egg.Object
    or not Egg.Object.Parent then

        return false
    end

    local Prompt =
        FindPrompt(Egg.Object)

    if not Prompt
    or not Prompt.Enabled then

        return false
    end

    for i = 1, BURST_COUNT do

        if not Egg.Object.Parent then
            break
        end

        Prompt = FindPrompt(Egg.Object)

        if not Prompt
        or not Prompt.Enabled then
            break
        end

        StatusLabel.Text =
            "Estado: RÁFAGA "
            .. i
            .. "/"
            .. BURST_COUNT

        pcall(function()
            Prompt.HoldDuration = 0
        end)

        pcall(function()

            Prompt:InputHoldBegin()

            task.wait(
                PROMPT_DELAY
            )

            Prompt:InputHoldEnd()

        end)

        task.wait(
            PROMPT_DELAY
        )
    end

    return true
end

--==============================================================
-- BUSCAR PLOT
--==============================================================

local function IsMyPlot(Object)

    for _,Name in ipairs({
        "Owner",
        "owner",
        "OwnerName",
        "ownerName"
    }) do

        local Attribute =
            Object:GetAttribute(Name)

        if Attribute ~= nil then

            if tostring(Attribute)
                == Player.Name
            or tostring(Attribute)
                == tostring(Player.UserId) then

                return true
            end
        end

        local Value =
            Object:FindFirstChild(
                Name,
                true
            )

        if Value then

            if Value:IsA("StringValue")
            and Value.Value == Player.Name then

                return true
            end

            if Value:IsA("IntValue")
            and Value.Value == Player.UserId then

                return true
            end

            if Value:IsA("ObjectValue")
            and Value.Value == Player then

                return true
            end
        end
    end

    return false
end

local function FindMyPlot()

    for _,Object in ipairs(
        workspace:GetDescendants()
    ) do

        local Name =
            Object.Name:lower()

        if Name:find("plot")
        or Name:find("tycoon")
        or Name:find("base") then

            if IsMyPlot(Object) then

                local Position =
                    GetPosition(Object)

                if Position then
                    return Position
                end
            end
        end
    end

    return nil
end

--==============================================================
-- UN CICLO
--==============================================================

local function RunOnce()

    if BUSY then
        return
    end

    BUSY = true

    StatusLabel.Text =
        "Estado: BUSCANDO"

    local Egg =
        FindBestEggFast()

    if not Egg then

        BestLabel.Text =
            "🏆 Mejor: NINGUNO"

        ValueLabel.Text =
            "Valor: —"

        StatusLabel.Text =
            "Estado: SIN HUEVO"

        BUSY = false
        return
    end

    BestLabel.Text =
        "🏆 Mejor: "
        .. Egg.Object.Name

    if Egg.Object.Name == "Volcanic Egg"
        or Egg.Object.Name:lower():find("volcanic", 1, true) then
        ValueLabel.Text = "Valor: 2.5T  •  PRIORIDAD #1"
    else
        ValueLabel.Text =
            "Valor: "
            .. tostring(Egg.Value)
    end

    StatusLabel.Text =
        "Estado: TP AL HUEVO"

    if IsExcluded(Egg.Position) then
        BUSY = false
        return
    end

    Teleport(Egg.Position)

    task.wait(0.08)

    if Egg.Object.Parent then

        BurstCollect(Egg)

        -- Esperar un momento para que el servidor
        -- procese la interacción.
        task.wait(0.15)
    end

    StatusLabel.Text =
        "Estado: BUSCANDO PLOT"

    local Plot =
        FindMyPlot()

    if Plot then

        StatusLabel.Text =
            "Estado: TP AL PLOT"

        Teleport(Plot)

        task.wait(0.25)

        StatusLabel.Text =
            "Estado: COMPLETADO"

    else

        StatusLabel.Text =
            "Estado: PLOT NO ENCONTRADO"
    end

    BUSY = false
end

