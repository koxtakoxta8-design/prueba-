--// RIDE A PET - BEST EGG AUTO ROUTE
--// MEJOR HUEVO -> TP -> AGARRAR -> CENTRO -> SOLTAR
--// -> AGARRAR -> DESPLAZAMIENTO 1000 -> PLOT -> SOLTAR

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--==================================================
-- CONFIGURACIÓN
--==================================================

local CENTER = Vector3.new(
    146.87,
    40316.12,
    911.14
)

local EXCLUSION_RADIUS = 210
local PLOT_SPEED = 1000

--==================================================
-- VALORES DE HUEVOS
--==================================================

local EggValues = {
    ["White Egg"] = 1,
    ["Brown Egg"] = 5,
    ["Cracked Egg"] = 30,
    ["Easter Egg"] = 50,
    ["Stone Egg"] = 100,
    ["Leaf Egg"] = 200,
    ["Mushroom Egg"] = 500,
    ["Flower Egg"] = 750,
    ["Slime Egg"] = 1000,
    ["Ice Egg"] = 3000,
    ["Glass Egg"] = 10000,
    ["Golden Egg"] = 30000,
    ["Crystal Egg"] = 150000,
    ["Skull Egg"] = 250000,
    ["Dominus Egg"] = 700000,
    ["Flaming Egg"] = 1000000,
    ["Sinister Egg"] = 3000000,
    ["Soul Egg"] = 7000000,
    ["Aurora Egg"] = 300000000,
    ["Galaxy Egg"] = 1500000000,
    ["Blackhole Egg"] = 100000000000,
    ["Solaris Egg"] = 300000000000,
    ["Cherub Egg"] = 1000000000000,
    ["Volcanic Egg"] = 2500000000000
}

--==================================================
-- ROOT
--==================================================

local function getRoot()
    local character = Player.Character
        or Player.CharacterAdded:Wait()

    return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- DETECTAR HUEVO
--==================================================

local function isEgg(obj)
    local name = obj.Name:lower()

    return name:find("egg", 1, true) ~= nil
        or name:find("huevo", 1, true) ~= nil
end

local function getEggPart(egg)
    if egg:IsA("BasePart") then
        return egg
    end

    return egg:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

--==================================================
-- VALOR DEL HUEVO
--==================================================

local function getEggValue(egg)

    local name = egg.Name:lower()
    local value = 0

    for eggName, eggValue in pairs(EggValues) do
        if name:find(
            eggName:lower(),
            1,
            true
        ) then
            value = math.max(value, eggValue)
        end
    end

    -- Buscar valores internos
    for _, obj in ipairs(
        egg:GetDescendants()
    ) do

        if obj:IsA("NumberValue")
            or obj:IsA("IntValue") then

            local n = obj.Name:lower()

            if n:find("luck", 1, true)
                or n:find("value", 1, true)
                or n:find("worth", 1, true) then

                value = math.max(
                    value,
                    obj.Value
                )
            end
        end
    end

    return value
end

--==================================================
-- EXCLUSIÓN DE 210 STUDS
--==================================================

local function isInsideExclusion(position)
    return (
        position - CENTER
    ).Magnitude <= EXCLUSION_RADIUS
end

--==================================================
-- BUSCAR MEJOR HUEVO
--==================================================

local function findBestEgg()

    local bestEgg = nil
    local bestValue = -1

    for _, obj in ipairs(
        workspace:GetDescendants()
    ) do

        if isEgg(obj) then

            local part = getEggPart(obj)

            if part
                and not isInsideExclusion(
                    part.Position
                ) then

                local value =
                    getEggValue(obj)

                if value > bestValue then
                    bestValue = value
                    bestEgg = obj
                end
            end
        end
    end

    return bestEgg, bestValue
end

--==================================================
-- TP
--==================================================

local function teleportTo(position)

    local root = getRoot()

    if not root then
        return false
    end

    root.CFrame = CFrame.new(position)

    return true
end

--==================================================
-- DESPLAZAMIENTO A 1000
--==================================================

local function moveTo(position)

    local root = getRoot()

    if not root then
        return false
    end

    local startPosition = root.Position

    local distance =
        (position - startPosition).Magnitude

    if distance <= 1 then
        root.CFrame = CFrame.new(position)
        return true
    end

    local duration =
        distance / PLOT_SPEED

    local startTime = os.clock()

    while true do

        root = getRoot()

        if not root then
            return false
        end

        local alpha = math.clamp(
            (os.clock() - startTime)
                / duration,
            0,
            1
        )

        root.CFrame = CFrame.new(
            startPosition:Lerp(
                position,
                alpha
            )
        )

        if alpha >= 1 then
            break
        end

        RunService.Heartbeat:Wait()
    end

    return true
end

--==================================================
-- AGARRAR HUEVO
--==================================================

local function grabEgg(egg)

    if not egg then
        return false
    end

    for _, obj in ipairs(
        egg:GetDescendants()
    ) do

        if obj:IsA("ProximityPrompt") then

            pcall(function()
                fireproximityprompt(obj)
            end)

        elseif obj:IsA("ClickDetector") then

            pcall(function()
                fireclickdetector(obj)
            end)
        end
    end

    return true
end

--==================================================
-- SOLTAR - SISTEMA PRINCIPAL
--==================================================

local function triggerDropEggButton()

    local foundButton = nil

    -- Buscar DropEgg
    for _, gui in ipairs(
        PlayerGui:GetDescendants()
    ) do

        if gui:IsA("TextButton")
            or gui:IsA("ImageButton") then

            local name =
                gui.Name:lower()

            if name == "dropegg"
                or name:find(
                    "dropegg",
                    1,
                    true
                ) then

                if gui.Visible then
                    foundButton = gui
                    break
                end
            end
        end
    end

    --==============================================
    -- MÉTODO 1: DropEgg
    --==============================================

    if foundButton then

        pcall(function()
            foundButton:Activate()
        end)

        pcall(function()

            for _, connection in ipairs(
                getconnections(
                    foundButton.Activated
                )
            ) do
                connection:Fire()
            end

        end)

        pcall(function()

            for _, connection in ipairs(
                getconnections(
                    foundButton.MouseButton1Click
                )
            ) do
                connection:Fire()
            end

        end)

        print("📦 DropEgg activado")

        return true
    end

    --==============================================
    -- MÉTODO 2: REMOTE DEL JUEGO
    --==============================================

    local packages =
        ReplicatedStorage:FindFirstChild(
            "Packages"
        )

    local networking =
        packages
        and packages:FindFirstChild(
            "Networking"
        )

    local remote =
        networking
        and networking:FindFirstChild(
            "RF/EggWorld/AskFieldEggDrop"
        )

    if remote then

        local success = pcall(function()

            remote:InvokeServer({
                Reason = "PlayerRequest"
            })

        end)

        if success then
            print("📦 Remote Drop activado")
            return true
        end
    end

    --==============================================
    -- MÉTODO 3: RESPALDO MULTIIDIOMA
    --==============================================

    local words = {

        -- Español
        "soltar",
        "liberar",
        "dejar",

        -- Inglés
        "drop",
        "release",
        "discard",
        "throw",

        -- Portugués
        "soltar",
        "liberar",

        -- Francés
        "lacher",
        "liberer",

        -- Italiano
        "lascia",
        "rilascia",

        -- Alemán
        "ablegen",
        "loslassen",

        -- Holandés
        "laten",
        "loslaten",

        -- Ruso transliterado
        "otpus",

        -- Japonés
        "drop",

        -- Coreano
        "drop",

        -- Chino
        "drop"
    }

    for _, gui in ipairs(
        PlayerGui:GetDescendants()
    ) do

        if gui:IsA("TextButton")
            or gui:IsA("ImageButton") then

            if gui.Visible then

                local text =
                    tostring(
                        gui.Text or ""
                    ):lower()

                local name =
                    gui.Name:lower()

                for _, word in ipairs(words) do

                    if text:find(
                        word,
                        1,
                        true
                    )
                    or name:find(
                        word,
                        1,
                        true
                    ) then

                        pcall(function()
                            gui:Activate()
                        end)

                        print(
                            "📦 Botón detectado:",
                            gui.Name
                        )

                        return true
                    end
                end
            end
        end
    end

    warn(
        "⚠️ No se encontró método para soltar."
    )

    return false
end

--==================================================
-- BUSCAR PLOT
--==================================================

local function findMyPlot()

    local plotNames = {
        "Plot",
        "Plots",
        "Base",
        "Bases",
        "Tycoon",
        "Tycoons",
        "PlayerPlot",
        "MyPlot",
        "PlotBase",
        "PlotBycoon"
    }

    local ownerAttributes = {
        "Owner",
        "OwnerName",
        "Player",
        "PlayerName",
        "Username",
        "UserName",
        "UserId",
        "OwnerUserId"
    }

    for _, obj in ipairs(
        workspace:GetDescendants()
    ) do

        local objectName =
            obj.Name:lower()

        for _, plotName in ipairs(
            plotNames
        ) do

            if objectName
                == plotName:lower() then

                for _, attribute in ipairs(
                    ownerAttributes
                ) do

                    local owner =
                        obj:GetAttribute(
                            attribute
                        )

                    if owner ~= nil then

                        if tostring(owner)
                            == Player.Name
                            or tostring(owner)
                            == tostring(
                                Player.UserId
                            ) then

                            return obj
                        end
                    end
                end

                -- ObjectValue
                for _, child in ipairs(
                    obj:GetDescendants()
                ) do

                    if child:IsA(
                        "ObjectValue"
                    )
                    and child.Value
                        == Player then

                        return obj
                    end
                end
            end
        end
    end

    return nil
end

--==================================================
-- POSICIÓN DEL PLOT
--==================================================

local function getPlotPosition(plot)

    if not plot then
        return nil
    end

    local spawnNames = {
        "Spawn",
        "SpawnLocation",
        "PlotSpawn",
        "SpawnPoint",
        "Drop",
        "DropPoint",
        "EggDrop"
    }

    for _, name in ipairs(
        spawnNames
    ) do

        local obj =
            plot:FindFirstChild(
                name,
                true
            )

        if obj
            and obj:IsA(
                "BasePart"
            ) then

            return obj.Position
        end
    end

    local part =
        plot:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if part then
        return part.Position
    end

    return nil
end

--==================================================
-- CICLO PRINCIPAL
--==================================================

local function start()

    print("🔎 Buscando mejor huevo...")

    local egg, value =
        findBestEgg()

    if not egg then

        warn(
            "❌ No encontré huevo fuera de los 210 studs."
        )

        return
    end

    local eggPart =
        getEggPart(egg)

    if not eggPart then
        return
    end

    print(
        "🥚 Mejor huevo:",
        egg.Name,
        "| Valor:",
        value
    )

    --==============================================
    -- 1. TP AL MEJOR HUEVO
    --==============================================

    teleportTo(
        eggPart.Position
    )

    task.wait(0.2)

    --==============================================
    -- 2. AGARRAR
    --==============================================

    grabEgg(egg)

    task.wait(0.4)

    --==============================================
    -- 3. TP AL CENTRO
    --==============================================

    print("📍 TP al centro")

    teleportTo(CENTER)

    task.wait(0.4)

    --==============================================
    -- 4. SOLTAR
    --==============================================

    print("📦 Soltando en centro")

    triggerDropEggButton()

    task.wait(0.5)

    --==============================================
    -- 5. VOLVER A AGARRAR
    --==============================================

    print("✋ Agarrando nuevamente")

    grabEgg(egg)

    task.wait(0.5)

    --==============================================
    -- 6. BUSCAR PLOT
    --==============================================

    print("🏠 Buscando plot")

    local plot =
        findMyPlot()

    if not plot then

        warn(
            "❌ No encontré tu plot."
        )

        return
    end

    local plotPosition =
        getPlotPosition(plot)

    if not plotPosition then

        warn(
            "❌ No encontré la posición del plot."
        )

        return
    end

    --==============================================
    -- 7. DESPLAZAMIENTO A 1000
    --==============================================

    print(
        "🚀 Desplazamiento al plot: 1000"
    )

    moveTo(
        plotPosition
            + Vector3.new(0, 3, 0)
    )

    task.wait(0.5)

    --==============================================
    -- 8. SOLTAR EN PLOT
    --==============================================

    print("📦 Soltando en plot")

    triggerDropEggButton()

    print("✅ CICLO COMPLETADO")
end

start()
