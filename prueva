    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then
        return
    end

    if not Locked then
        CenterPosition = Root.Position
    end

    if CenterPosition then

        Coords.Text =
            string.format(
                "X: %.2f\nY: %.2f\nZ: %.2f",
                CenterPosition.X,
                CenterPosition.Y,
                CenterPosition.Z
