local function UpdateBestUI()

    if BestEgg
        and BestEgg.Parent
    then

        local data =
            GetEggData(
                BestEgg.Name
            )

        if data then

            BestText.Text =
                "🥚 MEJOR HUEVO\n"
                .. BestEgg.Name
                .. "   🍀 Lucky: "
                .. data.Luck

        end

    else

        BestText.Text =
            "🥚 MEJOR HUEVO\nBuscando..."

    end

end

--==============================================================
-- CICLO DE UN HUEVO
--==============================================================

local function DoOneCycle()

    if not InstaTP then
        return
    end

    RefreshBestEgg()
    UpdateBestUI()

    local egg =
        BestEgg

    if not egg then
        return
    end

    if not TeleportToEgg(egg) then
        return
    end

    -- SE QUEDA TIESO
    FreezeCharacter()

    task.wait(0.12)

    if not InstaTP then
        UnfreezeCharacter()
        return
    end

    -- AUTO GRAB DESPUÉS DEL TP
    AutoGrab(egg)

    task.wait(0.35)

    if not InstaTP then
        UnfreezeCharacter()
        return
    end

    -- SPAWN GUARDADO
    ReturnToSpawn()

    task.wait(0.15)

    UnfreezeCharacter()

end

