--------------------------------------------------
-- EJECUCIÓN
--------------------------------------------------

local function Run()

    if Running then
        return
    end

    Running = true

    Status.Text = "Estado: BUSCANDO..."

    local egg, amount =
        FindBestEgg()

    Count.Text =
        "Huevos detectados: " .. tostring(amount)

    if not egg then

        Info.Text =
            "🥚 Mejor: NO ENCONTRADO\n" ..
            "🍀 Lucky: ---\n" ..
            "⭐ Rareza: ---"

        Status.Text =
            "Estado: SIN HUEVOS"

        Running = false
        return
    end

    Info.Text =
        "🥚 Mejor: " .. egg.Name ..
        "\n🍀 Lucky: " .. egg.Luck ..
        "\n⭐ Rareza: " .. egg.Rarity

    Status.Text =
        "Estado: TP AL HUEVO"

    local success =
        TeleportToEgg(egg)

    if not success then

        Status.Text =
            "Estado: ERROR TP"

        UnfreezeCharacter()
        Running = false
        return
    end

    Status.Text =
        "Estado: CONGELADO EN EL HUEVO"

    task.wait(.7)

    -- Interacción preparada.
    GrabEgg(egg)

    -- Cuando tengas conectado el Remote oficial
    -- de recogida, aquí se puede esperar su confirmación.

    task.wait(.7)

    Status.Text =
        "Estado: VOLVIENDO AL SPAWN"

    TeleportToSpawn()

    task.wait(.2)

    UnfreezeCharacter()

    Status.Text =
        "Estado: TERMINADO"

    Running = false
end

Button.Activated:Connect(Run)

--------------------------------------------------
-- ARRASTRAR
--------------------------------------------------

local dragging = false
local dragStart
local startPos

Title.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = Main.Position

        input.Changed:Connect(function()

            if input.UserInputState ==
                Enum.UserInputState.End then

                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)

    if not dragging then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        local delta =
            input.Position - dragStart

        Main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,

            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

