--==============================================================
-- UTILIDADES
--==============================================================

local function GetRoot()
    local Character = Player.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

local function GetPosition(Object)

    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then
        return Object.Position
    end

    if Object:IsA("Model") then

        if Object.PrimaryPart then
            return Object.PrimaryPart.Position
        end

        local Part = Object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

        if Part then
            return Part.Position
        end
    end

    return nil
end

local function IsExcluded(Position)

    if not Position then
        return true
    end

    local X = math.abs(
        Position.X - EXCLUSION_CENTER.X
    )

    local Z = math.abs(
        Position.Z - EXCLUSION_CENTER.Z
    )

    return X <= EXCLUSION_RADIUS
       and Z <= EXCLUSION_RADIUS
end

--==============================================================
-- DETECTOR DE HUEVOS
--==============================================================

local function LooksLikeEggName(Name)

    Name = tostring(Name or ""):lower()

    return
        Name:find("egg",1,true) ~= nil
        or Name:find("huevo",1,true) ~= nil
        or Name:find("volcanic",1,true) ~= nil
        or Name:find("cherub",1,true) ~= nil
        or Name:find("solaris",1,true) ~= nil
        or Name:find("solar",1,true) ~= nil
        or Name:find("blackhole",1,true) ~= nil
        or (
            Name:find("black",1,true)
            and
            Name:find("hole",1,true)
        )
end

local function FindPrompt(Object)

    if not Object then
        return nil
    end

    if Object:IsA("ProximityPrompt") then
        return Object
    end

    return Object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )
end

local function GetEggFromPrompt(Prompt)

    if not Prompt then
        return nil
    end

    local Current = Prompt.Parent

    for _ = 1,12 do

        if not Current then
            break
        end

        if Current:IsA("Model")
        or Current:IsA("BasePart") then

            if LooksLikeEggName(Current.Name)
            or Current:GetAttribute("IsEgg") == true
            or Current:GetAttribute("Egg") == true then

                return Current
            end
        end

        Current = Current.Parent
    end

    return nil
end

--==============================================================
-- VALOR DEL HUEVO
--==============================================================

local function GetValue(Object)

    if not Object then
        return 0
    end

    -- atributos
    local Attributes = {
        "Luck",
        "luck",
        "EggLuck",
        "RarityValue",
        "Value",
        "Price",
        "Worth",
        "Cost"
    }

    for _,Name in ipairs(Attributes) do

        local Value = Object:GetAttribute(Name)

        if typeof(Value) == "number" then
            return Value
        end
    end

    -- valores directos
    for _,Item in ipairs(Object:GetChildren()) do

        if Item:IsA("NumberValue")
        or Item:IsA("IntValue") then

            local Name = Item.Name:lower()

            if Name:find("luck",1,true)
            or Name:find("rarity",1,true)
            or Name:find("value",1,true)
            or Name:find("price",1,true)
            or Name:find("worth",1,true)
            or Name:find("cost",1,true) then

                return Item.Value
            end
        end
    end

    return 0
end

--==============================================================
-- PRIORIDADES
--==============================================================

local EggPriority = {

    ["Volcanic Egg"] = 2500000000000,

    ["Cherub Egg"] = 1000000000000,

    ["Solaris Egg"] = 300000000000,

    ["Black Hole Egg"] = 100000000000,

    ["Blackhole Egg"] = 100000000000,
}

local function GetPriority(Object)

    if not Object then
        return 0
    end

    local Exact = EggPriority[Object.Name]

    if Exact then
        return Exact
    end

    local Name = Object.Name:lower()

    if Name:find("volcanic",1,true) then
        return 2500000000000
    end

    if Name:find("cherub",1,true) then
        return 1000000000000
    end

    if Name:find("solaris",1,true) then
        return 300000000000
    end

    if Name:find("blackhole",1,true)
    or (
        Name:find("black",1,true)
        and
        Name:find("hole",1,true)
    ) then

        return 100000000000
    end

    -- IMPORTANTE:
    -- huevo desconocido = usa su valor
    return GetValue(Object)
end

--==============================================================
-- REGISTRAR HUEVO
--==============================================================

local function RegisterEgg(Object)

    if not Object
    or not Object.Parent then
        return
    end

    local Egg = Object

    if Object:IsA("ProximityPrompt") then
        Egg = GetEggFromPrompt(Object)
    end

    if not Egg then
        return
    end

    if not LooksLikeEggName(Egg.Name)
    and Egg:GetAttribute("IsEgg") ~= true
    and Egg:GetAttribute("Egg") ~= true then

        return
    end

    local Position = GetPosition(Egg)

    if not Position
    or IsExcluded(Position) then

        EggCache[Egg] = nil
        return
    end

    local Prompt = FindPrompt(Egg)

    if not Prompt then
        return
    end

    local Priority = GetPriority(Egg)
    local Value = GetValue(Egg)

    -- Si no hay prioridad ni valor,
    -- todavía lo guardamos si claramente es un huevo.
    if Priority <= 0 then
        Priority = 1
    end

    EggCache[Egg] = {
        Object = Egg,
        Position = Position,
        Prompt = Prompt,
        Value = Value,
        Priority = Priority
    }

    -- Detectar si desaparece
    if not Egg:GetAttribute("KOXTA_WATCHING") then

        pcall(function()
            Egg:SetAttribute(
                "KOXTA_WATCHING",
                true
            )
        end)
    end
end

