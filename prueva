--// RIDE A PET - AUTO BEST EGG
--// No depende del idioma del botón de soltar

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--==================================================
-- CONFIG
--==================================================

local CENTER = Vector3.new(
    146.87,
    40316.12,
    911.14
)

local EXCLUSION_RADIUS = 210
local PLOT_SPEED = 1000

--==================================================
-- VALORES
--==================================================

local EggValues = {
    ["White Egg"] = 1,
    ["Brown Egg"] = 5,
    ["Cracked Egg"] = 30,
    ["Easter Egg"] = 50,
    ["Stone Egg"] = 100,
    ["Leaf Egg"] = 200,
    ["Mushroom Egg"] = 500,
    ["Flower Egg"] = 750,
    ["Slime Egg"] = 1000,
    ["Ice Egg"] = 3000,
    ["Glass Egg"] = 10000,
    ["Golden Egg"] = 30000,
    ["Crystal Egg"] = 150000,
    ["Skull Egg"] = 250000,
    ["Dominus Egg"] = 700000,
    ["Flaming Egg"] = 1000000,
    ["Sinister Egg"] = 3000000,
    ["Soul Egg"] = 7000000,
    ["Aurora Egg"] = 300000000,
    ["Galaxy Egg"] = 1500000000,
    ["Blackhole Egg"] = 100000000000,
    ["Solaris Egg"] = 300000000000,
    ["Cherub Egg"] = 1000000000000,
    ["Volcanic Egg"] = 2500000000000
}

--==================================================
-- ROOT
--==================================================

local function Root()
    local char = Player.Character

    if not char then
        return nil
    end

    return char:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- EGG
--==================================================

local function IsEgg(obj)
    local n = obj.Name:lower()

    return n:find("egg", 1, true) ~= nil
        or n:find("huevo", 1, true) ~= nil
end

local function EggPart(egg)

    if egg:IsA("BasePart") then
        return egg
    end

    return egg:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

local function EggValue(egg)

    local n = egg.Name:lower()
    local value = 0

    for name, amount in pairs(EggValues) do
        if n:find(name:lower(), 1, true) then
            value = math.max(value, amount)
        end
    end

    for _, v in ipairs(egg:GetDescendants()) do

        if v:IsA("NumberValue")
            or v:IsA("IntValue") then

            local vn = v.Name:lower()

            if vn:find("luck", 1, true)
                or vn:find("value", 1, true)
                or vn:find("worth", 1, true) then

                value = math.max(value, v.Value)
            end
        end
    end

    return value
end

--==================================================
-- EXCLUSION 210 STUDS
--==================================================

local function IsExcluded(pos)
    return (pos - CENTER).Magnitude <= EXCLUSION_RADIUS
end

--==================================================
-- MEJOR HUEVO
--==================================================

local function BestEgg()

    local best = nil
    local bestValue = -1

    for _, obj in ipairs(workspace:GetDescendants()) do

        if IsEgg(obj) then

            local part = EggPart(obj)

            if part and not IsExcluded(part.Position) then

                local value = EggValue(obj)

                if value > bestValue then
                    best = obj
                    bestValue = value
                end
            end
        end
    end

    return best, bestValue
end

--==================================================
-- TP
--==================================================

local function TP(pos)

    local root = Root()

    if not root then
        return false
    end

    root.CFrame = CFrame.new(pos)

    return true
end

--==================================================
-- DESPLAZAMIENTO 1000
--==================================================

local function Move1000(pos)

    local root = Root()

    if not root then
        return false
    end

    local start = root.Position
    local distance = (pos - start).Magnitude

    if distance < 1 then
        root.CFrame = CFrame.new(pos)
        return true
    end

    local duration = distance / PLOT_SPEED
    local started = os.clock()

    while true do

        root = Root()

        if not root then
            return false
        end

        local alpha = math.clamp(
            (os.clock() - started) / duration,
            0,
            1
        )

        root.CFrame = CFrame.new(
            start:Lerp(pos, alpha)
        )

        if alpha >= 1 then
            break
        end

        RunService.Heartbeat:Wait()
    end

    return true
end

--==================================================
-- AGARRAR
--==================================================

local function Grab(egg)

    if not egg then
        return
    end

    for _, obj in ipairs(egg:GetDescendants()) do

        if obj:IsA("ProximityPrompt") then

            pcall(function()
                fireproximityprompt(obj)
            end)

        elseif obj:IsA("ClickDetector") then

            pcall(function()
                fireclickdetector(obj)
            end)

        end
    end
end

--==================================================
-- GUARDAR BOTONES VISIBLES
--==================================================

local function GetVisibleButtons()

    local result = {}

    for _, gui in ipairs(PlayerGui:GetDescendants()) do

        if gui:IsA("TextButton")
            or gui:IsA("ImageButton") then

            if gui.Visible
                and gui.AbsoluteSize.X > 0
                and gui.AbsoluteSize.Y > 0 then

                result[gui] = true
            end
        end
    end

    return result
end

--==================================================
-- DETECTAR BOTÓN NUEVO
--==================================================

local function FindNewButton(before)

    local possible = {}

    for _, gui in ipairs(PlayerGui:GetDescendants()) do

        if gui:IsA("TextButton")
            or gui:IsA("ImageButton") then

            if gui.Visible
                and gui.Active
                and gui.AbsoluteSize.X > 0
                and gui.AbsoluteSize.Y > 0
                and not before[gui] then

                table.insert(possible, gui)
            end
        end
    end

    -- Preferir botones pequeños/medianos
    -- que aparecieron recientemente.
    table.sort(possible, function(a, b)

        local areaA =
            a.AbsoluteSize.X *
            a.AbsoluteSize.Y

        local areaB =
            b.AbsoluteSize.X *
            b.AbsoluteSize.Y

        return areaA < areaB
    end)

    return possible[1]
end

--==================================================
-- ACTIVAR BOTÓN
--==================================================

local function ActivateButton(button)

    if not button then
        return false
    end

    print(
        "🖱️ Activando:",
        button:GetFullName()
    )

    pcall(function()
        button:Activate()
    end)

    return true
end

--==================================================
-- ESPERAR BOTÓN NUEVO
--==================================================

local function WaitForNewButton(before, timeout)

    local start = os.clock()

    while os.clock() - start < timeout do

        local button =
            FindNewButton(before)

        if button then
            return button
        end

        task.wait(0.05)
    end

    return nil
end

--==================================================
-- PLOT
--==================================================

local function FindPlot()

    local names = {
        "Plot",
        "Plots",
        "Base",
        "Bases",
        "Tycoon",
        "PlayerPlot",
        "MyPlot",
        "PlotBase",
        "PlotBycoon"
    }

    for _, obj in ipairs(workspace:GetDescendants()) do

        local objectName =
            obj.Name:lower()

        for _, wanted in ipairs(names) do

            if objectName == wanted:lower() then

                local ownerNames = {
                    "Owner",
                    "OwnerName",
                    "Player",
                    "PlayerName",
                    "Username",
                    "UserName",
                    "UserId",
                    "OwnerUserId"
                }

                for _, attribute in ipairs(ownerNames) do

                    local value =
                        obj:GetAttribute(attribute)

                    if value ~= nil then

                        if tostring(value)
                            == Player.Name
                            or tostring(value)
                            == tostring(Player.UserId) then

                            return obj
                        end
                    end
                end
            end
        end
    end

    return nil
end

local function PlotPosition(plot)

    if not plot then
        return nil
    end

    local names = {
        "Spawn",
        "SpawnLocation",
        "PlotSpawn",
        "SpawnPoint",
        "Drop",
        "DropPoint",
        "EggDrop"
    }

    for _, name in ipairs(names) do

        local obj =
            plot:FindFirstChild(name, true)

        if obj and obj:IsA("BasePart") then
            return obj.Position
        end
    end

    local part =
        plot:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    return part and part.Position
end

--==================================================
-- SOLTAR SIN IDIOMA
--==================================================

local function DropLanguageIndependent()

    -- Tomamos una fotografía de la interfaz
    -- y buscamos el control que apareció.

    local before =
        GetVisibleButtons()

    -- Esperar un momento a que el juego
    -- actualice la interfaz.
    task.wait(0.15)

    local button =
        WaitForNewButton(
            before,
            2
        )

    if button then
        ActivateButton(button)
        return true
    end

    -- Segundo intento:
    -- buscar botones cuyo nombre sugiera
    -- una acción de soltar/liberar,
    -- independientemente del idioma.

    local keywords = {
        "drop",
        "release",
        "throw",
        "discard",
        "soltar",
        "largar",
        "liberar"
    }

    for _, gui in ipairs(PlayerGui:GetDescendants()) do

        if gui:IsA("TextButton")
            or gui:IsA("ImageButton") then

            if gui.Visible and gui.Active then

                local text =
                    tostring(gui.Text or ""):lower()

                local name =
                    gui.Name:lower()

                for _, keyword in ipairs(keywords) do

                    if text:find(keyword, 1, true)
                        or name:find(keyword, 1, true) then

                        ActivateButton(gui)
                        return true
                    end
                end
            end
        end
    end

    warn(
        "⚠️ No encontré el control de soltar."
    )

    return false
end

--==================================================
-- CICLO
--==================================================

local function Start()

    print("🔎 Buscando mejor huevo...")

    local egg, value =
        BestEgg()

    if not egg then
        warn("❌ No encontré huevo.")
        return
    end

    local part =
        EggPart(egg)

    if not part then
        return
    end

    print(
        "🥚 Mejor huevo:",
        egg.Name,
        value
    )

    -- 1. TP AL HUEVO
    TP(part.Position)

    task.wait(0.15)

    -- 2. AGARRAR
    local buttonsBefore =
        GetVisibleButtons()

    Grab(egg)

    task.wait(0.4)

    -- 3. TP AL CENTRO
    print("📍 Centro")

    TP(CENTER)

    task.wait(0.3)

    -- 4. SOLTAR
    print("📦 Soltando en centro")

    DropLanguageIndependent()

    task.wait(0.4)

    -- 5. VOLVER A AGARRAR
    print("✋ Agarrando nuevamente")

    Grab(egg)

    task.wait(0.4)

    -- 6. BUSCAR PLOT
    local plot =
        FindPlot()

    if not plot then
        warn("❌ No encontré tu plot.")
        return
    end

    local position =
        PlotPosition(plot)

    if not position then
        warn("❌ No encontré posición del plot.")
        return
    end

    -- 7. DESPLAZAMIENTO A 1000
    print("🚀 Plot a velocidad 1000")

    Move1000(
        position + Vector3.new(0, 3, 0)
    )

    task.wait(0.3)

    -- 8. SOLTAR EN PLOT
    print("🏠 Soltando en plot")

    DropLanguageIndependent()

    print("✅ TERMINADO")
end

Start()
