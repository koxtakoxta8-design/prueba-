-- CONFIG
--========================

local EggData = {
    ["White Egg"] = 1,
    ["Brown Egg"] = 5,
    ["Cracked Egg"] = 30,
    ["Easter Egg"] = 50,
    ["Stone Egg"] = 100,
    ["Leaf Egg"] = 200,
    ["Mushroom Egg"] = 500,
    ["Flower Egg"] = 750,
    ["Slime Egg"] = 1000,
    ["Ice Egg"] = 3000,
    ["Glass Egg"] = 10000,
    ["Golden Egg"] = 30000,
    ["Crystal Egg"] = 150000,
    ["Skull Egg"] = 250000,
    ["Dominus Egg"] = 700000,
    ["Flaming Egg"] = 1000000,
    ["Sinister Egg"] = 3000000,
    ["Soul Egg"] = 7000000,
    ["Aurora Egg"] = 300000000,
    ["Galaxy Egg"] = 1500000000,
    ["Black Hole Egg"] = 100000000000,
    ["Cherub Egg"] = 1000000000000
}

local TPEnabled = false
local Running = false

--========================
-- CHARACTER
--========================

local function GetRoot()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

--========================
-- BUSCAR MEJOR HUEVO
--========================

local function GetBestEgg()
    local best = nil
    local bestLucky = -math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do

        if obj:IsA("BasePart") then

            local lucky = EggData[obj.Name]

            if lucky and lucky > bestLucky then
                bestLucky = lucky
                best = obj
            end

        end
    end

    return best
end

--========================
-- BUSCAR SPAWN
--========================

local function GetBaseSpawn()

    local spawn = Workspace:FindFirstChild("SpawnLocation", true)

    if spawn and spawn:IsA("BasePart") then
        return spawn
    end

    return nil
end

--========================
-- TP
--========================

local function TP(position)

    local root = GetRoot()

    if root then
        root.CFrame = CFrame.new(position + Vector3.new(0,3,0))
    end

end

--========================
-- INTENTAR RECOGER
--========================

local function GrabEgg(egg)

    local prompt = egg:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if prompt then

        pcall(function()
            prompt.HoldDuration = 0
        end)

        pcall(function()
            fireproximityprompt(prompt)
        end)

        return true
    end

    return false
end

--========================
-- RUTA
--========================

local function StartTP()

    if Running then
        return
    end

    Running = true

    while TPEnabled do

        local egg = GetBestEgg()

        if egg then

            -- Ir al mejor huevo
            TP(egg.Position)

            task.wait(0.5)

            -- Intentar agarrarlo
            GrabEgg(egg)

            task.wait(0.5)

            -- Volver a la base
            local spawn = GetBaseSpawn()

            if spawn then
                TP(spawn.Position)
            end

        end

        break
    end

    Running = false
end

