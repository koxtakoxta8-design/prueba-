local function DoCycle()

    if not InstaTP then
        return
    end

    RefreshBestEgg()
    UpdateUI()

    local egg = BestEgg

    if not egg then
        Status.Text = "● SIN HUEVO"
        return
    end

    Status.Text = "● TELEPORT"

    if not TeleportToEgg(egg) then
        return
    end

    Freeze()

    task.wait(0.12)

    if not InstaTP then
        Unfreeze()
        return
    end

    Status.Text = "● AUTO GRAB"

    AutoGrab(egg)

    task.wait(0.25)

    if not InstaTP then
        Unfreeze()
        return
    end

    Status.Text = "● RETURN"

    ReturnSpawn()

    task.wait(0.15)

    Unfreeze()

    Status.Text =
        LOP and "● LOOP ACTIVE" or "● READY"

end

