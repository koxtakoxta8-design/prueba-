local function GetEggData(name)
    if EggData[name] then return EggData[name] end
    local n = string.lower(name)
    for egg,data in pairs(EggData) do
        if string.find(n,string.lower(egg),1,true) then
            return data
        end
    end
end

local function IsEgg(obj)
    if not obj then return false end
    local n = string.lower(obj.Name)
    return string.find(n,"egg",1,true) ~= nil
        or string.find(n,"huevo",1,true) ~= nil
        or GetEggData(obj.Name) ~= nil
end

local function GetPart(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart end
        return obj:FindFirstChildWhichIsA("BasePart",true)
    end
end

local function GetPrompt(egg)
    if not egg then return nil end
    for _,v in ipairs(egg:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.Enabled then
            return v
        end
    end
end

local function IsPlacedEgg(egg)
    local names = {
        "Placed","IsPlaced","Claimed","InBase",
        "InPlot","Planted","IsPlanted"
    }

    for _,name in ipairs(names) do
        if egg:GetAttribute(name) == true then
            return true
        end
        local value = egg:FindFirstChild(name,true)
        if value and value:IsA("BoolValue") and value.Value then
            return true
        end
    end

    return false
end

local function GetRoot()
    local c = Player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local MySpawnPosition = nil

local function SaveMySpawn()
    local root = GetRoot()
    if root then
        MySpawnPosition = root.Position
    end
end

Player.CharacterAdded:Connect(function(character)
    task.wait(0.5)
    local root = character:FindFirstChild("HumanoidRootPart")
    if root then
        MySpawnPosition = root.Position
    end
end)

if Player.Character then
    task.defer(SaveMySpawn)
end

local function ReturnToMySpawn()
    local root = GetRoot()
    if root and MySpawnPosition then
        root.CFrame = CFrame.new(MySpawnPosition + Vector3.new(0,3,0))
        return true
    end
    return false
end

local function TeleportTo(part)
    local root = GetRoot()
    if not root or not part then return false end
    root.CFrame = part.CFrame + Vector3.new(0,2,0)
    return true
end

local function GetBestEgg()
    local best = nil
    local bestValue = -math.huge

    for _,obj in ipairs(Workspace:GetDescendants()) do
        if IsEgg(obj) and obj ~= CURRENT_EGG and not IsPlacedEgg(obj) then
            local data = GetEggData(obj.Name)
            local part = GetPart(obj)
            local prompt = GetPrompt(obj)

            if data and part and prompt then
                if data.Value > bestValue then
                    bestValue = data.Value
                    best = obj
                end
            end
        end
    end

    return best
end

