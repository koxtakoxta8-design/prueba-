local function RemoveESP(obj)
    local esp = obj:FindFirstChild("KOXTA_EggESP")
    if esp then esp:Destroy() end
end

local function ScanESP()
    for _,obj in ipairs(Workspace:GetDescendants()) do
        if IsEgg(obj) then
            if ESP_ENABLED then
                CreateESP(obj)
            else
                RemoveESP(obj)
            end
        end
    end
end

local function TryGrab(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then
        return false
    end

    local root = GetRoot()
    if not root then
        return false
    end

    local lockedPosition = root.Position
    local finished = false

    local connection
    connection = RunService.Heartbeat:Connect(function()
        if finished or not root.Parent then return end
        root.CFrame = CFrame.new(lockedPosition)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)

    local ok = pcall(function()
        prompt:InputHoldBegin()
        task.wait(math.max(prompt.HoldDuration,0.05))
        prompt:InputHoldEnd()
    end)

    finished = true
    if connection then
        connection:Disconnect()
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    return ok
end

local function WaitForGrab(egg,prompt)
    local deadline = os.clock() + 4

    while os.clock() < deadline do
        if not egg or not egg.Parent then
            return true
        end

        if not egg:IsDescendantOf(Workspace) then
            return true
        end

        if not prompt or not prompt.Parent then
            return true
        end

        if not prompt.Enabled then
            task.wait(0.08)
            if not prompt.Parent or not prompt.Enabled then
                return true
            end
        end

        task.wait()
    end

    return false
end

local function AutoGrabOnce()
    if BUSY then return end
    BUSY = true

    local egg = GetBestEgg()
    if not egg then
        BUSY = false
        return
    end

    CURRENT_EGG = egg

    local part = GetPart(egg)
    local prompt = GetPrompt(egg)

    if not part or not prompt then
        CURRENT_EGG = nil
        BUSY = false
        return
    end

    TeleportTo(part)
    RunService.Heartbeat:Wait()

    local grabbed = false

    for attempt = 1,3 do
        if not egg.Parent then
            grabbed = true
            break
        end

        prompt = GetPrompt(egg) or prompt

        if not prompt or not prompt.Parent then
            grabbed = true
            break
        end

        TryGrab(prompt)
        task.wait(0.05)

        if WaitForGrab(egg,prompt) then
            grabbed = true
            break
        end

        task.wait(0.05)
    end

    if grabbed then
        ReturnToMySpawn()

        local deliveryStart = os.clock()
        while os.clock() - deliveryStart < 1.5 do
            local root = GetRoot()
            if root and MySpawnPosition then
                root.CFrame = CFrame.new(MySpawnPosition + Vector3.new(0,3,0))
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
            RunService.Heartbeat:Wait()
        end
    end

    CURRENT_EGG = nil
    BUSY = false
end

task.spawn(function()
    while task.wait(AUTO_INTERVAL) do
        if AUTO_GRAB then
            pcall(AutoGrabOnce)
        end
    end
end)

local function EnableFPSBoost()
    FPS_ENABLED = true

    for _,obj in ipairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("ParticleEmitter")
                or obj:IsA("Trail")
                or obj:IsA("Beam")
                or obj:IsA("Smoke")
                or obj:IsA("Fire")
                or obj:IsA("Sparkles") then
                obj.Enabled = false
            elseif obj:IsA("PointLight")
                or obj:IsA("SpotLight")
                or obj:IsA("SurfaceLight") then
                obj.Enabled = false
            elseif obj:IsA("BasePart") then
                obj.CastShadow = false
            end
        end)
    end

    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
    end)

    for _,obj in ipairs(Lighting:GetChildren()) do
        pcall(function()
            if obj:IsA("BloomEffect")
                or obj:IsA("BlurEffect")
                or obj:IsA("ColorCorrectionEffect")
                or obj:IsA("DepthOfFieldEffect")
                or obj:IsA("SunRaysEffect") then
                obj.Enabled = false
            end
        end)
    end
end

local function DisableFPSBoost()
    FPS_ENABLED = false
    -- El boost está pensado para esta sesión; al apagarlo
    -- se restaura lo esencial de iluminación.
    pcall(function()
        Lighting.GlobalShadows = true
        Lighting.EnvironmentDiffuseScale = 1
        Lighting.EnvironmentSpecularScale = 1
    end)
end

