--==============================================================
-- FUNCIONES
--==============================================================

local function GetRoot()
    local Character = Player.Character
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function GetPosition(Object)
    if Object:IsA("BasePart") then
        return Object.Position
    end

    if Object:IsA("Model") then
        local Part = Object.PrimaryPart
            or Object:FindFirstChildWhichIsA("BasePart",true)

        return Part and Part.Position
    end

    return nil
end

local function IsExcluded(Position)
    if not Position then
        return true
    end

    return
        math.abs(Position.X - EXCLUSION_CENTER.X) <= EXCLUSION_RADIUS
        and
        math.abs(Position.Z - EXCLUSION_CENTER.Z) <= EXCLUSION_RADIUS
end

local function IsEgg(Object)
    local Name = Object.Name:lower()

    return
        Name:find("egg") ~= nil
        or
        Name:find("huevo") ~= nil
        or
        Object:GetAttribute("IsEgg") == true
end

local function FindPrompt(Object)
    if Object:IsA("ProximityPrompt") then
        return Object
    end

    return Object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )
end

--==============================================================
-- VALOR DEL HUEVO
--==============================================================

local function GetValue(Object)

    local Attributes = {
        "Luck",
        "luck",
        "EggLuck",
        "RarityValue",
        "Value",
        "Price"
    }

    for _,Name in ipairs(Attributes) do
        local Value = Object:GetAttribute(Name)

        if typeof(Value) == "number" then
            return Value
        end
    end

    for _,Item in ipairs(Object:GetDescendants()) do
        if Item:IsA("NumberValue")
        or Item:IsA("IntValue") then

            local Name = Item.Name:lower()

            if Name:find("luck")
            or Name:find("rarity")
            or Name:find("value")
            or Name:find("price") then

                return Item.Value
            end
        end
    end

    return 0
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function FindBestEgg()

    local Best = nil
    local Highest = -math.huge

    for _,Object in ipairs(workspace:GetDescendants()) do

        if IsEgg(Object) then

            local Position = GetPosition(Object)

            if Position and not IsExcluded(Position) then

                local Prompt = FindPrompt(Object)

                if Prompt and Prompt.Enabled then

                    local Value = GetValue(Object)

                    if Value > Highest then

                        Highest = Value

                        Best = {
                            Object = Object,
                            Position = Position,
                            Prompt = Prompt,
                            Value = Value
                        }
                    end
                end
            end
        end
    end

    return Best
end

--==============================================================
-- TELEPORT
--==============================================================

local function Teleport(Position)

    local Root = GetRoot()

    if not Root then
        return false
    end

    Root.CFrame = CFrame.new(
        Position + EGG_OFFSET
    )

    return true
end

--==============================================================
-- RECOGER
--==============================================================

local function CollectEgg(Egg)

    if not Egg
    or not Egg.Object
    or not Egg.Object.Parent then

        return false
    end

    local Prompt = FindPrompt(Egg.Object)

    if not Prompt or not Prompt.Enabled then
        return false
    end

    StatusLabel.Text = "Estado: RECOGIENDO"

    pcall(function()
        Prompt.HoldDuration = 0
    end)

    pcall(function()
        Prompt:InputHoldBegin()
        task.wait()
        Prompt:InputHoldEnd()
    end)

    return true
end

--==============================================================
-- BUSCAR PLOT
--==============================================================

local function IsMyPlot(Object)

    local Names = {
        "Owner",
        "owner",
        "OwnerName",
        "ownerName"
    }

    for _,Name in ipairs(Names) do

        local Attribute = Object:GetAttribute(Name)

        if Attribute ~= nil then

            if tostring(Attribute) == Player.Name
            or tostring(Attribute) == tostring(Player.UserId) then

                return true
            end
        end

        local Value = Object:FindFirstChild(Name,true)

        if Value then

            if Value:IsA("StringValue")
            and Value.Value == Player.Name then
                return true
            end

            if Value:IsA("IntValue")
            and Value.Value == Player.UserId then
                return true
            end

            if Value:IsA("ObjectValue")
            and Value.Value == Player then
                return true
            end
        end
    end

    return false
end

local function FindMyPlot()

    for _,Object in ipairs(workspace:GetDescendants()) do

        local Name = Object.Name:lower()

        if Name:find("plot")
        or Name:find("tycoon")
        or Name:find("base") then

            if IsMyPlot(Object) then

                local Position = GetPosition(Object)

                if Position then
                    return Position
                end
            end
        end
    end

    return nil
end

--==============================================================
-- CICLO UNA VEZ
--==============================================================

local function RunOnce()

    if Busy then
        return
    end

    Busy = true

    StatusLabel.Text = "Estado: BUSCANDO"

    local Egg = FindBestEgg()

    if not Egg then
        BestLabel.Text = "🏆 Mejor: NINGUNO"
        ValueLabel.Text = "Valor: —"
        StatusLabel.Text = "Estado: SIN HUEVO"
        Busy = false
        return
    end

    BestLabel.Text =
        "🏆 Mejor: " .. Egg.Object.Name

    ValueLabel.Text =
        "Valor: " .. tostring(Egg.Value)

    if IsExcluded(Egg.Position) then
        Busy = false
        return
    end

    StatusLabel.Text = "Estado: TP AL HUEVO"

    Teleport(Egg.Position)

    task.wait(0.12)

    if Egg.Object.Parent then

        CollectEgg(Egg)

        local Start = os.clock()

        while os.clock() - Start < 1.5 do

            if not Egg.Object.Parent then
                break
            end

            task.wait()
        end
    end

    StatusLabel.Text = "Estado: BUSCANDO PLOT"

    local Plot = FindMyPlot()

    if Plot then

        StatusLabel.Text = "Estado: TP AL PLOT"

        Teleport(Plot)

        task.wait(.3)

        StatusLabel.Text = "Estado: COMPLETADO"

    else

        StatusLabel.Text = "Estado: PLOT NO ENCONTRADO"
    end

    Busy = false
end

