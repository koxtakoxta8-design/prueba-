local animatedGradients = {}

local function createAnimatedStroke(parent, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.new(1, 1, 1)
    stroke.Thickness = thickness or 1.5
    stroke.Parent = parent

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
        ColorSequenceKeypoint.new(0.5, Color3.new(0, 0, 0)),
        ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1))
    })
    gradient.Rotation = 90
    gradient.Parent = stroke

    table.insert(animatedGradients, gradient)
    return stroke, gradient
end

local function translateRarity(rarity)
    local r = string.lower(rarity or "")
    if r == "comun" or r == "common" then return "Common"
    elseif r == "raro" or r == "rare" then return "Rare"
    elseif r == "epico" or r == "epic" then return "Epic"
    elseif r == "legendario" or r == "legendary" then return "Legendary"
    elseif r == "mitico" or r == "mythic" then return "Mythic"
    elseif r == "divino" or r == "divine" then return "Divine"
    elseif r == "etereo" or r == "etereal" then return "Ethereal"
    else return rarity or "Divine" end
end

local function applyRarityStyle(label, rarity)
    for _, child in ipairs(label:GetChildren()) do
        if child:IsA("UIGradient") then child:Destroy() end
    end
    local r = string.lower(rarity or "")
    if r == "common" or r == "comun" then
        label.TextColor3 = Color3.fromRGB(150, 150, 150)
    elseif r == "rare" or r == "raro" then
        label.TextColor3 = Color3.fromRGB(100, 200, 255)
    elseif r == "epic" or r == "epico" then
        label.TextColor3 = Color3.fromRGB(170, 80, 255)
    elseif r == "legendary" or r == "legendario" then
        label.TextColor3 = Color3.fromRGB(255, 220, 50)
    elseif r == "mythic" or r == "mitico" then
        label.TextColor3 = Color3.fromRGB(255, 105, 180)
    elseif r == "divine" or r == "divino" then
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        local grad = Instance.new("UIGradient")
        grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 215, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(218, 165, 32))
        })
        grad.Parent = label
    elseif r == "ethereal" or r == "etereo" then
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        local grad = Instance.new("UIGradient")
        grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(80, 140, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 100, 180))
        })
        grad.Parent = label
    else
        label.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end

local function getEggData(eggName)
    if EggDatabase[eggName] then return EggDatabase[eggName] end
    for name, data in pairs(EggDatabase) do
        if string.find(string.lower(eggName), string.lower(name)) then
            return data
        end
    end
    return {Rank = 0, Rarity = "Divine", Cost = "---"}
end

local function getEggImage(eggName)
    local main = PlayerGui:FindFirstChild("Main")
    local index = main and main:FindFirstChild("Index")
    local holders = index and index:FindFirstChild("Holders")
    local eggsHolder = holders and holders:FindFirstChild("EggsHolder")

    if eggsHolder then
        local eggFrame = eggsHolder:FindFirstChild(eggName)
        if eggFrame then
            local img = eggFrame:FindFirstChild("ImageLabel") or eggFrame:FindFirstChildOfClass("ImageLabel")
            if img then return img.Image end
        end
    end
    return JK_IMAGE
end

local function getRoot()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return char:FindFirstChild("HumanoidRootPart")
end

local function teleportToCF(cf)
    local root = getRoot()
    if root and cf then
        root.CFrame = cf * CFrame.new(0, 2, 0)
