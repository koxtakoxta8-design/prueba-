--==============================================================
-- MINIMIZAR
--==============================================================

local Minimized = false

local FullSize =
    UDim2.fromOffset(285,185)

local BarSize =
    UDim2.fromOffset(285,34)

local FullPosition =
    Main.Position

MinButton.MouseButton1Click:Connect(
    function()

        if not Minimized then

            Minimized = true

            TweenService:Create(
                Main,
                TweenInfo.new(
                    0.35,
                    Enum.EasingStyle.Quart,
                    Enum.EasingDirection.Out
                ),
                {
                    Size = BarSize,
                    Position =
                        UDim2.new(
                            FullPosition.X.Scale,
                            FullPosition.X.Offset,
                            0,
                            10
                        )
                }
            ):Play()

        else

            Minimized = false

            TweenService:Create(
                Main,
                TweenInfo.new(
                    0.35,
                    Enum.EasingStyle.Quart,
                    Enum.EasingDirection.Out
                ),
                {
                    Size = FullSize,
                    Position = FullPosition
                }
            ):Play()
        end
    end
)

