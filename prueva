--==============================================================
-- NORMALIZAR TEXTO
--==============================================================

local function Normalize(text)

    if text == nil then
        return ""
    end

    text = tostring(text)

    text = text
        :gsub("🍀", "")
        :gsub("🥚", "")
        :gsub("⭐", "")
        :gsub("🏆", "")

    text = text:gsub("^%s+", "")
    text = text:gsub("%s+$", "")

    return string.lower(text)
end

--==============================================================
-- BUSCAR EGG DATA
--==============================================================

local function FindEggData(value)

    if value == nil then
        return nil, nil
    end

    local text = Normalize(value)

    if text == "" then
        return nil, nil
    end

    -- Exacto
    for eggName, data in pairs(EggData) do

        if text == Normalize(eggName) then
            return eggName, data
        end
    end

    -- Contenido
    for eggName, data in pairs(EggData) do

        if string.find(
            text,
            Normalize(eggName),
            1,
            true
        ) then

            return eggName, data
        end
    end

    return nil, nil
end

--==============================================================
-- PARTE / POSICIÓN
--==============================================================

local function GetPosition(obj)

    if not obj then
        return nil
    end

    if obj:IsA("BasePart") then
        return obj.Position
    end

    if obj:IsA("Attachment") then
        return obj.WorldPosition
    end

    if obj:IsA("Model") then

        if obj.PrimaryPart then
            return obj.PrimaryPart.Position
        end

        local part =
            obj:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        if part then
            return part.Position
        end
    end

    return nil
end

--==============================================================
-- ENCONTRAR POSICIÓN EN PADRE
--==============================================================

local function FindParentPosition(obj)

    local current = obj

    for i = 1, 8 do

        if not current then
            break
        end

        local pos =
            GetPosition(current)

        if pos then
            return pos
        end

        current =
            current.Parent
    end

    return nil
end

--==============================================================
