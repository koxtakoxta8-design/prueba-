
--// RIDE A PET - AUTO BEST EGG
--// SINGLE LOCALSCRIPT
--// ON / OFF

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

local CENTER = Vector3.new(146.87, 40316.12, 911.14)
local EXCLUSION_RADIUS = 210
local PLOT_SPEED = 500

local Enabled = false
local Running = false

local EggValues = {
	["White Egg"] = 1,
	["Brown Egg"] = 5,
	["Cracked Egg"] = 30,
	["Easter Egg"] = 50,
	["Stone Egg"] = 100,
	["Leaf Egg"] = 200,
	["Mushroom Egg"] = 500,
	["Flower Egg"] = 750,
	["Slime Egg"] = 1000,
	["Ice Egg"] = 3000,
	["Glass Egg"] = 10000,
	["Golden Egg"] = 30000,
	["Crystal Egg"] = 150000,
	["Skull Egg"] = 250000,
	["Dominus Egg"] = 700000,
	["Flaming Egg"] = 1000000,
	["Sinister Egg"] = 3000000,
	["Soul Egg"] = 7000000,
	["Aurora Egg"] = 300000000,
	["Galaxy Egg"] = 1500000000,
	["Blackhole Egg"] = 100000000000,
	["Solaris Egg"] = 300000000000,
	["Cherub Egg"] = 1000000000000,
	["Volcanic Egg"] = 2500000000000,
}

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

local function getCharacter()
	local Character = Player.Character
	if not Character then
		return nil, nil
	end

	return Character, Character:FindFirstChild("HumanoidRootPart")
end

--------------------------------------------------
-- EGG POSITION
--------------------------------------------------

local function getEggPosition(Egg)
	if not Egg or not Egg.Parent then
		return nil
	end

	if Egg:IsA("BasePart") then
		return Egg.Position
	end

	if Egg:IsA("Model") then
		return Egg:GetPivot().Position
	end

	local Part = Egg:FindFirstChildWhichIsA("BasePart", true)

	return Part and Part.Position
end

--------------------------------------------------
-- EGG VALUE
--------------------------------------------------

local function getEggValue(Egg)
	if EggValues[Egg.Name] then
		return EggValues[Egg.Name]
	end

	local Name = Egg:GetAttribute("EggName")

	if typeof(Name) == "string" then
		return EggValues[Name]
	end

	return nil
end

--------------------------------------------------
-- CENTER BLOCK
--------------------------------------------------

local function isInsideCenter(Position)
	return (Position - CENTER).Magnitude <= EXCLUSION_RADIUS
end

--------------------------------------------------
-- FIND BEST EGG
--------------------------------------------------

local function findBestEgg()

	local BestEgg = nil
	local BestValue = -math.huge

	for _, Object in ipairs(workspace:GetDescendants()) do

		if not Enabled then
			return nil
		end

		local Value = getEggValue(Object)

		if Value then

			local Position = getEggPosition(Object)

			if Position and not isInsideCenter(Position) then

				if Value > BestValue then
					BestValue = Value
					BestEgg = Object
				end
			end
		end
	end

	return BestEgg
end

--------------------------------------------------
-- TP
--------------------------------------------------

local function teleport(Position)

	if not Enabled then
		return false
	end

	local Character, Root = getCharacter()

	if not Character or not Root then
		return false
	end

	Character:PivotTo(
		CFrame.new(Position + Vector3.new(0, 3, 0))
	)

	return true
end

--------------------------------------------------
-- FIND GRAB PROMPT
--------------------------------------------------

local GrabWords = {
	"grab",
	"pickup",
	"pick up",
	"collect",
	"take",
	"get",
	"recoger",
	"agarrar",
	"tomar",
	"coger",
	"levantar",
}

local function findGrabPrompt(Egg)

	if not Egg then
		return nil
	end

	for _, Object in ipairs(Egg:GetDescendants()) do

		if Object:IsA("ProximityPrompt") then

			local Text = string.lower(
				tostring(Object.Name) .. " " ..
				tostring(Object.ActionText) .. " " ..
				tostring(Object.ObjectText)
			)

			for _, Word in ipairs(GrabWords) do

				if string.find(Text, Word, 1, true) then
					return Object
				end
			end
		end
	end

	return nil
end

--------------------------------------------------
-- GRAB
--------------------------------------------------

local function grabEgg(Egg)

	local Prompt = findGrabPrompt(Egg)

	if not Prompt then
		return false
	end

	pcall(function()
		Prompt.HoldDuration = 0
	end)

	pcall(function()
		Prompt:InputHoldBegin()
		Prompt:InputHoldEnd()
	end)

	return true
end

--------------------------------------------------
-- DETECT HOLDING
--------------------------------------------------

local function isHoldingEgg()

	local Character = Player.Character

	if not Character then
		return false
	end

	if Character:GetAttribute("HoldingEgg") == true then
		return true
	end

	if Player:GetAttribute("HoldingEgg") == true then
		return true
	end

	for _, Object in ipairs(Character:GetDescendants()) do

		if Object:GetAttribute("IsEgg") == true then
			return true
		end

		if Object:GetAttribute("HoldingEgg") == true then
			return true
		end

		if EggValues[Object.Name] then
			return true
		end
	end

	return false
end

--------------------------------------------------
-- GRAB UNTIL CONFIRMED
--------------------------------------------------

local function grabUntilConfirmed(Egg)

	for _ = 1, 40 do

		if not Enabled then
			return false
		end

		if isHoldingEgg() then
			return true
		end

		grabEgg(Egg)

		task.wait(0.05)

		if isHoldingEgg() then
			return true
		end
	end

	return isHoldingEgg()
end

--------------------------------------------------
-- DROP EGG
--------------------------------------------------

local function dropEgg()

	if not Enabled then
		return false
	end

	local PlayerGui = Player:FindFirstChild("PlayerGui")

	if not PlayerGui then
		return false
	end

	for _, Gui in ipairs(PlayerGui:GetDescendants()) do

		if
			(Gui:IsA("TextButton") or Gui:IsA("ImageButton"))
			and (
				string.lower(Gui.Name) == "dropegg"
				or string.find(string.lower(Gui.Name), "dropegg", 1, true)
			)
		then

			pcall(function()
				Gui:Activate()
			end)

			return true
		end
	end

	return false
end

--------------------------------------------------
-- FIND MY PLOT
--------------------------------------------------

local function findMyPlot()

	for _, Object in ipairs(workspace:GetDescendants()) do

		if not Enabled then
			return nil
		end

		if Object:IsA("Model") or Object:IsA("Folder") then

			local Names = {
				"Owner",
				"OwnerName",
				"Player",
				"PlayerName",
				"Username",
				"UserName",
			}

			for _, Attribute in ipairs(Names) do

				local Value = Object:GetAttribute(Attribute)

				if Value == Player.Name
					or Value == Player.DisplayName then

					return Object
				end
			end

			local UserId =
				Object:GetAttribute("UserId")
				or Object:GetAttribute("OwnerUserId")

			if tonumber(UserId) == Player.UserId then
				return Object
			end
		end
	end

	return nil
end

--------------------------------------------------
-- PLOT POSITION
--------------------------------------------------

local function getPlotPosition(Plot)

	if not Plot then
		return nil
	end

	local Names = {
		"Spawn",
		"SpawnLocation",
		"EggDrop",
		"DropEgg",
		"Drop",
		"Base",
	}

	for _, Name in ipairs(Names) do

		local Object = Plot:FindFirstChild(Name, true)

		if Object then

			if Object:IsA("BasePart") then
				return Object.Position
			end

			if Object:IsA("Model") then
				return Object:GetPivot().Position
			end
		end
	end

	if Plot:IsA("Model") then
		return Plot:GetPivot().Position
	end

	return nil
end

--------------------------------------------------
-- MOVE 500 STUDS/S
--------------------------------------------------

local function moveToPlot(Position)

	local Character, Root = getCharacter()

	if not Character or not Root then
		return false
	end

	local Start = Root.Position
	local Distance = (Position - Start).Magnitude

	if Distance <= 1 then
		return true
	end

	local Duration = Distance / PLOT_SPEED
	local StartTime = os.clock()

	while Enabled do

		local Alpha = math.clamp(
			(os.clock() - StartTime) / Duration,
			0,
			1
		)

		Character:PivotTo(
			CFrame.new(Start:Lerp(Position, Alpha))
		)

		if Alpha >= 1 then
			return true
		end

		RunService.Heartbeat:Wait()
	end

	return false
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

local function start()

	if Running then
		return
	end

	Running = true

	while Enabled do

		-- BEST EGG
		local Egg = findBestEgg()

		if not Egg then
			task.wait(0.2)
			continue
		end

		local Position = getEggPosition(Egg)

		if not Position then
			continue
		end

		-- TP
		teleport(Position)

		task.wait()

		-- GRAB
		if not grabUntilConfirmed(Egg) then
			continue
		end

		-- CENTER
		teleport(CENTER)

		task.wait()

		-- DROP
		dropEgg()

		task.wait(0.2)

		-- SECOND BEST EGG
		local Egg2 = findBestEgg()

		if not Egg2 then
			continue
		end

		local Position2 = getEggPosition(Egg2)

		if not Position2 then
			continue
		end

		-- NEVER PICK INSIDE 210
		if isInsideCenter(Position2) then
			continue
		end

		-- TP
		teleport(Position2)

		task.wait()

		-- GRAB AGAIN
		if not grabUntilConfirmed(Egg2) then
			continue
		end

		-- MY PLOT
		local Plot = findMyPlot()

		if not Plot then
			task.wait(0.2)
			continue
		end

		local PlotPosition = getPlotPosition(Plot)

		if not PlotPosition then
			continue
		end

		-- 500 STUDS/S
		if not moveToPlot(PlotPosition) then
			break
		end

		-- FINAL DROP
		if Enabled then
			dropEgg()
		end

		task.wait(0.25)
	end

	Running = false
end

