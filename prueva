local function triggerDropEggButton()
    local foundBtn = nil
    for _, gui in ipairs(PlayerGui:GetDescendants()) do
        if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and (string.lower(gui.Name) == "dropegg" or string.find(string.lower(gui.Name), "dropegg")) then
            foundBtn = gui
            break
        end
    end

    if foundBtn then
        for _, conn in ipairs(getconnections(foundBtn.MouseButton1Click)) do
            conn:Fire()
        end
        for _, conn in ipairs(getconnections(foundBtn.Activated)) do
            conn:Fire()
        end
    else
        pcall(function()
            local remote = ReplicatedStorage:FindFirstChild("Packages") 
                and ReplicatedStorage.Packages:FindFirstChild("Networking") 
                and ReplicatedStorage.Packages.Networking:FindFirstChild("RF/EggWorld/AskFieldEggDrop")
            if remote then
                remote:InvokeServer({ Reason = "PlayerRequest" })
            end
        end)
    end
end

local function characterHasEgg()
    local char = LocalPlayer.Character
    if not char then return false end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") or string.find(string.lower(child.Name), "egg") then
            return true
        end
    end
    return false
end

local addStealHistory

local function executeIdaAutoGrab(targetObj, activeCheckCondition)
    if not targetObj or not targetObj.Parent then return end
    local startTime = tick()
    while activeCheckCondition() and (tick() - startTime < 3.5) do
        interactWithPrompt(targetObj)
        if characterHasEgg() or not targetObj.Parent then break end
        task.wait()
    end
end

local function executeAntiCheatAutoGrab(maxTime)
    local grabRadius = 15
    local timeout = maxTime or 2.0
    local startTime = tick()

    while not characterHasEgg() and (tick() - startTime < timeout) do
        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")

        if rootPart then
            local nearestPrompt = nil
            local nearestDist = grabRadius

            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") and obj.Enabled then
                    local parentPart = obj.Parent
                    if parentPart and parentPart:IsA("BasePart") then
                        local dist = (rootPart.Position - parentPart.Position).Magnitude
                        if dist <= nearestDist then
                            nearestDist = dist
                            nearestPrompt = obj
                        end
                    end
                end
            end

            if nearestPrompt then
                pcall(function()
                    if fireproximityprompt then
                        fireproximityprompt(nearestPrompt)
                    else
                        nearestPrompt:InputHoldBegin()
                        nearestPrompt:InputHoldEnd()
                    end
                end)
            end
        end

        if characterHasEgg() then break end
        task.wait()
    end
end

local function performAntiCheatAndReturn(eggName, rarity, cost)
    -- Mantener el punto anti-cheat original
    teleportToVector(ANTI_CHEAT_POS)
    task.wait()

    -- Soltar y recuperar rápidamente
    triggerDropEggButton()
    executeAntiCheatAutoGrab(2.0)

    -- Sin espera fija de 2 segundos: salir al plot apenas se tenga
    if characterHasEgg() then
        addStealHistory(eggName, rarity, cost)
    end

    teleportToHome()
    unequipEggs()
end

local function getTop10EggsInServer()
    local containers = {
        Workspace:FindFirstChild("RenderedEggs"),
        Workspace:FindFirstChild("Shop"),
        Workspace:FindFirstChild("ShopEggs"),
        Workspace:FindFirstChild("Eggs")
    }

    local foundEggs = {}
    for _, container in ipairs(containers) do
        if container then
            local children = container:GetChildren()
            for i = 1, #children do
                local egg = children[i]
                if egg:IsA("Model") or egg:IsA("BasePart") then
                    local data = getEggData(egg.Name)
                    table.insert(foundEggs, {Object = egg, Name = egg.Name, Data = data})
                end
            end
        end
    end

    table.sort(foundEggs, function(a, b) return a.Data.Rank > b.Data.Rank end)

    local top10 = {}
    for i = 1, math.min(10, #foundEggs) do
        table.insert(top10, foundEggs[i])
    end
    return top10
end


