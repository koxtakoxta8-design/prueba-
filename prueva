local Dragging = false
local DragStart
local StartPosition

Panel.InputBegan:Connect(
    function(Input)

        if
            Input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or
            Input.UserInputType ==
            Enum.UserInputType.Touch
        then

            Dragging = true

            DragStart =
                Input.Position

            StartPosition =
                FX.Position

        end
    end
)

UserInputService.InputChanged:Connect(
    function(Input)

        if not Dragging then
            return
        end

        if
            Input.UserInputType ==
            Enum.UserInputType.MouseMovement
            or
            Input.UserInputType ==
            Enum.UserInputType.Touch
        then

            local Delta =
                Input.Position -
                DragStart

            FX.Position =
                UDim2.new(
                    StartPosition.X.Scale,
                    StartPosition.X.Offset +
                    Delta.X,

                    StartPosition.Y.Scale,
                    StartPosition.Y.Offset +
                    Delta.Y
                )
        end
    end
)

UserInputService.InputEnded:Connect(
    function(Input)

        if
            Input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or
            Input.UserInputType ==
            Enum.UserInputType.Touch
        then

            Dragging = false

        end
    end
)

