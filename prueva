local function UpdateUI()
    if BestEgg and BestEgg.Parent then
        local luck = GetDynamicLuck(BestEgg)
        EggText.Text =
            "Mejor huevo: " .. tostring(BestEgg.Name)
            .. " | Luck: " .. tostring(luck or "N/A")
    else
        EggText.Text = "Mejor huevo: buscando..."
    end
end

local function DoCycle()

    if not InstaTP then
        return
    end

    RefreshBestEgg()
    UpdateUI()

    local egg = BestEgg

    if not egg or not IsValidEgg(egg) then
        RefreshBestEgg()
        UpdateUI()
        egg = BestEgg
    end

    if not egg then
        Status.Text = "Estado: no hay huevo válido"
        return
    end

    Status.Text = "Estado: TP a " .. tostring(egg.Name)

    if not TeleportToEgg(egg) then
        Status.Text = "Estado: fallo TP"
        return
    end

    Freeze()

    if not InstaTP then
        Unfreeze()
        StopEggLock()
        return
    end

    Status.Text = "Estado: agarrando"

    local grabbed = AutoGrab(egg)

    if not grabbed then
        StopEggLock()
        Unfreeze()
        Status.Text = "Estado: no se pudo agarrar"
        return
    end

    task.wait(0.25)

    if not InstaTP then
        StopEggLock()
        Unfreeze()
        return
    end

    Status.Text = "Estado: regresando"

    StopEggLock()
    Unfreeze()

    task.wait(0.05)

    local returned = ReturnSpawn()

    Status.Text =
        returned and (LOP and "Estado: LOOP activo" or "Estado: listo")
        or "Estado: spawn no encontrado"
end

