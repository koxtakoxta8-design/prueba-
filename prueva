--==============================================================
-- UTILIDADES
--==============================================================

local function GetRoot()

    local Character =
        Player.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild(
        "HumanoidRootPart"
    )
end

local function GetPart(Object)

    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then
        return Object
    end

    if Object:IsA("Model") then

        return Object.PrimaryPart
            or Object:FindFirstChildWhichIsA(
                "BasePart",
                true
            )
    end

    return nil
end

local function LuckValue(Value)

    local Number =
        tonumber(
            string.match(
                tostring(Value),
                "[%d%.]+"
            )
        )

    if not Number then
        return 0
    end

    local Text =
        string.upper(
            tostring(Value)
        )

    if string.find(Text, "T", 1, true) then
        return Number * 1000000000000
    end

    if string.find(Text, "B", 1, true) then
        return Number * 1000000000
    end

    if string.find(Text, "M", 1, true) then
        return Number * 1000000
    end

    if string.find(Text, "K", 1, true) then
        return Number * 1000
    end

    return Number
end

--==============================================================
-- 🚫 ZONA PROTEGIDA DE TU BASE
--==============================================================

local function IsInsideOwnBase(Position)

    if not Position then
        return true
    end

    local Distance =
        (
            Position -
            EXCLUSION_CENTER
        ).Magnitude

    return Distance <= EXCLUSION_RADIUS
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function FindBestEgg()

    local Root =
        GetRoot()

    if not Root then
        return nil
    end

    local Best = nil
    local BestValue = -1

    for _, Object in ipairs(
        Workspace:GetDescendants()
    ) do

        local Luck =
            EggNames[
                Object.Name
            ]

        if Luck then

            local Part =
                GetPart(Object)

            if Part then

                local Position =
                    Part.Position

                --==================================================
                -- 🚫 PRIMER FILTRO:
                -- NUNCA SELECCIONAR HUEVOS DENTRO DE LOS 210 STUDS
                --==================================================

                local OwnBase =
                    IsInsideOwnBase(
                        Position
                    )

                if not OwnBase then

                    --================================================
                    -- DISTANCIA MÁXIMA
                    --================================================

                    local Distance =
                        (
                            Position -
                            Root.Position
                        ).Magnitude

                    if Distance <= MAX_DISTANCE then

                        local Value =
                            LuckValue(
                                Luck
                            )

                        if Value > BestValue then

                            BestValue =
                                Value

                            Best =
                                Object

                        end
                    end
                end
            end
        end
    end

    return Best
end

