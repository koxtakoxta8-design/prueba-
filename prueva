--==============================================================
-- CICLO COMPLETO
--==============================================================

local function DoCycle()

    if not InstaTP then
        return
    end

    -- refrescar objetivo inmediatamente
    BestEgg =
        FindBestEgg()

    if not BestEgg then

        Status.Text =
            "● NO HAY HUEVO"

        return
    end

    Status.Text =
        "● TELEPORT"

    local Teleported =
        TeleportToEgg(
            BestEgg
        )

    if not Teleported then
        return
    end

    -- quedarse totalmente quieto
    Freeze()

    task.wait(
        0.12
    )

    if not InstaTP then

        Unfreeze()

        return
    end

    Status.Text =
        "● AUTO GRAB x3"

    AutoGrab(
        BestEgg
    )

    task.wait(
        0.25
    )

    if not InstaTP then

        Unfreeze()

        return
    end

    Status.Text =
        "● SPAWN"

    ReturnSpawn()

    task.wait(
        0.15
    )

    Unfreeze()

    Status.Text =
        LOP
        and "● LOOP ACTIVE"
        or "● READY"
end

--==============================================================
-- BOTÓN LOP
--==============================================================

LoopButton.Activated:Connect(
    function()

        ButtonAnimation(
            LoopButton
        )

        LOP =
            not LOP

        UpdateButtons()

        if LOP then

            Status.Text =
                "● LOOP READY"

        else

            Status.Text =
                "● READY"

        end
    end
)

--==============================================================
-- BOTÓN INSTA TP
--==============================================================

TPButton.Activated:Connect(
    function()

        ButtonAnimation(
            TPButton
        )

        InstaTP =
            not InstaTP

        UpdateButtons()

        if not InstaTP then

            Status.Text =
                "● READY"

            Unfreeze()

            return
        end

        -- guardar posición inicial
        SaveSpawn()

        --==========================================================
        -- LOP ACTIVADO
        --==========================================================

        if LOP then

            Status.Text =
                "● LOOP ACTIVE"

            task.spawn(
                function()

                    while
                        InstaTP
                        and LOP
                    do

                        if not Busy then

                            Busy = true

                            pcall(
                                function()
                                    DoCycle()
                                end
                            )

                            Busy = false

                        end

                        -- ciclo controlado
                        task.wait(
                            REFRESH_TIME
                        )
                    end

                end
            )

        --==========================================================
        -- LOP DESACTIVADO
        --==========================================================

        else

            task.spawn(
                function()

                    if not Busy then

                        Busy = true

                        pcall(
                            function()
                                DoCycle()
                            end
                        )

                        Busy = false

                    end

                    InstaTP = false

                    UpdateButtons()

                    Status.Text =
                        "● READY"

                end
            )
        end
    end
)

