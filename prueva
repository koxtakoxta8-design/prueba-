local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Player = Players.LocalPlayer

--==================================================
-- REMOTE DEL SNAPSHOT
--==================================================

local function FindRemote(path)
    local current = ReplicatedStorage

    for part in string.gmatch(path, "[^%.]+") do
        current = current and current:FindFirstChild(part)
    end

    return current
end

local SnapshotRemote =
    FindRemote("Packages.Networking.RF/EggWorld/AskFieldEggSnapshot")

--==================================================
-- 22 HUEVOS
--==================================================

local EggLuck = {
    ["White Egg"]      = 1,
    ["Brown Egg"]      = 5,
    ["Cracked Egg"]    = 30,
    ["Easter Egg"]     = 50,
    ["Stone Egg"]      = 100,
    ["Leaf Egg"]       = 200,
    ["Mushroom Egg"]   = 500,
    ["Flower Egg"]     = 750,
    ["Slime Egg"]      = 1000,
    ["Ice Egg"]        = 3000,
    ["Glass Egg"]      = 10000,
    ["Golden Egg"]     = 30000,
    ["Crystal Egg"]    = 150000,
    ["Skull Egg"]      = 250000,
    ["Dominus Egg"]    = 700000,
    ["Flaming Egg"]    = 1000000,
    ["Sinister Egg"]   = 3000000,
    ["Soul Egg"]       = 7000000,
    ["Aurora Egg"]     = 300000000,
    ["Galaxy Egg"]     = 1500000000,
    ["Black Hole Egg"] = 100000000000,
    ["Cherub Egg"]     = 1000000000000,
}

--==================================================
-- CATALOGO
--==================================================

local Catalog = {}

pcall(function()

    local Data = ReplicatedStorage:FindFirstChild("Data")
    local Assets = Data and Data:FindFirstChild("Assets")

    if Assets then

        local module = require(Assets)

        if type(module) == "table"
        and type(module.Directory) == "table" then

            Catalog = module.Directory
        end
    end
end)

--==================================================
-- OBTENER NOMBRE REAL
--==================================================

local function GetAssetName(category)

    local entry = Catalog[tostring(category)]

    if not entry then
        return nil
    end

    return entry.DisplayName
        or entry._id
        or entry.Name
end

--==================================================
-- SNAPSHOT → MEJOR HUEVO
--==================================================

local function FindBestEgg()

    if not SnapshotRemote then
        warn("AskFieldEggSnapshot no encontrado")
        return nil
    end

    local ok, snapshot =
        pcall(function()
            return SnapshotRemote:InvokeServer()
        end)

    if not ok or type(snapshot) ~= "table" then
        return nil
    end

    local records =
        snapshot.Records or snapshot

    if type(records) ~= "table" then
        return nil
    end

    local bestRecord
    local bestLuck = -1
    local bestName

    for _, record in pairs(records) do

        if type(record) == "table"
        and record.BottomCFrame then

            local name =
                GetAssetName(record.AssetCategory)

            local luck =
                name and EggLuck[name]

            if luck and luck > bestLuck then

                bestRecord = record
                bestLuck = luck
                bestName = name
            end
        end
    end

    return bestRecord, bestName, bestLuck
end

--==================================================
-- ENCONTRAR HUEVO FÍSICO
--==================================================

local function FindPhysicalEgg(name, position)

    local closest
    local closestDistance = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do

        if obj.Name == name then

            local part

            if obj:IsA("BasePart") then
                part = obj

            elseif obj:IsA("Model") then
                part =
                    obj.PrimaryPart
                    or obj:FindFirstChildWhichIsA(
                        "BasePart",
                        true
                    )
            end

            if part then

                local distance =
                    (part.Position - position).Magnitude

                if distance < closestDistance then

                    closest = obj
                    closestDistance = distance
                end
            end
        end
    end

    return closest
end

--==================================================
-- PROMPT
--==================================================

local function FindPrompt(object)

    if not object then
        return nil
    end

    return object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )
end

--==================================================
-- SPAWN
--==================================================

local function FindSpawn()

    return Workspace:FindFirstChildWhichIsA(
        "SpawnLocation",
        true
    )
end

--==================================================
-- EJECUTAR
--==================================================

local Busy = false

local function Execute()

    if Busy then
        return
    end

    Busy = true

    local character = Player.Character
    local root =
        character
        and character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        Busy = false
        return
    end

    local record, name, luck =
        FindBestEgg()

    if not record then
        warn("No encontré ninguno de los 22 huevos.")
        Busy = false
        return
    end

    local position

    if typeof(record.BottomCFrame) == "CFrame" then
        position = record.BottomCFrame.Position

    elseif typeof(record.BottomCFrame) == "Vector3" then
        position = record.BottomCFrame
    end

    if not position then
        Busy = false
        return
    end

    print("🥚 MEJOR:", name)
    print("🍀 LUCK:", luck)

    -- Buscar objeto físico
    local egg =
        FindPhysicalEgg(name, position)

    if not egg then
        warn("No encontré el objeto físico:", name)
        Busy = false
        return
    end

    local part =
        egg:IsA("BasePart")
        and egg
        or egg.PrimaryPart
        or egg:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if not part then
        Busy = false
        return
    end

    -- TP
    root.CFrame =
        part.CFrame + Vector3.new(0, 3, 0)

    task.wait(0.15)

    -- Prompt
    local prompt =
        FindPrompt(egg)

    if prompt then
        print("🟢 PROMPT:", prompt:GetFullName())

        pcall(function()
            prompt:InputHoldBegin()
        end)

        task.wait(
            math.max(
                prompt.HoldDuration,
                0.05
            )
        )

        pcall(function()
            prompt:InputHoldEnd()
        end)
    else
        warn("El huevo no tiene ProximityPrompt.")
    end

    task.wait(0.25)

    -- Spawn
    local spawn = FindSpawn()

    if spawn then
        root.CFrame =
            spawn.CFrame + Vector3.new(0, 3, 0)
    end

    Busy = false
end

