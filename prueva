--==============================================================
-- LUCK
--==============================================================

local function ParseLuck(value)

    local text = tostring(value or ""):upper()

    local number =
        tonumber(
            string.match(text, "[%d%.]+")
        )

    if not number then
        return 0
    end

    if string.find(text, "T", 1, true) then
        return number * 1000000000000
    elseif string.find(text, "B", 1, true) then
        return number * 1000000000
    elseif string.find(text, "M", 1, true) then
        return number * 1000000
    elseif string.find(text, "K", 1, true) then
        return number * 1000
    end

    return number
end

--==============================================================
-- EGG DATA
--==============================================================

local function GetEggData(name)

    if not name then
        return nil
    end

    if EggData[name] then
        return EggData[name]
    end

    local lower =
        string.lower(name)

    for eggName, data in pairs(EggData) do

        if string.find(
            lower,
            string.lower(eggName),
            1,
            true
        ) then
            return data
        end

    end

    return nil
end

--==============================================================
-- PART
--==============================================================

local function GetPart(obj)

    if not obj then
        return nil
    end

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then

        if obj.PrimaryPart then
            return obj.PrimaryPart
        end

        return obj:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
    end

    return nil
end

--==============================================================
-- ROOT
--==============================================================

local function GetRoot()

    local character =
        LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChild(
        "HumanoidRootPart"
    )
end

--==============================================================
-- POSITION
--==============================================================

local function GetPosition(obj)

    local part =
        GetPart(obj)

    if part then
        return part.Position
    end

    return nil
end

--==============================================================
-- VALID EGG
--==============================================================

local function IsValidEgg(obj)

    if not obj or not obj.Parent then
        return false
    end

    local data =
        GetEggData(obj.Name)

    if not data then
        return false
    end

    local position =
        GetPosition(obj)

    if not position then
        return false
    end

    local root =
        GetRoot()

    if not root then
        return false
    end

    -- EXCLUSION 210
    if (
        position - EXCLUSION_CENTER
    ).Magnitude <= EXCLUSION_RADIUS then
        return false
    end

    -- 100K
    if (
        position - root.Position
    ).Magnitude > DETECTION_DISTANCE then
        return false
    end

    return true
end

--==============================================================
-- REFRESH DEL MEJOR HUEVO
--==============================================================

local function RefreshBestEgg()

    local best = nil
    local bestValue = -1

    for _, obj in ipairs(
        Workspace:GetDescendants()
    ) do

        if IsValidEgg(obj) then

            local data =
                GetEggData(obj.Name)

            local value =
                ParseLuck(data.Luck)

            if value > bestValue then
                bestValue = value
                best = obj
            end

        end
    end

    BestEgg = best
    BestLuck = bestValue

    return best
end

