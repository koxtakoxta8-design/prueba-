--// RIDE A PET
--// BEST EGG -> GRAB -> +100 STUDS -> PLOT
--// EXCLUSION: 210 STUDS

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

--==================================================
-- CONFIGURACIÓN
--==================================================

local UP_SPEED = 2000
local PLOT_SPEED = 1000
local UP_DISTANCE = 100

-- Centro que NO debe utilizarse
local EXCLUSION_CENTER = Vector3.new(
    146.87,
    40316.12,
    911.14
)

local EXCLUSION_RADIUS = 210

--==================================================
-- VALORES DE LOS HUEVOS
--==================================================

local EggValues = {
    ["White Egg"] = 1,
    ["Brown Egg"] = 5,
    ["Cracked Egg"] = 30,
    ["Easter Egg"] = 50,
    ["Stone Egg"] = 100,
    ["Leaf Egg"] = 200,
    ["Mushroom Egg"] = 500,
    ["Flower Egg"] = 750,
    ["Slime Egg"] = 1000,
    ["Ice Egg"] = 3000,
    ["Glass Egg"] = 10000,
    ["Golden Egg"] = 30000,
    ["Crystal Egg"] = 150000,
    ["Skull Egg"] = 250000,
    ["Dominus Egg"] = 700000,
    ["Flaming Egg"] = 1000000,
    ["Sinister Egg"] = 3000000,
    ["Soul Egg"] = 7000000,
    ["Aurora Egg"] = 300000000,
    ["Galaxy Egg"] = 1500000000,
    ["Blackhole Egg"] = 100000000000,
    ["Solaris Egg"] = 300000000000,
    ["Cherub Egg"] = 1000000000000,
    ["Volcanic Egg"] = 2500000000000
}

--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
    return Player.Character
        or Player.CharacterAdded:Wait()
end

local function getRoot()
    local character = getCharacter()
    return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- DISTANCIA AL CENTRO DE EXCLUSIÓN
--==================================================

local function InsideExclusion(position)
    return (position - EXCLUSION_CENTER).Magnitude <= EXCLUSION_RADIUS
end

--==================================================
-- DETECTAR HUEVO
--==================================================

local function IsEgg(object)
    if not object then
        return false
    end

    local name = object.Name:lower()

    if name:find("egg") then
        return true
    end

    if name:find("huevo") then
        return true
    end

    return false
end

--==================================================
-- OBTENER PARTE DEL HUEVO
--==================================================

local function GetEggPart(egg)
    if not egg then
        return nil
    end

    if egg:IsA("BasePart") then
        return egg
    end

    return egg:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

--==================================================
-- VALOR DEL HUEVO
--==================================================

local function GetEggValue(egg)

    local name = egg.Name:lower()

    local bestValue = 0

    for eggName, value in pairs(EggValues) do
        if name:find(eggName:lower()) then
            bestValue = math.max(bestValue, value)
        end
    end

    -- Buscar valores internos
    for _, object in ipairs(egg:GetDescendants()) do

        if object:IsA("NumberValue")
            or object:IsA("IntValue") then

            local n = object.Name:lower()

            if n:find("luck")
                or n:find("value")
                or n:find("worth")
                or n:find("rarity") then

                bestValue = math.max(
                    bestValue,
                    object.Value
                )
            end
        end
    end

    return bestValue
end

--==================================================
-- BUSCAR MEJOR HUEVO
--==================================================

local function FindBestEgg()

    local bestEgg = nil
    local bestValue = -1

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if IsEgg(object) then

            local part = GetEggPart(object)

            if part then

                -- NO usar huevos dentro de 210 studs
                if not InsideExclusion(part.Position) then

                    local value =
                        GetEggValue(object)

                    if value > bestValue then

                        bestValue = value
                        bestEgg = object

                    end
                end
            end
        end
    end

    return bestEgg, bestValue
end

--==================================================
-- MOVIMIENTO
--==================================================

local function MoveTo(position, speed)

    local root = getRoot()

    if not root then
        return false
    end

    local startPosition =
        root.Position

    local distance =
        (startPosition - position).Magnitude

    if distance <= 1 then
        root.CFrame =
            CFrame.new(position)

        return true
    end

    local duration =
        distance / speed

    local startTime = tick()

    while true do

        root = getRoot()

        if not root then
            return false
        end

        local elapsed =
            tick() - startTime

        local alpha =
            math.clamp(
                elapsed / duration,
                0,
                1
            )

        local newPosition =
            startPosition:Lerp(
                position,
                alpha
            )

        root.CFrame =
            CFrame.new(newPosition)

        if alpha >= 1 then
            break
        end

        RunService.Heartbeat:Wait()
    end

    return true
end

--==================================================
-- AGARRAR HUEVO
--==================================================

local function GrabEgg(egg)

    if not egg then
        return
    end

    for _, object in ipairs(
        egg:GetDescendants()
    ) do

        if object:IsA("ProximityPrompt") then

            pcall(function()
                fireproximityprompt(object)
            end)

        elseif object:IsA("ClickDetector") then

            pcall(function()
                fireclickdetector(object)
            end)

        end
    end
end

--==================================================
-- BUSCAR PLOT DEL JUGADOR
--==================================================

local function FindMyPlot()

    local names = {
        "Plot",
        "Plots",
        "Base",
        "Bases",
        "Tycoon",
        "Tycoons",
        "PlayerPlot",
        "MyPlot",
        "PlotBase",
        "PlotBycoon",
        "PlotTycoon"
    }

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        for _, wantedName in ipairs(names) do

            if object.Name:lower()
                == wantedName:lower() then

                local attributes = {
                    "Owner",
                    "OwnerName",
                    "Player",
                    "PlayerName",
                    "Username",
                    "UserName",
                    "UserId",
                    "OwnerUserId"
                }

                for _, attribute in ipairs(
                    attributes
                ) do

                    local value =
                        object:GetAttribute(attribute)

                    if value ~= nil then

                        if tostring(value)
                            == Player.Name
                            or tostring(value)
                            == tostring(Player.UserId) then

                            return object
                        end
                    end
                end

                -- Buscar ObjectValue
                for _, child in ipairs(
                    object:GetDescendants()
                ) do

                    if child:IsA("ObjectValue")
                        and child.Value
                        == Player then

                        return object
                    end
                end
            end
        end
    end

    return nil
end

--==================================================
-- POSICIÓN DEL PLOT
--==================================================

local function GetPlotPosition(plot)

    if not plot then
        return nil
    end

    local spawnNames = {
        "Spawn",
        "SpawnLocation",
        "PlotSpawn",
        "SpawnPoint",
        "Drop",
        "DropPoint",
        "EggDrop"
    }

    for _, name in ipairs(spawnNames) do

        local object =
            plot:FindFirstChild(
                name,
                true
            )

        if object
            and object:IsA("BasePart") then

            return object.Position
        end
    end

    local part =
        plot:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if part then
        return part.Position
    end

    return nil
end

--==================================================
-- SOLTAR HUEVO
--==================================================

local function DropEgg()

    local names = {
        "DropEgg",
        "Drop Egg",
        "Drop",
        "DropButton",
        "DropEggButton",
        "Soltar",
        "SoltarHuevo"
    }

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        for _, wantedName in ipairs(names) do

            if object.Name:lower()
                == wantedName:lower() then

                if object:IsA("ProximityPrompt") then

                    pcall(function()
                        fireproximityprompt(object)
                    end)

                elseif object:IsA("ClickDetector") then

                    pcall(function()
                        fireclickdetector(object)
                    end)

                end
            end
        end
    end
end

--==================================================
-- CICLO PRINCIPAL
--==================================================

local function Start()

    print("🔎 Buscando mejor huevo...")

    local egg, value =
        FindBestEgg()

    if not egg then

        warn(
            "❌ No encontré un huevo válido fuera de los 210 studs."
        )

        return
    end

    local eggPart =
        GetEggPart(egg)

    if not eggPart then
        return
    end

    print(
        "🥚 Mejor huevo:",
        egg.Name,
        "Valor:",
        value
    )

    --==============================================
    -- 1. IR AL HUEVO
    --==============================================

    MoveTo(
        eggPart.Position,
        UP_SPEED
    )

    task.wait(0.1)

    --==============================================
    -- 2. AGARRAR
    --==============================================

    GrabEgg(egg)

    task.wait(0.15)

    --==============================================
    -- 3. SUBIR 100 STUDS
    --==============================================

    local root =
        getRoot()

    if not root then
        return
    end

    local currentPosition =
        root.Position

    local upPosition =
        currentPosition
        + Vector3.new(
            0,
            UP_DISTANCE,
            0
        )

    print(
        "⬆️ Subiendo 100 studs..."
    )

    MoveTo(
        upPosition,
        UP_SPEED
    )

    --==============================================
    -- 4. BUSCAR NUESTRO PLOT
    --==============================================

    task.wait(0.05)

    print(
        "🏠 Buscando tu plot..."
    )

    local plot =
        FindMyPlot()

    if not plot then

        warn(
            "❌ No pude encontrar tu plot."
        )

        return
    end

    local plotPosition =
        GetPlotPosition(plot)

    if not plotPosition then

        warn(
            "❌ Encontré el plot pero no su posición."
        )

        return
    end

    --==============================================
    -- 5. IR AL PLOT A 1000
    --==============================================

    print(
        "🚀 Yendo al plot..."
    )

    MoveTo(
        plotPosition
        + Vector3.new(0, 3, 0),
        PLOT_SPEED
    )

    task.wait(0.5)

    --==============================================
    -- 6. SOLTAR
    --==============================================

    print(
        "📦 Soltando huevo..."
    )

    DropEgg()

    print(
        "✅ Terminado."
    )
end

--==================================================
-- EJECUTAR
--==================================================

Start()
