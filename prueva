local function SearchBest()

    Status.Text = "Estado: BUSCANDO..."

    local best, luck, count =
        FindBestEgg()

    CountLabel.Text =
        "📡 HUEVOS: " .. tostring(count)

    if not best then

        BestLabel.Text = "🥚 MEJOR: NO ENCONTRADO"
        LuckLabel.Text = "🍀 LUCKY: ---"
        Status.Text = "Estado: SIN RESULTADO"

        return nil
    end

    BestLabel.Text =
        "🥚 MEJOR: " .. best.Name

    LuckLabel.Text =
        "🍀 LUCKY: " .. tostring(luck)

    Status.Text =
        "Estado: HUEVO ENCONTRADO"

    return best
end

