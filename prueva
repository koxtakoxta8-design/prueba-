local MotionLines = {}

local function CreateLine()

    local Line = Instance.new("Frame")
    Line.Size = UDim2.fromOffset(
        math.random(25,65),
        math.random(1,2)
    )
    Line.AnchorPoint = Vector2.new(.5,.5)
    Line.BackgroundColor3 = Color3.fromRGB(
        math.random(80,180),
        math.random(80,180),
        math.random(80,180)
    )
    Line.BorderSizePixel = 0
    Line.ZIndex = 5
    Line.Parent = FX

    local Side = math.random(1,4)

    local data = {
        Object = Line,
        Side = Side,
        Progress = math.random(),
        Speed = math.random(20,55)/100
    }

    table.insert(MotionLines,data)
end

for i = 1,14 do
    CreateLine()
end

RunService.RenderStepped:Connect(function(dt)

    for _,data in ipairs(MotionLines) do

        data.Progress += dt * data.Speed

        if data.Progress > 1 then
            data.Progress = 0
        end

        local line = data.Object
        local p = data.Progress

        if data.Side == 1 then

            line.Position =
                UDim2.new(
                    0,
                    25 + p * 280,
                    0,
                    10
                )

            line.Rotation = 0

        elseif data.Side == 2 then

            line.Position =
                UDim2.new(
                    0,
                    315,
                    0,
                    25 + p * 180
                )

            line.Rotation = 90

        elseif data.Side == 3 then

            line.Position =
                UDim2.new(
                    0,
                    305 - p * 280,
                    0,
                    215
                )

            line.Rotation = 0

        else

            line.Position =
                UDim2.new(
                    0,
                    5,
                    0,
                    195 - p * 180
                )

            line.Rotation = 90

        end
    end
end)

