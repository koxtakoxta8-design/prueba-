--==============================================================

TPButton.Activated:Connect(
    function()

        ClickAnimation(
            TPButton
        )

        InstaTP =
            not InstaTP

        UpdateTPButton()

        if InstaTP then

            SaveSpawn()

            if LOP then

                Status.Text =
                    "● LOOP ACTIVE"

                task.spawn(
                    function()

                        while
                            InstaTP
                            and LOP
                        do

                            if not Busy then

                                Busy = true

                                pcall(
                                    function()
                                        DoCycle()
                                    end
                                )

                                Busy = false

                            end

                            task.wait(
                                REFRESH_TIME
                            )

                        end

                    end
                )

            else

                task.spawn(
                    function()

                        if not Busy then

                            Busy = true

                            pcall(
                                function()
                                    DoCycle()
                                end
                            )

                            Busy = false

                        end

                        InstaTP = false

                        UpdateTPButton()

                        Status.Text =
                            "● READY"

                    end
                )

            end

        else

            InstaTP = false

            Status.Text =
                "● READY"

            UnfreezeCharacter()

        end

    end
)

